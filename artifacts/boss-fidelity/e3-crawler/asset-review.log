   464	def add_damage_shapes(drain_mast: bpy.types.Object, tracks: bpy.types.Object, capacitor_bank: bpy.types.Object) -> None:
   465	    drain_mast.shape_key_add(name="Basis")
   466	    toppled = drain_mast.shape_key_add(name="Damage_ToppledDrainMast")
   467	    pivot = Vector((-1.02, 0.0, 0.83))
   468	    angle = math.radians(-66)
   469	    for index in group_vertex_indices(drain_mast, "DamageMast"):
   470	        co = toppled.data[index].co
   471	        local = co - pivot
   472	        x = local.x * math.cos(angle) + local.z * math.sin(angle)
   473	        z = -local.x * math.sin(angle) + local.z * math.cos(angle)
   474	        co.x = pivot.x + x
   475	        co.z = pivot.z + z - 0.10
   476	        co.y += max(0.0, local.z) * 0.11
   477	    shard_moves = (
   478	        Vector((-0.34, 0.30, 0.18)),
   479	        Vector((-0.22, -0.34, 0.31)),
   480	        Vector((0.14, 0.39, 0.12)),
   481	    )
   482	    for shard, movement in enumerate(shard_moves):
   483	        for index in group_vertex_indices(drain_mast, f"DamageMastShard{shard}"):
   484	            toppled.data[index].co += movement
   485	    for index in group_vertex_indices(drain_mast, "DamageMastBreach"):
   486	        toppled.data[index].co += Vector((0.0, 0.52, 0.08))
   487	
   488	    tracks.shape_key_add(name="Basis")
   489	    shattered = tracks.shape_key_add(name="Damage_ShatteredTracks")
   490	    for index in group_vertex_indices(tracks, "DamageTrackNear"):
   491	        co = shattered.data[index].co
   492	        front = max(0.0, min(1.0, (-co.x + 0.25) / 1.55))
   493	        co.y += 0.20 + front * 0.34
   494	        co.z += math.sin((co.x + 1.5) * 5.5) * 0.12 + front * 0.14
   495	        co.x -= front * 0.18
   496	    for index in group_vertex_indices(tracks, "DamageTrackSkirt"):
   497	        co = shattered.data[index].co
   498	        front = max(0.0, min(1.0, (-co.x + 0.30) / 1.60))
   499	        co.y += 0.58
   500	        co.z -= 0.16 + front * 0.26
   501	        co.x -= front * 0.16
   502	    shard_moves = (
   503	        Vector((-0.48, 0.52, 0.32)),
   504	        Vector((-0.12, 0.62, 0.04)),
   505	        Vector((0.26, 0.48, 0.24)),
   506	    )
   507	    for shard, movement in enumerate(shard_moves):
   508	        for index in group_vertex_indices(tracks, f"DamageTrackShard{shard}"):
   509	            shattered.data[index].co += movement
   510	
   511	    capacitor_bank.shape_key_add(name="Basis")
   512	    ruptured = capacitor_bank.shape_key_add(name="Damage_RupturedCapacitorBank")
   513	    for index in group_vertex_indices(capacitor_bank, "DamageCapNear"):
   514	        co = ruptured.data[index].co
   515	        rear = max(0.0, min(1.0, (co.x - 0.35) / 1.05))
   516	        co.y += 0.34 + rear * 0.32
   517	        co.x += rear * 0.18
   518	        co.z -= 0.20 + rear * 0.28
   519	    for index in group_vertex_indices(capacitor_bank, "DamageCapRear"):
   520	        co = ruptured.data[index].co
   521	        co.x += 0.18
   522	        co.z -= max(0.0, co.z - 0.80) * 0.22
   523	    rupture_moves = (Vector((0.0, 0.68, 0.14)), Vector((0.12, 0.76, 0.26)))
   524	    arc_moves = (Vector((-0.07, 0.72, 0.44)), Vector((0.15, 0.82, 0.56)))
   525	    for rupture, movement in enumerate(rupture_moves):
   526	        for index in group_vertex_indices(capacitor_bank, f"DamageCapRupture{rupture}"):
   527	            co = ruptured.data[index].co
   528	            center = Vector(((0.72, 1.06)[rupture], 0.28, 1.50))
   529	            local = co - center
   530	            co.x = center.x + local.x * 1.35
   531	            co.y = center.y + local.y * 1.75
   532	            co.z = center.z + local.z * 0.62
   533	            co += movement
   534	    for arc, movement in enumerate(arc_moves):
   535	        for index in group_vertex_indices(capacitor_bank, f"DamageCapArc{arc}"):
   536	            ruptured.data[index].co += movement
   537	
   538	    for obj in (drain_mast, tracks, capacitor_bank):
   539	        obj.active_shape_key_index = 0
   540	        for key in obj.data.shape_keys.key_blocks:
   541	            key.value = 0.0
   542	
   543	
   544	def triangle_count(objects: tuple[bpy.types.Object, ...]) -> int:
   545	    return sum(sum(len(polygon.vertices) - 2 for polygon in obj.data.polygons) for obj in objects)
   546	
   547	
   548	def world_bounds(objects: tuple[bpy.types.Object, ...]) -> tuple[Vector, Vector]:
   549	    points = [obj.matrix_world @ vertex.co for obj in objects for vertex in obj.data.vertices]
   550	    return (
   551	        Vector((min(point.x for point in points), min(point.y for point in points), min(point.z for point in points))),
   552	        Vector((max(point.x for point in points), max(point.y for point in points), max(point.z for point in points))),
   553	    )
   554	
   555	
   556	def normalize_base_center(objects: tuple[bpy.types.Object, ...]) -> None:
   557	    minimum, maximum = world_bounds(objects)
   558	    center_x = (minimum.x + maximum.x) * 0.5
   559	    center_y = (minimum.y + maximum.y) * 0.5
   560	    scale_x = MODEL_LENGTH / (maximum.x - minimum.x)
   561	    for obj in objects:
   562	        for vertex in obj.data.vertices:
   563	            vertex.co.x = (vertex.co.x - center_x) * scale_x
   564	            vertex.co.y -= center_y
   565	            vertex.co.z -= minimum.z
   566	        obj.data.update()
   567	
   568	
   569	def export(objects: tuple[bpy.types.Object, ...]) -> None:
   570	    bpy.ops.object.select_all(action="DESELECT")
   571	    for obj in objects:
   572	        obj.select_set(True)
   573	    bpy.context.view_layer.objects.active = objects[0]
   574	    bpy.ops.wm.save_as_mainfile(filepath=str(BLEND))
   575	    bpy.ops.export_scene.gltf(
   576	        filepath=str(GLB.with_suffix("")),
   577	        export_format="GLB",
   578	        use_selection=True,
   579	        export_apply=True,
   580	        export_cameras=False,
   581	        export_lights=False,
   582	        export_animations=False,
   583	        export_materials="EXPORT",
   584	        export_morph=True,
   585	        export_extras=True,
   586	    )
   587	
   588	
   589	def main() -> None:
   590	    OUT.mkdir(parents=True, exist_ok=True)
   591	    reset_scene()
   592	    bpy.context.preferences.filepaths.save_version = 0
   593	    atlas, source_sha = create_atlas()
   594	    material = create_material(atlas)
   595	    drain_mast = join_component("drain_mast", build_drain_mast(material), material)
   596	    tracks = join_component("tracks", build_tracks(material), material)
   597	    capacitor_bank = join_component("capacitor_bank", build_capacitor_bank(material), material)
   598	    objects = (drain_mast, tracks, capacitor_bank)
   599	    normalize_base_center(objects)
   600	    add_damage_shapes(*objects)
   601	    collector_indices = group_vertex_indices(drain_mast, "CollectorAnchor")
   602	    assert collector_indices, "missing authored collector anchor"
   603	    anchors = {}
   604	    for state, key_name in (("intact", "Basis"), ("damaged", "Damage_ToppledDrainMast")):
   605	        points = drain_mast.data.shape_keys.key_blocks[key_name].data
   606	        center = sum((points[index].co for index in collector_indices), Vector()) / len(collector_indices)
   607	        anchors[state] = [float(center.x), float(center.z), float(-center.y)]
   608	        assert all(math.isfinite(value) for value in anchors[state])
   609	    # Extras use glTF's Y-up coordinates and follow the real collector through its morph.
   610	    drain_mast["collectorAnchor"] = anchors
   611	
   612	    minimum, maximum = world_bounds(objects)
   613	    triangles = triangle_count(objects)
   614	    assert triangles <= 12_000, f"triangle budget exceeded: {triangles}"
   615	    assert abs((maximum.x - minimum.x) - MODEL_LENGTH) < 0.01
   616	    assert abs((maximum.x + minimum.x) * 0.5) < 0.001
   617	    assert abs((maximum.y + minimum.y) * 0.5) < 0.001
   618	    assert abs(minimum.z) < 0.001
   619	    assert len({slot.material.name for obj in objects for slot in obj.material_slots if slot.material}) == 1
   620	    export(objects)
   621	    print(
   622	        json.dumps(
   623	            {
   624	                "blend": str(BLEND),
   625	                "glb": str(GLB),
   626	                "sha256": hashlib.sha256(GLB.read_bytes()).hexdigest(),
   627	                "sourcePlate": str(REFERENCE.relative_to(ROOT)),
   628	                "sourcePlateSha256": source_sha,
   629	                "surfaceSource": str(SURFACE_REFERENCE.relative_to(ROOT)),
   630	                "surfaceSha256": hashlib.sha256(SURFACE_REFERENCE.read_bytes()).hexdigest(),
   631	                "objects": [obj.name for obj in objects],
   632	                "damageMorphs": [obj.data.shape_keys.key_blocks[1].name for obj in objects],
   633	                "triangles": triangles,
   634	                "boundsBlender": {
   635	                    "min": [round(value, 6) for value in minimum],
   636	                    "max": [round(value, 6) for value in maximum],
   637	                },
   638	            },
   639	            indent=2,
   640	        )
   641	    )
   642	
   643	
