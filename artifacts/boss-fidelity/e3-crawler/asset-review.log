   134	            "max": [round(value, 6) for value in maximum],
   135	            "size": [round(maximum[axis] - minimum[axis], 6) for axis in range(3)],
   136	            "center": [round((maximum[axis] + minimum[axis]) * 0.5, 6) for axis in range(3)],
   137	        },
   138	    }
