   409	def prepare_part(obj: bpy.types.Object) -> None:
   410	    bpy.context.view_layer.objects.active = obj
   411	    obj.select_set(True)
   412	    for modifier in list(obj.modifiers):
   413	        bpy.ops.object.modifier_apply(modifier=modifier.name)
   414	    # Preserve vertical V on the copper cylinders so the winding lines stay horizontal.
   415	    if not obj.get("keep_cylinder_uv", False):
   416	        bpy.ops.object.mode_set(mode="EDIT")
   417	        bpy.ops.mesh.select_all(action="SELECT")
   418	        bpy.ops.mesh.normals_make_consistent(inside=False)
   419	        bpy.ops.uv.smart_project(angle_limit=math.radians(66), island_margin=0.025)
   420	        bpy.ops.object.mode_set(mode="OBJECT")
   421	    uv = obj.data.uv_layers.active.data
   422	    coords = np.array([[loop.uv.x, loop.uv.y] for loop in uv], dtype=np.float32)
   423	    low = coords.min(axis=0)
   424	    span = np.maximum(coords.max(axis=0) - low, 1e-6)
   425	    u0, v0, u1, v1 = REGIONS[obj["atlas_region"]]
   426	    for loop, coord in zip(uv, coords):
   427	        normalized = (coord - low) / span
   428	        loop.uv = (u0 + normalized[0] * (u1 - u0), v0 + normalized[1] * (v1 - v0))
   429	    obj.select_set(False)
   430	
   431	
   432	def join_component(name: str, parts: list[bpy.types.Object], material: bpy.types.Material) -> bpy.types.Object:
   433	    for part in parts:
   434	        prepare_part(part)
   435	    bpy.ops.object.select_all(action="DESELECT")
   436	    for part in parts:
   437	        part.select_set(True)
   438	    bpy.context.view_layer.objects.active = parts[0]
   439	    bpy.ops.object.join()
   440	    component = bpy.context.object
   441	    component.name = name
   442	    component.data.name = f"{name}Mesh"
   443	    component.data.materials.clear()
   444	    component.data.materials.append(material)
   445	    for polygon in component.data.polygons:
   446	        polygon.material_index = 0
   447	    component.data.uv_layers.active.name = "UVMap"
   448	    for key in list(component.keys()):
   449	        del component[key]
   450	    bpy.context.scene.cursor.location = (0, 0, 0)
   451	    bpy.ops.object.origin_set(type="ORIGIN_CURSOR")
   452	    component.select_set(False)
   453	    return component
   454	
   455	
   456	def group_vertex_indices(obj: bpy.types.Object, group_name: str) -> set[int]:
   457	    group = obj.vertex_groups.get(group_name)
   458	    if group is None:
   459	        return set()
   460	    index = group.index
   461	    return {vertex.index for vertex in obj.data.vertices if any(item.group == index for item in vertex.groups)}
   462	
