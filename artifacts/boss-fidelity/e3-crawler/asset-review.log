    43	def read_glb(path: Path) -> tuple[dict, bytes]:
    44	    data = path.read_bytes()
    45	    magic, version, total = struct.unpack_from("<4sII", data)
    46	    assert magic == b"glTF" and version == 2 and total == len(data)
    47	    json_length, json_kind = struct.unpack_from("<II", data, 12)
    48	    assert json_kind == 0x4E4F534A
    49	    document = json.loads(data[20:20 + json_length])
    50	    binary_offset = 20 + json_length
    51	    binary_length, binary_kind = struct.unpack_from("<II", data, binary_offset)
    52	    assert binary_kind == 0x004E4942
    53	    return document, data[binary_offset + 8:binary_offset + 8 + binary_length]
    54	
    55	
    56	def image_dimensions(document: dict, binary: bytes) -> list[list[int]]:
    57	    dimensions = []
    58	    for image in document.get("images", []):
    59	        view = document["bufferViews"][image["bufferView"]]
    60	        start = view.get("byteOffset", 0)
    61	        payload = binary[start:start + view["byteLength"]]
    62	        assert payload[:8] == b"\x89PNG\r\n\x1a\n"
    63	        dimensions.append(list(struct.unpack(">II", payload[16:24])))
    64	    return dimensions
    65	
    66	
    67	def contract(path: Path) -> dict:
    68	    document, binary = read_glb(path)
    69	    accessors = document.get("accessors", [])
    70	    meshes = document.get("meshes", [])
    71	    primitives = [(mesh, primitive) for mesh in meshes for primitive in mesh.get("primitives", [])]
    72	    materials = document.get("materials", [])
    73	    textures = document.get("textures", [])
    74	    primitive_materials = [primitive.get("material") for _, primitive in primitives]
    75	    material_texture_bindings = []
    76	    for material_index, material in enumerate(materials):
    77	        texture_index = material.get("pbrMetallicRoughness", {}).get("baseColorTexture", {}).get("index")
    78	        image_index = textures[texture_index].get("source") if isinstance(texture_index, int) and texture_index < len(textures) else None
    79	        material_texture_bindings.append(
    80	            {"material": material_index, "baseColorTexture": texture_index, "image": image_index}
    81	        )
    82	    positions = [accessors[primitive["attributes"]["POSITION"]] for _, primitive in primitives]
    83	    minimum = [min(item["min"][axis] for item in positions) for axis in range(3)]
    84	    maximum = [max(item["max"][axis] for item in positions) for axis in range(3)]
    85	    nodes = document.get("nodes", [])
    86	    node_names = [node.get("name") for node in nodes if "mesh" in node]
    87	    morphs = {mesh.get("name"): mesh.get("extras", {}).get("targetNames", []) for mesh in meshes}
    88	    bindings = []
    89	    transforms = {}
    90	    for node in nodes:
    91	        if "mesh" not in node:
    92	            continue
    93	        mesh = meshes[node["mesh"]]
    94	        targets = mesh.get("extras", {}).get("targetNames", [])
    95	        weights = node.get("weights", mesh.get("weights", [0.0] * len(targets)))
    96	        bindings.append(
    97	            {"node": node.get("name"), "mesh": mesh.get("name"), "targets": targets, "defaultWeights": weights}
    98	        )
    99	        transforms[node.get("name")] = {
   100	            "translation": node.get("translation", [0.0, 0.0, 0.0]),
   101	            "rotation": node.get("rotation", [0.0, 0.0, 0.0, 1.0]),
   102	            "scale": node.get("scale", [1.0, 1.0, 1.0]),
   103	            "matrix": node.get("matrix"),
   104	        }
   105	    return {
   106	        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
   107	        "bytes": path.stat().st_size,
   108	        "nodes": node_names,
   109	        "nodeCount": len(nodes),
   110	        "bindings": bindings,
   111	        "nodeTransforms": transforms,
   112	        "collectorAnchor": next((node.get("extras", {}).get("collectorAnchor") for node in nodes if node.get("name") == "drain_mast"), None),
   113	        "meshes": len(meshes),
   114	        "meshNames": [mesh.get("name") for mesh in meshes],
   115	        "primitives": len(primitives),
   116	        "primitiveMaterials": primitive_materials,
   117	        "triangles": sum(accessors[primitive["indices"]]["count"] // 3 for _, primitive in primitives),
   118	        "morphTargets": morphs,
   119	        "targetCounts": {
   120	            mesh.get("name"): sum(len(primitive.get("targets", [])) for primitive in mesh.get("primitives", []))
   121	            for mesh in meshes
   122	        },
   123	        "materials": len(materials),
   124	        "materialTextureBindings": material_texture_bindings,
   125	        "textureSources": [texture.get("source") for texture in textures],
   126	        "images": len(document.get("images", [])),
   127	        "embeddedImages": sum("bufferView" in image for image in document.get("images", [])),
   128	        "imageDimensions": image_dimensions(document, binary),
   129	        "cameras": len(document.get("cameras", [])),
   130	        "lights": len(document.get("extensions", {}).get("KHR_lights_punctual", {}).get("lights", [])),
   131	        "animations": len(document.get("animations", [])),
   132	        "bounds": {
