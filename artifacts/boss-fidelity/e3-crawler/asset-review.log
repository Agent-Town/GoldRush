    67	def mark_all(obj: bpy.types.Object, group_name: str | None) -> None:
    68	    if not group_name:
    69	        return
    70	    group = obj.vertex_groups.new(name=group_name)
    71	    group.add(list(range(len(obj.data.vertices))), 1.0, "REPLACE")
