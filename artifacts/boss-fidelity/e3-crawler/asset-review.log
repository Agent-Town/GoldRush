    74	def tag(
    75	    obj: bpy.types.Object,
    76	    region: str,
    77	    material: bpy.types.Material,
    78	    bevel: float = 0.008,
    79	    damage_group: str | None = None,
    80	    smooth: bool = False,
    81	) -> bpy.types.Object:
    82	    obj["atlas_region"] = region
    83	    obj.data.materials.append(material)
    84	    mark_all(obj, damage_group)
    85	    if bevel > 0:
    86	        modifier = obj.modifiers.new("Battered edge", "BEVEL")
    87	        modifier.width = bevel
    88	        modifier.segments = 1
    89	        modifier.limit_method = "ANGLE"
    90	    if smooth:
    91	        for polygon in obj.data.polygons:
    92	            polygon.use_smooth = True
    93	    return obj
