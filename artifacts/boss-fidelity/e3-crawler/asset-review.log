   197	def beam(
   198	    name: str,
   199	    start: tuple[float, float, float],
   200	    end: tuple[float, float, float],
   201	    width: float,
   202	    region: str,
   203	    material: bpy.types.Material,
   204	    damage_group: str | None = None,
   205	) -> bpy.types.Object:
   206	    a, b = Vector(start), Vector(end)
   207	    direction = b - a
   208	    obj = box(
   209	        name,
   210	        (width, width, direction.length),
   211	        tuple((a + b) * 0.5),
   212	        region,
   213	        material,
   214	        bevel=min(0.006, width * 0.18),
   215	        damage_group=damage_group,
   216	    )
   217	    obj.rotation_mode = "QUATERNION"
   218	    obj.rotation_quaternion = direction.to_track_quat("Z", "Y")
   219	    bpy.context.view_layer.objects.active = obj
   220	    obj.select_set(True)
   221	    bpy.ops.object.transform_apply(location=False, rotation=True, scale=False)
   222	    obj.select_set(False)
   223	    return obj
