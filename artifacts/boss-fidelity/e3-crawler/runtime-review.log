   701	  private hideTransientPresentation(): void {
   702	    for (const mesh of this.componentMeshes.values()) mesh.visible = false;
   703	    this.beam.visible = false;
   704	    this.dial.visible = false;
   705	    this.wreck.visible = false;
   706	  }
   707	}
