   717	function cylinder(radius: number, height: number, color: string, x: number, y: number, z: number): THREE.Mesh {
   718	  const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius, height, 12), new THREE.MeshBasicMaterial({ color }));
   719	  mesh.position.set(x, y, z);
   720	  return mesh;
   721	}
