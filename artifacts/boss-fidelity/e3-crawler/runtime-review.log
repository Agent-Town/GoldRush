   711	function box(width: number, height: number, depth: number, color: string, x: number, y: number, z: number): THREE.Mesh {
   712	  const mesh = new THREE.Mesh(new THREE.BoxGeometry(width, height, depth), new THREE.MeshBasicMaterial({ color }));
   713	  mesh.position.set(x, y, z);
   714	  return mesh;
   715	}
