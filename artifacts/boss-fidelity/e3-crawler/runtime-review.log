   528	      this.crawler3dComponentBounds.set(id, new THREE.Box3());
   529	    }
   530	    for (const mesh of meshes.values()) {
   531	      const material = (mesh.material as THREE.MeshStandardMaterial).clone();
   532	      material.emissiveMap = material.map;
   533	      mesh.material = material;
   534	    }
   535	    for (const material of materials) material.dispose();
   536	    return meshes;
   537	  }
   538	
   539	  private updateCrawler3d(components: ReadonlyMap<CrawlerComponentId, ClaimJumperEnemy>): void {
   540	    if (!this.crawler3dModel || this.crawler3dState !== 'ready' || components.size === 0) return;
   541	    const anchor = components.values().next().value as ClaimJumperEnemy | undefined;
   542	    if (!anchor?.bossGroupId) return;
   543	    if (this.crawler3dGroupId !== anchor.bossGroupId) {
   544	      const contract = activeContract();
   545	      const baron = contract.twist.baron;
   546	      const route = contract.tileParams.rails?.[baron?.railRouteIndex ?? 0];
   547	      const start = route?.points[0], end = route?.points.at(-1);
   548	      if (baron?.variantId !== CRAWLER_VARIANT || !start || !end) return;
   549	      const length = Math.hypot(end.x - start.x, end.z - start.z);
   550	      if (length < 0.001) return;
   551	      const alongX = (end.x - start.x) / length, alongZ = (end.z - start.z) / length;
   552	      this.crawler3dYaw = Math.atan2(-alongZ, alongX);
   553	      this.crawler3dGroupId = anchor.bossGroupId;
   554	      this.crawler3dOffsets.clear();
   555	      // The complete authored formation survives late loading, reversal and any
   556	      // component loss. Dead positions become stale while surviving routes move.
   557	      const authored = baron.components ?? [];
   558	      const meanAlong = authored.reduce((sum, part, index) => sum + (part.xOffset ?? index * 1.1), 0) / authored.length;
   559	      const meanSide = authored.reduce((sum, part) => sum + (part.zOffset ?? 0), 0) / authored.length;
   560	      for (const [index, part] of authored.entries()) {
   561	        if (!COMPONENT_IDS.includes(part.id as CrawlerComponentId)) continue;
   562	        const along = (part.xOffset ?? index * 1.1) - meanAlong, side = (part.zOffset ?? 0) - meanSide;
   563	        this.crawler3dOffsets.set(part.id as CrawlerComponentId, new THREE.Vector3(alongX * along - alongZ * side, 0, alongZ * along + alongX * side));
   564	      }
   565	    }
   566	    this.crawler3dCenter.set(0, 0, 0);
   567	    for (const [id, enemy] of components) {
   568	      this.crawler3dCenter.add(enemy.position);
   569	      const offset = this.crawler3dOffsets.get(id);
   570	      if (offset) this.crawler3dCenter.sub(offset);
   571	    }
   572	    this.crawler3dCenter.multiplyScalar(1 / components.size);
   573	    this.crawler3dCenter.x += Math.cos(this.crawler3dYaw) * CRAWLER_3D_LONGITUDINAL_SHIFT;
   574	    this.crawler3dCenter.z -= Math.sin(this.crawler3dYaw) * CRAWLER_3D_LONGITUDINAL_SHIFT;
   575	    this.crawler3dModel.position.set(
   576	      this.crawler3dCenter.x,
   577	      Terrain.visualY(this.crawler3dCenter.x, this.crawler3dCenter.z, 0),
   578	      this.crawler3dCenter.z,
   579	    );
   580	    this.crawler3dModel.rotation.set(0, this.crawler3dYaw, 0);
   581	    this.crawler3dModel.scale.setScalar(CRAWLER_3D_SCALE);
   582	    this.groundCrawler3d();
   583	    this.crawler3dModel.visible = true;
   584	    for (const [id, mesh] of this.crawler3dMeshes) {
   585	      const enemy = components.get(id);
   586	      const damaged = this.destroyed.has(id) || Boolean(enemy && enemy.currentHp / Math.max(1, enemy.maxHp) <= CRAWLER_DAMAGE_THRESHOLD);
   587	      if (mesh.morphTargetInfluences) mesh.morphTargetInfluences[0] = damaged ? 1 : 0;
   588	      const material = mesh.material as THREE.MeshStandardMaterial;
   589	      material.emissive.copy(CRAWLER_3D_FILL);
   590	      if (damaged) material.emissive.set(CRAWLER_3D_COMPONENTS[id].damageColor).lerp(CRAWLER_3D_FILL, 0.8);
   591	      material.emissiveIntensity = damaged ? 2.2 : 2;
   592	    }
   593	    this.crawler3dModel.updateWorldMatrix(true, true);
   594	    this.crawler3dBounds.makeEmpty();
   595	    let barPointCount = 0;
   596	    for (const [id, mesh] of this.crawler3dMeshes) {
   597	      const bounds = this.crawler3dComponentBounds.get(id)!;
   598	      const damaged = mesh.morphTargetInfluences?.[0] === 1 ? 1 : 0;
   599	      bounds.copy(this.crawler3dLocalBounds.get(id)![damaged]).applyMatrix4(mesh.matrixWorld);
   600	      this.crawler3dBounds.union(bounds);
   601	      for (const point of this.crawler3dHullPoints.get(id)![damaged]) {
   602	        const worldPoint = this.crawler3dBarPoints[barPointCount] ?? (this.crawler3dBarPoints[barPointCount] = new THREE.Vector3());
   603	        worldPoint.copy(point).applyMatrix4(mesh.matrixWorld);
   604	        barPointCount += 1;
   605	      }
   606	    }
   607	    this.crawler3dBarPoints.length = barPointCount;
   608	  }
   609	
   610	  private groundCrawler3d(): void {
   611	    const model = this.crawler3dModel!;
   612	    const halfX = this.crawler3dSupportHalfSize.x * CRAWLER_3D_SCALE, halfZ = this.crawler3dSupportHalfSize.y * CRAWLER_3D_SCALE;
   613	    const cos = Math.cos(this.crawler3dYaw), sin = Math.sin(this.crawler3dYaw);
   614	    const height = (x: number, z: number) => Terrain.visualY(model.position.x + cos * x + sin * z, model.position.z - sin * x + cos * z, 0);
   615	    const h00 = height(-halfX, -halfZ), h10 = height(halfX, -halfZ), h01 = height(-halfX, halfZ), h11 = height(halfX, halfZ);
   616	    const slopeX = (h10 + h11 - h00 - h01) / (4 * halfX), slopeZ = (h01 + h11 - h00 - h10) / (4 * halfZ);
   617	    this.crawler3dNormal.set(-slopeX, 1, -slopeZ).normalize();
   618	    this.crawler3dTilt.setFromUnitVectors(this.crawler3dUp, this.crawler3dNormal);
   619	    model.quaternion.multiply(this.crawler3dTilt);
   620	    model.position.y = (h00 + h10 + h01 + h11 + height(0, 0)) / 5;
   621	    model.updateWorldMatrix(true, true);
   622	    const tracks = this.crawler3dMeshes.get('tracks')!;
   623	    let lift = 0;
   624	    // Cache the intact support vertices once; damage debris must not lift the chassis.
   625	    for (const point of this.crawler3dSupportPoints) {
   626	      this.crawler3dPoint.copy(point).applyMatrix4(tracks.matrixWorld);
   627	      lift = Math.max(lift, Terrain.visualY(this.crawler3dPoint.x, this.crawler3dPoint.z, 0) - this.crawler3dPoint.y);
   628	    }
   629	    model.position.y += lift + 0.025;
   630	  }
   631	
   632	  private disposeCrawler3d(nextState: Crawler3dState): void {
   633	    this.crawler3dLoadSerial += 1;
   634	    if (this.crawler3dModel) {
   635	      this.group.remove(this.crawler3dModel);
   636	      disposeObject3D(this.crawler3dModel);
   637	      this.crawler3dModel = undefined;
   638	    }
   639	    this.crawler3dMeshes.clear();
   640	    this.crawler3dOffsets.clear();
   641	    this.crawler3dLocalBounds.clear();
   642	    this.crawler3dHullPoints.clear();
   643	    this.crawler3dBarPoints.length = 0;
   644	    this.crawler3dComponentBounds.clear();
   645	    this.crawler3dBounds.makeEmpty();
   646	    this.crawler3dSupportPoints.length = 0;
   647	    this.crawler3dGroupId = null;
   648	    this.crawler3dState = nextState;
   649	    this.publishCrawler3d();
   650	  }
   651	
   652	  private publishCrawler3d(components: ReadonlyMap<CrawlerComponentId, ClaimJumperEnemy> = this.liveComponents()): void {
   653	    if (typeof document === 'undefined') return;
   654	    const canvas = document.querySelector('canvas');
   655	    if (!canvas) return;
   656	    canvas.dataset.crawler3dState = this.crawler3dState;
   657	    canvas.dataset.crawler3dSource = this.crawler3dState === 'ready' ? 'glb' : 'placeholder';
   658	    canvas.dataset.crawler3dMounted = String(this.crawler3dState === 'ready' && this.crawler3dGroupId !== null);
   659	    canvas.dataset.crawler3dDamageStates = JSON.stringify(Object.fromEntries(COMPONENT_IDS.map((id) => {
   660	      const enemy = components.get(id);
   661	      const damaged = this.destroyed.has(id) || Boolean(enemy && enemy.currentHp / Math.max(1, enemy.maxHp) <= CRAWLER_DAMAGE_THRESHOLD);
   662	      return [id, damaged ? 'broken' : 'intact'];
   663	    })));
   664	  }
   665	
   666	  private placeBeamSegment(mesh: THREE.Mesh, start: THREE.Vector3, end: THREE.Vector3): void {
   667	    const direction = end.clone().sub(start);
   668	    mesh.position.copy(start).add(end).multiplyScalar(0.5);
   669	    mesh.scale.set(1, direction.length(), 1);
   670	    mesh.quaternion.setFromUnitVectors(Y_AXIS, direction.normalize());
   671	  }
   672	
   673	  private nearestRelay(position: THREE.Vector3): PowerNodeSnapshot | null {
   674	    let nearest: PowerNodeSnapshot | null = null;
   675	    let distance = Number.POSITIVE_INFINITY;
   676	    for (const node of this.powerNodes()) {
   677	      if (node.kind !== 'relay' || !node.online || node.state === 'dark') continue;
   678	      const candidate = Math.hypot(node.x - position.x, node.z - position.z);
   679	      if (candidate >= distance) continue;
   680	      nearest = node;
   681	      distance = candidate;
   682	    }
   683	    return nearest;
   684	  }
   685	
   686	  private syncDrainTarget(target: PowerNodeSnapshot | null): void {
   687	    const nextNodeId = this.drainActive && target ? `crawler-drain-${target.id.replace(/^pylon-/, '')}` : null;
   688	    if (this.drainNodeId !== nextNodeId) {
   689	      if (this.drainNodeId) this.queuePower({ type: 'set-node-online', nodeId: this.drainNodeId, online: false });
   690	      if (nextNodeId) this.queuePower({ type: 'set-node-online', nodeId: nextNodeId, online: true });
   691	      this.drainNodeId = nextNodeId;
   692	    }
   693	    this.drainTarget = target?.id ?? null;
   694	  }
   695	
   696	  private activeDrainNode(): PowerNodeSnapshot | null {
   697	    if (!this.drainActive || !this.drainNodeId) return null;
   698	    return this.powerNodes().find((node) => node.id === this.drainNodeId) ?? null;
   699	  }
