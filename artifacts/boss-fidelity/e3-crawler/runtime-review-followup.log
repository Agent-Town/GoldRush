   546	  private updateCrawler3d(components: ReadonlyMap<CrawlerComponentId, ClaimJumperEnemy>): void {
   547	    if (!this.crawler3dModel || this.crawler3dState !== 'ready' || components.size === 0) return;
   548	    const anchor = components.values().next().value as ClaimJumperEnemy | undefined;
   549	    if (!anchor?.bossGroupId) return;
   550	    if (this.crawler3dGroupId !== anchor.bossGroupId) {
   551	      const contract = activeContract();
   552	      const baron = contract.twist.baron;
   553	      const route = contract.tileParams.rails?.[baron?.railRouteIndex ?? 0];
   554	      const start = route?.points[0], end = route?.points.at(-1);
   555	      if (baron?.variantId !== CRAWLER_VARIANT || !start || !end) return;
   556	      const length = Math.hypot(end.x - start.x, end.z - start.z);
   557	      if (length < 0.001) return;
   558	      const alongX = (end.x - start.x) / length, alongZ = (end.z - start.z) / length;
   559	      this.crawler3dYaw = Math.atan2(-alongZ, alongX);
   560	      this.crawler3dGroupId = anchor.bossGroupId;
   561	      this.crawler3dOffsets.clear();
   562	      // The complete authored formation survives late loading, reversal and any
   563	      // component loss. Dead positions become stale while surviving routes move.
   564	      const authored = baron.components ?? [];
   565	      const meanAlong = authored.reduce((sum, part, index) => sum + (part.xOffset ?? index * 1.1), 0) / authored.length;
   566	      const meanSide = authored.reduce((sum, part) => sum + (part.zOffset ?? 0), 0) / authored.length;
   567	      for (const [index, part] of authored.entries()) {
   568	        if (!COMPONENT_IDS.includes(part.id as CrawlerComponentId)) continue;
   569	        const along = (part.xOffset ?? index * 1.1) - meanAlong, side = (part.zOffset ?? 0) - meanSide;
   570	        this.crawler3dOffsets.set(part.id as CrawlerComponentId, new THREE.Vector3(alongX * along - alongZ * side, 0, alongZ * along + alongX * side));
   571	      }
   572	    }
   573	    this.crawler3dCenter.set(0, 0, 0);
   574	    for (const [id, enemy] of components) {
   575	      this.crawler3dCenter.add(enemy.position);
   576	      const offset = this.crawler3dOffsets.get(id);
   577	      if (offset) this.crawler3dCenter.sub(offset);
   578	    }
   579	    this.crawler3dCenter.multiplyScalar(1 / components.size);
   580	    this.crawler3dCenter.x += Math.cos(this.crawler3dYaw) * CRAWLER_3D_LONGITUDINAL_SHIFT;
   581	    this.crawler3dCenter.z -= Math.sin(this.crawler3dYaw) * CRAWLER_3D_LONGITUDINAL_SHIFT;
   582	    this.crawler3dModel.position.set(
   583	      this.crawler3dCenter.x,
   584	      Terrain.visualY(this.crawler3dCenter.x, this.crawler3dCenter.z, 0),
   585	      this.crawler3dCenter.z,
   586	    );
   587	    this.crawler3dModel.rotation.set(0, this.crawler3dYaw, 0);
   588	    this.crawler3dModel.scale.setScalar(CRAWLER_3D_SCALE);
   589	    this.groundCrawler3d();
   590	    this.crawler3dModel.visible = true;
   591	    for (const [id, mesh] of this.crawler3dMeshes) {
   592	      const enemy = components.get(id);
   593	      const damaged = this.destroyed.has(id) || Boolean(enemy && enemy.currentHp / Math.max(1, enemy.maxHp) <= CRAWLER_DAMAGE_THRESHOLD);
   594	      if (mesh.morphTargetInfluences) mesh.morphTargetInfluences[0] = damaged ? 1 : 0;
   595	      const material = mesh.material as THREE.MeshStandardMaterial;
   596	      material.emissive.copy(CRAWLER_3D_FILL);
   597	      if (damaged) material.emissive.set(CRAWLER_3D_COMPONENTS[id].damageColor).lerp(CRAWLER_3D_FILL, 0.8);
   598	      material.emissiveIntensity = damaged ? 2.2 : 2;
   599	    }
   600	    this.crawler3dModel.updateWorldMatrix(true, true);
   601	    this.crawler3dBounds.makeEmpty();
   602	    let barPointCount = 0;
   603	    for (const [id, mesh] of this.crawler3dMeshes) {
   604	      const bounds = this.crawler3dComponentBounds.get(id)!;
   605	      const damaged = mesh.morphTargetInfluences?.[0] === 1 ? 1 : 0;
   606	      bounds.copy(this.crawler3dLocalBounds.get(id)![damaged]).applyMatrix4(this.crawler3dModel.matrixWorld);
   607	      this.crawler3dBounds.union(bounds);
   608	      for (const point of this.crawler3dHullPoints.get(id)![damaged]) {
   609	        const worldPoint = this.crawler3dBarPoints[barPointCount] ?? (this.crawler3dBarPoints[barPointCount] = new THREE.Vector3());
   610	        worldPoint.copy(point).applyMatrix4(this.crawler3dModel.matrixWorld);
   611	        barPointCount += 1;
   612	      }
   613	    }
   614	    this.crawler3dBarPoints.length = barPointCount;
   615	  }
   616	
   617	  private groundCrawler3d(): void {
