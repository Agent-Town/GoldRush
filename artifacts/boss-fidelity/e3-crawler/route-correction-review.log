      const examiner = new live.constructor(() => [], () => [], () => false, () => false);
      invalid[fault] = examiner.inspectCrawler3d(clone) === null;
      examiner.dispose();
      meshes.forEach(mesh => mesh.geometry.dispose());
      material.dispose();
    }
    const models = {};
