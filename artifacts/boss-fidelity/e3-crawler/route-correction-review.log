  const delta = (a, b) => Math.max(...a.flat(Infinity).map((v, i) => Math.abs(v - b.flat(Infinity)[i])));
  const boundsDelta = (a, b) => Math.max(...Object.keys(a).flatMap(id => a[id].map((state, i) => delta([state.min, state.max], [b[id][i].min, b[id][i].max]))));
