      hpScale: 4,
      speedScale: 0.001,
      visualScale: 4,
      banner: true,
      heroPursuitRange: 45,
      buildingDamageScale: 12,
      supportBuildingDamageScale: 8,
    });
  });
  await advance(page, 0.05);
  return errors;
}


