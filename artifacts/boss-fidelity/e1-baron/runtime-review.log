    32	      h.spawnPack(1, 12, { eliteKind: 'baron', hpScale: 240, speedScale: 0.001, visualScale: 4, banner: true, wrecker: true, heroPursuitRange: 45 });
    33	   }, gameUrl);
    34	    await page.waitForFunction(() => window.__baronProbe && window.__THREE_GAME_DIAGNOSTICS__?.baronRocket.props.state === 'ready');
    35	    const idle = await page.evaluate(() => {
    36	      const g = window.__baronProbe;
    37	      const launcher = g.baronProps3dModel.getObjectByName('BaronShoulderLauncher');
    38	      const keg = g.baronProps3dModel.getObjectByName('BaronPowderKeg');
    39	      window.__baronLaunches = [];
    40	      const launch = g.combat.launchLob;
    41	      g.combat.launchLob = function (origin, ...args) {
    42	        window.__baronLaunches.push({ origin: origin.toArray(), boss: g.activeBaronEnemy().position.toArray(), target: args[0].toArray() });
    43	        return launch.call(this, origin, ...args);
    44	      };
    45	      const tracer = g.baronVolleyVfx.tracer;
    46	      g.baronVolleyVfx.tracer = function (...args) {
    47	        tracer.apply(this, args);
    48	        const at = this.tracerFrom[this.tracerAge.findIndex(age => age === 0)];
    49	        window.__baronLaunches.at(-1).visualOrigin = at.toArray();
    50	        window.__baronLaunches.at(-1).launcherPosition = launcher.getWorldPosition(at.clone()).toArray();
    51	      };
    52	      return { emission: launcher.material.emissiveIntensity, kegEmission: keg.material.emissiveIntensity,
    53	        materialsSeparate: launcher.material !== keg.material,
    54	        emissiveMapPreserved: !!launcher.material.emissiveMap && launcher.material.emissiveMap !== launcher.material.map,
    55	        rocketUsesKegMaterial: g.baronVolleyVfx.rocketMaterial === keg.material };
    56	    });
    57	    assert.equal(idle.materialsSeparate, true, 'only launcher pulses');
    58	    assert.equal(idle.emissiveMapPreserved, true, 'authored selective emission survives loading');
    59	    assert.equal(idle.rocketUsesKegMaterial, true, 'flight material stays independent of launcher pulse');
    60	    await page.evaluate(x => window.__GR_TEST__.teleport(x, 12), viewport.width > 400 ? 5 : 1.6);
    61	    let tell;
    62	    for (let i = 0; i < 150; i++) {
    63	      tell = await page.evaluate(() => {
    64	        window.__GR_TEST__.advanceSim(1 / 30);
    65	        const g = window.__baronProbe;
    66	        g.syncBaronRocketCart();
    67	        return { active: window.__THREE_GAME_DIAGNOSTICS__.baronRocket.telegraphActive,
    68	          launcher: g.baronShoulderLauncher.material.emissiveIntensity,
    69	          keg: g.baronProps3dModel.getObjectByName('BaronPowderKeg').material.emissiveIntensity };
    70	      });
    71	      if (tell.active) break;
    72	    }
    73	    assert.equal(tell.active, true);
    74	    assert.ok(tell.launcher >= idle.emission * 1.59, 'loaded fuse brightens during warning');
    75	    assert.equal(tell.keg, idle.kegEmission, 'keg does not flash with the launcher');
    76	    let launched;
    77	    for (let i = 0; i < 60; i++) {
    78	      launched = await page.evaluate(() => { window.__GR_TEST__.advanceSim(1 / 30); return window.__baronLaunches; });
    79	      if (launched.length) break;
    80	    }
    81	    assert.equal(launched.length, 3, 'volley size preserved');
    82	    for (const shot of launched) {
    83	      assert.deepEqual(shot.origin, shot.boss, 'combat origin remains the planar boss position');
    84	      assert.ok(Math.hypot(...shot.visualOrigin.map((v, i) => v - shot.launcherPosition[i])) < 1.1, 'VFX leaves visible launcher');
    85	      assert.ok(shot.visualOrigin[1] - shot.origin[1] > 2, 'VFX is shoulder-height, not ground-center');
    86	      const forwardDot = [0, 2].reduce((sum, i) => sum + (shot.visualOrigin[i] - shot.launcherPosition[i]) * (shot.target[i] - shot.launcherPosition[i]), 0);
    87	      assert.ok(forwardDot > 0, 'launcher noses face the volley target rather than away');
    88	    }
    89	    const settled = await page.evaluate(() => {
    90	      const g = window.__baronProbe;
    91	      g.enemies.baronSpriteAnimator.update(0.071, 'walk', 's', false, 3, 3);
    92	      g.syncBaronRocketCart();
    93	      const baron = g.activeBaronEnemy();
    94	      return { emission: g.baronShoulderLauncher.material.emissiveIntensity, bobOffset: g.enemies.baronSpriteBobOffset,
    95	        bobDifference: g.baronRocketCartGroup.position.y - g.enemies.renderPositionOf(baron).y - baron.visualScale * 0.42 - g.enemies.baronSpriteBobOffset,
    96	        rockets: g.baronVolleyVfx.diagnostics().rockets };
    97	    });
    98	    assert.equal(settled.emission, idle.emission, 'warning resets after launch');
    99	    assert.ok(settled.bobOffset > 0.0001, 'shared motion check samples a nonzero stride');
   100	    assert.ok(Math.abs(settled.bobDifference) < 1e-9, 'props share existing sprite bob');
   101	    assert.ok(settled.rockets.active <= settled.rockets.capacity);
   102	    assert.deepEqual(errors, []);
   103	    console.log(JSON.stringify({ viewport, idle, tell, launched, settled, errors }));
   104	    await page.close();
   105	  }
