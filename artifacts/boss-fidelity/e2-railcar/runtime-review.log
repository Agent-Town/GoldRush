     1	// Run against scratch Vite: node scripts/check-railcar-presentation.mjs http://127.0.0.1:5246
     2	// Uses test-local access to live meshes; production diagnostics stay unchanged.
     3	import assert from 'node:assert/strict';
     4	import { chromium } from 'playwright';
     5	
     6	const browser = await chromium.launch({ channel: 'chromium', headless: true });
     7	try {
     8	  for (const viewport of [{ width: 1280, height: 800 }, { width: 390, height: 844 }]) {
     9	    for (const contract of ['e2-hill-mine', 'e2-trestle', 'e2-incline']) {
    10	      const page = await browser.newPage({ viewport, deviceScaleFactor: 1 });
    11	      const errors = [];
    12	      let gameUrl;
    13	      page.on('request', request => { if (new URL(request.url()).pathname === '/src/game/Game.ts') gameUrl = request.url(); });
    14	      page.on('pageerror', error => errors.push(error.message));
    15	      page.on('console', message => { if (message.type() === 'error' && !message.text().includes('WebSocket connection')) errors.push(message.text()); });
    16	      await page.goto(`${process.argv[2] ?? 'http://127.0.0.1:5246'}/?debug&contract=${contract}&nolevel&nopause&nosteal&nowreck&tier=full&timescale=1&seed=railcar-presentation`);
    17	      await page.waitForFunction(() => window.__GR_TEST__ && (window.__THREE_GAME_DIAGNOSTICS__?.frame ?? 0) > 16, null, { timeout: 60000 });
    18	      await page.getByTestId('contract-briefing-dismiss').click();
    19	      await page.evaluate(async gameUrl => {
    20	        if (!gameUrl) throw new Error('running Game module URL missing');
    21	        const { Game } = await import(gameUrl);
    22	        const original = Game.prototype.syncBaronRocketCart;
    23	        Game.prototype.syncBaronRocketCart = function (...args) {
    24	          window.__railcarProbe = this;
    25	          Game.prototype.syncBaronRocketCart = original;
    26	          return original.apply(this, args);
    27	        };
    28	        const h = window.__GR_TEST__;
    29	        h.setManualSim(true);
    30	        for (const [key, value] of Object.entries({ 'waves.waveInterval': .35, 'waves.trickleInterval': 999, 'waves.pulseBase': 0, 'waves.pulsePerWave': 0, 'waves.aliveCap': 0, 'enemy.contactDamage': 0, 'sparkRig.range': 0, 'sparkRig.damage': 0 })) h.setBalance(key, value);
    31	        h.setWave(11); h.advanceSim(.4); h.setBalance('waves.waveInterval', 999);
    32	        for (const seconds of [2, 8, 12]) h.advanceSim(seconds);
    33	      }, gameUrl);
    34	      await page.waitForFunction(() => window.__railcarProbe && document.querySelector('canvas')?.dataset.railcar3dState === 'ready');
    35	      const poses = {};
    36	      for (const direction of ['outbound', 'return']) {
    37	        if (direction === 'return') await page.evaluate(() => { window.__GR_TEST__.advanceSim(26); window.__GR_TEST__.advanceSim(4); });
    38	        await page.waitForTimeout(100);
    39	        const pose = await page.evaluate(() => {
    40	          const g = window.__railcarProbe, h = window.__GR_TEST__;
    41	          const before = JSON.stringify(h.captureSuspend().enemies);
    42	          for (let i = 0; i < 5; i++) g.enemies.updateRailcar3d();
    43	          const simUnchanged = before === JSON.stringify(h.captureSuspend().enemies);
    44	          const model = g.enemies.railcar3dModel;
    45	          model.updateWorldMatrix(true, true);
    46	          const enemies = h.enemyPositions().filter(e => e.eliteKind === 'railcar');
    47	          const cabinAxis = model.position.clone().set(1, 0, 0).transformDirection(model.matrixWorld);
    48	          const speed = Math.hypot(enemies[0].vx, enemies[0].vz);
    49	          const components = enemies.map(enemy => {
    50	            const mesh = g.enemies.railcar3dMeshes.get(enemy.bossComponentId);
    51	            const min = [Infinity, Infinity, Infinity], max = [-Infinity, -Infinity, -Infinity];
    52	            const point = model.position.clone();
    53	            for (let i = 0; i < mesh.geometry.attributes.position.count; i++) {
    54	              mesh.getVertexPosition(i, point).applyMatrix4(mesh.matrixWorld);
    55	              point.toArray().forEach((v, j) => { min[j] = Math.min(min[j], v); max[j] = Math.max(max[j], v); });
    56	            }
    57	            const center = min.map((v, j) => (v + max[j]) / 2);
    58	            return { id: enemy.bossComponentId, position: [enemy.x, enemy.y, enemy.z], offset: [enemy.x - model.position.x, enemy.z - model.position.z], hitRadius: enemy.hitRadius,
    59	              proxyDistance: Math.hypot(enemy.x - center[0], enemy.z - center[2]), maxY: max[1], velocity: [enemy.vx, enemy.vz], presentation: enemy.presentation };
    60	          });
    61	          return { simUnchanged, modelVisible: model.visible, cabinAxis: cabinAxis.toArray(), noseDotVelocity: -(cabinAxis.x * enemies[0].vx + cabinAxis.z * enemies[0].vz) / speed,
    62	            modelPosition: model.position.toArray(), components, barY: g.enemies.bossHpGroup.position.y, renderer: window.__THREE_GAME_DIAGNOSTICS__.renderer };
    63	        });
    64	        assert.equal(pose.simUnchanged, true, 'presentation updates preserve saved enemy state');
    65	        assert.equal(pose.modelVisible, true);
    66	        assert.equal(pose.components.length, 3);
    67	        const inward = contract === 'e2-hill-mine' ? [1, 0, 0] : [0, 0, 1];
    68	        assert.ok(pose.cabinAxis.reduce((sum, v, i) => sum + v * inward[i], 0) > .99, `${contract} keeps cabin at the inward end on ${direction}`);
    69	        assert.ok(direction === 'outbound' ? pose.noseDotVelocity < -.99 : pose.noseDotVelocity > .99, 'stock backs out cab-first and returns cowcatcher-first without spinning');
    70	        for (const component of pose.components) {
    71	          assert.ok(component.proxyDistance < component.hitRadius, `${contract} ${direction}: visible ${component.id} center remains within its damage proxy`);
    72	          assert.equal(component.presentation.source, 'glb');
    73	          assert.equal(component.presentation.morphInfluence, 0);
    74	          assert.ok(pose.barY > component.maxY + .25, 'boss bar clears the authored geometry');
    75	          if (direction === 'return') {
    76	            const before = poses.outbound.components.find(c => c.id === component.id);
    77	            component.offset.forEach((value, i) => assert.ok(Math.abs(value - before.offset[i]) < 1e-7, 'component route offsets are unchanged on return'));
    78	          }
    79	        }
    80	        poses[direction] = pose;
    81	      }
    82	      assert.deepEqual(errors, []);
    83	      console.log(JSON.stringify({ viewport, contract, poses, errors }));
    84	      await page.close();
    85	    }
    86	  }
    87	} finally { await browser.close(); }

