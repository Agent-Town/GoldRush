    if (this.velocity.lengthSq() > 0.0025) {
      this.group.rotation.y = Math.atan2(this.velocity.x, -this.velocity.z);
      this.spriteOrientation = this.orientationResolver.resolve(this.velocity.x, this.velocity.z);
    } else {
