   526	def main() -> None:
   527	    OUT.mkdir(parents=True, exist_ok=True)
   528	    reset_scene()
   529	    bpy.context.preferences.filepaths.save_version = 0
   530	    atlas, source_sha = create_atlas()
   531	    material = create_material(atlas)
   532	    wheels = join_component("Railcar_Wheels", build_wheels(material), material)
   533	    boiler = join_component("Railcar_Boiler", build_boiler(material), material)
   534	    cabin = join_component("Railcar_Cabin", build_cabin(material), material)
