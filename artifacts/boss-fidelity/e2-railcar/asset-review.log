   353	    uv = obj.data.uv_layers.active.data
   354	    coords = np.array([[loop.uv.x, loop.uv.y] for loop in uv], dtype=np.float32)
   355	    low = coords.min(axis=0)
   356	    span = np.maximum(coords.max(axis=0) - low, 1e-6)
   357	    u0, v0, u1, v1 = REGIONS[obj["atlas_region"]]
   358	    for loop, coord in zip(uv, coords):
