   507	def export(objects: tuple[bpy.types.Object, ...]) -> None:
   508	    bpy.ops.object.select_all(action="DESELECT")
   509	    for obj in objects:
   510	        obj.select_set(True)
   511	    bpy.context.view_layer.objects.active = objects[0]
   512	    bpy.ops.wm.save_as_mainfile(filepath=str(BLEND))
   513	    bpy.ops.export_scene.gltf(
   514	        filepath=str(GLB.with_suffix("")),
   515	        export_format="GLB",
   516	        use_selection=True,
   517	        export_apply=True,
   518	        export_cameras=False,
   519	        export_lights=False,
   520	        export_animations=False,
   521	        export_materials="EXPORT",
   522	        export_morph=True,
   523	    )
