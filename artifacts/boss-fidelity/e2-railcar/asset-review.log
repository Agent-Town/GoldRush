   366	        if part.name.startswith(("Heavy wheel rim", "Armored wheel hub", "Wheel spoke", "Gauge collar", "Teal gauge", "Stack", "Steam dome", "Rear pressure", "Safety valve")):
   367	            mark_all(part, f"RoundX:{part.name}")
   368	        prepare_part(part)
   369	    bpy.ops.object.select_all(action="DESELECT")
   370	    for part in parts:
   371	        part.select_set(True)
   372	    bpy.context.view_layer.objects.active = parts[0]
   373	    bpy.ops.object.join()
   374	    component = bpy.context.object
   375	    component.name = name
   376	    component.data.name = f"{name}Mesh"
   377	    component.data.materials.clear()
   378	    component.data.materials.append(material)
   379	    for polygon in component.data.polygons:
   380	        polygon.material_index = 0
   381	    component.data.uv_layers.active.name = "UVMap"
   382	    bpy.context.scene.cursor.location = (0, 0, 0)
   383	    bpy.ops.object.origin_set(type="ORIGIN_CURSOR")
   384	    component.select_set(False)
   385	    return component
   386	
   387	
   388	def group_vertex_indices(obj: bpy.types.Object, group_name: str) -> set[int]:
   389	    group = obj.vertex_groups.get(group_name)
   390	    if group is None:
   391	        return set()
   392	    index = group.index
   393	    return {vertex.index for vertex in obj.data.vertices if any(item.group == index for item in vertex.groups)}
   394	
   395	
   396	def add_damage_shapes(wheels: bpy.types.Object, boiler: bpy.types.Object, cabin: bpy.types.Object) -> None:
   397	    wheels.shape_key_add(name="Basis")
   398	    bent = wheels.shape_key_add(name="Damage_BentWheels")
   399	    marked = group_vertex_indices(wheels, "DamageBent")
   400	    for index in marked:
   401	        co = bent.data[index].co
   402	        side = 1 if co.y >= 0 else -1
   403	        center = Vector((WHEEL_AXLES[0][0], side * 0.39, WHEEL_AXLES[0][1] + 0.008))
   404	        local = co - center
   405	        angle = math.radians(42 * side)
   406	        new_y = local.y * math.cos(angle) - local.z * math.sin(angle)
   407	        new_z = local.y * math.sin(angle) + local.z * math.cos(angle)
   408	        co.y = center.y + new_y + side * 0.11
   409	        co.x += (co.z - center.z) * 0.16
   410	        derail_lift = max(0.0, min(1.0, (-co.x - 0.12) / 0.62)) * (0.25 if side > 0 else 0.10)
   411	        co.x -= derail_lift * 0.45
   412	        co.z = max(0.0, center.z + new_z + derail_lift)
   413	
   414	    boiler.shape_key_add(name="Basis")
   415	    venting = boiler.shape_key_add(name="Damage_VentingBoiler")
   416	    marked = group_vertex_indices(boiler, "DamageVent")
   417	    for index in marked:
   418	        co = venting.data[index].co
   419	        side = 1 if co.y >= 0 else -1
   420	        co.y += side * 0.20
   421	        co.z += 0.18 + max(0.0, co.x - 0.08) * 0.24
   422	        co.x += side * 0.025
   423	    for index in group_vertex_indices(boiler, "DamageVentHole"):
   424	        co = venting.data[index].co
   425	        co.y += (1 if co.y >= 0 else -1) * 0.085
   426	    steam_moves = {
   427	        "DamageSteamSmall": Vector((0.08, 0.31, 0.31)),
   428	        "DamageSteamMedium": Vector((0.12, 0.37, 0.46)),
   429	        "DamageSteamLarge": Vector((0.18, 0.44, 0.64)),
   430	    }
   431	    for group_name, movement in steam_moves.items():
   432	        for index in group_vertex_indices(boiler, group_name):
   433	            venting.data[index].co += movement
   434	
   435	    cabin.shape_key_add(name="Basis")
   436	    cracked = cabin.shape_key_add(name="Damage_CrackedCabin")
   437	    dents = group_vertex_indices(cabin, "DamageDent")
   438	    caving_wall = group_vertex_indices(cabin, "DamageCabWall")
   439	    caving_roof = group_vertex_indices(cabin, "DamageCabRoof")
   440	    for index in dents:
   441	        co = cracked.data[index].co
   442	        co.x -= 0.085 + max(0.0, co.z - 0.82) * 0.10
   443	        co.z -= 0.035 + max(0.0, co.x - 0.60) * 0.13
   444	        if co.y > 0:
   445	            co.y -= 0.065
   446	    for index in caving_wall:
   447	        co = cracked.data[index].co
   448	        u = (co.x - 0.88) / 0.30
   449	        v = (co.z - 0.84) / 0.21
   450	        influence = max(0.0, 1.0 - min(1.0, math.sqrt(u * u + v * v)))
   451	        co.y -= 0.19 * influence
   452	        co.x -= 0.045 * influence
   453	        co.z -= 0.055 * influence
   454	    for index in group_vertex_indices(cabin, "DamageCabVoid"):
   455	        cracked.data[index].co.y += 0.23
   456	    for index in caving_roof:
   457	        co = cracked.data[index].co
   458	        near = max(0.0, min(1.0, (co.y + 0.02) / 0.46))
   459	        rear = max(0.0, min(1.0, (co.x - 0.45) / 0.72))
   460	        collapse = near * (0.45 + rear * 0.55)
   461	        co.y -= 0.08 * collapse
   462	        co.x -= 0.045 * collapse
   463	        co.z -= 0.18 * collapse
   464	
   465	    for obj in (wheels, boiler, cabin):
   466	        obj.active_shape_key_index = 0
   467	        for key in obj.data.shape_keys.key_blocks:
   468	            key.value = 0.0
   469	
   470	
   471	def triangle_count(objects: tuple[bpy.types.Object, ...]) -> int:
   472	    return sum(sum(len(polygon.vertices) - 2 for polygon in obj.data.polygons) for obj in objects)
   473	
   474	
   475	def world_bounds(objects: tuple[bpy.types.Object, ...]) -> tuple[Vector, Vector]:
   476	    points = [obj.matrix_world @ vertex.co for obj in objects for vertex in obj.data.vertices]
   477	    return Vector((min(p.x for p in points), min(p.y for p in points), min(p.z for p in points))), Vector((max(p.x for p in points), max(p.y for p in points), max(p.z for p in points)))
   478	
   479	
   480	def normalize_base_center(objects: tuple[bpy.types.Object, ...]) -> None:
   481	    minimum, maximum = world_bounds(objects)
   482	    center_x = (minimum.x + maximum.x) * 0.5
   483	    center_y = (minimum.y + maximum.y) * 0.5
   484	    scale_x = MODEL_LENGTH / (maximum.x - minimum.x)
   485	    for obj in objects:
   486	        # Lengthen the chassis without turning round wheels, gauges and lamps into ovals.
   487	        round_centers = {}
   488	        round_profiles = []
   489	        for group in obj.vertex_groups:
   490	            if group.name.startswith("RoundX:"):
   491	                indices = group_vertex_indices(obj, group.name)
   492	                center = (min(obj.data.vertices[i].co.x for i in indices) + max(obj.data.vertices[i].co.x for i in indices)) * 0.5
   493	                span = max(obj.data.vertices[i].co.x for i in indices) - min(obj.data.vertices[i].co.x for i in indices)
   494	                round_profiles.append((indices, span))
   495	                round_centers.update({i: center for i in indices})
   496	        for vertex in obj.data.vertices:
   497	            pivot = round_centers.get(vertex.index, vertex.co.x)
   498	            vertex.co.x = (pivot - center_x) * scale_x + vertex.co.x - pivot
   499	            vertex.co.y -= center_y
   500	            vertex.co.z -= minimum.z
   501	        for indices, span in round_profiles:
   502	            actual = max(obj.data.vertices[i].co.x for i in indices) - min(obj.data.vertices[i].co.x for i in indices)
   503	            assert abs(actual - span) < 1e-6, "round profile stretched with chassis"
   504	        obj.data.update()
   505	
