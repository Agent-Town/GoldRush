    51	def contract(path: Path) -> dict:
    52	    document, binary = read_glb(path)
    53	    accessors = document.get("accessors", [])
    54	    meshes = document.get("meshes", [])
    55	    primitives = [(mesh, primitive) for mesh in meshes for primitive in mesh.get("primitives", [])]
    56	    materials = document.get("materials", [])
    57	    textures = document.get("textures", [])
    58	    primitive_materials = [primitive.get("material") for _, primitive in primitives]
    59	    material_texture_bindings = []
    60	    for material_index, material in enumerate(materials):
    61	        texture_index = material.get("pbrMetallicRoughness", {}).get("baseColorTexture", {}).get("index")
    62	        image_index = textures[texture_index].get("source") if isinstance(texture_index, int) and texture_index < len(textures) else None
    63	        material_texture_bindings.append({
    64	            "material": material_index,
    65	            "baseColorTexture": texture_index,
    66	            "image": image_index,
    67	        })
    68	    positions = [accessors[primitive["attributes"]["POSITION"]] for _, primitive in primitives]
    69	    minimum = [min(item["min"][axis] for item in positions) for axis in range(3)]
    70	    maximum = [max(item["max"][axis] for item in positions) for axis in range(3)]
    71	    nodes = document.get("nodes", [])
    72	    node_names = [node.get("name") for node in nodes if "mesh" in node]
    73	    morphs = {mesh.get("name"): mesh.get("extras", {}).get("targetNames", []) for mesh in meshes}
    74	    bindings = []
    75	    transforms = {}
    76	    for node in nodes:
    77	        if "mesh" not in node:
    78	            continue
    79	        mesh = meshes[node["mesh"]]
    80	        targets = mesh.get("extras", {}).get("targetNames", [])
    81	        weights = node.get("weights", mesh.get("weights", [0.0] * len(targets)))
    82	        bindings.append({"node": node.get("name"), "mesh": mesh.get("name"), "targets": targets, "defaultWeights": weights})
    83	        transforms[node.get("name")] = {
    84	            "translation": node.get("translation", [0.0, 0.0, 0.0]),
    85	            "rotation": node.get("rotation", [0.0, 0.0, 0.0, 1.0]),
    86	            "scale": node.get("scale", [1.0, 1.0, 1.0]),
    87	            "matrix": node.get("matrix"),
    88	        }
    89	    return {
    90	        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
    91	        "bytes": path.stat().st_size,
    92	        "nodes": node_names,
    93	        "nodeCount": len(nodes),
    94	        "bindings": bindings,
    95	        "nodeTransforms": transforms,
    96	        "meshes": len(meshes),
    97	        "meshNames": [mesh.get("name") for mesh in meshes],
    98	        "primitives": len(primitives),
    99	        "primitiveMaterials": primitive_materials,
   100	        "triangles": sum(accessors[primitive["indices"]]["count"] // 3 for _, primitive in primitives),
   101	        "morphTargets": morphs,
   102	        "targetCounts": {mesh.get("name"): sum(len(primitive.get("targets", [])) for primitive in mesh.get("primitives", [])) for mesh in meshes},
   103	        "materials": len(materials),
   104	        "materialTextureBindings": material_texture_bindings,
   105	        "textureSources": [texture.get("source") for texture in textures],
   106	        "images": len(document.get("images", [])),
   107	        "embeddedImages": sum("bufferView" in image for image in document.get("images", [])),
   108	        "imageDimensions": image_dimensions(document, binary),
   109	        "cameras": len(document.get("cameras", [])),
   110	        "lights": len(document.get("extensions", {}).get("KHR_lights_punctual", {}).get("lights", [])),
   111	        "animations": len(document.get("animations", [])),
   112	        "bounds": {
   113	            "min": [round(value, 6) for value in minimum],
   114	            "max": [round(value, 6) for value in maximum],
   115	            "size": [round(maximum[axis] - minimum[axis], 6) for axis in range(3)],
   116	            "center": [round((maximum[axis] + minimum[axis]) * 0.5, 6) for axis in range(3)],
   117	        },
   118	    }
