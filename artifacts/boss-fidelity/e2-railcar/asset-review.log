    27	def read_glb(path: Path) -> tuple[dict, bytes]:
    28	    data = path.read_bytes()
    29	    magic, version, total = struct.unpack_from("<4sII", data)
    30	    assert magic == b"glTF" and version == 2 and total == len(data)
    31	    json_length, json_kind = struct.unpack_from("<II", data, 12)
    32	    assert json_kind == 0x4E4F534A
    33	    document = json.loads(data[20:20 + json_length])
    34	    binary_offset = 20 + json_length
    35	    binary_length, binary_kind = struct.unpack_from("<II", data, binary_offset)
    36	    assert binary_kind == 0x004E4942
    37	    return document, data[binary_offset + 8:binary_offset + 8 + binary_length]
    38	
    39	
    40	def image_dimensions(document: dict, binary: bytes) -> list[list[int]]:
    41	    dimensions = []
    42	    for image in document.get("images", []):
    43	        view = document["bufferViews"][image["bufferView"]]
    44	        start = view.get("byteOffset", 0)
    45	        payload = binary[start:start + view["byteLength"]]
    46	        assert payload[:8] == b"\x89PNG\r\n\x1a\n"
    47	        dimensions.append(list(struct.unpack(">II", payload[16:24])))
    48	    return dimensions
    49	
