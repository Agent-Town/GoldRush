   541	    assert tris <= 12_000, f"triangle budget exceeded: {tris}"
   542	    assert abs((maximum.x - minimum.x) - MODEL_LENGTH) < 0.01, f"length bounds {minimum.x:.4f}..{maximum.x:.4f}"
   543	    assert abs((maximum.x + minimum.x) * 0.5) < 0.001
   544	    assert abs((maximum.y + minimum.y) * 0.5) < 0.001
   545	    assert abs(minimum.z) < 0.001
   546	    assert len({slot.material.name for obj in objects for slot in obj.material_slots if slot.material}) == 1
