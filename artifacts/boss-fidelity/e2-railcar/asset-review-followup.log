   407	def group_vertex_indices(obj: bpy.types.Object, group_name: str) -> set[int]:
   408	    group = obj.vertex_groups.get(group_name)
   409	    if group is None:
   410	        return set()
   411	    index = group.index
   412	    return {vertex.index for vertex in obj.data.vertices if any(item.group == index for item in vertex.groups)}
