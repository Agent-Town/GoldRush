   415	def add_damage_shapes(wheels: bpy.types.Object, boiler: bpy.types.Object, cabin: bpy.types.Object) -> None:
   416	    wheels.shape_key_add(name="Basis")
   417	    bent = wheels.shape_key_add(name="Damage_BentWheels")
   418	    marked = group_vertex_indices(wheels, "DamageBent")
   419	    for index in marked:
   420	        co = bent.data[index].co
   421	        side = 1 if co.y >= 0 else -1
   422	        center = Vector((WHEEL_AXLES[0][0], side * 0.39, WHEEL_AXLES[0][1] + 0.008))
   423	        local = co - center
   424	        angle = math.radians(42 * side)
   425	        new_y = local.y * math.cos(angle) - local.z * math.sin(angle)
   426	        new_z = local.y * math.sin(angle) + local.z * math.cos(angle)
