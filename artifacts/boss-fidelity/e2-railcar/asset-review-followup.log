sys.dont_write_bytecode=True
source=Path('assets/pilots/railcar-3d/build_railcar.py').resolve()
b=runpy.run_path(str(source))
radii=(.065,.085,.105)
groups=('DamageSteamSmall','DamageSteamMedium','DamageSteamLarge')

def check_mesh(label,p,t,uv,n):
    assert np.isfinite(p).all() and np.isfinite(uv).all() and np.isfinite(n).all()
    center=(p.max(axis=0)+p.min(axis=0))/2
    cross=np.cross(p[t[:,1]]-p[t[:,0]],p[t[:,2]]-p[t[:,0]])
    lengths=np.linalg.norm(cross,axis=1)
    outward=np.einsum('ij,ij->i',cross,p[t].mean(axis=1)-center)
    assert lengths.min()>1e-9 and outward.min()>1e-10,(label,'degenerate or inward',lengths.min(),outward.min())
    assert np.all(np.einsum('ij,ij->i',n,p-center)>0),(label,'inward vertex normals')
    assert np.allclose(np.linalg.norm(n,axis=1),1,atol=2e-6)
    edges=collections.defaultdict(list)
    for tri in t:
        for a,c in zip(tri,np.roll(tri,-1)):
            edges[tuple(sorted((a,c)))].append(1 if a<c else -1)
    assert all(len(v)==2 and sum(v)==0 for v in edges.values()),(label,'nonmanifold or inconsistent winding')
    assert len(p)-len(edges)+len(t)==2
    d1=uv[t[:,1]]-uv[t[:,0]]; d2=uv[t[:,2]]-uv[t[:,0]]
    uv_area=d1[:,0]*d2[:,1]-d1[:,1]*d2[:,0]
    assert np.abs(uv_area).min()>1e-9,(label,'zero-area UV triangles')
    return {'label':label,'vertices':len(p),'triangles':len(t),'outwardTriangles':int((outward>0).sum()),'minNormalRadialDot':float(np.einsum('ij,ij->i',n,p-center).min()),'minAbsUVArea2':float(np.abs(uv_area).min()),'uvMin':uv.min(axis=0).tolist(),'uvMax':uv.max(axis=0).tolist(),'closedOrientedManifold':True}

# Exercise the changed authored branch directly; no atlas loading or file export.
b['reset_scene']()
mat=bpy.data.materials.new('review-only')
source_hashes=[]
for iteration in range(8):
    puff=b['steam_puff']('review-only',.065,(.37,0,.74),'glass',mat,groups[0])
    assert len(puff.data.vertices)==26 and len(puff.data.polygons)==32 and len(puff.data.edges)==56
    authored=np.array([v.uv[:] for v in puff.data.uv_layers.active.data])
    b['prepare_part'](puff)
    m=puff.data;m.calc_loop_triangles()
    packed=np.array([v.uv[:] for v in m.uv_layers.active.data])
    assert np.allclose(packed,authored*np.array([.225,.47])+np.array([.515,.02]),atol=1e-7)
    assert all(poly.use_smooth for poly in m.polygons)
    assert len(b['group_vertex_indices'](puff,groups[0]))==26
    p=np.array([v.co[:] for v in m.vertices]); n=np.array([v.normal[:] for v in m.vertices]); t=np.array([tri.vertices[:] for tri in m.loop_triangles])
    uv=np.empty((26,2))
    for loop,u in zip(m.loops,packed):uv[loop.vertex_index]=u
    result=check_mesh('source-authored-steam',p,t,uv,n)
    source_hashes.append(hashlib.sha256(p.tobytes()+t.tobytes()+packed.tobytes()).hexdigest())
    bpy.data.objects.remove(puff,do_unlink=True)
assert len(set(source_hashes))==1
print('SOURCE_PUFF_CHECK',json.dumps(result),'identicalAcross8Constructions',len(set(source_hashes))==1)

# Read the delivered GLB bytes directly, including morph accessors.
data=source.with_name('railcar.glb').read_bytes()
assert struct.unpack_from('<III',data)==(0x46546c67,2,len(data))
