   132	        vertices.extend((radius * math.sin(phi) * math.cos(math.tau * i / 8), radius * math.sin(phi) * math.sin(math.tau * i / 8), radius * math.cos(phi)) for i in range(8))
   133	    vertices.append((0, 0, -radius))
   134	    faces = [(0, 1 + i, 1 + (i + 1) % 8) for i in range(8)]
   135	    for start in (1, 9):
   136	        faces.extend((start + i, start + 8 + i, start + 8 + (i + 1) % 8, start + (i + 1) % 8) for i in range(8))
   137	    faces.extend((25, 17 + (i + 1) % 8, 17 + i) for i in range(8))
   138	    mesh = bpy.data.meshes.new(name)
   139	    mesh.from_pydata(vertices, [], faces)
   140	    uv = mesh.uv_layers.new(name="UVMap")
   141	    for loop in mesh.loops:
   142	        x, y, _ = vertices[loop.vertex_index]
   143	        uv.data[loop.index].uv = (x / (2 * radius) + 0.5, y / (2 * radius) + 0.5)
   144	    obj = bpy.data.objects.new(name, mesh)
   145	    bpy.context.collection.objects.link(obj)
