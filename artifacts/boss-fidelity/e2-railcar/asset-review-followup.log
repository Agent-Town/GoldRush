bin_size,bin_type=struct.unpack_from('<II',data,20+json_size);blob=data[28+json_size:28+json_size+bin_size]
types={5126:'<f4',5125:'<u4',5123:'<u2',5121:'u1'};widths={'SCALAR':1,'VEC2':2,'VEC3':3,'VEC4':4}
def buf(view_id,offset,count,width,component):
    view=j['bufferViews'][view_id];dt=np.dtype(types[component]);stride=view.get('byteStride',dt.itemsize*width)
    return np.ndarray((count,width),dtype=dt,buffer=blob,offset=view.get('byteOffset',0)+offset,strides=(stride,dt.itemsize)).copy()
