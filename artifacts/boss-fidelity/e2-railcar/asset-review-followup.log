   127	def steam_puff(name: str, radius: float, at: tuple[float, float, float], region: str, material: bpy.types.Material, damage_group: str) -> bpy.types.Object:
   128	    # Fixed ring topology avoids Blender's nondeterministic sphere face ordering.
