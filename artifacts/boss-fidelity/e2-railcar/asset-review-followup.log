   360	def prepare_part(obj: bpy.types.Object) -> None:
   361	    bpy.context.view_layer.objects.active = obj
   362	    obj.select_set(True)
   363	    for modifier in list(obj.modifiers):
   364	        bpy.ops.object.modifier_apply(modifier=modifier.name)
   365	    # Steam has explicit topology and UVs; automatic unwrap varies across rebuilds.
   366	    if not obj.get("keep_authored_uv", False):
   367	        bpy.ops.object.mode_set(mode="EDIT")
   368	        bpy.ops.mesh.select_all(action="SELECT")
   369	        bpy.ops.mesh.normals_make_consistent(inside=False)
   370	        bpy.ops.uv.smart_project(angle_limit=math.radians(66), island_margin=0.025)
   371	        bpy.ops.object.mode_set(mode="OBJECT")
   372	    uv = obj.data.uv_layers.active.data
   373	    coords = np.array([[loop.uv.x, loop.uv.y] for loop in uv], dtype=np.float32)
   374	    low = coords.min(axis=0)
   375	    span = np.maximum(coords.max(axis=0) - low, 1e-6)
   376	    u0, v0, u1, v1 = REGIONS[obj["atlas_region"]]
   377	    for loop, coord in zip(uv, coords):
   378	        normalized = (coord - low) / span
   379	        loop.uv = (u0 + normalized[0] * (u1 - u0), v0 + normalized[1] * (v1 - v0))
   380	    obj.select_set(False)
