   274	    faces = [(0, 1, 2, 3), (7, 6, 5, 4), (0, 4, 5, 1), (1, 5, 6, 2), (2, 6, 7, 3), (3, 7, 4, 0)]
   275	    return from_pydata(name, vertices, faces, region, material, 0.004, damage_group)
