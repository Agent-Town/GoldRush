   312	def beam(
   313	    name: str,
   314	    start: tuple[float, float, float],
   315	    end: tuple[float, float, float],
   316	    width: float,
   317	    region: str,
   318	    material: bpy.types.Material,
   319	    damage_group: str | None = None,
   320	) -> bpy.types.Object:
   321	    a, b = Vector(start), Vector(end)
   322	    direction = b - a
   323	    obj = box(
   324	        name,
   325	        (width, width, direction.length),
   326	        tuple((a + b) * 0.5),
   327	        region,
   328	        material,
   329	        bevel=min(0.006, width * 0.18),
   330	        damage_group=damage_group,
   331	    )
   332	    obj.rotation_mode = "QUATERNION"
   333	    obj.rotation_quaternion = direction.to_track_quat("Z", "Y")
   334	    bpy.context.view_layer.objects.active = obj
   335	    obj.select_set(True)
   336	    bpy.ops.object.transform_apply(location=False, rotation=True, scale=False)
   337	    obj.select_set(False)
   338	    return obj
