    76	def mark_all(obj: bpy.types.Object, group_name: str | None) -> None:
    77	    if not group_name:
    78	        return
    79	    group = obj.vertex_groups.new(name=group_name)
    80	    group.add(list(range(len(obj.data.vertices))), 1.0, "REPLACE")
