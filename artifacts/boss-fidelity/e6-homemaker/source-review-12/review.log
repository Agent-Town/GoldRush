   636	def group_vertex_indices(obj: bpy.types.Object, group_name: str) -> set[int]:
   637	    group = obj.vertex_groups.get(group_name)
   638	    if group is None:
   639	        return set()
   640	    index = group.index
   641	    return {vertex.index for vertex in obj.data.vertices if any(item.group == index for item in vertex.groups)}
