   341	def triangle_panel(
   342	    name: str,
   343	    points: tuple[tuple[float, float, float], tuple[float, float, float], tuple[float, float, float]],
   344	    thickness: float,
   345	    region: str,
   346	    material: bpy.types.Material,
   347	    damage_group: str | None = None,
   348	) -> bpy.types.Object:
   349	    front = [Vector(point) + Vector((0, -thickness * 0.5, 0)) for point in points]
   350	    back = [Vector(point) + Vector((0, thickness * 0.5, 0)) for point in points]
   351	    vertices = [tuple(point) for point in [*front, *back]]
   352	    faces = [(0, 1, 2), (5, 4, 3), (0, 3, 4, 1), (1, 4, 5, 2), (2, 5, 3, 0)]
   353	    mesh = bpy.data.meshes.new(f"{name}Mesh")
   354	    mesh.from_pydata(vertices, [], faces)
   355	    mesh.update()
   356	    obj = bpy.data.objects.new(name, mesh)
   357	    bpy.context.collection.objects.link(obj)
   358	    return tag(obj, region, material, 0.004, damage_group)
