    30	def sampled_color(colors: np.ndarray, mask: np.ndarray, fallback: tuple[float, float, float]) -> np.ndarray:
    31	    selected = colors[mask]
    32	    if len(selected) < 32:
    33	        return np.array(fallback, dtype=np.float32)
    34	    return np.clip(np.median(selected, axis=0), 0.01, 0.82)
    35	
    36	
    37	def resized_nearest(source: np.ndarray, height: int, width: int) -> np.ndarray:
    38	    ys = np.linspace(0, source.shape[0] - 1, height).astype(np.int32)
    39	    xs = np.linspace(0, source.shape[1] - 1, width).astype(np.int32)
    40	    return source[ys[:, None], xs[None, :]]
