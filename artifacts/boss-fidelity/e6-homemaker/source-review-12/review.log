   391	def recenter_shape_keyed_basis(objects: tuple[bpy.types.Object, ...]) -> None:
   392	    """Re-center the basis after the hidden chair bundle changes its bounds.
   393	
   394	    Apply the same translation to every key block so the authored damage
   395	    deltas remain unchanged while the exported intact basis stays base-center.
   396	    """
   397	    points = [
   398	        point.co
   399	        for obj in objects
   400	        for point in obj.data.shape_keys.key_blocks["Basis"].data
   401	    ]
   402	    minimum = Vector(tuple(min(point[axis] for point in points) for axis in range(3)))
   403	    maximum = Vector(tuple(max(point[axis] for point in points) for axis in range(3)))
   404	    offset = Vector(((minimum.x + maximum.x) * 0.5, (minimum.y + maximum.y) * 0.5, minimum.z))
   405	    for obj in objects:
   406	        keys = obj.data.shape_keys
   407	        assert keys is not None
   408	        for key in keys.key_blocks:
   409	            for point in key.data:
   410	                point.co -= offset
   411	        obj.data.update()
   412	
   413	
   414	def shape_basis_bounds(objects: tuple[bpy.types.Object, ...]) -> tuple[Vector, Vector]:
   415	    points = [
   416	        point.co
   417	        for obj in objects
   418	        for point in obj.data.shape_keys.key_blocks["Basis"].data
   419	    ]
   420	    return (
   421	        Vector(tuple(min(point[axis] for point in points) for axis in range(3))),
   422	        Vector(tuple(max(point[axis] for point in points) for axis in range(3))),
   423	    )
