    43	def plate_colors(path: Path) -> np.ndarray:
    44	    source = bpy.data.images.load(str(path), check_existing=False)
    45	    pixels = np.array(source.pixels[:], dtype=np.float32).reshape(source.size[1], source.size[0], 4)
    46	    return pixels[:, :, :3]
