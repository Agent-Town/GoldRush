   178	def mark_all(obj: bpy.types.Object, group_name: str | None) -> None:
   179	    if not group_name:
   180	        return
   181	    group = obj.vertex_groups.new(name=group_name)
   182	    group.add(list(range(len(obj.data.vertices))), 1.0, "REPLACE")
