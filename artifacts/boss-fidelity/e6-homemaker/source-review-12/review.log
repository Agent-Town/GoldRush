    43	
    44	def sampled_color(colors: np.ndarray, mask: np.ndarray, fallback: tuple[float, float, float]) -> np.ndarray:
    45	    selected = colors[mask]
    46	    if len(selected) < 32:
    47	        return np.array(fallback, dtype=np.float32)
    48	    return np.clip(np.median(selected, axis=0), 0.01, 0.82)
    49	
    50	
    51	def resized_nearest(source: np.ndarray, height: int, width: int) -> np.ndarray:
    52	    ys = np.linspace(0, source.shape[0] - 1, height).astype(np.int32)
    53	    xs = np.linspace(0, source.shape[1] - 1, width).astype(np.int32)
    54	    return source[ys[:, None], xs[None, :]]
    55	
    56	
    57	def create_atlas() -> tuple[bpy.types.Image, dict[str, str]]:
    58	    source = bpy.data.images.load(str(REFERENCE), check_existing=False)
    59	    pixels = np.array(source.pixels[:], dtype=np.float32).reshape(source.size[1], source.size[0], 4)
    60	    colors = pixels[:, :, :3]
    61	    luminance = colors.mean(axis=2)
    62	    saturation = colors.max(axis=2) - colors.min(axis=2)
    63	    dark = sampled_color(colors, (luminance > 0.015) & (luminance < 0.14), (0.035, 0.030, 0.022))
    64	    warm = sampled_color(
    65	        colors,
    66	        (colors[:, :, 0] > colors[:, :, 1] * 1.08)
    67	        & (colors[:, :, 1] > colors[:, :, 2] * 1.12)
    68	        & (luminance > 0.12)
    69	        & (luminance < 0.48),
    70	        (0.34, 0.20, 0.07),
    71	    )
    72	    rust = sampled_color(
    73	        colors,
    74	        (colors[:, :, 0] > colors[:, :, 1] * 1.30)
    75	        & (colors[:, :, 1] > colors[:, :, 2] * 1.05)
    76	        & (saturation > 0.09),
    77	        (0.34, 0.075, 0.028),
    78	    )
    79	    teal = sampled_color(
    80	        colors,
    81	        (colors[:, :, 1] > colors[:, :, 0] * 1.18)
    82	        & (colors[:, :, 2] > colors[:, :, 0] * 1.18)
    83	        & (saturation > 0.06),
    84	        (0.025, 0.36, 0.38),
    85	    )
    86	    palette = {
    87	        "soot": np.clip(dark * 0.50, 0.010, 0.060),
    88	        "iron": np.clip(dark * 0.58 + warm * 0.34 + 0.015, 0.035, 0.22),
    89	        "brass": np.clip(warm * 0.88 + 0.025, 0.09, 0.55),
    90	        "deck": np.clip(warm * 0.54 + rust * 0.26 + 0.045, 0.06, 0.36),
    91	        "teal": np.clip(teal * 1.12, 0.02, 0.62),
    92	        "damage": np.clip(rust * 0.72 + np.array((0.16, 0.025, 0.012)), 0.03, 0.48),
    93	        "sail": np.clip(rust * 0.74 + np.array((0.08, 0.012, 0.008)), 0.03, 0.40),
    94	        "rope": np.clip(warm * 0.54 + np.array((0.10, 0.055, 0.012)), 0.05, 0.50),
    95	        "cargo": np.clip(rust * 0.42 + warm * 0.42 + 0.018, 0.05, 0.44),
    96	    }
    97	    atlas = np.ones((ATLAS_SIZE, ATLAS_SIZE, 4), dtype=np.float32)
    98	    atlas[:, :, :3] = palette["soot"]
    99	    rng = np.random.default_rng(517)
   100	
   101	    # Carry the approved plate's real engraved line density into the largest tile.
   102	    x0, y0, x1, y1 = region_pixels(REGIONS["plate"])
   103	    crop = colors[
   104	        int(source.size[1] * 0.09):int(source.size[1] * 0.88),
   105	        int(source.size[0] * 0.08):int(source.size[0] * 0.95),
   106	    ]
   107	    painted = resized_nearest(resized_nearest(crop, 300, 420), y1 - y0, x1 - x0)
   108	    ink = 1.0 - np.clip((painted.mean(axis=2) - 0.025) / 0.40, 0.0, 1.0)
   109	    plate_base = palette["iron"] * 0.76 + palette["brass"] * 0.24
   110	    engraved = plate_base[None, None, :] * (1.08 - ink[:, :, None] * 0.55)
   111	    warm_mask = (painted[:, :, 0] > painted[:, :, 2] * 1.28) & (ink > 0.20)
   112	    engraved[warm_mask] = engraved[warm_mask] * 0.75 + palette["brass"] * 0.17
   113	    engraved += rng.normal(0, 0.008, (y1 - y0, x1 - x0, 1))
   114	    atlas[y0:y1, x0:x1, :3] = np.clip(engraved, 0.008, 0.34)
   115	
   116	    for name, region in REGIONS.items():
   117	        if name == "plate":
   118	            continue
   119	        x0, y0, x1, y1 = region_pixels(region)
   120	        base = palette[name]
   121	        noise = rng.normal(0, 0.008 if name != "teal" else 0.004, (y1 - y0, x1 - x0, 1))
   122	        block = np.clip(base + noise, 0.008, 0.72)
   123	        atlas[y0:y1, x0:x1, :3] = block
   124	        if name in {"soot", "iron", "brass", "deck", "damage", "sail", "cargo"}:
   125	            height = y1 - y0
   126	            spacing = 17 if name in {"iron", "brass"} else 23
   127	            for offset in range(-height, x1 - x0, spacing):
   128	                for yy in range(y0, y1):
   129	                    xx = x0 + offset + (yy - y0)
   130	                    if x0 <= xx < x1:
   131	                        atlas[yy, xx:min(xx + 2, x1), :3] *= 0.58
   132	        if name in {"iron", "brass", "deck"}:
   133	            for yy in range(y0 + 12, y1, 29):
   134	                for xx in range(x0 + 12, x1, 29):
   135	                    atlas[yy - 2:yy + 3, xx - 2:xx + 3, :3] *= 0.46
   136	        if name == "sail":
   137	            for yy in range(y0 + 18, y1, 26):
   138	                atlas[yy:yy + 2, x0:x1, :3] *= 0.62
   139	        if name == "teal":
   140	            for yy in range(y0 + 7, y1, 15):
   141	                atlas[yy:yy + 2, x0:x1, :3] = np.clip(base * 1.35, 0, 0.78)
   142	
   143	    # The source plate is storm-dark. Lift its baked albedo, not the material,
   144	    # so engraved detail survives the high gameplay camera without emission.
   145	    atlas[:, :, :3] = np.clip(atlas[:, :, :3] * 1.34 + 0.012, 0.008, 0.78)
   146	
   147	    image = bpy.data.images.new("DredgeQueenPlateAtlas", ATLAS_SIZE, ATLAS_SIZE, alpha=True)
   148	    image.colorspace_settings.name = "sRGB"
   149	    image.pixels.foreach_set(atlas.ravel())
   150	    image.pack()
   151	    return image, {
   152	        "intact": hashlib.sha256(REFERENCE.read_bytes()).hexdigest(),
   153	        "damage": hashlib.sha256(DAMAGE_REFERENCE.read_bytes()).hexdigest(),
   154	    }
   155	
   156	
   157	def create_material(image: bpy.types.Image) -> bpy.types.Material:
   158	    material = bpy.data.materials.new("DredgeQueenMaterial")
   159	    material.use_nodes = True
   160	    material.use_backface_culling = False
   161	    nodes = material.node_tree.nodes
   162	    nodes.clear()
   163	    output = nodes.new("ShaderNodeOutputMaterial")
   164	    shader = nodes.new("ShaderNodeBsdfPrincipled")
   165	    texture = nodes.new("ShaderNodeTexImage")
   166	    texture.image = image
   167	    texture.interpolation = "Linear"
   168	    texture.extension = "REPEAT"
   169	    shader.inputs["Metallic"].default_value = 0.0
   170	    shader.inputs["Roughness"].default_value = 0.9
   171	    shader.inputs["Emission Color"].default_value = (0, 0, 0, 1)
   172	    shader.inputs["Emission Strength"].default_value = 0
   173	    material.node_tree.links.new(texture.outputs["Color"], shader.inputs["Base Color"])
   174	    material.node_tree.links.new(shader.outputs["BSDF"], output.inputs["Surface"])
   175	    return material
