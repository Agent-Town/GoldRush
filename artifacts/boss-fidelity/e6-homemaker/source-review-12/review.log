   426	def main() -> None:
   427	    HERE.mkdir(parents=True, exist_ok=True)
   428	    dq.reset_scene()
   429	    atlas = create_atomic_atlas()
   430	    material = dq.create_material(atlas)
   431	    material.name = "Homemaker9000PaintedMaterial"
   432	    groups={"vac":build_vac(material),"rack":build_rack(material),"core":build_core(material)}
   433	    for parts in groups.values():
   434	        for part in parts:
   435	            if any(word in part.name.lower() for word in ("rim", "cage", "bristle", "ray", "rail")):
   436	                for modifier in list(part.modifiers):
   437	                    if modifier.type=="BEVEL":part.modifiers.remove(modifier)
   438	    vac,rack,core=(dq.join_component(name,groups[name],material) for name in ("vac","rack","core"))
   439	    objects = (vac, rack, core)
   440	    dq.MODEL_LENGTH = MODEL_LENGTH
   441	    dq.normalize_base_center(objects)
   442	    add_damage_shapes(*objects)
   443	    recenter_shape_keyed_basis(objects)
   444	
   445	
   446	    triangles = dq.triangle_count(objects)
   447	    minimum, maximum = shape_basis_bounds(objects)
   448	    assert triangles <= 12_000
   449	    assert abs(maximum.x - minimum.x - MODEL_LENGTH) < 0.01
   450	    assert abs(minimum.z) < 0.001
   451	    assert abs((maximum.x + minimum.x) * 0.5) < 0.001
   452	    assert abs((maximum.y + minimum.y) * 0.5) < 0.001
   453	    dq.BLEND, dq.GLB = BLEND, GLB
   454	    dq.export(objects)
   455	    print(json.dumps({
   456	        "blend": str(BLEND), "glb": str(GLB), "sha256": hashlib.sha256(GLB.read_bytes()).hexdigest(),
   457	        "sourcePlate": {str(REFERENCE.relative_to(ROOT)): hashlib.sha256(REFERENCE.read_bytes()).hexdigest()},
   458	        "components": [obj.name for obj in objects],
   459	        "damageMorphs": [obj.data.shape_keys.key_blocks[1].name for obj in objects],
   460	        "triangles": triangles,
   461	        "boundsBlender": {"min": [round(v, 6) for v in minimum], "max": [round(v, 6) for v in maximum]},
   462	    }, indent=2))
   463	
   464	
   465	if __name__ == "__main__":
   466	    main()
