   499	def arc_points(
   500	    centre: tuple[float, float, float],
   501	    radius: float,
   502	    start_angle: float,
   503	    end_angle: float,
   504	    steps: int,
   505	    plane: str = "xz",
   506	) -> list[tuple[float, float, float]]:
   507	    points = []
   508	    for step in range(steps + 1):
   509	        angle = start_angle + (end_angle - start_angle) * step / steps
   510	        cos, sin = math.cos(angle) * radius, math.sin(angle) * radius
   511	        if plane == "xz":
   512	            points.append((centre[0] + cos, centre[1], centre[2] + sin))
   513	        elif plane == "xy":
   514	            points.append((centre[0] + cos, centre[1] + sin, centre[2]))
   515	        else:
   516	            points.append((centre[0], centre[1] + cos, centre[2] + sin))
   517	    return points
