    24	def reset_scene() -> None:
    25	    bpy.ops.wm.read_factory_settings(use_empty=True)
    26	    bpy.context.scene.unit_settings.system = "METRIC"
    27	    bpy.context.scene.unit_settings.length_unit = "METERS"
