    49	def create_material(name: str, image: bpy.types.Image) -> bpy.types.Material:
    50	    """Exact shipped material contract: metallic 0, roughness 0.9, double-sided, no emission."""
    51	    material = bpy.data.materials.new(name)
    52	    material.use_nodes = True
    53	    material.use_backface_culling = False
    54	    nodes = material.node_tree.nodes
    55	    nodes.clear()
    56	    output = nodes.new("ShaderNodeOutputMaterial")
    57	    shader = nodes.new("ShaderNodeBsdfPrincipled")
    58	    texture = nodes.new("ShaderNodeTexImage")
    59	    texture.image = image
    60	    texture.interpolation = "Linear"
    61	    texture.extension = "REPEAT"
    62	    shader.inputs["Metallic"].default_value = 0.0
    63	    shader.inputs["Roughness"].default_value = 0.9
    64	    shader.inputs["Emission Color"].default_value = (0, 0, 0, 1)
    65	    shader.inputs["Emission Strength"].default_value = 0
    66	    material.node_tree.links.new(texture.outputs["Color"], shader.inputs["Base Color"])
    67	    material.node_tree.links.new(shader.outputs["BSDF"], output.inputs["Surface"])
    68	    return material
