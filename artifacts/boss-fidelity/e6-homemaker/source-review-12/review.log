   419	def build_claw(material: bpy.types.Material) -> list[bpy.types.Object]:
   420	    parts: list[bpy.types.Object] = []
   421	    arm = "DamageClawArm"
   422	    parts.append(box("Armored fore hull", (3.05, 3.70, 0.74), (-2.28, 0, 0.48), "plate", material, 0.10))
   423	    parts.append(box("Reinforced bow wall", (0.58, 3.18, 0.92), (-3.72, 0, 0.64), "iron", material, 0.10))
   424	    parts.append(box("Fore working deck", (2.88, 3.42, 0.18), (-2.30, 0, 0.94), "deck", material, 0.025))
   425	    for side in (-1, 1):
   426	        y = side * 1.76
   427	        parts.append(beam(f"Fore rail {side}", (-3.48, y, 1.16), (-1.02, y, 1.16), 0.075, "brass", material))
   428	        for x in (-3.35, -2.75, -2.15, -1.55, -1.05):
   429	            parts.append(beam(f"Fore post {side} {x}", (x, y, 0.94), (x, y, 1.22), 0.060, "brass", material))
   430	        add_rivets(parts, f"Bow flank {side}", (-3.52, -3.10, -2.68, -2.26, -1.84, -1.42), side * 1.88, 0.58, material)
   431	    parts.append(box("Crane turntable", (0.82, 1.32, 0.30), (-1.36, 0, 1.14), "brass", material, 0.045))
   432	    parts.append(cylinder("Crane pivot drum", 0.42, 1.20, (-1.42, 0, 1.48), "plate", material, vertices=14, rotation=(math.pi / 2, 0, 0), bevel=0))
   433	    for side in (-1, 1):
   434	        y = side * 0.50
   435	        parts.append(beam(f"Crane leg lower {side}", (-1.48, y, 1.42), (-2.88, y, 4.42), 0.17, "iron", material, arm))
   436	        parts.append(beam(f"Crane leg brass edge {side}", (-1.39, y, 1.50), (-2.78, y, 4.48), 0.075, "brass", material, arm))
   437	    for rung, z in enumerate(np.linspace(1.96, 4.14, 7)):
   438	        t = (z - 1.42) / (4.42 - 1.42)
   439	        x = -1.48 + (-2.88 + 1.48) * t
   440	        parts.append(beam(f"Crane cross rung {rung}", (x, -0.53, float(z)), (x, 0.53, float(z)), 0.060, "brass", material, arm))
   441	    parts.append(beam("Crane boom upper", (-2.84, -0.40, 4.45), (-3.58, -0.28, 4.94), 0.16, "iron", material, arm))
   442	    parts.append(beam("Crane boom upper pair", (-2.84, 0.40, 4.45), (-3.58, 0.28, 4.94), 0.16, "iron", material, arm))
   443	    parts.append(cylinder("Crane crown pulley", 0.42, 0.34, (-2.86, 0, 4.53), "brass", material, vertices=14, rotation=(math.pi / 2, 0, 0), bevel=0, damage_group=arm))
