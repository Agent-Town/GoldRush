   184	
   185	def tag(
   186	    obj: bpy.types.Object,
   187	    region: str,
   188	    material: bpy.types.Material,
   189	    bevel: float = 0.012,
   190	    damage_group: str | None = None,
   191	    smooth: bool = False,
   192	) -> bpy.types.Object:
   193	    obj["atlas_region"] = region
   194	    obj.data.materials.append(material)
   195	    mark_all(obj, damage_group)
   196	    if bevel > 0:
   197	        modifier = obj.modifiers.new("Worked edge", "BEVEL")
   198	        modifier.width = bevel
   199	        modifier.segments = 1
   200	        modifier.limit_method = "ANGLE"
   201	    if smooth:
   202	        for polygon in obj.data.polygons:
   203	            polygon.use_smooth = True
   204	    return obj
