   305	def rotate_x(co: Vector, pivot: Vector, angle: float) -> None:
   306	    local = co - pivot
   307	    y = local.y * math.cos(angle) - local.z * math.sin(angle)
   308	    z = local.y * math.sin(angle) + local.z * math.cos(angle)
   309	    co.y = pivot.y + y
   310	    co.z = pivot.z + z
