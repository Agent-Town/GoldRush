    13	REFERENCE = ROOT / "assets/raw/boss-dredge-queen.png"
    14	DAMAGE_REFERENCE = ROOT / "assets/raw/boss-dredge-queen-damage.png"
    15	BLEND = OUT / "dredge-queen.blend"
    16	GLB = OUT / "dredge-queen.glb"
    17	ATLAS_SIZE = 1024
    18	MODEL_LENGTH = 8.0
    19	
    20	REGIONS = {
    21	    "soot": (0.02, 0.02, 0.20, 0.47),
    22	    "iron": (0.23, 0.02, 0.41, 0.47),
    23	    "brass": (0.44, 0.02, 0.61, 0.47),
    24	    "deck": (0.64, 0.02, 0.78, 0.47),
    25	    "teal": (0.81, 0.02, 0.89, 0.47),
    26	    "damage": (0.92, 0.02, 0.98, 0.47),
    27	    "plate": (0.02, 0.52, 0.53, 0.98),
    28	    "sail": (0.56, 0.52, 0.78, 0.98),
    29	    "rope": (0.81, 0.52, 0.89, 0.98),
    30	    "cargo": (0.92, 0.52, 0.98, 0.98),
    31	}
