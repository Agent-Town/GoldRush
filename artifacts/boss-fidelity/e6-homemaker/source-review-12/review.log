   678	def export(objects: tuple[bpy.types.Object, ...], blend: Path, glb: Path) -> None:
   679	    bpy.ops.object.select_all(action="DESELECT")
   680	    for obj in objects:
   681	        obj.select_set(True)
   682	    bpy.context.view_layer.objects.active = objects[0]
   683	    bpy.ops.wm.save_as_mainfile(filepath=str(blend))
   684	    bpy.ops.export_scene.gltf(
