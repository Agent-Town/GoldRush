   105	def from_pydata(
   106	    name: str,
   107	    vertices: list[tuple[float, float, float]],
   108	    faces: list[tuple[int, ...]],
   109	    region: str,
   110	    material: bpy.types.Material,
   111	    bevel: float = 0.0,
   112	    damage_group: str | None = None,
   113	    smooth: bool = False,
   114	) -> bpy.types.Object:
   115	    mesh = bpy.data.meshes.new(f"{name}Mesh")
   116	    mesh.from_pydata(vertices, [], faces)
   117	    mesh.update()
   118	    obj = bpy.data.objects.new(name, mesh)
   119	    bpy.context.collection.objects.link(obj)
   120	    return tag(obj, region, material, bevel, damage_group, smooth)
