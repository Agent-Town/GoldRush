   362	def truss(
   363	    parts: list[bpy.types.Object],
   364	    prefix: str,
   365	    start: tuple[float, float, float],
   366	    end: tuple[float, float, float],
   367	    spread: float,
   368	    width: float,
   369	    bays: int,
   370	    region: str,
   371	    brace_region: str,
   372	    material: bpy.types.Material,
   373	    damage_group: str | None = None,
   374	    axis: int = 1,
   375	) -> None:
   376	    """Two chords, transverse rungs, and alternating diagonals: a real lattice derrick."""
   377	    a, b = Vector(start), Vector(end)
   378	    offset = Vector((0.0, 0.0, 0.0))
   379	    offset[axis] = spread * 0.5
   380	    for sign in (-1, 1):
   381	        chord_a = a + offset * sign
   382	        chord_b = b + offset * sign
   383	        parts.append(beam(f"{prefix} chord {sign}", tuple(chord_a), tuple(chord_b), width, region, material, damage_group))
   384	    for bay in range(bays + 1):
   385	        t = bay / bays
   386	        point = a.lerp(b, t)
   387	        parts.append(
   388	            beam(
   389	                f"{prefix} rung {bay}",
   390	                tuple(point - offset),
   391	                tuple(point + offset),
   392	                width * 0.62,
   393	                brace_region,
   394	                material,
   395	                damage_group,
   396	            )
   397	        )
   398	    for bay in range(bays):
   399	        low = a.lerp(b, bay / bays)
   400	        high = a.lerp(b, (bay + 1) / bays)
   401	        near, far = (-1, 1) if bay % 2 == 0 else (1, -1)
   402	        parts.append(
   403	            beam(
   404	                f"{prefix} diagonal {bay}",
   405	                tuple(low + offset * near),
   406	                tuple(high + offset * far),
   407	                width * 0.50,
   408	                brace_region,
   409	                material,
   410	                damage_group,
   411	            )
   412	        )
   413	
   414	
   415	def chain_run(
   416	    parts: list[bpy.types.Object],
   417	    prefix: str,
   418	    start: tuple[float, float, float],
   419	    end: tuple[float, float, float],
   420	    links: int,
   421	    radius: float,
   422	    region: str,
   423	    material: bpy.types.Material,
   424	    damage_group: str | None = None,
   425	) -> None:
   426	    """Alternating perpendicular links. The plate's chains are load-bearing, not painted.
   427	
   428	    A link's plane CONTAINS the run direction, so the torus axis must be perpendicular to it.
   429	    Consecutive links alternate between the two perpendiculars, which is what reads as a chain.
   430	    """
   431	    a, b = Vector(start), Vector(end)
   432	    direction = (b - a).normalized()
   433	    seed = Vector((0.0, 0.0, 1.0)) if abs(direction.z) < 0.90 else Vector((1.0, 0.0, 0.0))
   434	    first = direction.cross(seed).normalized()
   435	    second = direction.cross(first).normalized()
   436	    for link in range(links):
   437	        centre = a.lerp(b, (link + 0.5) / links)
   438	        axis = first if link % 2 == 0 else second
   439	        parts.append(
   440	            torus(
   441	                f"{prefix} link {link}",
   442	                radius,
   443	                radius * 0.34,
   444	                tuple(centre),
   445	                region,
   446	                material,
   447	                rotation=tuple(axis.to_track_quat("Z", "Y").to_euler()),
   448	                damage_group=damage_group,
   449	                major_segments=6,
   450	                minor_segments=4,
   451	            )
   452	        )
   453	
   454	
   455	def swept_tube(
   456	    name: str,
   457	    points: list[tuple[float, float, float]],
   458	    radii: list[float],
   459	    region: str,
   460	    material: bpy.types.Material,
   461	    sides: int = 8,
   462	    damage_group: str | None = None,
   463	    smooth: bool = True,
   464	) -> bpy.types.Object:
   465	    """A tapering tube swept along a curve, parallel-transported so it never twists.
   466	
   467	    This is what buys a real curved talon or cable: a beam chain reads as sticks,
   468	    a swept tube reads as a claw, and it costs fewer triangles than beams+knuckles.
   469	    """
   470	    assert len(points) == len(radii) >= 2
   471	    path = [Vector(point) for point in points]
   472	    tangents = []
   473	    for index in range(len(path)):
   474	        if index == 0:
   475	            tangent = path[1] - path[0]
   476	        elif index == len(path) - 1:
   477	            tangent = path[-1] - path[-2]
   478	        else:
   479	            tangent = path[index + 1] - path[index - 1]
   480	        tangents.append(tangent.normalized())
   481	    seed = Vector((0.0, 0.0, 1.0)) if abs(tangents[0].z) < 0.90 else Vector((1.0, 0.0, 0.0))
   482	    right = tangents[0].cross(seed).normalized()
   483	    rings: list[list[tuple[float, float, float]]] = []
   484	    for index, (centre, tangent, radius) in enumerate(zip(path, tangents, radii)):
   485	        if index > 0:
   486	            # parallel transport: re-project the previous frame onto the new normal plane
   487	            right = (right - tangent * right.dot(tangent))
   488	            right = right.normalized() if right.length > 1e-6 else tangent.cross(seed).normalized()
   489	        up = tangent.cross(right).normalized()
   490	        ring = []
   491	        for step in range(sides):
   492	            angle = math.tau * step / sides
   493	            offset = right * (math.cos(angle) * radius) + up * (math.sin(angle) * radius)
   494	            ring.append(tuple(centre + offset))
   495	        rings.append(ring)
   496	    return loft(name, rings, region, material, damage_group=damage_group, smooth=smooth)
