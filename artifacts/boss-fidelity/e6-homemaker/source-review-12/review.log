   588	def prepare_part(obj: bpy.types.Object, regions: dict[str, tuple[float, float, float, float]]) -> None:
   589	    bpy.context.view_layer.objects.active = obj
   590	    obj.select_set(True)
   591	    for modifier in list(obj.modifiers):
   592	        bpy.ops.object.modifier_apply(modifier=modifier.name)
   593	    bpy.ops.object.mode_set(mode="EDIT")
   594	    bpy.ops.mesh.select_all(action="SELECT")
   595	    bpy.ops.mesh.normals_make_consistent(inside=False)
   596	    bpy.ops.uv.smart_project(angle_limit=math.radians(66), island_margin=0.025)
   597	    bpy.ops.object.mode_set(mode="OBJECT")
   598	    uv = obj.data.uv_layers.active.data
   599	    coords = np.array([[loop.uv.x, loop.uv.y] for loop in uv], dtype=np.float32)
   600	    low = coords.min(axis=0)
   601	    span = np.maximum(coords.max(axis=0) - low, 1e-6)
   602	    u0, v0, u1, v1 = regions[obj["atlas_region"]]
   603	    for loop, coord in zip(uv, coords):
   604	        normalized = (coord - low) / span
   605	        loop.uv = (u0 + normalized[0] * (u1 - u0), v0 + normalized[1] * (v1 - v0))
   606	    obj.select_set(False)
   607	
   608	
   609	def join_component(
   610	    name: str,
   611	    parts: list[bpy.types.Object],
   612	    material: bpy.types.Material,
   613	    regions: dict[str, tuple[float, float, float, float]],
   614	) -> bpy.types.Object:
   615	    for part in parts:
   616	        prepare_part(part, regions)
   617	    bpy.ops.object.select_all(action="DESELECT")
   618	    for part in parts:
   619	        part.select_set(True)
   620	    bpy.context.view_layer.objects.active = parts[0]
   621	    bpy.ops.object.join()
   622	    component = bpy.context.object
   623	    component.name = name
   624	    component.data.name = f"{name}Mesh"
   625	    component.data.materials.clear()
   626	    component.data.materials.append(material)
   627	    for polygon in component.data.polygons:
   628	        polygon.material_index = 0
   629	    component.data.uv_layers.active.name = "UVMap"
   630	    bpy.context.scene.cursor.location = (0, 0, 0)
   631	    bpy.ops.object.origin_set(type="ORIGIN_CURSOR")
   632	    component.select_set(False)
   633	    return component
