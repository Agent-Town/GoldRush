   624	
   625	def group_vertex_indices(obj: bpy.types.Object, group_name: str) -> set[int]:
   626	    group = obj.vertex_groups.get(group_name)
   627	    if group is None:
   628	        return set()
   629	    index = group.index
   630	    return {vertex.index for vertex in obj.data.vertices if any(item.group == index for item in vertex.groups)}
   631	
   632	
   633	def rotate_y(co: Vector, pivot: Vector, angle: float) -> None:
   634	    local = co - pivot
   635	    x = local.x * math.cos(angle) + local.z * math.sin(angle)
   636	    z = -local.x * math.sin(angle) + local.z * math.cos(angle)
   637	    co.x = pivot.x + x
   638	    co.z = pivot.z + z
   639	
   640	
   641	def add_damage_shapes(
   642	    claw: bpy.types.Object,
   643	    paddle_port: bpy.types.Object,
   644	    paddle_starboard: bpy.types.Object,
   645	    hold: bpy.types.Object,
   646	) -> None:
   647	    claw.shape_key_add(name="Basis")
   648	    slack = claw.shape_key_add(name="Damage_SlackClaw")
   649	    pivot = Vector((-1.40, 0.0, 1.30))
   650	    for index in group_vertex_indices(claw, "DamageClawArm"):
   651	        co = slack.data[index].co
   652	        rotate_y(co, pivot, math.radians(-30))
   653	        co.z -= 0.34
   654	        co.y *= 1.06
   655	    shard_moves = (Vector((-0.36, -0.40, -0.22)), Vector((-0.22, 0.44, -0.35)), Vector((0.10, 0.56, -0.46)))
   656	    for shard, movement in enumerate(shard_moves):
   657	        for index in group_vertex_indices(claw, f"DamageClawShard{shard}"):
   658	            slack.data[index].co += movement
   659	
   660	    for paddle, side, label in ((paddle_port, -1, "Port"), (paddle_starboard, 1, "Starboard")):
   661	        paddle.shape_key_add(name="Basis")
   662	        broken = paddle.shape_key_add(name=f"Damage_Broken{label}Paddle")
   663	        center = Vector((1.35, side * 2.48, 1.64))
   664	        for index in group_vertex_indices(paddle, f"Damage{label}Paddle"):
   665	            co = broken.data[index].co
   666	            radial_x = co.x - center.x
   667	            radial_z = co.z - center.z
   668	            upper = max(0.0, radial_z)
   669	            co.y += side * (0.30 + upper * 0.46)
   670	            co.x += radial_z * (0.18 if side > 0 else -0.18)
   671	            co.z -= 0.42 + abs(radial_x) * 0.18
   672	        moves = (
   673	            Vector((-0.56, side * 0.46, -0.18)),
   674	            Vector((0.16, side * 0.62, -0.44)),
   675	            Vector((0.62, side * 0.40, 0.08)),
   676	        )
   677	        for shard, movement in enumerate(moves):
   678	            for index in group_vertex_indices(paddle, f"Damage{label}Shard{shard}"):
   679	                broken.data[index].co += movement
   680	
   681	    hold.shape_key_add(name="Basis")
   682	    cracked = hold.shape_key_add(name="Damage_CrackedLootHold")
   683	    for index in group_vertex_indices(hold, "DamageHoldPortLid"):
   684	        co = cracked.data[index].co
   685	        co.y -= 0.58
   686	        co.z += max(0.0, 2.50 - co.z) * 0.15 + 0.28
   687	    for index in group_vertex_indices(hold, "DamageHoldStarboardLid"):
   688	        co = cracked.data[index].co
   689	        co.y += 0.62
   690	        co.z += max(0.0, 2.50 - co.z) * 0.12 - 0.18
   691	        co.x += 0.18
   692	    for index in group_vertex_indices(hold, "DamageHoldRear"):
   693	        co = cracked.data[index].co
   694	        rear = max(0.0, min(1.0, (co.x - 1.55) / 1.80))
   695	        co.x += rear * 0.20
   696	        co.z -= rear * 0.50
   697	        co.y *= 1.0 + rear * 0.08
   698	    for index in group_vertex_indices(hold, "DamageFlag"):
   699	        co = cracked.data[index].co
   700	        mast_x = 0.52 if co.x < 2.60 else 3.00
   701	        co.x = mast_x + (co.x - mast_x) * 0.30
   702	        co.z = 2.42 + (co.z - 2.42) * 0.25
   703	        co.y *= 0.60
   704	    cargo_moves = (
   705	        Vector((1.86, -2.08, -0.94)),
   706	        Vector((1.58, 2.16, -0.86)),
   707	        Vector((2.22, -1.12, -1.02)),
   708	        Vector((2.00, 1.28, -0.92)),
   709	    )
   710	    for cargo, movement in enumerate(cargo_moves):
   711	        for index in group_vertex_indices(hold, f"DamageCargo{cargo}"):
   712	            cracked.data[index].co += movement
   713	    for index in group_vertex_indices(hold, "DamageHoldBreach"):
   714	        cracked.data[index].co += Vector((0.68, 1.68, -0.34))
   715	
   716	    for obj in (claw, paddle_port, paddle_starboard, hold):
   717	        obj.active_shape_key_index = 0
   718	        for key in obj.data.shape_keys.key_blocks:
   719	            key.value = 0.0
   720	
   721	
   722	def triangle_count(objects: tuple[bpy.types.Object, ...]) -> int:
   723	    return sum(sum(len(polygon.vertices) - 2 for polygon in obj.data.polygons) for obj in objects)
   724	
   725	
   726	def world_bounds(objects: tuple[bpy.types.Object, ...]) -> tuple[Vector, Vector]:
   727	    points = [obj.matrix_world @ vertex.co for obj in objects for vertex in obj.data.vertices]
   728	    return (
   729	        Vector((min(point.x for point in points), min(point.y for point in points), min(point.z for point in points))),
   730	        Vector((max(point.x for point in points), max(point.y for point in points), max(point.z for point in points))),
   731	    )
   732	
   733	
   734	def normalize_base_center(objects: tuple[bpy.types.Object, ...]) -> None:
   735	    minimum, maximum = world_bounds(objects)
   736	    center_x = (minimum.x + maximum.x) * 0.5
   737	    center_y = (minimum.y + maximum.y) * 0.5
   738	    scale = MODEL_LENGTH / (maximum.x - minimum.x)
   739	    for obj in objects:
   740	        for vertex in obj.data.vertices:
   741	            vertex.co.x = (vertex.co.x - center_x) * scale
   742	            vertex.co.y = (vertex.co.y - center_y) * scale
   743	            vertex.co.z = (vertex.co.z - minimum.z) * scale
   744	        obj.data.update()
   745	
   746	
   747	def export(objects: tuple[bpy.types.Object, ...]) -> None:
   748	    bpy.ops.object.select_all(action="DESELECT")
   749	    for obj in objects:
   750	        obj.select_set(True)
   751	    bpy.context.view_layer.objects.active = objects[0]
   752	    bpy.ops.wm.save_as_mainfile(filepath=str(BLEND))
   753	    bpy.ops.export_scene.gltf(
   754	        filepath=str(GLB.with_suffix("")),
   755	        export_format="GLB",
   756	        use_selection=True,
   757	        export_apply=True,
   758	        export_cameras=False,
   759	        export_lights=False,
   760	        export_animations=False,
   761	        export_materials="EXPORT",
   762	        export_morph=True,
   763	    )
   764	
   765	
   766	def main() -> None:
   767	    OUT.mkdir(parents=True, exist_ok=True)
   768	    reset_scene()
   769	    atlas, source_hashes = create_atlas()
   770	    material = create_material(atlas)
   771	    claw = join_component("claw", build_claw(material), material)
   772	    paddle_port = join_component("paddle_port", build_paddle(material, -1), material)
   773	    paddle_starboard = join_component("paddle_starboard", build_paddle(material, 1), material)
   774	    hold = join_component("hold", build_hold(material), material)
   775	    objects = (claw, paddle_port, paddle_starboard, hold)
   776	    normalize_base_center(objects)
   777	    add_damage_shapes(*objects)
   778	
   779	    minimum, maximum = world_bounds(objects)
   780	    triangles = triangle_count(objects)
   781	    assert triangles <= 12_000, f"triangle budget exceeded: {triangles}"
   782	    assert abs((maximum.x - minimum.x) - MODEL_LENGTH) < 0.01
   783	    assert abs((maximum.x + minimum.x) * 0.5) < 0.001
   784	    assert abs((maximum.y + minimum.y) * 0.5) < 0.001
   785	    assert abs(minimum.z) < 0.001
   786	    assert len({slot.material.name for obj in objects for slot in obj.material_slots if slot.material}) == 1
   787	    export(objects)
   788	    print(json.dumps({
   789	        "blend": str(BLEND),
   790	        "glb": str(GLB),
   791	        "sha256": hashlib.sha256(GLB.read_bytes()).hexdigest(),
   792	        "sourcePlates": {
   793	            str(REFERENCE.relative_to(ROOT)): source_hashes["intact"],
   794	            str(DAMAGE_REFERENCE.relative_to(ROOT)): source_hashes["damage"],
   795	        },
   796	        "objects": [obj.name for obj in objects],
   797	        "damageMorphs": [obj.data.shape_keys.key_blocks[1].name for obj in objects],
   798	        "triangles": triangles,
   799	        "boundsBlender": {
   800	            "min": [round(value, 6) for value in minimum],
   801	            "max": [round(value, 6) for value in maximum],
   802	        },
   803	    }, indent=2))
   804	
   805	
   806	if __name__ == "__main__":
   807	    main()
===== detail_opus5_kit.py =====
     1	"""Shared craft kit for the Opus-5 boss-detail duel entries.
     2	
     3	This module carries the shipped pilot idiom verbatim where it is legality-relevant
     4	(atlas sampling, one-material setup, region UV remap, join/normalise/export) and adds
     5	the higher-detail construction helpers the 45k-triangle duel ceiling pays for:
     6	lofted hulls, lattice trusses, chain runs, arc sweeps, and radial repeats.
     7	
     8	Nothing here writes to a shipped file. Both duel builders import this kit.
     9	"""
