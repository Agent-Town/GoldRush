   582	def prepare_part(obj: bpy.types.Object) -> None:
   583	    bpy.context.view_layer.objects.active = obj
   584	    obj.select_set(True)
   585	    for modifier in list(obj.modifiers):
   586	        bpy.ops.object.modifier_apply(modifier=modifier.name)
   587	    bpy.ops.object.mode_set(mode="EDIT")
   588	    bpy.ops.mesh.select_all(action="SELECT")
   589	    bpy.ops.mesh.normals_make_consistent(inside=False)
   590	    bpy.ops.uv.smart_project(angle_limit=math.radians(66), island_margin=0.025)
   591	    bpy.ops.object.mode_set(mode="OBJECT")
   592	    uv = obj.data.uv_layers.active.data
   593	    coords = np.array([[loop.uv.x, loop.uv.y] for loop in uv], dtype=np.float32)
   594	    low = coords.min(axis=0)
   595	    span = np.maximum(coords.max(axis=0) - low, 1e-6)
   596	    u0, v0, u1, v1 = REGIONS[obj["atlas_region"]]
   597	    for loop, coord in zip(uv, coords):
   598	        normalized = (coord - low) / span
   599	        loop.uv = (u0 + normalized[0] * (u1 - u0), v0 + normalized[1] * (v1 - v0))
   600	    obj.select_set(False)
