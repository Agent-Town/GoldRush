   300	
   301	def loft(
   302	    name: str,
   303	    rings: list[list[tuple[float, float, float]]],
   304	    region: str,
   305	    material: bpy.types.Material,
   306	    cap_start: bool = True,
   307	    cap_end: bool = True,
   308	    damage_group: str | None = None,
   309	    smooth: bool = False,
   310	) -> bpy.types.Object:
   311	    """Skin a stack of equal-length closed rings. The cheapest way to buy real hull form."""
   312	    count = len(rings[0])
   313	    assert all(len(ring) == count for ring in rings), "loft rings must be equal length"
   314	    vertices: list[tuple[float, float, float]] = []
   315	    for ring in rings:
   316	        vertices.extend(tuple(float(value) for value in point) for point in ring)
   317	    faces: list[tuple[int, ...]] = []
   318	    for index in range(len(rings) - 1):
   319	        base = index * count
   320	        nxt = base + count
   321	        for step in range(count):
   322	            following = (step + 1) % count
   323	            faces.append((base + step, base + following, nxt + following, nxt + step))
   324	    if cap_start:
   325	        faces.append(tuple(range(count - 1, -1, -1)))
   326	    if cap_end:
   327	        base = (len(rings) - 1) * count
   328	        faces.append(tuple(range(base, base + count)))
   329	    return from_pydata(name, vertices, faces, region, material, 0.0, damage_group, smooth)
   330	
   331	
   332	def hull_section(
   333	    half_beam: float, keel: float, deck: float, crown: float = 0.06, tumblehome: float = 0.95
   334	) -> list[tuple[float, float, float]]:
   335	    """One armoured-corsair station: keel, bilge turn, max beam, tumblehome, deck edge, cambered deck."""
   336	    mid = (keel + deck) * 0.5
   337	    starboard = [
   338	        (0.0, 0.0, keel),
   339	        (0.0, half_beam * 0.52, keel + (deck - keel) * 0.06),
   340	        (0.0, half_beam * 0.89, keel + (deck - keel) * 0.30),
   341	        (0.0, half_beam, mid),
   342	        (0.0, half_beam * tumblehome, deck - (deck - keel) * 0.16),
   343	        (0.0, half_beam * (tumblehome - 0.09), deck),
   344	    ]
   345	    port = [(0.0, -point[1], point[2]) for point in reversed(starboard[1:])]
   346	    return [*starboard, (0.0, 0.0, deck + crown), *port]
   347	
   348	
   349	def hull_loft(
   350	    name: str,
   351	    stations: list[tuple[float, float, float, float]],
   352	    region: str,
   353	    material: bpy.types.Material,
   354	    damage_group: str | None = None,
   355	) -> bpy.types.Object:
   356	    rings = []
   357	    for x, half_beam, keel, deck in stations:
   358	        rings.append([(x, point[1], point[2]) for point in hull_section(half_beam, keel, deck)])
   359	    return loft(name, rings, region, material, damage_group=damage_group)
