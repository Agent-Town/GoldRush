   314	def add_damage_shapes(vac: bpy.types.Object, rack: bpy.types.Object, core: bpy.types.Object) -> None:
   315	    vac.shape_key_add(name="Basis")
   316	    dropped = vac.shape_key_add(name="Damage_DroppedVac")
   317	    pivot = group_center(vac, "VacUpperArm")
   318	    for index in dq.group_vertex_indices(vac, "VacUpperArm"):
   319	        co = dropped.data[index].co
   320	        dq.rotate_y(co, pivot, math.radians(-28))
   321	        co += Vector((-0.18, -0.18, -0.46))
   322	    for index in dq.group_vertex_indices(vac, "VacHose"):
   323	        co = dropped.data[index].co
   324	        co += Vector((-0.18, -0.20, -0.55 * min(1, max(0, (co.z-.2)/1.2)) - max(0.0, co.z - 0.8) * 0.12))
   325	    for index in dq.group_vertex_indices(vac, "VacHead"):
   326	        dropped.data[index].co += Vector((-0.68, -0.88, 0.02))
   327	    for shard, move in enumerate((Vector((-1.1, -1.0, -0.10)), Vector((-0.2, -1.35, -0.18)), Vector((0.45, -0.82, -0.12)))):
   328	        for index in dq.group_vertex_indices(vac, f"VacShard{shard}"):
   329	            dropped.data[index].co += move
   330	        indices = dq.group_vertex_indices(vac, f"VacShard{shard}")
   331	        floor_delta = 0.02 - min(dropped.data[index].co.z for index in indices)
   332	        for index in indices:
   333	            dropped.data[index].co.z += floor_delta
   334	
   335	    rack.shape_key_add(name="Basis")
   336	    spent = rack.shape_key_add(name="Damage_SpentRack")
   337	    minimum, maximum = group_bounds(rack, "RackUpper")
   338	    pivot = Vector((minimum.x, (minimum.y + maximum.y) * 0.5, minimum.z))
   339	    for index in dq.group_vertex_indices(rack, "RackUpper"):
   340	        co = spent.data[index].co
   341	        rotate_x(co, pivot, math.radians(18))
   342	        dq.rotate_y(co, pivot, math.radians(-14))
   343	        co += Vector((2.18, 0.78, -4.96))
   344	    for shard, move in enumerate((Vector((-1.35, -1.15, -5.57)), Vector((0.15, -1.55, -5.52)), Vector((1.18, -0.82, -5.52)))):
   345	        for index in dq.group_vertex_indices(rack, f"RackShard{shard}"):
   346	            spent.data[index].co += move
   347	        indices = dq.group_vertex_indices(rack, f"RackShard{shard}")
   348	        floor_delta = 0.02 - min(spent.data[index].co.z for index in indices)
   349	        for index in indices:
   350	            spent.data[index].co.z += floor_delta
   351	
   352	    core.shape_key_add(name="Basis")
   353	    chair_pose = core.shape_key_add(name="Damage_ChairPose")
   354	    body_pivot = group_center(core, "ChairBody")
   355	    for index in dq.group_vertex_indices(core, "ChairBody"):
   356	        co = chair_pose.data[index].co
   357	        rotate_x(co, body_pivot, math.radians(-12))
   358	        co += Vector((0.0, 0.72, -1.24))
   359	    for index in dq.group_vertex_indices(core, "CoreShutdownShutter"):
   360	        co = chair_pose.data[index].co
   361	        co.y -= 1.888
   362	        rotate_x(co, body_pivot, math.radians(-12))
   363	        co += Vector((0.0, 0.72, -1.24))
   364	    for group_name, x_move in (("ChairLeftLeg", -0.22), ("ChairRightLeg", 0.22)):
   365	        pivot = group_center(core, group_name)
   366	        for index in dq.group_vertex_indices(core, group_name):
   367	            co = chair_pose.data[index].co
   368	            rotate_x(co, pivot, math.radians(-42))
   369	            co += Vector((x_move, -0.90, 0.21))
   370	    broom_pivot = group_center(core, "BroomShoulderPivot")
   371	    for index in dq.group_vertex_indices(core, "ChairBroom"):
   372	        co = chair_pose.data[index].co
   373	        dq.rotate_y(co, broom_pivot, math.radians(-30))
   374	        rotate_x(co, body_pivot, math.radians(-12))
   375	        co += Vector((0.0, 0.72, -1.24))
   376	
   377	    # Keep the target's full chair coordinates, but make the intact basis a
   378	    # near-zero bundle under the body. At weight 1 the debris chair builds.
   379	    anchor = Vector((0.0, 0.55, 0.12))
   380	    basis = core.data.shape_keys.key_blocks["Basis"]
   381	    for index in dq.group_vertex_indices(core, "ChairDebris"):
   382	        basis.data[index].co = anchor + (basis.data[index].co - anchor) * 0.006
   383	
   384	    for obj in (vac, rack, core):
   385	        obj.active_shape_key_index = 0
   386	        for key in obj.data.shape_keys.key_blocks:
   387	            key.value = 0.0
   388	        obj.data.update()
