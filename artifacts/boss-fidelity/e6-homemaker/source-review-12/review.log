    83	def tag(
    84	    obj: bpy.types.Object,
    85	    region: str,
    86	    material: bpy.types.Material,
    87	    bevel: float = 0.012,
    88	    damage_group: str | None = None,
    89	    smooth: bool = False,
    90	) -> bpy.types.Object:
    91	    obj["atlas_region"] = region
    92	    obj.data.materials.append(material)
    93	    mark_all(obj, damage_group)
    94	    if bevel > 0:
    95	        modifier = obj.modifiers.new("Worked edge", "BEVEL")
    96	        modifier.width = bevel
    97	        modifier.segments = 1
    98	        modifier.limit_method = "ANGLE"
    99	    if smooth:
   100	        for polygon in obj.data.polygons:
   101	            polygon.use_smooth = True
   102	    return obj
