   291	def group_bounds(obj: bpy.types.Object, group_name: str) -> tuple[Vector, Vector]:
   292	    points = [obj.data.vertices[index].co for index in dq.group_vertex_indices(obj, group_name)]
   293	    assert points, f"missing group {obj.name}:{group_name}"
   294	    return (
   295	        Vector(tuple(min(point[axis] for point in points) for axis in range(3))),
   296	        Vector(tuple(max(point[axis] for point in points) for axis in range(3))),
   297	    )
