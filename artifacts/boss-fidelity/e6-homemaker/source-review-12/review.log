   207	def box(
   208	    name: str,
   209	    size: tuple[float, float, float],
   210	    at: tuple[float, float, float],
   211	    region: str,
   212	    material: bpy.types.Material,
   213	    bevel: float = 0.012,
   214	    rotation: tuple[float, float, float] = (0, 0, 0),
   215	    damage_group: str | None = None,
   216	) -> bpy.types.Object:
   217	    bpy.ops.mesh.primitive_cube_add(location=at, rotation=rotation)
   218	    obj = bpy.context.object
   219	    obj.name = name
   220	    obj.scale = tuple(value * 0.5 for value in size)
   221	    bpy.ops.object.transform_apply(location=False, rotation=True, scale=True)
   222	    return tag(obj, region, material, bevel, damage_group)
