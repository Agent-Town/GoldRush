   643	
   644	def rotate_y(co: Vector, pivot: Vector, angle: float) -> None:
   645	    local = co - pivot
   646	    x = local.x * math.cos(angle) + local.z * math.sin(angle)
   647	    z = -local.x * math.sin(angle) + local.z * math.cos(angle)
   648	    co.x = pivot.x + x
   649	    co.z = pivot.z + z
   650	
   651	
   652	def triangle_count(objects: tuple[bpy.types.Object, ...]) -> int:
   653	    return sum(sum(len(polygon.vertices) - 2 for polygon in obj.data.polygons) for obj in objects)
   654	
   655	
   656	def world_bounds(objects: tuple[bpy.types.Object, ...]) -> tuple[Vector, Vector]:
   657	    points = [obj.matrix_world @ vertex.co for obj in objects for vertex in obj.data.vertices]
   658	    return (
   659	        Vector((min(p.x for p in points), min(p.y for p in points), min(p.z for p in points))),
   660	        Vector((max(p.x for p in points), max(p.y for p in points), max(p.z for p in points))),
   661	    )
   662	
   663	
   664	def normalize_base_center(objects: tuple[bpy.types.Object, ...], axis: int, target: float) -> None:
   665	    """Scale on one axis to the shipped footprint, centre X/Y, sit the base on z=0."""
   666	    minimum, maximum = world_bounds(objects)
   667	    center_x = (minimum.x + maximum.x) * 0.5
   668	    center_y = (minimum.y + maximum.y) * 0.5
   669	    scale = target / ((maximum - minimum)[axis])
   670	    for obj in objects:
   671	        for vertex in obj.data.vertices:
   672	            vertex.co.x = (vertex.co.x - center_x) * scale
   673	            vertex.co.y = (vertex.co.y - center_y) * scale
   674	            vertex.co.z = (vertex.co.z - minimum.z) * scale
   675	        obj.data.update()
   676	
