   292	def group_bounds(obj: bpy.types.Object, group_name: str) -> tuple[Vector, Vector]:
   293	    points = [obj.data.vertices[index].co for index in dq.group_vertex_indices(obj, group_name)]
   294	    assert points, f"missing group {obj.name}:{group_name}"
   295	    return (
   296	        Vector(tuple(min(point[axis] for point in points) for axis in range(3))),
   297	        Vector(tuple(max(point[axis] for point in points) for axis in range(3))),
   298	    )
   299	
   300	
   301	def group_center(obj: bpy.types.Object, group_name: str) -> Vector:
   302	    minimum, maximum = group_bounds(obj, group_name)
   303	    return (minimum + maximum) * 0.5
