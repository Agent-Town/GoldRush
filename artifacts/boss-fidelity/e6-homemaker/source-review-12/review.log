    40	    cells={"iron":(0,2),"plate":(0,2),"amber":(1,2),"teal":(2,2),"brass":(0,1),
    41	           "soot":(1,1),"cargo":(2,1),"sail":(0,0),"deck":(1,0),
    42	           "damage":(2,0)}
    43	    dq.REGIONS={name:((x+.07)/3,(y+.07)/3,(x+.93)/3,(y+.93)/3)
    44	                for name,(x,y) in cells.items()}
    45	    dq.REGIONS["glow"]=(.48,.80,.54,.87)
    46	    image=bpy.data.images.load(str(HERE.parent / "candidate-material/atlas-silver-v5.png"),check_existing=False)
