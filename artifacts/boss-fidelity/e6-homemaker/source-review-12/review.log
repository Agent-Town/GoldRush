   230	def beam(
   231	    name: str,
   232	    start: tuple[float, float, float],
   233	    end: tuple[float, float, float],
   234	    width: float,
   235	    region: str,
   236	    material: bpy.types.Material,
   237	    damage_group: str | None = None,
   238	    depth: float | None = None,
   239	) -> bpy.types.Object:
   240	    a, b = Vector(start), Vector(end)
   241	    direction = b - a
   242	    obj = box(
   243	        name,
   244	        (width, depth if depth is not None else width, direction.length),
   245	        tuple((a + b) * 0.5),
   246	        region,
   247	        material,
   248	        bevel=min(0.006, width * 0.18),
   249	        damage_group=damage_group,
   250	    )
   251	    obj.rotation_mode = "QUATERNION"
   252	    obj.rotation_quaternion = direction.to_track_quat("Z", "Y")
   253	    bpy.context.view_layer.objects.active = obj
   254	    obj.select_set(True)
   255	    bpy.ops.object.transform_apply(location=False, rotation=True, scale=False)
   256	    obj.select_set(False)
   257	    return obj
