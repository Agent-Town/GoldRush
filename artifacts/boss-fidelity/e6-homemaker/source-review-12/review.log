   306	def rotate_x(co: Vector, pivot: Vector, angle: float) -> None:
   307	    local = co - pivot
   308	    y = local.y * math.cos(angle) - local.z * math.sin(angle)
   309	    z = local.y * math.sin(angle) + local.z * math.cos(angle)
   310	    co.y = pivot.y + y
   311	    co.z = pivot.z + z
