    25	def load(name: str, path: Path):
    26	    spec = importlib.util.spec_from_file_location(name, path)
    27	    module = importlib.util.module_from_spec(spec)
    28	    assert spec.loader is not None
    29	    sys.modules[name] = module
    30	    spec.loader.exec_module(module)
    31	    return module
