   390	def recenter_shape_keyed_basis(objects: tuple[bpy.types.Object, ...]) -> None:
   391	    """Re-center the basis after the hidden chair bundle changes its bounds.
   392	
   393	    Apply the same translation to every key block so the authored damage
   394	    deltas remain unchanged while the exported intact basis stays base-center.
   395	    """
   396	    points = [
   397	        point.co
   398	        for obj in objects
   399	        for point in obj.data.shape_keys.key_blocks["Basis"].data
   400	    ]
   401	    minimum = Vector(tuple(min(point[axis] for point in points) for axis in range(3)))
   402	    maximum = Vector(tuple(max(point[axis] for point in points) for axis in range(3)))
   403	    offset = Vector(((minimum.x + maximum.x) * 0.5, (minimum.y + maximum.y) * 0.5, minimum.z))
   404	    for obj in objects:
   405	        keys = obj.data.shape_keys
   406	        assert keys is not None
   407	        for key in keys.key_blocks:
   408	            for point in key.data:
   409	                point.co -= offset
   410	        obj.data.update()
   411	
