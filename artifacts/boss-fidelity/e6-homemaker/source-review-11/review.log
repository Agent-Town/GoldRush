   633	def rotate_y(co: Vector, pivot: Vector, angle: float) -> None:
   634	    local = co - pivot
   635	    x = local.x * math.cos(angle) + local.z * math.sin(angle)
   636	    z = -local.x * math.sin(angle) + local.z * math.cos(angle)
   637	    co.x = pivot.x + x
   638	    co.z = pivot.z + z
