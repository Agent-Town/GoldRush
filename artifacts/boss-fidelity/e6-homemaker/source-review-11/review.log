   376	    # Keep the target's full chair coordinates, but make the intact basis a
   377	    # near-zero bundle under the body. At weight 1 the debris chair builds.
   378	    anchor = Vector((0.0, 0.55, 0.12))
   379	    basis = core.data.shape_keys.key_blocks["Basis"]
   380	    for index in dq.group_vertex_indices(core, "ChairDebris"):
   381	        basis.data[index].co = anchor + (basis.data[index].co - anchor) * 0.006
