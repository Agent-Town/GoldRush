   734	def normalize_base_center(objects: tuple[bpy.types.Object, ...]) -> None:
   735	    minimum, maximum = world_bounds(objects)
   736	    center_x = (minimum.x + maximum.x) * 0.5
   737	    center_y = (minimum.y + maximum.y) * 0.5
   738	    scale = MODEL_LENGTH / (maximum.x - minimum.x)
   739	    for obj in objects:
   740	        for vertex in obj.data.vertices:
   741	            vertex.co.x = (vertex.co.x - center_x) * scale
   742	            vertex.co.y = (vertex.co.y - center_y) * scale
   743	            vertex.co.z = (vertex.co.z - minimum.z) * scale
   744	        obj.data.update()
