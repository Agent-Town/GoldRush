   313	def add_damage_shapes(vac: bpy.types.Object, rack: bpy.types.Object, core: bpy.types.Object) -> None:
   314	    vac.shape_key_add(name="Basis")
   315	    dropped = vac.shape_key_add(name="Damage_DroppedVac")
   316	    pivot = group_center(vac, "VacUpperArm")
   317	    for index in dq.group_vertex_indices(vac, "VacUpperArm"):
   318	        co = dropped.data[index].co
   319	        dq.rotate_y(co, pivot, math.radians(-28))
   320	        co += Vector((-0.18, -0.18, -0.46))
   321	    for index in dq.group_vertex_indices(vac, "VacHose"):
   322	        co = dropped.data[index].co
   323	        co += Vector((-0.18, -0.20, -0.55 * min(1, max(0, (co.z-.2)/1.2)) - max(0.0, co.z - 0.8) * 0.12))
   324	    for index in dq.group_vertex_indices(vac, "VacHead"):
   325	        dropped.data[index].co += Vector((-0.68, -0.88, 0.02))
   326	    for shard, move in enumerate((Vector((-1.1, -1.0, -0.10)), Vector((-0.2, -1.35, -0.18)), Vector((0.45, -0.82, -0.12)))):
   327	        for index in dq.group_vertex_indices(vac, f"VacShard{shard}"):
   328	            dropped.data[index].co += move
   329	        indices = dq.group_vertex_indices(vac, f"VacShard{shard}")
   330	        floor_delta = 0.02 - min(dropped.data[index].co.z for index in indices)
   331	        for index in indices:
   332	            dropped.data[index].co.z += floor_delta
   333	
   334	    rack.shape_key_add(name="Basis")
   335	    spent = rack.shape_key_add(name="Damage_SpentRack")
   336	    minimum, maximum = group_bounds(rack, "RackUpper")
   337	    pivot = Vector((minimum.x, (minimum.y + maximum.y) * 0.5, minimum.z))
   338	    for index in dq.group_vertex_indices(rack, "RackUpper"):
   339	        co = spent.data[index].co
   340	        rotate_x(co, pivot, math.radians(18))
   341	        dq.rotate_y(co, pivot, math.radians(-14))
   342	        co += Vector((2.18, 0.78, -4.96))
   343	    for shard, move in enumerate((Vector((-1.35, -1.15, -5.57)), Vector((0.15, -1.55, -5.52)), Vector((1.18, -0.82, -5.52)))):
   344	        for index in dq.group_vertex_indices(rack, f"RackShard{shard}"):
   345	            spent.data[index].co += move
   346	        indices = dq.group_vertex_indices(rack, f"RackShard{shard}")
   347	        floor_delta = 0.02 - min(spent.data[index].co.z for index in indices)
   348	        for index in indices:
   349	            spent.data[index].co.z += floor_delta
   350	
   351	    core.shape_key_add(name="Basis")
   352	    chair_pose = core.shape_key_add(name="Damage_ChairPose")
   353	    body_pivot = group_center(core, "ChairBody")
   354	    for index in dq.group_vertex_indices(core, "ChairBody"):
   355	        co = chair_pose.data[index].co
   356	        rotate_x(co, body_pivot, math.radians(-12))
   357	        co += Vector((0.0, 0.72, -1.24))
   358	    for index in dq.group_vertex_indices(core, "CoreShutdownShutter"):
   359	        co = chair_pose.data[index].co
   360	        co.y -= 1.888
   361	        rotate_x(co, body_pivot, math.radians(-12))
   362	        co += Vector((0.0, 0.72, -1.24))
   363	    for group_name, x_move in (("ChairLeftLeg", -0.22), ("ChairRightLeg", 0.22)):
   364	        pivot = group_center(core, group_name)
   365	        for index in dq.group_vertex_indices(core, group_name):
   366	            co = chair_pose.data[index].co
   367	            rotate_x(co, pivot, math.radians(-42))
   368	            co += Vector((x_move, -0.90, 0.21))
   369	    broom_pivot = group_center(core, "BroomShoulderPivot")
   370	    for index in dq.group_vertex_indices(core, "ChairBroom"):
   371	        co = chair_pose.data[index].co
   372	        dq.rotate_y(co, broom_pivot, math.radians(-30))
   373	        rotate_x(co, body_pivot, math.radians(-12))
   374	        co += Vector((0.0, 0.72, -1.24))
