   300	
   301	def loft(
   302	    name: str,
   303	    rings: list[list[tuple[float, float, float]]],
   304	    region: str,
   305	    material: bpy.types.Material,
   306	    cap_start: bool = True,
   307	    cap_end: bool = True,
   308	    damage_group: str | None = None,
   309	    smooth: bool = False,
   310	) -> bpy.types.Object:
   311	    """Skin a stack of equal-length closed rings. The cheapest way to buy real hull form."""
   312	    count = len(rings[0])
   313	    assert all(len(ring) == count for ring in rings), "loft rings must be equal length"
   314	    vertices: list[tuple[float, float, float]] = []
   315	    for ring in rings:
   316	        vertices.extend(tuple(float(value) for value in point) for point in ring)
   317	    faces: list[tuple[int, ...]] = []
   318	    for index in range(len(rings) - 1):
   319	        base = index * count
   320	        nxt = base + count
   321	        for step in range(count):
   322	            following = (step + 1) % count
   323	            faces.append((base + step, base + following, nxt + following, nxt + step))
   324	    if cap_start:
   325	        faces.append(tuple(range(count - 1, -1, -1)))
   326	    if cap_end:
   327	        base = (len(rings) - 1) * count
   328	        faces.append(tuple(range(base, base + count)))
   329	    return from_pydata(name, vertices, faces, region, material, 0.0, damage_group, smooth)
