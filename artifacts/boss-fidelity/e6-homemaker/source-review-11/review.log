    35	def load(name: str, path: Path):
    36	    spec = importlib.util.spec_from_file_location(name, path)
    37	    module = importlib.util.module_from_spec(spec)
    38	    assert spec.loader is not None
    39	    sys.modules[name] = module
    40	    spec.loader.exec_module(module)
    41	    return module
