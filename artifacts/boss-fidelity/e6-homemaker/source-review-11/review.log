   726	def world_bounds(objects: tuple[bpy.types.Object, ...]) -> tuple[Vector, Vector]:
   727	    points = [obj.matrix_world @ vertex.co for obj in objects for vertex in obj.data.vertices]
   728	    return (
   729	        Vector((min(point.x for point in points), min(point.y for point in points), min(point.z for point in points))),
   730	        Vector((max(point.x for point in points), max(point.y for point in points), max(point.z for point in points))),
   731	    )
