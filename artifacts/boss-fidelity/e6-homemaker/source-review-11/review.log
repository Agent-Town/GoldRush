   425	def main() -> None:
   426	    HERE.mkdir(parents=True, exist_ok=True)
   427	    dq.reset_scene()
   428	    atlas = create_atomic_atlas()
   429	    material = dq.create_material(atlas)
   430	    material.name = "Homemaker9000PaintedMaterial"
   431	    groups={"vac":build_vac(material),"rack":build_rack(material),"core":build_core(material)}
   432	    for parts in groups.values():
   433	        for part in parts:
   434	            if any(word in part.name.lower() for word in ("rim", "cage", "bristle", "ray", "rail")):
   435	                for modifier in list(part.modifiers):
   436	                    if modifier.type=="BEVEL":part.modifiers.remove(modifier)
   437	    vac,rack,core=(dq.join_component(name,groups[name],material) for name in ("vac","rack","core"))
   438	    objects = (vac, rack, core)
   439	    dq.MODEL_LENGTH = MODEL_LENGTH
   440	    dq.normalize_base_center(objects)
   441	    add_damage_shapes(*objects)
   442	    recenter_shape_keyed_basis(objects)
   443	
   444	
   445	    triangles = dq.triangle_count(objects)
   446	    minimum, maximum = shape_basis_bounds(objects)
   447	    assert triangles <= 12_000
   448	    assert abs(maximum.x - minimum.x - MODEL_LENGTH) < 0.01
   449	    assert abs(minimum.z) < 0.001
   450	    assert abs((maximum.x + minimum.x) * 0.5) < 0.001
   451	    assert abs((maximum.y + minimum.y) * 0.5) < 0.001
   452	    dq.BLEND, dq.GLB = BLEND, GLB
   453	    dq.export(objects)
   454	    print(json.dumps({
   455	        "blend": str(BLEND), "glb": str(GLB), "sha256": hashlib.sha256(GLB.read_bytes()).hexdigest(),
   456	        "sourcePlate": {str(REFERENCE.relative_to(ROOT)): hashlib.sha256(REFERENCE.read_bytes()).hexdigest()},
   457	        "components": [obj.name for obj in objects],
   458	        "damageMorphs": [obj.data.shape_keys.key_blocks[1].name for obj in objects],
   459	        "triangles": triangles,
   460	        "boundsBlender": {"min": [round(v, 6) for v in minimum], "max": [round(v, 6) for v in maximum]},
   461	    }, indent=2))
   462	
   463	
   464	if __name__ == "__main__":
   465	    main()
