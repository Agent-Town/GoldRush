   413	def shape_basis_bounds(objects: tuple[bpy.types.Object, ...]) -> tuple[Vector, Vector]:
   414	    points = [
   415	        point.co
   416	        for obj in objects
   417	        for point in obj.data.shape_keys.key_blocks["Basis"].data
   418	    ]
   419	    return (
   420	        Vector(tuple(min(point[axis] for point in points) for axis in range(3))),
   421	        Vector(tuple(max(point[axis] for point in points) for axis in range(3))),
   422	    )
