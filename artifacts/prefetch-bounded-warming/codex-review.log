   223	export function bindPerformanceTierControl(root: ParentNode, id: string): () => void {
   224	  const select = root.querySelector<HTMLSelectElement>(`[data-testid="${id}"]`);
   225	  if (!select) return () => undefined;
   226	
   227	  const sync = () => {
   228	    select.value = readPerformanceTierOverride();
   229	  };
   230	  const onChange = () => savePerformanceTierOverride(normalizePerformanceTierOverride(select.value) ?? 'auto');
   231	  select.addEventListener('change', onChange);
   232	  listeners.add(sync);
   233	  sync();
   234	
   235	  return () => {
   236	    select.removeEventListener('change', onChange);
   237	    listeners.delete(sync);
   238	  };
   239	}
