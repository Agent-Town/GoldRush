   131	const listeners = new Set<() => void>();
   132	let lastDiagnostics: PerformanceTierDiagnostics | null = null;
   133	
   134	export function applyStoredPerformanceTier(contractId: string | null = currentContractId()): PerformanceTierDiagnostics {
   135	  const override = readPerformanceTierOverride();
   136	  const detected = detectPerformanceTier();
   137	  const runtimeVerdict = readRuntimePerformanceVerdict(contractId);
   138	  const selectedTier = override === 'auto' ? detected.tier : override;
   139	  const tier = runtimeVerdict >= 3 ? 'lite' : selectedTier;
   140	  const baseConfig = PERFORMANCE_TIER_CONFIGS[tier];
   141	  const config = runtimeVerdict >= 1
   142	    ? { ...baseConfig, shadowsQuality: 'blob' as const, shadowMapSize: 0 }
   143	    : baseConfig;
   144	  const diagnostics: PerformanceTierDiagnostics = {
   145	    tier,
   146	    override,
   147	    source: override === 'auto' ? 'auto' : 'override',
   148	    reason: `${override === 'auto' ? detected.reason : 'settings override'}${runtimeVerdict ? `; runtime fallback ${runtimeVerdict}` : ''}`,
   149	    gpuRenderer: detected.gpuRenderer,
   150	    deviceMemory: detected.deviceMemory,
   151	    userAgent: detected.userAgent,
   152	    config,
   153	    runtimeVerdict,
   154	  };
   155	  applyPerformanceTierConfig(diagnostics.config);
   156	  lastDiagnostics = diagnostics;
   157	  console.info('[gold-rush] performance tier', diagnostics);
   158	  return diagnostics;
   159	}
   160	
   161	export function performanceTierDiagnostics(): PerformanceTierDiagnostics {
   162	  return lastDiagnostics ?? applyStoredPerformanceTier();
   163	}
   164	
   165	export function readPerformanceTierOverride(): PerformanceTierOverride {
   166	  const params = new URLSearchParams(getSearch());
   167	  const raw = params.get('tier') ?? params.get('performance') ?? params.get('quality');
   168	  const fromSearch = normalizePerformanceTierOverride(raw);
   169	  if (fromSearch) {
   170	    savePerformanceTierOverride(fromSearch);
   171	    return fromSearch;
   172	  }
   173	  return normalizePerformanceTierOverride(readStoredOverride()) ?? 'auto';
   174	}
   175	
   176	export function savePerformanceTierOverride(value: PerformanceTierOverride): PerformanceTierOverride {
   177	  if (readStoredOverride() === value) return value;
   178	  try {
   179	    globalThis.localStorage?.setItem(PERFORMANCE_TIER_STORAGE_KEY, value);
   180	  } catch {}
   181	  notify();
   182	  return value;
   183	}
   184	
   185	export function readRuntimePerformanceVerdict(contractId: string | null = currentContractId()): RuntimePerformanceVerdict {
   186	  if (!contractId) return 0;
   187	  try {
   188	    const stored = JSON.parse(globalThis.sessionStorage?.getItem(RUNTIME_PERFORMANCE_VERDICTS_STORAGE_KEY) ?? '{}') as Record<string, unknown>;
   189	    const value = Number(stored[contractId]);
   190	    return value === 1 || value === 2 || value === 3 ? value : 0;
   191	  } catch {
   192	    return 0;
   193	  }
   194	}
   195	
   196	export function saveRuntimePerformanceVerdict(contractId: string, verdict: RuntimePerformanceVerdict): RuntimePerformanceVerdict {
   197	  const current = readRuntimePerformanceVerdict(contractId);
   198	  const next = Math.max(current, verdict) as RuntimePerformanceVerdict;
   199	  if (next === current) return current;
   200	  try {
   201	    const stored = JSON.parse(globalThis.sessionStorage?.getItem(RUNTIME_PERFORMANCE_VERDICTS_STORAGE_KEY) ?? '{}') as Record<string, unknown>;
   202	    globalThis.sessionStorage?.setItem(RUNTIME_PERFORMANCE_VERDICTS_STORAGE_KEY, JSON.stringify({ ...stored, [contractId]: next }));
   203	  } catch {}
   204	  if (lastDiagnostics) lastDiagnostics.runtimeVerdict = next;
   205	  return next;
   206	}
