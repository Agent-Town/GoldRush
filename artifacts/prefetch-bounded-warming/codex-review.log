   273	      } else if (this.settingsOpen) {
   274	        this.settingsOpen = false;
   275	        this.render();
   276	        this.root.querySelector<HTMLElement>('[data-testid="start-menu-settings"]')?.focus({ preventScroll: true });
   277	      }
   278	      return;
   279	    }
   280	    if (event.target instanceof HTMLInputElement) return;
   281	    if (event.key === 'ArrowDown') {
   282	      event.preventDefault();
   283	      this.focusAction(1);
   284	    }
   285	    if (event.key === 'ArrowUp') {
   286	      event.preventDefault();
   287	      this.focusAction(-1);
   288	    }
   289	  };
