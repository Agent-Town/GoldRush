   241	function detectPerformanceTier(): Omit<PerformanceTierDiagnostics, 'override' | 'source' | 'config' | 'runtimeVerdict'> {
   242	  const userAgent = getUserAgent();
   243	  const deviceMemory = getDeviceMemory();
   244	  const gpuRenderer = readGpuRenderer();
   245	  const iosFamily = /iPad|iPhone|iPod/i.test(userAgent) || (/Macintosh/i.test(userAgent) && getMaxTouchPoints() > 1);
   246	
   247	  if (iosFamily) return { tier: 'lite', reason: 'iPad/iOS user agent', gpuRenderer, deviceMemory, userAgent };
   248	  if (deviceMemory !== null && deviceMemory <= 3) return { tier: 'lite', reason: `deviceMemory ${deviceMemory}GB`, gpuRenderer, deviceMemory, userAgent };
   249	  if (/apple a\d|adreno [0-5]\d{2}|mali-|powervr/i.test(gpuRenderer)) {
   250	    return { tier: 'lite', reason: `mobile-class GPU: ${gpuRenderer}`, gpuRenderer, deviceMemory, userAgent };
   251	  }
   252	  if (deviceMemory !== null && deviceMemory <= 6) return { tier: 'balanced', reason: `deviceMemory ${deviceMemory}GB`, gpuRenderer, deviceMemory, userAgent };
   253	  if (/swiftshader|llvmpipe|software|intel\(r\).*uhd|intel\(r\).*hd/i.test(gpuRenderer)) {
