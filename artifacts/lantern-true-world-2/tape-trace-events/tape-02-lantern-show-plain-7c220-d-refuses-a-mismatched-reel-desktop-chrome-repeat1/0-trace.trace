ary {\n  display: block;\n  list-style: none;\n}\n\n.town-ui__settings > summary::-webkit-details-marker {\n  display: none;\n}\n\n.town-ui__settings-panel {\n  position: fixed;\n  top: calc(max(14px, env(safe-area-inset-top)) + 54px);\n  right: max(14px, env(safe-area-inset-right));\n  display: grid;\n  gap: 12px;\n  width: min(320px, calc(100vw - 28px));\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  padding: 14px;\n  color: #2e1b0e;\n  background: rgba(245, 230, 200, 0.98);\n  box-shadow: 0 6px 0 rgba(46, 27, 14, 0.62), 0 18px 32px rgba(46, 27, 14, 0.3);\n}\n\n.town-ui__settings-panel h2 {\n  margin: 0;\n  font-size: 1.1rem;\n}\n\n.town-ui__settings-panel label {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 6px 10px;\n  font-weight: 900;\n}\n\n.town-ui__settings-panel input[type='range'] {\n  grid-column: 1 / -1;\n  width: 100%;\n  accent-color: #5b8a8a;\n}\n\n.town-ui__settings-panel input[type='checkbox'] {\n  width: 24px;\n  height: 24px;\n  margin: 0;\n  accent-color: #5b8a8a;\n}\n\n.town-ui__prompt-stack {\n  position: absolute;\n  left: 50%;\n  bottom: calc(max(18px, env(safe-area-inset-bottom)) + 88px);\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  align-items: center;\n  width: min(520px, calc(100vw - 32px));\n  transform: translateX(-50%);\n  pointer-events: none;\n}\n\n.town-ui__prompt {\n  width: max-content;\n  max-width: 100%;\n  margin: 0 auto;\n  padding: 9px 13px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.92), rgba(245, 230, 200, 0.98)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 1px rgba(139, 125, 60, 0.36),\n    0 4px 0 rgba(46, 27, 14, 0.62),\n    0 12px 20px rgba(46, 27, 14, 0.22);\n  font: 900 0.88rem/1.15 Wellfleet, Georgia, serif;\n  text-align: center;\n  pointer-events: auto;\n}\n\n.town-ui__prompt[hidden] {\n  display: none;\n}\n\n.town-ui__bark {\n  display: grid;\n  grid-template-columns: 54px minmax(0, 1fr);\n  gap: 10px;\n  align-items: center;\n  width: min(420px, 100%);\n  border: 2px solid rgba(46, 27, 14, 0.88);\n  border-radius: 8px;\n  padding: 8px 10px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.97), rgba(245, 230, 200, 0.98)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 1px rgba(139, 125, 60, 0.34),\n    0 5px 0 rgba(46, 27, 14, 0.58),\n    0 14px 24px rgba(46, 27, 14, 0.24);\n  pointer-events: none;\n}\n\n.town-ui__bark:has(.town-ui__bark-action) {\n  pointer-events: auto;\n}\n\n.town-ui__bark[hidden] {\n  display: none;\n}\n\n.town-ui__bark-portrait {\n  width: 54px;\n  height: 54px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  background: #e8d5a8;\n  object-fit: cover;\n}\n\n.town-ui__bark-copy {\n  display: grid;\n  gap: 2px;\n  min-width: 0;\n}\n\n.town-ui__bark-copy strong {\n  font-size: 0.82rem;\n  line-height: 1;\n}\n\n.town-ui__bark-copy span {\n  color: #5b8a8a;\n  font-size: 0.66rem;\n  font-weight: 900;\n  line-height: 1;\n  text-transform: uppercase;\n}\n\n.town-ui__bark-copy p {\n  margin: 3px 0 0;\n  color: rgba(46, 27, 14, 0.86);\n  font-size: 0.8rem;\n  font-weight: 900;\n  line-height: 1.18;\n}\n\n.town-ui__bark-action {\n  justify-self: start;\n  min-height: 34px;\n  margin-top: 4px;\n  border: 2px solid #2e1b0e;\n  border-radius: 7px;\n  padding: 6px 10px;\n  color: #fff8e8;\n  background: #5b8a8a;\n  font: 900 0.78rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n  pointer-events: auto;\n}\n\n.town-ui__prompt-button {\n  margin-left: 10px;\n  border: 2px solid #2e1b0e;\n  border-radius: 7px;\n  padding: 5px 9px;\n  color: #fff8e8;\n  background: #5b8a8a;\n  font: 900 0.78rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n[data-testid='raise-stamp-mill-site'] {\n  min-height: 44px;\n}\n\n.town-ui__board {\n  position: absolute;\n  inset: 0;\n  z-index: 3;\n  display: grid;\n  place-items: center;\n  padding: max(18px, env(safe-area-inset-top)) max(14px, env(safe-area-inset-right)) max(18px, env(safe-area-inset-bottom)) max(14px, env(safe-area-inset-left));\n  pointer-events: auto;\n}\n\n.town-ui__board[hidden] {\n  display: none;\n}\n\n.town-ui__surface {\n  position: absolute;\n  inset: 0;\n  z-index: 3;\n  display: grid;\n  place-items: center;\n  padding: max(18px, env(safe-area-inset-top)) max(14px, env(safe-area-inset-right)) max(18px, env(safe-area-inset-bottom)) max(14px, env(safe-area-inset-left));\n  background: rgba(46, 27, 14, 0.42);\n  pointer-events: none;\n}\n\n.town-ui__era-backdrop {\n  position: absolute;\n  inset: 0;\n  background: #2e1b0e center / cover no-repeat;\n  pointer-events: none;\n}\n\n.town-ui__era-backdrop::after {\n  position: absolute;\n  inset: 0;\n  content: \"\";\n  background: radial-gradient(ellipse at center, rgba(35, 22, 12, 0.2) 0 30%, rgba(20, 14, 10, 0.82) 100%);\n}\n\n.town-ui__surface[hidden] {\n  display: none;\n}\n\n.town-ui__surface-shell {\n  /* above the absolutely-positioned era backdrop, or the panel chrome (header,\n     era tabs, branch labels) paints underneath the plate (owner, 2026-07-13) */\n  position: relative;\n  z-index: 1;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  width: min(1180px, calc(100vw - 28px));\n  max-height: min(760px, calc(100vh - 28px));\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background: rgba(245, 230, 200, 0.97);\n  pointer-events: auto;\n  box-shadow:\n    inset 0 0 0 1px rgba(255, 248, 232, 0.68),\n    0 7px 0 rgba(46, 27, 14, 0.68),\n    0 22px 48px rgba(46, 27, 14, 0.42);\n  overflow: hidden;\n}\n\n.town-ui__surface-header {\n  display: flex;\n  align-items: start;\n  justify-content: space-between;\n  gap: 14px;\n  padding: 14px 16px 12px;\n  border-bottom: 2px solid rgba(46, 27, 14, 0.58);\n  background: rgba(255, 248, 232, 0.64);\n}\n\n.town-ui__surface-header h2 {\n  margin: 0;\n  font-size: 1.55rem;\n  line-height: 1.05;\n}\n\n.town-ui__surface-body {\n  min-height: 0;\n  padding: 14px;\n  overflow: auto;\n  overscroll-behavior: contain;\n  -webkit-overflow-scrolling: touch;\n}\n\n.town-ui__wardrobe-shell {\n  width: min(760px, calc(100vw - 28px));\n}\n\n.town-ui__wardrobe-copy {\n  margin: 0 0 14px;\n}\n\n.town-ui__wardrobe-racks {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n}\n\n.town-ui__wardrobe-rack {\n  display: grid;\n  gap: 10px;\n  min-width: 0;\n  padding: 16px;\n  border: 3px double rgba(46, 27, 14, 0.72);\n  border-radius: 8px;\n  background:\n    linear-gradient(rgba(255, 248, 232, 0.8), rgba(232, 213, 168, 0.74)),\n    repeating-linear-gradient(90deg, transparent 0 18px, rgba(139, 125, 60, 0.09) 18px 20px);\n  box-shadow: inset 0 0 0 2px rgba(139, 125, 60, 0.2);\n}\n\n.town-ui__wardrobe-rack label {\n  display: grid;\n  gap: 8px;\n  font-weight: 900;\n}\n\n.town-ui__wardrobe-rack select {\n  width: 100%;\n  min-height: 48px;\n  border: 2px solid #2e1b0e;\n  border-radius: 7px;\n  padding: 8px;\n  color: #2e1b0e;\n  background: #fff8e8;\n  font: 900 0.9rem/1.2 Wellfleet, Georgia, serif;\n}\n\n.town-ui__wardrobe-preview {\n  display: grid;\n  grid-template-rows: minmax(0, 176px) auto;\n  min-width: 0;\n  margin: 0;\n  border: 3px double #8b7d3c;\n  border-radius: 6px;\n  color: #2e1b0e;\n  background:\n    radial-gradient(circle at 50% 42%, rgba(255, 248, 232, 0.96), rgba(232, 213, 168, 0.72)),\n    #f5e6c8;\n  overflow: hidden;\n}\n\n.town-ui__wardrobe-preview img {\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  object-fit: contain;\n  filter: drop-shadow(0 6px 4px rgba(46, 27, 14, 0.28));\n}\n\n.town-ui__wardrobe-preview figcaption {\n  display: grid;\n  gap: 2px;\n  padding: 8px 10px;\n  border-top: 2px solid rgba(46, 27, 14, 0.52);\n  background: rgba(255, 248, 232, 0.82);\n  text-align: center;\n}\n\n.town-ui__wardrobe-preview figcaption span {\n  color: #315f61;\n  font-size: 0.72rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.town-ui__wardrobe-preview[data-preview-state='at-tailors'] figcaption span {\n  color: #a0522d;\n}\n\n.town-ui__epoch-door {\n  margin: 16px auto 2px;\n  padding: 18px;\n  border: 2px solid #5b8a8a;\n  border-radius: 8px;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.96), rgba(196, 136, 58, 0.24)),\n    repeating-linear-gradient(90deg, transparent 0 18px, rgba(139, 125, 60, 0.1) 18px 20px);\n  box-shadow: inset 0 0 0 2px rgba(139, 125, 60, 0.22), 0 8px 20px rgba(46, 27, 14, 0.18);\n  text-align: center;\n}\n\n.town-ui__epoch-door h3,\n.town-ui__epoch-door p {\n  margin: 4px 0 10px;\n}\n\n.town-ui__epoch-door button {\n  min-width: min(100%, 320px);\n  min-height: 48px;\n  border: 2px solid #2e1b0e;\n  border-radius: 7px;\n  color: #fff8e8;\n  background: #5b8a8a;\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.62);\n  font: 900 1rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.town-ui__epoch-door button:focus-visible {\n  outline: 3px solid #ffe4a0;\n  outline-offset: 3px;\n}\n\n.town-ui__board-backdrop {\n  position: absolute;\n  inset: 0;\n  background: #2e1b0e center / cover no-repeat;\n}\n\n.town-ui__board-backdrop::after {\n  position: absolute;\n  inset: 0;\n  content: \"\";\n  background:\n    linear-gradient(90deg, rgba(46, 27, 14, 0.42), rgba(46, 27, 14, 0.12) 44%, rgba(46, 27, 14, 0.48)),\n    linear-gradient(0deg, rgba(46, 27, 14, 0.62), rgba(46, 27, 14, 0.12) 42%, rgba(46, 27, 14, 0.36));\n}\n\n.town-ui__board-shell {\n  position: relative;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr) auto auto;\n  width: min(1040px, calc(100vw - 28px));\n  max-height: min(760px, calc(100vh - 28px));\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background: rgba(245, 230, 200, 0.94);\n  box-shadow:\n    inset 0 0 0 1px rgba(255, 248, 232, 0.68),\n    0 7px 0 rgba(46, 27, 14, 0.68),\n    0 22px 48px rgba(46, 27, 14, 0.42);\n  overflow: hidden;\n}\n\n.town-ui__board-header {\n  display: flex;\n  align-items: start;\n  justify-content: space-between;\n  gap: 14px;\n  padding: 14px 16px 12px;\n  border-bottom: 2px solid rgba(46, 27, 14, 0.58);\n  background: rgba(255, 248, 232, 0.64);\n}\n\n.town-ui__board-host {\n  flex: 0 0 auto;\n  width: 62px;\n  height: 62px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  background: #e8d5a8;\n  object-fit: cover;\n  object-position: 52% 42%;\n}\n\n.town-ui__board-eyebrow {\n  margin: 0 0 4px;\n  color: #5b8a8a;\n  font-size: 0.76rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.town-ui__board-header h2 {\n  margin: 0;\n  font-size: 1.55rem;\n  line-height: 1.05;\n}\n\n.town-ui__board-close,\n.town-ui__contract-action {\n  min-height: 44px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  font: 900 0.9rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.town-ui__board-close {\n  padding: 9px 13px;\n  color: #2e1b0e;\n  background: #ffe4a0;\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.5);\n}\n\n.town-ui__contracts {\n  display: grid;\n  grid-template-columns: 50px minmax(0, 1fr) 50px;\n  align-items: center;\n  gap: 14px;\n  min-height: 0;\n  padding: 16px;\n  overflow: auto;\n  overscroll-behavior: contain;\n  touch-action: pan-y;\n  -webkit-overflow-scrolling: touch;\n}\n\n.town-ui__board-sections {\n  display: grid;\n  align-self: start;\n  gap: 18px;\n  min-width: 0;\n}\n\n.town-ui__book-chapter {\n  align-self: start;\n  min-width: 0;\n  border: 2px solid rgba(46, 27, 14, 0.82);\n  border-top: 6px solid var(--town-era-accent, #ffe4a0);\n  border-radius: 8px;\n  background: rgba(245, 230, 200, 0.88);\n  overflow: hidden;\n}\n\n.town-ui__chapter-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 10px 14px;\n  border-bottom: 2px solid rgba(46, 27, 14, 0.42);\n  background: color-mix(in srgb, var(--town-era-accent, #ffe4a0) 28%, #fff8e8);\n}\n\n.town-ui__chapter-header h3,\n.town-ui__chapter-header p {\n  margin: 0;\n}\n\n.town-ui__chapter-header h3 {\n  font-size: 1.4rem;\n  line-height: 1.05;\n}\n\n.town-ui__chapter-header > span {\n  font-size: 0.82rem;\n  font-weight: 900;\n}\n\n.town-ui__chapter-contracts {\n  display: grid;\n  gap: 12px;\n  padding: 12px;\n}\n\n.town-ui__training-ground {\n  display: grid;\n  gap: 10px;\n  border-top: 4px double rgba(91, 138, 138, 0.82);\n  padding-top: 14px;\n}\n\n.town-ui__training-ground-header {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 0 4px;\n}\n\n.town-ui__training-ground-header h3,\n.town-ui__training-ground-header span {\n  margin: 0;\n}\n\n.town-ui__training-ground-header h3 {\n  color: #355f5f;\n  font-size: 1.15rem;\n  letter-spacing: 0.08em;\n}\n\n.town-ui__training-ground-header span {\n  color: rgba(46, 27, 14, 0.7);\n  font-size: 0.76rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.town-ui__contract.town-ui__training-card {\n  border: 3px solid #5b8a8a;\n  background:\n    linear-gradient(135deg, rgba(236, 238, 207, 0.98), rgba(206, 222, 194, 0.98)),\n    #e4e3c2;\n  box-shadow:\n    inset 0 0 0 2px rgba(255, 248, 232, 0.68),\n    0 3px 0 rgba(53, 95, 95, 0.6);\n}\n\n.town-ui__training-card .town-ui__contract-tag {\n  background: #8b7d3c;\n}\n\n.town-ui__training-card .town-ui__contract-state {\n  background: #d7e5c6;\n}\n\n.town-ui__training-card .town-ui__contract-action {\n  background: #8b7d3c;\n}\n\n.town-ui__catalog-arrow {\n  width: 50px;\n  min-height: 72px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background: rgba(255, 228, 160, 0.92);\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.5);\n  font: 900 2rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.town-ui__catalog-arrow:disabled {\n  opacity: 0.38;\n  box-shadow: none;\n  cursor: not-allowed;\n}\n\n.town-ui__contract {\n  display: grid;\n  grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.1fr);\n  gap: 14px;\n  min-height: 0;\n  border: 2px solid rgba(46, 27, 14, 0.82);\n  border-radius: 8px;\n  padding: 14px;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.96), rgba(232, 213, 168, 0.98)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 1px rgba(139, 125, 60, 0.3),\n    0 2px 0 rgba(46, 27, 14, 0.46);\n}\n\n.town-ui__contract--locked {\n  background:\n    linear-gradient(135deg, rgba(232, 213, 168, 0.9), rgba(174, 144, 93, 0.72)),\n    #e8d5a8;\n}\n\n.town-ui__contract-art {\n  position: relative;\n  min-height: 190px;\n  margin: 0;\n  border: 2px solid rgba(46, 27, 14, 0.74);\n  border-radius: 8px;\n  background:\n    radial-gradient(circle at 24% 22%, rgba(255, 228, 160, 0.35), transparent 34%),\n    linear-gradient(135deg, #f5e6c8, #b98249 52%, #5b8a8a);\n  box-shadow: inset 0 0 0 1px rgba(255, 248, 232, 0.54);\n  overflow: hidden;\n}\n\n.town-ui__contract-art::before,\n.town-ui__contract-art::after {\n  position: absolute;\n  inset: 0;\n  content: \"\";\n  pointer-events: none;\n}\n\n.town-ui__contract-art::before {\n  background:\n    linear-gradient(90deg, rgba(46, 27, 14, 0.18), transparent 36%, rgba(46, 27, 14, 0.22)),\n    repeating-linear-gradient(135deg, rgba(46, 27, 14, 0.08) 0 1px, transparent 1px 8px);\n  mix-blend-mode: multiply;\n}\n\n.town-ui__contract-art::after {\n  box-shadow: inset 0 -56px 76px rgba(46, 27, 14, 0.34);\n}\n\n/* Interim map renders wear parchment until their engraved plate arrives (one book, owner 2026-07-20). */\n.town-ui__contract-art-image--interim {\n  filter: sepia(0.55) saturate(0.72) contrast(0.94) brightness(1.04);\n}\n.town-ui__contract-art-image--interim + .town-ui__contract-art-inset,\nfigure:has(> .town-ui__contract-art-image--interim)::after {\n  content: '';\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: radial-gradient(ellipse at center, rgba(112, 84, 48, 0) 55%, rgba(92, 66, 34, 0.28) 100%);\n  mix-blend-mode: multiply;\n}\n\n.town-ui__contract-art-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  filter: saturate(0.92) sepia(0.08);\n}\n\n.town-ui__contract-art-inset {\n  position: absolute;\n  right: 18px;\n  bottom: 12px;\n  width: min(27%, 132px);\n  max-height: 78%;\n  object-fit: contain;\n  filter: drop-shadow(0 7px 8px rgba(46, 27, 14, 0.46));\n}\n\n.town-ui__contract-art--dusk-lantern {\n  background:\n    radial-gradient(circle at 72% 46%, rgba(255, 228, 160, 0.52), transparent 18%),\n    linear-gradient(135deg, #2e3142, #5b6572 52%, #2e1b0e);\n}\n\n.town-ui__contract-art--dusk-lantern .town-ui__contract-art-image,\n.town-ui__contract-art--kit-the-baron .town-ui__contract-art-image {\n  object-fit: contain;\n  padding: 14px;\n}\n\n.town-ui__contract-art--kit-the-baron {\n  background:\n    radial-gradient(circle at 48% 46%, rgba(255, 228, 160, 0.38), transparent 32%),\n    linear-gradient(135deg, #7f2633, #b98249 48%, #2e1b0e);\n}\n\n.town-ui__contract-art--steam-terraces {\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.34), transparent 42%),\n    repeating-linear-gradient(168deg, rgba(46, 27, 14, 0.28) 0 4px, transparent 4px 24px),\n    repeating-linear-gradient(0deg, #8b7d3c 0 24px, #5b8a8a 24px 31px, #b98249 31px 54px);\n}\n\n.town-ui__contract--locked .town-ui__contract-art {\n  filter: grayscale(0.65) sepia(0.2);\n}\n\n.town-ui__contract--locked .town-ui__contract-art::before {\n  background:\n    linear-gradient(90deg, rgba(46, 27, 14, 0.32), rgba(255, 248, 232, 0.12), rgba(46, 27, 14, 0.38)),\n    repeating-linear-gradient(135deg, rgba(46, 27, 14, 0.16) 0 2px, transparent 2px 10px);\n}\n\n.town-ui__contract-copy {\n  display: flex;\n  flex-direction: column;\n  gap: 11px;\n  min-width: 0;\n}\n\n.town-ui__contract-topline {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  min-height: 26px;\n}\n\n.town-ui__contract-tag,\n.town-ui__contract-state {\n  border: 1px solid rgba(46, 27, 14, 0.52);\n  border-radius: 6px;\n  padding: 4px 7px;\n  font-size: 0.7rem;\n  font-weight: 900;\n  line-height: 1;\n}\n\n.town-ui__contract-tag {\n  color: #fff8e8;\n  background: #5b8a8a;\n}\n\n.town-ui__contract-state {\n  color: #2e1b0e;\n  background: #ffe4a0;\n}\n\n.town-ui__contract h3,\n.town-ui__contract p {\n  margin: 0;\n}\n\n.town-ui__contract h3 {\n  font-size: 2rem;\n  line-height: 1.1;\n}\n\n.town-ui__contract p {\n  color: rgba(46, 27, 14, 0.78);\n  font-size: 0.94rem;\n  line-height: 1.34;\n}\n\n.town-ui__contract-flavor {\n  max-width: 68ch;\n  color: rgba(46, 27, 14, 0.84) !important;\n  font-size: 1rem !important;\n  font-weight: 800;\n}\n\n.town-ui__contract-briefing {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  align-content: start;\n  gap: 12px;\n  min-width: 0;\n}\n\n.town-ui__contract-briefing section {\n  display: grid;\n  align-content: start;\n  gap: 6px;\n  min-width: 0;\n  border: 1px solid rgba(46, 27, 14, 0.22);\n  border-radius: 8px;\n  padding: 10px;\n  background: rgba(255, 248, 232, 0.4);\n}\n\n.town-ui__contract-briefing-label {\n  color: #5b8a8a !important;\n  font-size: 0.66rem !important;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.town-ui__contract-briefing-geography {\n  grid-column: 1 / -1;\n  color: rgba(46, 27, 14, 0.78) !important;\n  font-size: 0.86rem !important;\n  font-weight: 900;\n}\n\n.town-ui__contract-briefing ul {\n  display: grid;\n  gap: 5px;\n  margin: 0;\n  padding-left: 1rem;\n  color: rgba(46, 27, 14, 0.84);\n  font-size: 0.82rem;\n  font-weight: 800;\n  line-height: 1.28;\n}\n\n.town-ui__contract-best {\n  min-height: 1.4em;\n  font-weight: 900;\n}\n\n.town-ui__contract-best:not(.town-ui__contract-medal) {\n  margin-top: 4px;\n}\n\n.town-ui__contract-stakes,\n.town-ui__contract-medal,\n.town-ui__contract-lock,\n.town-ui__contract-teaser {\n  align-self: stretch;\n  padding: 6px 8px;\n  border: 1px solid rgba(127, 38, 51, 0.42);\n  border-radius: 6px;\n  background: rgba(127, 38, 51, 0.1);\n}\n\n.town-ui__contract-medal {\n  min-height: auto;\n  color: #7f2633;\n}\n\n.town-ui__contract-lock {\n  color: #7f2633 !important;\n  background: rgba(127, 38, 51, 0.12);\n  font-size: 1.35rem !important;\n  font-weight: 900;\n}\n\n.town-ui__contract-teaser {\n  border-color: rgba(91, 138, 138, 0.42);\n  color: rgba(46, 27, 14, 0.76) !important;\n  background: rgba(91, 138, 138, 0.11);\n  font-weight: 900;\n}\n\n.town-ui__contract-action {\n  width: 100%;\n  margin-top: auto;\n  padding: 9px 10px;\n  color: #fff8e8;\n  background: #5b8a8a;\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.55);\n}\n\n.town-ui__contract-action[data-first-claim-launch=\"true\"] {\n  animation: town-first-claim-button 1.55s ease-in-out infinite;\n}\n\n.town-ui__first-claim-tooltip {\n  align-self: center;\n  width: max-content;\n  max-width: 100%;\n  padding: 5px 8px;\n  border: 1px solid rgba(46, 27, 14, 0.36);\n  border-radius: 6px;\n  color: #2e1b0e !important;\n  background: rgba(255, 228, 160, 0.78);\n  font-size: 0.78rem !important;\n  font-weight: 900;\n  line-height: 1.1 !important;\n}\n\n.town-ui__contract-action:disabled {\n  color: rgba(46, 27, 14, 0.76);\n  background: #d6b478;\n  box-shadow: none;\n  cursor: not-allowed;\n}\n\n@keyframes town-first-claim-button {\n  0%,\n  100% {\n    box-shadow: 0 4px 0 rgba(46, 27, 14, 0.55), 0 0 0 rgba(255, 228, 160, 0);\n  }\n  50% {\n    box-shadow: 0 5px 0 rgba(46, 27, 14, 0.5), 0 0 18px rgba(255, 228, 160, 0.72);\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .town-ui__contract-action[data-first-claim-launch=\"true\"] {\n    animation: none;\n  }\n}\n\n.town-ui__catalog-nav {\n  display: flex;\n  min-width: 0;\n  align-items: center;\n  justify-content: center;\n  gap: 14px;\n  padding: 0 16px 14px;\n  overflow: hidden;\n}\n\n.town-ui__ride-card {\n  margin: 0 16px 16px;\n  border: 2px solid rgba(46, 27, 14, 0.82);\n  border-radius: 8px;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.96), rgba(214, 180, 120, 0.9)),\n    #f5e6c8;\n  box-shadow: inset 0 0 0 1px rgba(139, 125, 60, 0.32);\n}\n\n.town-ui__ride-toggle {\n  display: flex;\n  min-height: 44px;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  padding: 8px 12px;\n  color: #2e1b0e;\n  font: 900 0.86rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n  list-style: none;\n}\n\n.town-ui__ride-toggle::-webkit-details-marker {\n  display: none;\n}\n\n.town-ui__ride-toggle:focus-visible {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: -3px;\n}\n\n.town-ui__ride-body {\n  display: grid;\n  grid-template-columns: minmax(0, 1.2fr) auto minmax(180px, 0.75fr);\n  align-items: center;\n  gap: 12px;\n  padding: 0 12px 12px;\n}\n\n.town-ui__ride-card h3,\n.town-ui__ride-card p {\n  margin: 0;\n}\n\n.town-ui__ride-card h3 {\n  color: #2e1b0e;\n  font-size: 1.18rem;\n  line-height: 1.05;\n}\n\n.town-ui__ride-card p {\n  color: rgba(46, 27, 14, 0.78);\n  font-size: 0.82rem;\n  font-weight: 900;\n  line-height: 1.25;\n}\n\n.town-ui__ride-actions,\n.town-ui__ride-join {\n  display: grid;\n  gap: 8px;\n}\n\n.town-ui__ride-agent {\n  display: grid;\n  grid-column: 1 / -1;\n  gap: 6px;\n}\n\n.town-ui__ride-agent-command {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 8px;\n}\n\n.town-ui__ride-agent-command textarea {\n  min-width: 0;\n  resize: none;\n  border: 2px solid rgba(46, 27, 14, 0.58);\n  border-radius: 8px;\n  padding: 8px;\n  color: #2e1b0e;\n  background: rgba(255, 248, 232, 0.88);\n  font: 700 0.76rem/1.3 ui-monospace, SFMono-Regular, Menlo, monospace;\n}\n\n.town-ui__ride-code {\n  min-width: 0;\n  border: 2px dashed rgba(46, 27, 14, 0.58);\n  border-radius: 8px;\n  padding: 10px;\n  color: #2e1b0e;\n  background: rgba(255, 248, 232, 0.68);\n  font: 900 0.92rem/1.15 Wellfleet, Georgia, serif;\n  overflow-wrap: anywhere;\n  text-align: center;\n}\n\n.town-ui__ride-code--empty {\n  color: rgba(46, 27, 14, 0.58);\n}\n\n.town-ui__ride-status {\n  grid-column: 1 / -1;\n  min-height: 1.2em;\n}\n\n.town-ui__catalog-count {\n  min-width: 52px;\n  font-size: 0.82rem;\n  font-weight: 900;\n  text-align: center;\n}\n\n.town-ui__catalog-dots {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 4px;\n}\n\n.town-ui__chapter-tabs {\n  display: flex;\n  flex: 1 1 0;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 6px;\n  min-width: 0;\n  max-width: 100%;\n  overflow-x: auto;\n  padding: 4px;\n  scrollbar-width: thin;\n}\n\n.town-ui__chapter-tab {\n  flex: 0 0 auto;\n  min-height: 44px;\n  border: 2px solid rgba(46, 27, 14, 0.72);\n  border-radius: 7px;\n  padding: 7px 10px;\n  color: #2e1b0e;\n  background: rgba(255, 248, 232, 0.68);\n  font: 900 0.78rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.town-ui__chapter-tab[aria-current=\"page\"] {\n  color: #fff8e8;\n  background: #5b8a8a;\n}\n\n.town-ui__chapter-tab:hover,\n.town-ui__chapter-tab:focus-visible {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 2px;\n}\n\n.town-ui__catalog-dot {\n  position: relative;\n  display: grid;\n  place-items: center;\n  width: 32px;\n  height: 32px;\n  border: 0;\n  border-radius: 8px;\n  padding: 0;\n  background: transparent;\n  cursor: pointer;\n}\n\n.town-ui__catalog-dot::after {\n  width: 16px;\n  height: 16px;\n  border: 2px solid #2e1b0e;\n  border-radius: 999px;\n  background: rgba(255, 248, 232, 0.72);\n  content: \"\";\n}\n\n.town-ui__catalog-dot[aria-current=\"page\"]::after {\n  background: #5b8a8a;\n}\n\n.town-ui__catalog-dot--muted::after {\n  border-color: rgba(46, 27, 14, 0.45);\n  background: rgba(255, 248, 232, 0.3);\n  opacity: 0.58;\n}\n\n.town-ui__catalog-dot--muted[aria-current=\"page\"]::after {\n  background: rgba(91, 138, 138, 0.5);\n}\n\n.town-ui__board-close:hover,\n.town-ui__board-close:focus-visible,\n.town-ui__catalog-arrow:hover,\n.town-ui__catalog-arrow:focus-visible,\n.town-ui__catalog-dot:hover,\n.town-ui__catalog-dot:focus-visible,\n.town-ui__contract-action:hover,\n.town-ui__contract-action:focus-visible {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 3px;\n}\n\n.town-ui__catalog-dot:hover,\n.town-ui__catalog-dot:focus-visible {\n  outline: 0;\n}\n\n.town-ui__catalog-dot:hover::after,\n.town-ui__catalog-dot:focus-visible::after {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 3px;\n}\n\n.town-ui__name-card {\n  position: absolute;\n  inset: 0;\n  z-index: 1;\n  display: grid;\n  place-items: center;\n  padding: max(18px, env(safe-area-inset-top)) max(14px, env(safe-area-inset-right)) max(18px, env(safe-area-inset-bottom)) max(14px, env(safe-area-inset-left));\n  background: rgba(46, 27, 14, 0.28);\n  pointer-events: none;\n}\n\n.town-ui__name-card[hidden] {\n  display: none;\n}\n\n.town-ui__name-panel {\n  width: min(430px, calc(100vw - 28px));\n  padding: 16px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.96), rgba(245, 230, 200, 0.99)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 1px rgba(139, 125, 60, 0.36),\n    0 6px 0 rgba(46, 27, 14, 0.62),\n    0 18px 34px rgba(46, 27, 14, 0.28);\n  pointer-events: auto;\n}\n\n.town-ui__name-eyebrow,\n.town-ui__name-rule,\n.town-ui__name-error,\n.town-ui__name-beat {\n  margin: 0;\n}\n\n.town-ui__name-eyebrow {\n  color: #5b8a8a;\n  font-size: 0.78rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.town-ui__name-panel h2 {\n  margin: 6px 0 12px;\n  font-size: 1.45rem;\n  line-height: 1.08;\n}\n\n.town-ui__name-input {\n  width: 100%;\n  min-height: 44px;\n  box-sizing: border-box;\n  border: 2px solid #2e1b0e;\n  border-radius: 7px;\n  padding: 9px 10px;\n  color: #2e1b0e;\n  background: #fff8e8;\n  font: 900 16px/1.2 Wellfleet, Georgia, serif;\n}\n\n.town-ui__name-input:focus-visible,\n.town-ui__name-submit:focus-visible,\n.town-ui__prompt-button:focus-visible {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 3px;\n}\n\n.town-ui__name-rule {\n  margin-top: 7px;\n  color: rgba(46, 27, 14, 0.72);\n  font-size: 0.78rem;\n  line-height: 1.25;\n}\n\n.town-ui__name-error {\n  min-height: 1.2em;\n  margin-top: 8px;\n  color: #a0522d;\n  font-size: 0.86rem;\n  font-weight: 900;\n}\n\n.town-ui__name-beat {\n  margin-top: 8px;\n  color: #5b8a8a;\n  font-size: 0.95rem;\n  font-weight: 900;\n}\n\n.town-ui__name-submit {\n  width: 100%;\n  min-height: 44px;\n  margin-top: 12px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #fff8e8;\n  background: #5b8a8a;\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.62);\n  font: 900 0.95rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n@media (pointer: coarse), (max-width: 760px) {\n  .town-ui__prompt-stack {\n    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 154px);\n  }\n}\n\n@media (max-width: 430px) {\n  .town-ui__board,\n  .town-ui__surface {\n    align-items: stretch;\n  }\n\n  .town-ui__board-shell,\n  .town-ui__surface-shell {\n    width: calc(100vw - 20px);\n    max-height: calc(100vh - 20px);\n  }\n\n  .town-ui__board-header,\n  .town-ui__surface-header {\n    align-items: center;\n    padding: 8px 10px;\n  }\n\n  .town-ui__board-host {\n    width: 52px;\n    height: 52px;\n  }\n\n  .town-ui__board-eyebrow {\n    margin-bottom: 2px;\n    font-size: 0.68rem;\n  }\n\n  .town-ui__board-header h2 {\n    font-size: 1.34rem;\n    line-height: 1;\n  }\n\n  .town-ui__board-close {\n    min-height: 48px;\n    padding: 7px 10px;\n  }\n\n  .town-ui__wardrobe-racks {\n    grid-template-columns: 1fr;\n  }\n\n  .town-ui__wardrobe-rack {\n    padding: 12px;\n  }\n\n  .town-ui__wardrobe-preview {\n    grid-template-rows: minmax(0, 138px) auto;\n  }\n\n  .town-ui__contracts {\n    position: relative;\n    grid-template-columns: minmax(0, 1fr);\n    align-items: center;\n    gap: 8px;\n    padding: 8px;\n  }\n\n  .town-ui__chapter-header {\n    padding: 8px 10px;\n  }\n\n  .town-ui__chapter-header h3 {\n    font-size: 1.22rem;\n  }\n\n  .town-ui__chapter-contracts {\n    padding: 8px;\n  }\n\n  .town-ui__board-sections {\n    gap: 12px;\n  }\n\n  .town-ui__training-ground {\n    gap: 8px;\n    padding-top: 10px;\n  }\n\n  .town-ui__training-ground-header {\n    align-items: start;\n    flex-direction: column-reverse;\n    gap: 3px;\n  }\n\n  .town-ui__chapter-tabs {\n    flex-wrap: nowrap;\n    justify-content: flex-start;\n  }\n\n  .town-ui__catalog-arrow {\n    position: absolute;\n    z-index: 1;\n    top: 68px;\n    width: 42px;\n    min-height: 62px;\n    font-size: 1.55rem;\n  }\n\n  .town-ui__catalog-arrow--prev {\n    left: 12px;\n  }\n\n  .town-ui__catalog-arrow--next {\n    right: 12px;\n  }\n\n  .town-ui__contract {\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(120px, 18vh) auto;\n    gap: 8px;\n    min-height: 0;\n    padding: 8px;\n  }\n\n  .town-ui__contract.town-ui__training-card {\n    grid-template-rows: 120px auto;\n    gap: 6px;\n  }\n\n  .town-ui__contract-art {\n    min-height: 120px;\n  }\n\n  .town-ui__contract-copy {\n    gap: 8px;\n  }\n\n  .town-ui__contract-topline {\n    min-height: 24px;\n  }\n\n  .town-ui__contract h3 {\n    font-size: 1.26rem;\n    line-height: 1.08;\n  }\n\n  .town-ui__contract p {\n    font-size: 0.82rem;\n  }\n\n  .town-ui__contract-flavor {\n    font-size: 0.82rem !important;\n    line-height: 1.22 !important;\n  }\n\n  .town-ui__contract-briefing {\n    grid-template-columns: 1fr;\n    gap: 7px;\n  }\n\n  .town-ui__contract-briefing section {\n    gap: 4px;\n    padding: 7px;\n  }\n\n  .town-ui__contract-briefing ul {\n    font-size: 0.76rem;\n    gap: 3px;\n    line-height: 1.2;\n  }\n\n  .town-ui__contract-stakes,\n  .town-ui__contract-medal,\n  .town-ui__contract-lock,\n  .town-ui__contract-teaser {\n    padding: 5px 7px;\n  }\n\n  .town-ui__contract-action {\n    padding: 7px 10px;\n  }\n\n  .town-ui__catalog-nav {\n    gap: 8px;\n    padding: 0 8px 8px;\n  }\n\n  .town-ui__ride-card {\n    margin: 0 8px 8px;\n  }\n\n  .town-ui__ride-body {\n    grid-template-columns: 1fr;\n    gap: 8px;\n    padding: 0 8px 8px;\n  }\n\n  .town-ui__ride-actions {\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .town-ui__ride-agent-command {\n    grid-template-columns: 1fr;\n  }\n\n  .town-ui__ride-card h3 {\n    font-size: 1rem;\n  }\n\n  .town-ui__ride-code {\n    padding: 8px;\n    font-size: 0.78rem;\n  }\n\n  .town-ui__catalog-count {\n    min-width: 42px;\n  }\n\n  .town-ui__catalog-dots {\n    gap: 0;\n  }\n\n  .town-ui__catalog-dot {\n    width: 44px;\n    height: 44px;\n  }\n\n  .town-ui__catalog-dot::after {\n    width: 14px;\n    height: 14px;\n  }\n\n  .town-ui__title span {\n    display: none;\n  }\n\n  .town-ui__exit {\n    padding-inline: 11px;\n  }\n}\n"],["STYLE",{},"/* The ceremony stage — a house parchment surface over a painted, playable plate. */\n\n.ceremony-layer {\n  position: fixed;\n  inset: 0;\n  z-index: 60;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: max(14px, env(safe-area-inset-top)) max(10px, env(safe-area-inset-right)) max(14px, env(safe-area-inset-bottom)) max(10px, env(safe-area-inset-left));\n  background: rgba(46, 27, 14, 0.58);\n  backdrop-filter: blur(2px);\n  font-family: Wellfleet, Georgia, \"Iowan Old Style\", serif;\n}\n\n.ceremony-layer[hidden] {\n  display: none;\n}\n\n.ceremony-frame.town-ui__board-shell {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  width: min(760px, 94vw);\n  max-height: 94vh;\n  padding: 16px 18px;\n  border-color: var(--at-wood-950);\n  color: var(--at-wood-950);\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.92), rgba(245, 230, 200, 0.97)),\n    var(--at-sand-100);\n}\n\n.ceremony-frame::before,\n.ceremony-frame::after {\n  position: absolute;\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  content: \"\";\n  background: var(--at-brass-700);\n  box-shadow: inset 0 1px 0 rgba(255, 248, 232, 0.52);\n}\n\n.ceremony-frame::before { top: 6px; left: 6px; }\n.ceremony-frame::after { right: 6px; bottom: 6px; }\n\n.ceremony-header {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.ceremony-eyebrow {\n  margin: 0;\n  font-size: 11px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--at-teal-600);\n}\n\n.ceremony-frame h2 {\n  margin: 0;\n  font-size: clamp(18px, 3.4vw, 26px);\n  font-family: Smokum, Rye, Georgia, serif;\n  letter-spacing: 0.04em;\n}\n\n.ceremony-stage {\n  width: 100%;\n  aspect-ratio: 16 / 9;\n  border-radius: 8px;\n  background: #241d16;\n  touch-action: none;\n  cursor: pointer;\n}\n\n.ceremony-direction {\n  margin: 0;\n  min-height: 2.4em;\n  font-size: clamp(13px, 2.6vw, 16px);\n  line-height: 1.35;\n  color: rgba(46, 27, 14, 0.82);\n}\n\n.ceremony-hand {\n  display: flex;\n  justify-content: center;\n}\n\n.ceremony-hand-input {\n  width: auto;\n  padding: 12px 26px;\n  font-size: clamp(14px, 2.8vw, 17px);\n  cursor: pointer;\n  touch-action: none;\n  user-select: none;\n  -webkit-user-select: none;\n}\n\n.ceremony-hand-input:disabled {\n  opacity: 0.45;\n  cursor: default;\n}\n\n.ceremony-hand-input[data-hand-live='true']:active {\n  transform: translateY(1px);\n}\n\n.ceremony-leave {\n  width: auto;\n  align-self: flex-end;\n  padding: 6px 14px;\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.ceremony-layer[data-phase='done'] .ceremony-leave {\n  align-self: center;\n  font-size: 15px;\n  padding: 10px 22px;\n  background: var(--at-teal-600);\n}\n\n@media (max-width: 480px) {\n  .ceremony-frame {\n    padding: 12px;\n    gap: 8px;\n  }\n}\n"],["STYLE",{},".claim-herald {\n  position: fixed;\n  inset: 0;\n  z-index: 60;\n  display: grid;\n  place-items: center;\n  padding: 18px;\n  background: rgba(34, 21, 12, 0.58);\n  color: #2e1b0e;\n  font-family: Wellfleet, Georgia, \"Iowan Old Style\", serif;\n}\n\n.claim-herald__paper {\n  width: min(760px, 100%);\n  max-height: min(780px, calc(100vh - 36px));\n  overflow: auto;\n  border: 2px solid rgba(77, 49, 25, 0.82);\n  border-radius: 8px;\n  padding: 18px;\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.98), rgba(232, 213, 168, 0.97)),\n    repeating-linear-gradient(90deg, rgba(46, 27, 14, 0.045) 0 2px, transparent 2px 10px);\n  box-shadow: 0 24px 60px rgba(18, 11, 7, 0.46), inset 0 0 0 1px rgba(255, 255, 255, 0.56);\n}\n\n.claim-herald__masthead {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  gap: 12px;\n  align-items: center;\n  border-bottom: 4px double rgba(46, 27, 14, 0.72);\n  padding-bottom: 12px;\n}\n\n.claim-herald__mark {\n  display: grid;\n  place-items: center;\n  width: 54px;\n  height: 54px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  background: #ffe4a0;\n  font-size: 1.8rem;\n  line-height: 1;\n}\n\n.claim-herald__eyebrow,\n.claim-herald__date {\n  margin: 0;\n  color: #5b8a8a;\n  font-size: 0.74rem;\n  font-weight: 900;\n  letter-spacing: 0;\n  text-transform: uppercase;\n}\n\n.claim-herald h2 {\n  margin: 0;\n  font-size: clamp(1.55rem, 6vw, 2.6rem);\n  line-height: 0.95;\n}\n\n.claim-herald__close {\n  min-height: 44px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  padding: 9px 13px;\n  color: #2e1b0e;\n  background: #ffe4a0;\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.5);\n  font: 900 0.9rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.claim-herald__items {\n  display: grid;\n  gap: 14px;\n  padding-top: 14px;\n}\n\n.claim-herald__archive {\n  display: flex;\n  gap: 8px;\n  overflow-x: auto;\n  padding: 12px 0 2px;\n  border-bottom: 1px solid rgba(77, 49, 25, 0.24);\n}\n\n.claim-herald__back-issue {\n  display: grid;\n  gap: 3px;\n  flex: 0 0 auto;\n  max-width: 190px;\n  min-height: 44px;\n  border: 2px solid rgba(46, 27, 14, 0.62);\n  border-radius: 6px;\n  padding: 6px 9px;\n  color: #2e1b0e;\n  background: rgba(255, 248, 232, 0.72);\n  font: 900 0.72rem/1.15 Wellfleet, Georgia, serif;\n  text-align: left;\n  cursor: pointer;\n}\n\n.claim-herald__back-issue span {\n  color: #5b8a8a;\n  font-size: 0.6rem;\n  text-transform: uppercase;\n}\n\n.claim-herald__back-issue[data-showing='true'] {\n  background: #ffe4a0;\n  box-shadow: inset 0 0 0 1px rgba(46, 27, 14, 0.42);\n}\n\n.claim-herald__back-issue:hover,\n.claim-herald__back-issue:focus-visible {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 2px;\n}\n\n.claim-herald__back-issue--menu {\n  background: rgba(91, 138, 138, 0.16);\n}\n\n/* THE DOOR (owner ruling 2026-08-04): the town badge opens this index when the town has\n   printed more than one edition. Newest on top; unread carries its own word. */\n.claim-herald__editions {\n  display: grid;\n  gap: 8px;\n  padding: 16px 0 4px;\n}\n\n.claim-herald__editions h3 {\n  margin: 0;\n  padding-bottom: 8px;\n  border-bottom: 4px double rgba(46, 27, 14, 0.52);\n  font-size: 1.15rem;\n  text-transform: uppercase;\n}\n\n.claim-herald__edition-list {\n  display: grid;\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.claim-herald__edition-entry {\n  display: grid;\n  gap: 3px;\n  width: 100%;\n  min-height: 44px;\n  border: 2px solid rgba(46, 27, 14, 0.62);\n  border-radius: 6px;\n  padding: 10px 12px;\n  color: #2e1b0e;\n  background: rgba(255, 248, 232, 0.72);\n  font-family: Wellfleet, Georgia, serif;\n  text-align: left;\n  cursor: pointer;\n}\n\n.claim-herald__edition-entry[data-unread='true'] {\n  background: #ffe4a0;\n  box-shadow: inset 3px 0 0 #5b8a8a;\n}\n\n.claim-herald__edition-entry:hover,\n.claim-herald__edition-entry:focus-visible {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 2px;\n}\n\n.claim-herald__edition-entry-number {\n  color: #5b8a8a;\n  font-size: 0.62rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.claim-herald__edition-entry-headline {\n  font-size: 1.05rem;\n  font-weight: 900;\n  line-height: 1.06;\n}\n\n.claim-herald__edition-entry-standfirst {\n  color: rgba(46, 27, 14, 0.82);\n  font-size: 0.8rem;\n  font-style: italic;\n  font-weight: 800;\n  line-height: 1.28;\n}\n\n.claim-herald__edition {\n  display: grid;\n  gap: 8px;\n  padding: 16px 0 4px;\n}\n\n.claim-herald__edition h3 {\n  margin: 0;\n  font-size: clamp(1.3rem, 5vw, 1.9rem);\n  line-height: 1.02;\n}\n\n.claim-herald__standfirst {\n  margin: 0;\n  color: rgba(46, 27, 14, 0.86);\n  font-size: 0.94rem;\n  font-style: italic;\n  font-weight: 800;\n  line-height: 1.3;\n}\n\n/* A newspaper cut, not a poster: the plate is capped so the headline, the standfirst and the\n   first paragraphs of the lead all sit above the fold on an 780px-tall paper. */\nimg.claim-herald__plate {\n  width: 100%;\n  max-height: 208px;\n  aspect-ratio: 1672 / 941;\n  border: 1px solid rgba(77, 49, 25, 0.48);\n  border-radius: 4px;\n  object-fit: cover;\n}\n\ndiv.claim-herald__plate {\n  min-height: 92px;\n}\n\n.claim-herald__lead {\n  display: grid;\n  gap: 8px;\n}\n\n.claim-herald__lead p {\n  margin: 0;\n  color: rgba(46, 27, 14, 0.88);\n  font-size: 0.95rem;\n  font-weight: 800;\n  line-height: 1.38;\n}\n\n.claim-herald__lead p:first-child::first-letter {\n  float: left;\n  padding: 2px 6px 0 0;\n  font-size: 2.6rem;\n  line-height: 0.82;\n}\n\n.claim-herald__deed {\n  margin: 4px 0 0;\n  border-block: 4px double rgba(46, 27, 14, 0.52);\n  padding: 9px 0;\n  color: rgba(46, 27, 14, 0.9);\n  font-size: 0.88rem;\n  font-style: italic;\n  font-weight: 800;\n  line-height: 1.35;\n  text-align: center;\n}\n\n.claim-herald__first-issue {\n  margin-top: 14px;\n  border: 2px solid rgba(77, 49, 25, 0.52);\n  background: rgba(255, 248, 232, 0.48);\n}\n\n.claim-herald__issue-header {\n  padding: 12px;\n  border-bottom: 4px double rgba(46, 27, 14, 0.52);\n  text-align: center;\n}\n\n.claim-herald__issue-header p,\n.claim-herald__issue-header h3,\n.claim-herald__guide-panel h4,\n.claim-herald__guide-panel p,\n.claim-herald__latest h3 {\n  margin: 0;\n}\n\n.claim-herald__issue-header p {\n  color: #5b8a8a;\n  font-size: 0.72rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.claim-herald__issue-header h3 {\n  margin-top: 4px;\n  font-size: 1.12rem;\n  line-height: 1.1;\n}\n\n.claim-herald__guide-panels {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.claim-herald__guide-panel {\n  display: grid;\n  align-content: start;\n  gap: 6px;\n  padding: 12px;\n  border-right: 1px solid rgba(77, 49, 25, 0.24);\n  border-bottom: 1px solid rgba(77, 49, 25, 0.24);\n}\n\n.claim-herald__guide-panel:nth-child(2n) {\n  border-right: 0;\n}\n\n.claim-herald__guide-panel:nth-last-child(-n + 2) {\n  border-bottom: 0;\n}\n\n.claim-herald__guide-panel:last-child:nth-child(odd) {\n  grid-column: 1 / -1;\n  border-right: 0;\n}\n\n.claim-herald__guide-panel:nth-last-child(2):nth-child(even) {\n  border-bottom: 1px solid rgba(77, 49, 25, 0.24);\n}\n\n.claim-herald__art-slot {\n  display: grid;\n  place-items: center;\n  min-height: 76px;\n  border: 1px dashed rgba(77, 49, 25, 0.48);\n  color: rgba(46, 27, 14, 0.58);\n  background:\n    repeating-linear-gradient(135deg, transparent 0 8px, rgba(139, 125, 60, 0.08) 8px 9px);\n  font-size: 0.68rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\nimg.claim-herald__art-slot {\n  width: 100%;\n  min-height: 0;\n  aspect-ratio: 1672 / 941;\n  object-fit: cover;\n  border-style: solid;\n}\n\n.claim-herald__guide-panel h4 {\n  font-size: 0.95rem;\n  line-height: 1.08;\n}\n\n.claim-herald__guide-panel p {\n  color: rgba(46, 27, 14, 0.82);\n  font-size: 0.82rem;\n  font-weight: 800;\n  line-height: 1.3;\n}\n\n.claim-herald__latest {\n  padding-top: 18px;\n}\n\n.claim-herald__latest > h3 {\n  padding-bottom: 8px;\n  border-bottom: 4px double rgba(46, 27, 14, 0.52);\n  font-size: 1rem;\n  text-transform: uppercase;\n}\n\n.claim-herald__item {\n  position: relative;\n  display: grid;\n  gap: 7px;\n  border-bottom: 1px solid rgba(77, 49, 25, 0.24);\n  padding-bottom: 12px;\n}\n\n.claim-herald__item:has(.claim-herald__engraving) {\n  min-height: 120px;\n  padding-right: 132px;\n}\n\n.claim-herald__engraving {\n  position: absolute;\n  top: 0;\n  right: 0;\n  width: 120px;\n  height: 120px;\n  border-radius: 4px;\n  object-fit: cover;\n}\n\n.claim-herald__item:last-child {\n  border-bottom: 0;\n}\n\n.claim-herald__item h3,\n.claim-herald__item p {\n  margin: 0;\n}\n\n.claim-herald__item h3 {\n  font-size: 1.18rem;\n  line-height: 1.08;\n}\n\n.claim-herald__item p,\n.claim-herald__empty {\n  color: rgba(46, 27, 14, 0.82);\n  font-size: 0.95rem;\n  font-weight: 800;\n  line-height: 1.35;\n}\n\n.claim-herald__empty {\n  margin: 18px 0 0;\n}\n\n.claim-herald-actions {\n  display: flex;\n  gap: 8px;\n  align-items: start;\n  pointer-events: auto;\n}\n\n.claim-herald-badge {\n  display: grid;\n  min-height: 44px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  padding: 6px 10px;\n  color: #2e1b0e;\n  background: #f5e6c8;\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.62);\n  font: 900 0.8rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.claim-herald-badge span {\n  color: #5b8a8a;\n  font-size: 0.62rem;\n  text-transform: uppercase;\n}\n\n.claim-herald-badge[data-unread='true'] {\n  animation: claim-herald-pulse 1.6s ease-in-out infinite;\n}\n\n.claim-herald-badge:hover,\n.claim-herald-badge:focus-visible {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 3px;\n}\n\n@keyframes claim-herald-pulse {\n  50% {\n    background: #ffe4a0;\n    box-shadow: 0 4px 0 rgba(46, 27, 14, 0.62), 0 0 0 6px rgba(255, 228, 160, 0.3);\n  }\n}\n\n@media (max-width: 560px) {\n  .claim-herald {\n    padding: 10px;\n  }\n\n  .claim-herald__paper {\n    max-height: calc(100vh - 20px);\n    padding: 12px;\n  }\n\n  .claim-herald__masthead {\n    grid-template-columns: 42px minmax(0, 1fr);\n  }\n\n  .claim-herald__mark {\n    width: 42px;\n    height: 42px;\n    font-size: 1.35rem;\n  }\n\n  .claim-herald__close {\n    grid-column: 1 / -1;\n    justify-self: end;\n  }\n\n  .claim-herald__item:has(.claim-herald__engraving) {\n    min-height: 92px;\n    padding-right: 104px;\n  }\n\n  .claim-herald__engraving {\n    width: 92px;\n