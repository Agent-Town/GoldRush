);\n  font-size: 0.78rem;\n  line-height: 1.25;\n}\n\n.town-ui__name-error {\n  min-height: 1.2em;\n  margin-top: 8px;\n  color: #a0522d;\n  font-size: 0.86rem;\n  font-weight: 900;\n}\n\n.town-ui__name-beat {\n  margin-top: 8px;\n  color: #5b8a8a;\n  font-size: 0.95rem;\n  font-weight: 900;\n}\n\n.town-ui__name-submit {\n  width: 100%;\n  min-height: 44px;\n  margin-top: 12px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #fff8e8;\n  background: #5b8a8a;\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.62);\n  font: 900 0.95rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n@media (pointer: coarse), (max-width: 760px) {\n  .town-ui__prompt-stack {\n    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 154px);\n  }\n}\n\n@media (max-width: 430px) {\n  .town-ui__board,\n  .town-ui__surface {\n    align-items: stretch;\n  }\n\n  .town-ui__board-shell,\n  .town-ui__surface-shell {\n    width: calc(100vw - 20px);\n    max-height: calc(100vh - 20px);\n  }\n\n  .town-ui__board-header,\n  .town-ui__surface-header {\n    align-items: center;\n    padding: 8px 10px;\n  }\n\n  .town-ui__board-host {\n    width: 52px;\n    height: 52px;\n  }\n\n  .town-ui__board-eyebrow {\n    margin-bottom: 2px;\n    font-size: 0.68rem;\n  }\n\n  .town-ui__board-header h2 {\n    font-size: 1.34rem;\n    line-height: 1;\n  }\n\n  .town-ui__board-close {\n    min-height: 48px;\n    padding: 7px 10px;\n  }\n\n  .town-ui__wardrobe-racks {\n    grid-template-columns: 1fr;\n  }\n\n  .town-ui__wardrobe-rack {\n    padding: 12px;\n  }\n\n  .town-ui__wardrobe-preview {\n    grid-template-rows: minmax(0, 138px) auto;\n  }\n\n  .town-ui__contracts {\n    position: relative;\n    grid-template-columns: minmax(0, 1fr);\n    align-items: center;\n    gap: 8px;\n    padding: 8px;\n  }\n\n  .town-ui__chapter-header {\n    padding: 8px 10px;\n  }\n\n  .town-ui__chapter-header h3 {\n    font-size: 1.22rem;\n  }\n\n  .town-ui__chapter-contracts {\n    padding: 8px;\n  }\n\n  .town-ui__board-sections {\n    gap: 12px;\n  }\n\n  .town-ui__training-ground {\n    gap: 8px;\n    padding-top: 10px;\n  }\n\n  .town-ui__training-ground-header {\n    align-items: start;\n    flex-direction: column-reverse;\n    gap: 3px;\n  }\n\n  .town-ui__chapter-tabs {\n    flex-wrap: nowrap;\n    justify-content: flex-start;\n  }\n\n  .town-ui__catalog-arrow {\n    position: absolute;\n    z-index: 1;\n    top: 68px;\n    width: 42px;\n    min-height: 62px;\n    font-size: 1.55rem;\n  }\n\n  .town-ui__catalog-arrow--prev {\n    left: 12px;\n  }\n\n  .town-ui__catalog-arrow--next {\n    right: 12px;\n  }\n\n  .town-ui__contract {\n    grid-template-columns: 1fr;\n    grid-template-rows: minmax(120px, 18vh) auto;\n    gap: 8px;\n    min-height: 0;\n    padding: 8px;\n  }\n\n  .town-ui__contract.town-ui__training-card {\n    grid-template-rows: 120px auto;\n    gap: 6px;\n  }\n\n  .town-ui__contract-art {\n    min-height: 120px;\n  }\n\n  .town-ui__contract-copy {\n    gap: 8px;\n  }\n\n  .town-ui__contract-topline {\n    min-height: 24px;\n  }\n\n  .town-ui__contract h3 {\n    font-size: 1.26rem;\n    line-height: 1.08;\n  }\n\n  .town-ui__contract p {\n    font-size: 0.82rem;\n  }\n\n  .town-ui__contract-flavor {\n    font-size: 0.82rem !important;\n    line-height: 1.22 !important;\n  }\n\n  .town-ui__contract-briefing {\n    grid-template-columns: 1fr;\n    gap: 7px;\n  }\n\n  .town-ui__contract-briefing section {\n    gap: 4px;\n    padding: 7px;\n  }\n\n  .town-ui__contract-briefing ul {\n    font-size: 0.76rem;\n    gap: 3px;\n    line-height: 1.2;\n  }\n\n  .town-ui__contract-stakes,\n  .town-ui__contract-medal,\n  .town-ui__contract-lock,\n  .town-ui__contract-teaser {\n    padding: 5px 7px;\n  }\n\n  .town-ui__contract-action {\n    padding: 7px 10px;\n  }\n\n  .town-ui__catalog-nav {\n    gap: 8px;\n    padding: 0 8px 8px;\n  }\n\n  .town-ui__ride-card {\n    margin: 0 8px 8px;\n  }\n\n  .town-ui__ride-body {\n    grid-template-columns: 1fr;\n    gap: 8px;\n    padding: 0 8px 8px;\n  }\n\n  .town-ui__ride-actions {\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .town-ui__ride-agent-command {\n    grid-template-columns: 1fr;\n  }\n\n  .town-ui__ride-card h3 {\n    font-size: 1rem;\n  }\n\n  .town-ui__ride-code {\n    padding: 8px;\n    font-size: 0.78rem;\n  }\n\n  .town-ui__catalog-count {\n    min-width: 42px;\n  }\n\n  .town-ui__catalog-dots {\n    gap: 0;\n  }\n\n  .town-ui__catalog-dot {\n    width: 44px;\n    height: 44px;\n  }\n\n  .town-ui__catalog-dot::after {\n    width: 14px;\n    height: 14px;\n  }\n\n  .town-ui__title span {\n    display: none;\n  }\n\n  .town-ui__exit {\n    padding-inline: 11px;\n  }\n}\n"],["STYLE",{},"/* The ceremony stage — a house parchment surface over a painted, playable plate. */\n\n.ceremony-layer {\n  position: fixed;\n  inset: 0;\n  z-index: 60;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: max(14px, env(safe-area-inset-top)) max(10px, env(safe-area-inset-right)) max(14px, env(safe-area-inset-bottom)) max(10px, env(safe-area-inset-left));\n  background: rgba(46, 27, 14, 0.58);\n  backdrop-filter: blur(2px);\n  font-family: Wellfleet, Georgia, \"Iowan Old Style\", serif;\n}\n\n.ceremony-layer[hidden] {\n  display: none;\n}\n\n.ceremony-frame.town-ui__board-shell {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  width: min(760px, 94vw);\n  max-height: 94vh;\n  padding: 16px 18px;\n  border-color: var(--at-wood-950);\n  color: var(--at-wood-950);\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.92), rgba(245, 230, 200, 0.97)),\n    var(--at-sand-100);\n}\n\n.ceremony-frame::before,\n.ceremony-frame::after {\n  position: absolute;\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  content: \"\";\n  background: var(--at-brass-700);\n  box-shadow: inset 0 1px 0 rgba(255, 248, 232, 0.52);\n}\n\n.ceremony-frame::before { top: 6px; left: 6px; }\n.ceremony-frame::after { right: 6px; bottom: 6px; }\n\n.ceremony-header {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.ceremony-eyebrow {\n  margin: 0;\n  font-size: 11px;\n  letter-spacing: 0.14em;\n  text-transform: uppercase;\n  color: var(--at-teal-600);\n}\n\n.ceremony-frame h2 {\n  margin: 0;\n  font-size: clamp(18px, 3.4vw, 26px);\n  font-family: Smokum, Rye, Georgia, serif;\n  letter-spacing: 0.04em;\n}\n\n.ceremony-stage {\n  width: 100%;\n  aspect-ratio: 16 / 9;\n  border-radius: 8px;\n  background: #241d16;\n  touch-action: none;\n  cursor: pointer;\n}\n\n.ceremony-direction {\n  margin: 0;\n  min-height: 2.4em;\n  font-size: clamp(13px, 2.6vw, 16px);\n  line-height: 1.35;\n  color: rgba(46, 27, 14, 0.82);\n}\n\n.ceremony-hand {\n  display: flex;\n  justify-content: center;\n}\n\n.ceremony-hand-input {\n  width: auto;\n  padding: 12px 26px;\n  font-size: clamp(14px, 2.8vw, 17px);\n  cursor: pointer;\n  touch-action: none;\n  user-select: none;\n  -webkit-user-select: none;\n}\n\n.ceremony-hand-input:disabled {\n  opacity: 0.45;\n  cursor: default;\n}\n\n.ceremony-hand-input[data-hand-live='true']:active {\n  transform: translateY(1px);\n}\n\n.ceremony-leave {\n  width: auto;\n  align-self: flex-end;\n  padding: 6px 14px;\n  font-size: 13px;\n  cursor: pointer;\n}\n\n.ceremony-layer[data-phase='done'] .ceremony-leave {\n  align-self: center;\n  font-size: 15px;\n  padding: 10px 22px;\n  background: var(--at-teal-600);\n}\n\n@media (max-width: 480px) {\n  .ceremony-frame {\n    padding: 12px;\n    gap: 8px;\n  }\n}\n"],["STYLE",{},".claim-herald {\n  position: fixed;\n  inset: 0;\n  z-index: 60;\n  display: grid;\n  place-items: center;\n  padding: 18px;\n  background: rgba(34, 21, 12, 0.58);\n  color: #2e1b0e;\n  font-family: Wellfleet, Georgia, \"Iowan Old Style\", serif;\n}\n\n.claim-herald__paper {\n  width: min(760px, 100%);\n  max-height: min(780px, calc(100vh - 36px));\n  overflow: auto;\n  border: 2px solid rgba(77, 49, 25, 0.82);\n  border-radius: 8px;\n  padding: 18px;\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.98), rgba(232, 213, 168, 0.97)),\n    repeating-linear-gradient(90deg, rgba(46, 27, 14, 0.045) 0 2px, transparent 2px 10px);\n  box-shadow: 0 24px 60px rgba(18, 11, 7, 0.46), inset 0 0 0 1px rgba(255, 255, 255, 0.56);\n}\n\n.claim-herald__masthead {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr) auto;\n  gap: 12px;\n  align-items: center;\n  border-bottom: 4px double rgba(46, 27, 14, 0.72);\n  padding-bottom: 12px;\n}\n\n.claim-herald__mark {\n  display: grid;\n  place-items: center;\n  width: 54px;\n  height: 54px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  background: #ffe4a0;\n  font-size: 1.8rem;\n  line-height: 1;\n}\n\n.claim-herald__eyebrow,\n.claim-herald__date {\n  margin: 0;\n  color: #5b8a8a;\n  font-size: 0.74rem;\n  font-weight: 900;\n  letter-spacing: 0;\n  text-transform: uppercase;\n}\n\n.claim-herald h2 {\n  margin: 0;\n  font-size: clamp(1.55rem, 6vw, 2.6rem);\n  line-height: 0.95;\n}\n\n.claim-herald__close {\n  min-height: 44px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  padding: 9px 13px;\n  color: #2e1b0e;\n  background: #ffe4a0;\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.5);\n  font: 900 0.9rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.claim-herald__items {\n  display: grid;\n  gap: 14px;\n  padding-top: 14px;\n}\n\n.claim-herald__archive {\n  display: flex;\n  gap: 8px;\n  overflow-x: auto;\n  padding: 12px 0 2px;\n  border-bottom: 1px solid rgba(77, 49, 25, 0.24);\n}\n\n.claim-herald__back-issue {\n  display: grid;\n  gap: 3px;\n  flex: 0 0 auto;\n  max-width: 190px;\n  min-height: 44px;\n  border: 2px solid rgba(46, 27, 14, 0.62);\n  border-radius: 6px;\n  padding: 6px 9px;\n  color: #2e1b0e;\n  background: rgba(255, 248, 232, 0.72);\n  font: 900 0.72rem/1.15 Wellfleet, Georgia, serif;\n  text-align: left;\n  cursor: pointer;\n}\n\n.claim-herald__back-issue span {\n  color: #5b8a8a;\n  font-size: 0.6rem;\n  text-transform: uppercase;\n}\n\n.claim-herald__back-issue[data-showing='true'] {\n  background: #ffe4a0;\n  box-shadow: inset 0 0 0 1px rgba(46, 27, 14, 0.42);\n}\n\n.claim-herald__back-issue:hover,\n.claim-herald__back-issue:focus-visible {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 2px;\n}\n\n.claim-herald__back-issue--menu {\n  background: rgba(91, 138, 138, 0.16);\n}\n\n/* THE DOOR (owner ruling 2026-08-04): the town badge opens this index when the town has\n   printed more than one edition. Newest on top; unread carries its own word. */\n.claim-herald__editions {\n  display: grid;\n  gap: 8px;\n  padding: 16px 0 4px;\n}\n\n.claim-herald__editions h3 {\n  margin: 0;\n  padding-bottom: 8px;\n  border-bottom: 4px double rgba(46, 27, 14, 0.52);\n  font-size: 1.15rem;\n  text-transform: uppercase;\n}\n\n.claim-herald__edition-list {\n  display: grid;\n  gap: 8px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.claim-herald__edition-entry {\n  display: grid;\n  gap: 3px;\n  width: 100%;\n  min-height: 44px;\n  border: 2px solid rgba(46, 27, 14, 0.62);\n  border-radius: 6px;\n  padding: 10px 12px;\n  color: #2e1b0e;\n  background: rgba(255, 248, 232, 0.72);\n  font-family: Wellfleet, Georgia, serif;\n  text-align: left;\n  cursor: pointer;\n}\n\n.claim-herald__edition-entry[data-unread='true'] {\n  background: #ffe4a0;\n  box-shadow: inset 3px 0 0 #5b8a8a;\n}\n\n.claim-herald__edition-entry:hover,\n.claim-herald__edition-entry:focus-visible {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 2px;\n}\n\n.claim-herald__edition-entry-number {\n  color: #5b8a8a;\n  font-size: 0.62rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.claim-herald__edition-entry-headline {\n  font-size: 1.05rem;\n  font-weight: 900;\n  line-height: 1.06;\n}\n\n.claim-herald__edition-entry-standfirst {\n  color: rgba(46, 27, 14, 0.82);\n  font-size: 0.8rem;\n  font-style: italic;\n  font-weight: 800;\n  line-height: 1.28;\n}\n\n.claim-herald__edition {\n  display: grid;\n  gap: 8px;\n  padding: 16px 0 4px;\n}\n\n.claim-herald__edition h3 {\n  margin: 0;\n  font-size: clamp(1.3rem, 5vw, 1.9rem);\n  line-height: 1.02;\n}\n\n.claim-herald__standfirst {\n  margin: 0;\n  color: rgba(46, 27, 14, 0.86);\n  font-size: 0.94rem;\n  font-style: italic;\n  font-weight: 800;\n  line-height: 1.3;\n}\n\n/* A newspaper cut, not a poster: the plate is capped so the headline, the standfirst and the\n   first paragraphs of the lead all sit above the fold on an 780px-tall paper. */\nimg.claim-herald__plate {\n  width: 100%;\n  max-height: 208px;\n  aspect-ratio: 1672 / 941;\n  border: 1px solid rgba(77, 49, 25, 0.48);\n  border-radius: 4px;\n  object-fit: cover;\n}\n\ndiv.claim-herald__plate {\n  min-height: 92px;\n}\n\n.claim-herald__lead {\n  display: grid;\n  gap: 8px;\n}\n\n.claim-herald__lead p {\n  margin: 0;\n  color: rgba(46, 27, 14, 0.88);\n  font-size: 0.95rem;\n  font-weight: 800;\n  line-height: 1.38;\n}\n\n.claim-herald__lead p:first-child::first-letter {\n  float: left;\n  padding: 2px 6px 0 0;\n  font-size: 2.6rem;\n  line-height: 0.82;\n}\n\n.claim-herald__deed {\n  margin: 4px 0 0;\n  border-block: 4px double rgba(46, 27, 14, 0.52);\n  padding: 9px 0;\n  color: rgba(46, 27, 14, 0.9);\n  font-size: 0.88rem;\n  font-style: italic;\n  font-weight: 800;\n  line-height: 1.35;\n  text-align: center;\n}\n\n.claim-herald__first-issue {\n  margin-top: 14px;\n  border: 2px solid rgba(77, 49, 25, 0.52);\n  background: rgba(255, 248, 232, 0.48);\n}\n\n.claim-herald__issue-header {\n  padding: 12px;\n  border-bottom: 4px double rgba(46, 27, 14, 0.52);\n  text-align: center;\n}\n\n.claim-herald__issue-header p,\n.claim-herald__issue-header h3,\n.claim-herald__guide-panel h4,\n.claim-herald__guide-panel p,\n.claim-herald__latest h3 {\n  margin: 0;\n}\n\n.claim-herald__issue-header p {\n  color: #5b8a8a;\n  font-size: 0.72rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.claim-herald__issue-header h3 {\n  margin-top: 4px;\n  font-size: 1.12rem;\n  line-height: 1.1;\n}\n\n.claim-herald__guide-panels {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.claim-herald__guide-panel {\n  display: grid;\n  align-content: start;\n  gap: 6px;\n  padding: 12px;\n  border-right: 1px solid rgba(77, 49, 25, 0.24);\n  border-bottom: 1px solid rgba(77, 49, 25, 0.24);\n}\n\n.claim-herald__guide-panel:nth-child(2n) {\n  border-right: 0;\n}\n\n.claim-herald__guide-panel:nth-last-child(-n + 2) {\n  border-bottom: 0;\n}\n\n.claim-herald__guide-panel:last-child:nth-child(odd) {\n  grid-column: 1 / -1;\n  border-right: 0;\n}\n\n.claim-herald__guide-panel:nth-last-child(2):nth-child(even) {\n  border-bottom: 1px solid rgba(77, 49, 25, 0.24);\n}\n\n.claim-herald__art-slot {\n  display: grid;\n  place-items: center;\n  min-height: 76px;\n  border: 1px dashed rgba(77, 49, 25, 0.48);\n  color: rgba(46, 27, 14, 0.58);\n  background:\n    repeating-linear-gradient(135deg, transparent 0 8px, rgba(139, 125, 60, 0.08) 8px 9px);\n  font-size: 0.68rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\nimg.claim-herald__art-slot {\n  width: 100%;\n  min-height: 0;\n  aspect-ratio: 1672 / 941;\n  object-fit: cover;\n  border-style: solid;\n}\n\n.claim-herald__guide-panel h4 {\n  font-size: 0.95rem;\n  line-height: 1.08;\n}\n\n.claim-herald__guide-panel p {\n  color: rgba(46, 27, 14, 0.82);\n  font-size: 0.82rem;\n  font-weight: 800;\n  line-height: 1.3;\n}\n\n.claim-herald__latest {\n  padding-top: 18px;\n}\n\n.claim-herald__latest > h3 {\n  padding-bottom: 8px;\n  border-bottom: 4px double rgba(46, 27, 14, 0.52);\n  font-size: 1rem;\n  text-transform: uppercase;\n}\n\n.claim-herald__item {\n  position: relative;\n  display: grid;\n  gap: 7px;\n  border-bottom: 1px solid rgba(77, 49, 25, 0.24);\n  padding-bottom: 12px;\n}\n\n.claim-herald__item:has(.claim-herald__engraving) {\n  min-height: 120px;\n  padding-right: 132px;\n}\n\n.claim-herald__engraving {\n  position: absolute;\n  top: 0;\n  right: 0;\n  width: 120px;\n  height: 120px;\n  border-radius: 4px;\n  object-fit: cover;\n}\n\n.claim-herald__item:last-child {\n  border-bottom: 0;\n}\n\n.claim-herald__item h3,\n.claim-herald__item p {\n  margin: 0;\n}\n\n.claim-herald__item h3 {\n  font-size: 1.18rem;\n  line-height: 1.08;\n}\n\n.claim-herald__item p,\n.claim-herald__empty {\n  color: rgba(46, 27, 14, 0.82);\n  font-size: 0.95rem;\n  font-weight: 800;\n  line-height: 1.35;\n}\n\n.claim-herald__empty {\n  margin: 18px 0 0;\n}\n\n.claim-herald-actions {\n  display: flex;\n  gap: 8px;\n  align-items: start;\n  pointer-events: auto;\n}\n\n.claim-herald-badge {\n  display: grid;\n  min-height: 44px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  padding: 6px 10px;\n  color: #2e1b0e;\n  background: #f5e6c8;\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.62);\n  font: 900 0.8rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.claim-herald-badge span {\n  color: #5b8a8a;\n  font-size: 0.62rem;\n  text-transform: uppercase;\n}\n\n.claim-herald-badge[data-unread='true'] {\n  animation: claim-herald-pulse 1.6s ease-in-out infinite;\n}\n\n.claim-herald-badge:hover,\n.claim-herald-badge:focus-visible {\n  outline: 3px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 3px;\n}\n\n@keyframes claim-herald-pulse {\n  50% {\n    background: #ffe4a0;\n    box-shadow: 0 4px 0 rgba(46, 27, 14, 0.62), 0 0 0 6px rgba(255, 228, 160, 0.3);\n  }\n}\n\n@media (max-width: 560px) {\n  .claim-herald {\n    padding: 10px;\n  }\n\n  .claim-herald__paper {\n    max-height: calc(100vh - 20px);\n    padding: 12px;\n  }\n\n  .claim-herald__masthead {\n    grid-template-columns: 42px minmax(0, 1fr);\n  }\n\n  .claim-herald__mark {\n    width: 42px;\n    height: 42px;\n    font-size: 1.35rem;\n  }\n\n  .claim-herald__close {\n    grid-column: 1 / -1;\n    justify-self: end;\n  }\n\n  .claim-herald__item:has(.claim-herald__engraving) {\n    min-height: 92px;\n    padding-right: 104px;\n  }\n\n  .claim-herald__engraving {\n    width: 92px;\