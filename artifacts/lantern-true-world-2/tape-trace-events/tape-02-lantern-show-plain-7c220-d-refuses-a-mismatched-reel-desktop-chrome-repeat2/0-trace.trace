f1df;\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.42),\n    0 4px 0 rgba(46, 27, 14, 0.78),\n    0 16px 28px rgba(46, 27, 14, 0.28);\n  cursor: pointer;\n  font: inherit;\n  text-align: left;\n}\n\n.upgrade-card--provenance {\n  min-height: 198px;\n  padding-top: 44px;\n}\n\n.upgrade-card:hover,\n.upgrade-card:focus-visible {\n  outline: 3px solid var(--at-sun-200);\n  outline-offset: 3px;\n  transform: translateY(-2px);\n}\n\n.upgrade-card__key {\n  position: absolute;\n  top: 10px;\n  right: 10px;\n  display: grid;\n  place-items: center;\n  width: 28px;\n  height: 28px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 50%;\n  background: var(--at-teal-600);\n  color: var(--at-cream-50);\n  font-weight: 900;\n}\n\n.upgrade-card__elder-mark {\n  position: absolute;\n  top: 10px;\n  left: 10px;\n  display: grid;\n  place-items: center;\n  width: 28px;\n  height: 28px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 50%;\n  color: var(--at-cream-50);\n  background: var(--at-brass-700);\n  font-size: 0.72rem;\n  font-weight: 900;\n  line-height: 1;\n}\n\n.upgrade-card__name,\n.upgrade-card__effect,\n.upgrade-card__stacks {\n  display: block;\n}\n\n.upgrade-card__provenance {\n  display: block;\n  margin-top: 10px;\n  border-top: 1px solid rgba(91, 138, 138, 0.36);\n  padding-top: 8px;\n  color: rgba(46, 27, 14, 0.72);\n  font-size: 0.78rem;\n  font-weight: 800;\n  line-height: 1.22;\n}\n\n.upgrade-card__name {\n  max-width: calc(100% - 36px);\n  margin-bottom: 18px;\n  font-size: 1.48rem;\n  font-weight: 900;\n  line-height: 1.08;\n}\n\n.upgrade-card__effect {\n  color: var(--at-rust-600);\n  font-size: 1rem;\n  font-weight: 800;\n  line-height: 1.25;\n}\n\n.upgrade-card__stacks {\n  position: absolute;\n  left: 14px;\n  bottom: 12px;\n  display: grid;\n  place-items: center;\n  min-width: 24px;\n  height: 20px;\n  padding: 0 6px;\n  border: 1px solid rgba(139, 125, 60, 0.62);\n  border-radius: 999px;\n  color: rgba(46, 27, 14, 0.68);