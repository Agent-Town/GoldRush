) minmax(0, 640px);\n  place-content: center;\n  align-items: center;\n  width: auto;\n  min-height: 100%;\n  box-sizing: border-box;\n  padding: max(32px, env(safe-area-inset-top)) max(22px, env(safe-area-inset-right)) max(32px, env(safe-area-inset-bottom)) max(22px, env(safe-area-inset-left));\n  border: 0;\n  border-radius: 0;\n  color: #fff8e8;\n  background:\n    radial-gradient(circle at 18% 78%, rgba(196, 136, 58, 0.32) 0 4%, transparent 4.5%),\n    radial-gradient(circle at 79% 27%, rgba(91, 138, 138, 0.32) 0 7%, transparent 7.5%),\n    repeating-linear-gradient(105deg, transparent 0 58px, rgba(255, 248, 232, 0.035) 58px 60px),\n    linear-gradient(145deg, rgba(46, 27, 14, 0.97), rgba(72, 73, 55, 0.94));\n  box-shadow: inset 0 0 0 2px rgba(196, 136, 58, 0.55), inset 0 0 120px rgba(0, 0, 0, 0.48);\n  pointer-events: auto;\n  transform: scale(1.015);\n  isolation: isolate;\n  overflow: hidden;\n}\n\n.story-beat-card__backdrop,\n.story-beat-card__vignette {\n  position: absolute;\n  inset: 0;\n  z-index: -2;\n  pointer-events: none;\n}\n\n.story-beat-card__backdrop[data-art-loaded='true'] {\n  background: var(--ceremony-art) center / cover no-repeat;\n}\n\n.story-beat-card--ceremony[data-ceremony-step='valley'] .story-beat-card__backdrop[data-art-loaded='true']::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background: var(--ceremony-art-outgoing) center / cover no-repeat;\n  animation: ceremony-era-blend 4.5s ease-in-out forwards;\n}\n\n.story-beat-card__vignette {\n  z-index: -1;\n  background: radial-gradient(ellipse at center, rgba(35, 22, 12, 0.22) 0 30%, rgba(20, 14, 10, 0.82) 100%);\n}\n\n.story-beat-card--ceremony.story-beat-card--visible {\n  transform: scale(1);\n}\n\n.story-beat-card--ceremony .story-beat-card__portrait {\n  width: clamp(74px, 9vw, 112px);\n  height: clamp(96px, 13vw, 146px);\n  border-color: rgba(255, 228, 160, 0.74);\n  box-shadow: 0 0 0 5px rgba(46, 27, 14, 0.5), 0 16px 44px rgba(0, 0, 0, 0.38);\n}\n\n.story-beat-card--ceremony .story-beat-card__copy {\n  padding: 24px clamp(20px, 4vw, 48px);\n  border-block: 1px solid rgba(255, 228, 160, 0.45);\n  text-shadow: 0 3px 18px rgba(0, 0, 0, 0.72);\n  background: rgba(34, 24, 15, 0.42);\n  backdrop-filter: blur(2px);\n}\n\n.story-beat-card--ceremony .story-beat-card__speaker {\n  color: #83ded7;\n  font-size: 0.86rem;\n  letter-spacing: 0.12em;\n}\n\n.story-beat-card--ceremony .story-beat-card__line {\n  font-size: clamp(1.45rem, 4vw, 3.25rem);\n  line-height: 1.08;\n}\n\n.story-beat-card--ceremony[data-ceremony-step=\"title\"] {\n  grid-template-columns: minmax(0, 760px);\n  text-align: center;\n}\n\n.story-beat-card--ceremony[data-ceremony-step=\"title\"] .story-beat-card__portrait,\n.story-beat-card--ceremony[data-ceremony-step=\"title\"] .story-beat-card__speaker {\n  display: none;\n}\n\n.story-beat-card--ceremony[data-ceremony-step=\"title\"] .story-beat-card__line:first-of-type {\n  color: #ffe4a0;\n  font-size: clamp(1rem, 2vw, 1.3rem);\n  font-weight: 900;\n  letter-spacing: 0.22em;\n  text-transform: uppercase;\n}\n\n.story-beat-card--ceremony[data-ceremony-step=\"title\"] .story-beat-card__line:last-of-type {\n  margin-top: 12px;\n  font-size: clamp(2.4rem, 7vw, 5rem);\n}\n\n.story-beat-card__ceremony-actions {\n  grid-column: 1 / -1;\n  display: flex;\n  justify-content: center;\n  gap: 12px;\n  margin-top: 22px;\n}\n\n.story-beat-card__ceremony-actions button {\n  min-width: 150px;\n  min-height: 48px;\n  padding: 10px 18px;\n  border: 2px solid #ffe4a0;\n  border-radius: 7px;\n  color: #2e1b0e;\n  background: #ffe4a0;\n  box-shadow: 0 4px 0 rgba(0, 0, 0, 0.45);\n  font: 800 0.92rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.story-beat-card__ceremony-actions button + button {\n  color: #fff8e8;\n  background: rgba(46, 27, 14, 0.72);\n}\n\n.story-beat-card__ceremony-actions button:focus-visible {\n  outline: 3px solid #83ded7;\n  outline-offset: 4px;\n}\n\n.story-beat-card__portrait {\n  width: 74px;\n  height: 90px;\n  align-self: center;\n  border: 2px solid rgba(83, 50, 24, 0.7);\n  border-radius: 6px;\n  background: #5d3821;\n  object-fit: cover;\n  box-shadow: inset 0 0 0 2px rgba(255, 247, 219, 0.35);\n}\n\n.story-beat-card__copy {\n  min-width: 0;\n  align-self: center;\n}\n\n.story-beat-card__speaker {\n  margin: 0 0 6px;\n  font-size: 0.76rem;\n  font-weight: 800;\n  letter-spacing: 0;\n  color: #476a67;\n  text-transform: uppercase;\n}\n\n.story-beat-card__line {\n  margin: 0;\n  font-size: clamp(0.98rem, 1.6vw, 1.15rem);\n  line-height: 1.35;\n}\n\n.story-beat-card__line + .story-beat-card__line {\n  margin-top: 3px;\n}\n\n.story-pointer-glow {\n  position: relative;\n  z-index: 43;\n  box-shadow: 0 0 0 3px rgba(226, 182, 96, 0.62), 0 0 24px rgba(77, 177, 166, 0.42) !important;\n  animation: story-pointer-pulse 1.25s ease-in-out infinite;\n}\n\n@keyframes story-pointer-pulse {\n  0%,\n  100% {\n    filter: drop-shadow(0 0 0 rgba(226, 182, 96, 0));\n  }\n  50% {\n    filter: drop-shadow(0 0 12px rgba(226, 182, 96, 0.85));\n  }\n}\n\n@keyframes ceremony-era-blend {\n  0%, 18% { opacity: 1; }\n  100% { opacity: 0; }\n}\n\n@media (max-width: 560px) {\n  .story-beat-card {\n    left: 12px;\n    bottom: max(92px, env(safe-area-inset-bottom));\n    grid-template-columns: 58px minmax(0, 1fr);\n    min-height: 104px;\n    padding: 12px;\n    gap: 10px;\n  }\n\n  .story-beat-card__portrait {\n    width: 58px;\n    height: 76px;\n  }\n\n  .story-beat-card__line {\n    font-size: 0.94rem;\n  }\n\n  .story-beat-card--ceremony {\n    left: 0;\n    bottom: 0;\n    grid-template-columns: 62px minmax(0, 1fr);\n    min-height: 100%;\n    padding: max(24px, env(safe-area-inset-top)) 16px max(24px, env(safe-area-inset-bottom));\n    gap: 10px;\n  }\n\n  .story-beat-card--ceremony .story-beat-card__portrait {\n    width: 58px;\n    height: 82px;\n  }\n\n  .story-beat-card--ceremony .story-beat-card__copy {\n    padding: 18px 12px;\n  }\n\n  .story-beat-card--ceremony .story-beat-card__line {\n    font-size: clamp(1.3rem, 7vw, 2rem);\n  }\n\n  .story-beat-card__ceremony-actions {\n    flex-direction: column;\n    width: min(100%, 300px);\n    margin-inline: auto;\n  }\n\n  .story-beat-card__ceremony-actions button {\n    width: 100%;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .story-beat-card,\n  .story-pointer-glow,\n  .story-beat-card__backdrop::before {\n    transition: none;\n    animation: none;\n  }\n\n  .story-beat-card__backdrop::before {\n    opacity: 0;\n  }\n}\n"]],[[2,23]],["BODY",{},[[2,24]],["MAIN",{"id":"app"},[[2,25]],["CANVAS",{"__playwright_bounding_rect__":"{\"left\":0,\"top\":0,\"right\":1280,\"bottom\":800}","id":"game-canvas","aria-label":"Playable Three.js game canvas","data-asset-prefetch-scene":"menu","data-asset-prefetch-state":"fetching","data-asset-prefetch-ready":"0","data-asset-prefetch-total":"12","data-asset-prefetch-progress":"0/12","data-asset-prefetch-failed":"0","data-asset-prefetch-priority":"1","data-asset-prefetch-target":"town","data-asset-prefetch-save-data":"false","data-asset-prefetch-enabled":"true","data-asset-prefetch-town-state":"partial"}],[[2,27]],[[2,28]],[[2,29]],[[2,39]],[[2,40]],["SECTION",{"class":"gr-start-menu","data-testid":"start-menu","aria-label":"Gold Rush start menu","style":"--gr-menu-panel: url(\"http://127.0.0.1:5189/assets/processed/ui-menu-panel.png\");"},[[1,1]],["DIV",{"class":"gr-start-menu__backdrop","data-asset-slot":"ui-menu-backdrop","data-asset-state":"ready","data-era-backdrop":"kit-era-1","style":"background-image: url(\"/assets/processed/kit-era-1.png\");"}],[[1,3]],["DIV",{"class":"gr-start-menu__column"},[[1,4]],[[1,5]],[[1,6]],[[1,8]],[[1,9]],[[1,11]],[[1,12]],[[1,14]],[[1,15]],["NAV",{"class":"gr-start-menu__nav","aria-label":"Claim actions"},[[1,16]],["BUTTON",{"__playwright_target__":"","class":"gr-start-menu__button gr-start-menu__button--primary","type":"button","data-menu-action":"town","data-testid":"start-menu-enter-town"},[[1,17]]],[[1,