olid rgba(46, 27, 14, 0.45);\n  border-radius: 5px;\n  padding: 7px 8px;\n  color: inherit;\n  background: #fff8e8;\n  font: inherit;\n}\n\n.assay-bench button {\n  justify-self: start;\n  border: 0;\n  border-radius: 6px;\n  padding: 8px 10px;\n  color: #fff8e8;\n  background: #5b8a8a;\n  font: inherit;\n  cursor: pointer;\n}\n\n.assay-bench button[hidden] {\n  display: none;\n}\n\n.assay-bench__wire {\n  margin: 0;\n  padding: 7px 8px;\n  border-left: 3px solid #9a6a28;\n  color: #4b3828;\n  background: rgba(255, 248, 232, 0.72);\n}\n\n.assay-bench__close {\n  min-width: 34px;\n  min-height: 34px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1;\n}\n\n.assay-bench button:focus-visible {\n  outline: 3px solid #ffe4a0;\n  outline-offset: 2px;\n}\n\n.assay-bench pre,\n.assay-bench code {\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  font-family: \"JetBrains Mono\", ui-monospace, monospace;\n  font-size: 11px;\n}\n\n.assay-bench ol,\n.assay-bench ul {\n  display: grid;\n  gap: 5px;\n  margin: 0;\n  padding-left: 18px;\n}\n\n.assay-bench__pending-order {\n  padding-left: 6px;\n  border-left: 3px solid #5b8a8a;\n  color: #4b3828;\n}\n\n.assay-bench ol:empty::after,\n.assay-bench ul:empty::after {\n  content: \"None\";\n  opacity: 0.7;\n}\n\n@media (max-width: 760px) {\n  .assay-bench {\n    top: calc(max(12px, env(safe-area-inset-top)) + 150px);\n    right: max(12px, env(safe-area-inset-right));\n    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 354px);\n    width: min(430px, calc(100vw - 24px));\n    max-height: calc(100vh - 174px);\n  }\n}\n\n.complaint-desk.town-ui__board-shell {\n  position: fixed;\n  inset: 0;\n  z-index: 30;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  width: min(780px, calc(100vw - 28px));\n  height: min(760px, calc(100vh - 28px));\n  height: min(760px, calc(100dvh - 28px));\n  max-height: min(760px, calc(100vh - 28px));\n  min-height: 0;\n  box-sizing: border-box;\n  margin: auto;\n  overflow: hidden;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 8px;\n  color: var(--at-wood-950);\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.96), rgba(245, 230, 200, 0.96)),\n    var(--at-sand-100);\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.38),\n    0 7px 0 rgba(46, 27, 14, 0.68),\n    0 22px 48px rgba(46, 27, 14, 0.48);\n  font: 14px/1.4 Wellfleet, Georgia, serif;\n}\n\n.complaint-desk[hidden] {\n  display: none;\n}\n\n.complaint-desk::before,\n.complaint-desk::after {\n  position: absolute;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  content: \"\";\n  background: var(--at-brass-700);\n  box-shadow: inset 0 1px 0 rgba(255, 248, 232, 0.52);\n}\n\n.complaint-desk::before { top: 7px; left: 7px; }\n.complaint-desk::after { right: 7px; bottom: 7px; }\n\n.complaint-desk__header {\n  display: flex;\n  align-items: start;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 16px 18px 13px;\n  border-bottom: 2px solid rgba(46, 27, 14, 0.58);\n  background: rgba(255, 248, 232, 0.58);\n}\n\n.complaint-desk__header h2,\n.complaint-desk__header p,\n.complaint-desk__moment p,\n.complaint-desk__status {\n  margin: 0;\n}\n\n.complaint-desk__header h2 {\n  font-size: clamp(1.35rem, 4vw, 2rem);\n  line-height: 1.05;\n}\n\n.complaint-desk__eyebrow {\n  color: var(--at-teal-600);\n  font-size: 0.76rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.complaint-desk__close {\n  min-width: 44px;\n  min-height: 44px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 8px;\n  color: var(--at-wood-950);\n  background: var(--at-sand-200);\n  font: 900 1rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.complaint-desk__body {\n  display: grid;\n  grid-template-rows: minmax(0, 1fr) auto;\n  min-height: 0;\n}\n\n.complaint-desk__fields {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(220px, 0.72fr);\n  align-content: start;\n  gap: 12px;\n  min-height: 0;\n  padding: 16px 18px;\n  overflow-y: auto;\n}\n\n.complaint-desk label {\n  display: grid;\n  gap: 5px;\n  font-weight: 800;\n}\n\n.complaint-desk__description {\n  grid-row: span 2;\n}\n\n.complaint-desk textarea,\n.complaint-desk input {\n  width: 100%;\n  box-sizing: border-box;\n  border: 1px solid rgba(46, 27, 14, 0.5);\n  border-radius: 6px;\n  padding: 9px 10px;\n  color: inherit;\n  background: var(--at-cream-50);\n  font: inherit;\n}\n\n.complaint-desk textarea {\n  min-height: 150px;\n  resize: vertical;\n}\n\n.complaint-desk__moment {\n  grid-column: 1 / -1;\n  display: grid;\n  grid-template-columns: minmax(180px, 0.55fr) minmax(0, 1fr);\n  gap: 12px;\n  align-items: center;\n  padding: 10px;\n  border: 1px solid rgba(46, 27, 14, 0.35);\n  border-radius: 7px;\n  background: rgba(255, 248, 232, 0.7);\n}\n\n.complaint-desk__moment--dragging {\n  outline: 3px dashed var(--at-teal-600);\n  outline-offset: -4px;\n}\n\n.complaint-desk__moment img {\n  display: block;\n  width: 100%;\n  max-height: 220px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 6px;\n  object-fit: cover;\n}\n\n.complaint-desk__evidence-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 8px;\n}\n\n.complaint-desk label.complaint-desk__upload {\n  display: inline-flex;\n  align-items: center;\n  cursor: pointer;\n}\n\n.complaint-desk__upload input {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  clip-path: inset(50%);\n}\n\n.complaint-desk__upload-hint {\n  margin-top: 8px !important;\n  font-size: 0.78rem;\n}\n\n.complaint-desk__diagnostics,\n.complaint-desk__bounty {\n  grid-column: 1 / -1;\n  margin: 0;\n  padding: 9px 10px;\n  border-left: 4px solid var(--at-teal-600);\n  background: rgba(91, 138, 138, 0.12);\n}\n\n.complaint-desk__prize {\n  grid-column: 1 / -1;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 10px;\n  align-items: end;\n}\n\n.complaint-desk__bounty {\n  border-color: var(--at-ochre-500);\n  background: rgba(196, 136, 58