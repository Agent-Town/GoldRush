n}\n\n.gr-load-card h3 {\n  font-size: 1rem;\n}\n\n.gr-load-card p,\n.gr-load-claims__empty,\n.gr-load-claims__message {\n  color: rgba(46, 27, 14, 0.74);\n  font-size: 0.82rem;\n  line-height: 1.3;\n}\n\n.gr-load-card__actions,\n.gr-load-card__rename {\n  display: grid;\n  gap: 8px;\n}\n\n.gr-load-card__rename {\n  grid-template-columns: minmax(0, 1fr) minmax(76px, max-content);\n}\n\n.gr-load-card__rename input {\n  min-width: 0;\n  min-height: 44px;\n  border: 1px solid rgba(46, 27, 14, 0.38);\n  border-radius: 6px;\n  padding: 0 9px;\n  color: #2e1b0e;\n  background: #fff8e8;\n  font: inherit;\n}\n\n.gr-start-menu__small-button--danger {\n  background:\n    linear-gradient(135deg, rgba(160, 82, 45, 0.94), rgba(127, 38, 51, 0.9)),\n    #a0522d;\n  color: #fff8e8;\n}\n\n@media (min-width: 761px) {\n  .gr-load-card__actions {\n    grid-template-columns: minmax(0, 1fr) minmax(112px, 0.38fr);\n    align-items: start;\n  }\n\n  .gr-load-card__rename {\n    grid-column: 1 / -1;\n  }\n\n  .gr-load-card__actions > .gr-start-menu__small-button--danger {\n    grid-column: 2;\n    grid-row: 1;\n  }\n}\n\n.gr-start-menu__research-grid {\n  display: grid;\n  gap: 8px;\n  margin: 10px 0;\n}\n\n.gr-start-menu__research-grid article {\n  display: grid;\n  gap: 4px;\n  padding: 10px;\n  border: 1px solid rgba(46, 27, 14, 0.28);\n  border-radius: 6px;\n  background: rgba(255, 248, 232, 0.72);\n}\n\n.gr-start-menu__research-grid span {\n  color: #5b8a8a;\n  font-size: 12px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.gr-start-menu__research-grid p {\n  font-size: 13px;\n  line-height: 1.35;\n}\n\n.research-chart {\n  min-width: 0;\n  --research-ink: #2e1b0e;\n  --research-teal: #5b8a8a;\n  --research-brass: #8b7d3c;\n  --research-ochre: #c4883a;\n  --research-paper: rgba(255, 248, 232, 0.88);\n  --research-paper-warm: rgba(255, 228, 160, 0.34);\n}\n\n.research-chart__header,\n.research-chart__body {\n  display: grid;\n  gap: 14px;\n}\n\n.research-chart__header {\n  grid-template-columns: minmax(0, 1fr) minmax(210px, auto);\n  align-items: end;\n}\n\n.research-chart__header h2,\n.research-chart__header p,\n.research-chart__branch h3,\n.research-chart__selection h3,\n.research-chart__continued h3 {\n  margin: 0;\n}\n\n.research-chart__meter {\n  justify-self: end;\n  max-width: 420px;\n  color: var(--research-ink);\n  font-size: 13px;\n  line-height: 1.35;\n  text-align: right;\n}\n\n.research-impact__legacy-copy {\n  display: none;\n}\n\n.research-chart__body {\n  grid-template-columns: minmax(0, 1fr) minmax(230px, 280px);\n  align-items: start;\n}\n\n.research-chart__branches {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(220px, 1fr)) minmax(150px, 0.48fr);\n  gap: 14px;\n  min-width: 0;\n}\n\n.research-chart__branch,\n.research-chart__selection,\n.research-chart__continued,\n.research-chart__epoch {\n  border: 1px solid rgba(46, 27, 14, 0.32);\n  border-radius: 8px;\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.86), rgba(245, 230, 200, 0.78)),\n    repeating-linear-gradient(90deg, rgba(46, 27, 14, 0.035) 0 1px, transparent 1px 12px);\n}\n\n.research-chart__branch,\n.research-chart__selection,\n.research-chart__continued {\n  padding: 14px;\n}\n\n.research-chart__branch h3,\n.research-chart__selection h3,\n.research-chart__continued h3 {\n  color: var(--research-teal);\n  font-size: 13px;\n  text-transform: uppercase;\n}\n\n.research-chart__branch h3 {\n  display: grid;\n  grid-template-columns: 30px minmax(0, 1fr);\n  align-items: center;\n  gap: 8px;\n}\n\n.research-chart__branch-icon,\n.research-chart__node-icon {\n  display: block;\n  background-position: center;\n  background-repeat: no-repeat;\n  background-size: contain;\n}\n\n.research-chart__branch-icon {\n  width: 30px;\n  height: 30px;\n  border: 1px solid rgba(46, 27, 14, 0.35);\n  border-radius: 6px;\n  background-color: rgba(255, 248, 232, 0.76);\n}\n\n.research-chart__nodes {\n  display: grid;\n  gap: 0;\n  margin-top: 12px;\n}\n\n.research-chart__node {\n  position: relative;\n  display: grid;\n  gap: 8px;\n  width: 100%;\n  min-height: 128px;\n  border: 2px solid rgba(46, 27, 14, 0.28);\n  border-radius: 8px;\n  padding: 13px;\n  color: var(--research-ink);\n  background:\n    linear-gradient(180deg, var(--research-paper), rgba(245, 230, 200, 0.9)),\n    repeating-linear-gradient(135deg, rgba(46, 27, 14, 0.025) 0 1px, transparent 1px 11px);\n  font: inherit;\n  text-align: left;\n  cursor: pointer;\n}\n\n.research-chart__survey-line {\n  display: block;\n  width: 2px;\n  height: 24px;\n  margin: -1px 0 -1px 29px;\n  background: repeating-linear-gradient(180deg, rgba(46, 27, 14, 0.56) 0 4px, transparent 4px 8px);\n}\n\n.research-chart__survey-line::after {\n  content: \"\";\n  display: block;\n  width: 11px;\n  height: 2px;\n  margin-left: -4px;\n  background: rgba(46, 27, 14, 0.38);\n  transform: translateY(11px);\n}\n\n.research-chart__node:focus-visible {\n  outline: 3px solid #ffe4a0;\n  outline-offset: 2px;\n}\n\n.research-chart__node-topline {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n\n.research-chart__node-icon {\n  flex: 0 0 auto;\n  width: 46px;\n  height: 46px;\n  border: 1px solid rgba(46, 27, 14, 0.32);\n  border-radius: 8px;\n  background-color: rgba(255, 248, 232, 0.7);\n  box-shadow: inset 0 0 0 1px rgba(255, 248, 232, 0.5);\n}\n\n.research-chart__node strong {\n  font-size: 17px;\n  line-height: 1.12;\n}\n\n.research-chart__node .research-chart__effect,\n.research-chart__node em,\n.research-chart__node b,\n.research-chart__selection p,\n.research-chart__selection li,\n.research-chart__continued p {\n  font-size: 13px;\n  line-height: 1.42;\n}\n\n.research-chart__node em {\n  color: rgba(46, 27, 14, 0.68);\n  font-style: normal;\n}\n\n.research-chart__node b {\n  color: var(--research-brass);\n}\n\n.research-chart__state {\n  width: max-content;\n  color: var(--research-teal);\n  font-size: 11px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.research-chart__node[data-research-state=\"taken\"] {\n  border-color: var(--research-brass);\n  box-shadow: inset 0 0 0 2px rgba(139, 125, 60, 0.24);\n}\n\n.research-chart__node[data-research-state=\"available\"] {\n  border-color: var(--research-teal);\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.96), rgba(255, 228, 160, 0.52)),\n    repeating-linear-gradient(135deg, rgba(91, 138, 138, 0.045) 0 1px, transparent 1px 11px);\n  box-shadow:\n    inset 0 0 0 2px rgba(91, 138, 138, 0.14),\n    0 0 0 2px rgba(91, 138, 138, 0.2);\n}\n\n.research-chart__node[data-research-state=\"locked\"] {\n  opacity: 0.72;\n  color: rgba(46, 27, 14, 0.62);\n  background:\n    repeating-linear-gradient(135deg, rgba(46, 27, 14, 0.055) 0 2px, transparent 2px 10px),\n    rgba(232, 213, 168, 0.54);\n  filter: saturate(0.72);\n}\n\n.research-chart__node[data-research-state=\"locked\"] .research-chart__node-icon {\n  filter: grayscale(0.65) sepia(0.15);\n}\n\n.research-chart__node[data-selected-path=\"true\"] {\n  border-color: var(--research-ochre);\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.95), rgba(255, 228, 160, 0.52)),\n    repeating-linear-gradient(135deg, rgba(196, 136, 58, 0.07) 0 1px, transparent 1px 10px);\n}\n\n.research-chart__node[data-pinned-path=\"true\"] {\n  box-shadow:\n    inset 0 0 0 2px rgba(196, 136, 58, 0.22),\n    0 0 0 2px rgba(196, 136, 58, 0.18);\n}\n\n.research-chart__stamp,\n.research-chart__pin {\n  justify-self: start;\n  border: 2px solid currentColor;\n  border-radius: 5px;\n  padding: 2px 6px;\n  font-size: 11px;\n  line-height: 1;\n  transform: rotate(-2deg);\n}\n\n.research-chart__pin {\n  color: var(--research-ochre);\n  transform: none;\n}\n\n.research-chart__selection {\n  display: grid;\n  gap: 10px;\n  position: sticky;\n  top: 0;\n  border-width: 2px;\n  border-color: rgba(139, 125, 60, 0.5);\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.95), rgba(245, 230, 200, 0.92)),\n    repeating-linear-gradient(0deg, rgba(46, 27, 14, 0.04) 0 1px, transparent 1px 12px);\n}\n\n.research-chart__selection-kicker {\n  color: var(--research-ochre);\n  font-size: 11px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.research-impact {\n  display: grid;\n  gap: 7px;\n  border-top: 1px solid rgba(46, 27, 14, 0.24);\n  border-bottom: 1px solid rgba(46, 27, 14, 0.24);\n  padding: 9px 0;\n}\n\n.research-impact__badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.research-impact__badge {\n  width: max-content;\n  border: 1px solid var(--research-teal, #5b8a8a);\n  border-radius: 999px;\n  padding: 4px 8px;\n  color: #fff8e8;\n  background: var(--research-teal, #5b8a8a);\n  font-size: 11px;\n  font-weight: 900;\n  line-height: 1;\n  letter-spacing: 0.04em;\n}\n\n.research-chart__selection ol {\n  margin: 0;\n  padding-left: 18px;\n}\n\n.research-chart__epoch {\n  display: grid;\n  align-content: start;\n  gap: 4px;\n  min-height: 130px;\n  padding: 14px;\n  color: rgba(46, 27, 14, 0.48);\n  background:\n    linear-gradient(90deg, rgba(46, 27, 14, 0.18), transparent 16px),\n    repeating-linear-gradient(135deg, rgba(232, 213, 168, 0.62) 0 8px, rgba(255, 248, 232, 0.5) 8px 16px);\n}\n\n.research-chart__epoch span {\n  font-size: 12px;\n  text-transform: uppercase;\n}\n\n.research-chart__continued {\n  margin-top: 10px;\n}\n\n.gr-start-menu__small-button {\n  min-height: 44px;\n  padding: 8px 12px;\n  font-size: 14px;\n}\n\n@media (max-width: 760px) {\n  .gr-start-menu {\n    overflow: auto;\n  }\n\n  .gr-start-menu__column {\n    width: 100%;\n    min-width: 0;\n    min-height: 100%;\n    padding: max(22px, env(safe-area-inset-top)) 18px max(22px, env(safe-area-inset-bottom));\n    background: linear-gradient(180deg, rgba(46, 27, 14, 0.9), rgba(46, 27, 14, 0.64) 70%, rgba(46, 27, 14, 0.42));\n  }\n\n  .gr-start-menu__emblem {\n    width: 92px;\n  }\n\n  .gr-start-menu h1 {\n    font-size: 44px;\n  }\n\n  .gr-start-menu--research-open .gr-start-menu__column {\n    width: 100%;\n  }\n\n  .gr-start-menu--load-open .gr-start-menu__column {\n    width: 100%;\n  }\n\n  .gr-start-menu--research-open .gr-start-menu__nav {\n    grid-template-columns: 1fr;\n  }\n\n  .gr-start-menu--load-open .gr-start-menu__nav {\n    grid-template-columns: 1fr;\n  }\n\n  .gr-load-card {\n    grid-template-columns: 1fr;\n  }\n\n  .gr-load-card__rename {\n    grid-template-columns: 1fr;\n  }\n\n  .research-chart__header,\n  .research-chart__body {\n    grid-template-columns: 1fr;\n  }\n\n  .research-chart__meter {\n    justify-self: start;\n    text-align: left;\n  }\n\n  .research-chart__branches {\n    display: flex;\n    gap: 12px;\n    overflow-x: auto;\n    padding-bottom: 10px;\n    scroll-snap-type: x mandatory;\n  }\n\n  .research-chart__branch,\n  .research-chart__epoch {\n    flex: 0 0 min(340px, 86vw);\n    scroll-snap-align: start;\n  }\n\n  .research-chart__selection {\n    position: static;\n    order: -1;\n  }\n\n  .research-chart__node,\n  .research-chart__selection .gr-start-menu__small-button {\n    min-height: 44px;\n  }\n}\n\n#touch-controls {\n  position: absolute;\n  right: max(18px, env(safe-area-inset-right));\n  bottom: max(18px, env(safe-area-inset-bottom));\n  left: max(18px, env(safe-area-inset-left));\n  display: none;\n  justify-content: space-between;\n  align-items: flex-end;\n  pointer-events: none;\n}\n\n#touch-stick {\n  position: relative;\n  width: clamp(96px, 24vw, 132px);\n  aspect-ratio: 1;\n  border: 1px solid rgba(246, 241, 223, 0.28);\n  border-radius: 50%;\n  background: rgba(17, 19, 18, 0.52);\n  pointer-events: auto;\n  touch-action: none;\n}\n\n#touch-knob {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 42%;\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: #f5ba49;\n  box-shadow: 0 0 24px rgba(245, 186, 73, 0.44);\n  transform: translate(-50%, -50%);\n}\n\n#confirm-button,\n#rotate-button,\n#weapon-toggle-button {\n  width: clamp(74px, 18vw, 96px);\n  aspect-ratio: 1;\n  border: 1px solid rgba(246, 241, 223, 0.3);\n  border-radius: 50%;\n  color: #111312;\n  background: #48baa7;\n  font-weight: 800;\n  pointer-events: auto;\n  touch-action: none;\n}\n\n#rotate-button {\n  width: clamp(52px, 13vw, 68px);\n  background: #c4883a;\n}\n\n#weapon-toggle-button {\n  width: clamp(52px, 13vw, 68px);\n  background: #83ded7;\n}\n\n.hud-panel--weapon {\n  top: calc(max(16px, env(safe-area-inset-top)) + 58px);\n  right: max(16px, env(safe-area-inset-right));\n  display: grid;\n  grid-template-columns: max-content minmax(10ch, max-content);\n  align-items: baseline;\n  column-gap: 8px;\n  min-width: 168px;\n}\n\n.hud-panel--weapon .hud-value {\n  min-width: 10ch;\n}\n\n.hud-panel--weapon.hud-panel--disarmed > .hud-label,\n.hud-panel--weapon.hud-panel--disarmed > .hud-value {\n  opacity: 0.42;\n}\n\n.hud-weapon-reason {\n  grid-column: 1 / -1;\n  color: #7a4028;\n  font-size: 0.72rem;\n  font-style: italic;\n}\n\n.hud-agent-chip {\n  grid-column: 1 / -1;\n  display: grid;\n  grid-template-columns: 34px minmax(0, 1fr);\n  align-items: center;\n  gap: 4px 8px;\n  width: 100%;\n  max-width: 30ch;\n  min-height: 44px;\n  margin: 4px 0 0;\n  padding: 5px 0 0;\n  border-top: 1px solid rgba(255, 248, 232, 0.18);\n  border-right: 0;\n  border-bottom: 0;\n  border-left: 0;\n  color: inherit;\n  background: transparent;\n  font-size: 0.72rem;\n  font-family: inherit;\n  font-weight: 800;\n  text-align: left;\n  pointer-events: auto;\n  cursor: pointer;\n}\n\n.hud-agent-chip:hover,\n.hud-agent-chip:focus-visible {\n  outline: 2px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 3px;\n}\n\n.hud-agent-chip__portrait {\n  grid-row: span 2;\n  width: 34px;\n  height: 34px;\n  border: 1px solid rgba(46, 27, 14, 0.52);\n  border-radius: 6px;\n  object-fit: cover;\n  background: #f5e6c8;\n}\n\n.hud-agent-chip__main {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) max-content;\n  gap: 2px 6px;\n  width: 100%;\n  min-width: 0;\n}\n\n.hud-agent-chip__main [data-hud-agent-name] {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.hud-agent-chip strong {\n  color: #f5ba49;\n}\n\n.hud-agent-chip [data-hud-agent-label] {\n  grid-column: 1 / -1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.hud-agent-feed {\n  grid-column: 2;\n  max-width: 24ch;\n  overflow: hidden;\n  color: #83ded7;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.hud-agent-feed:empty {\n  display: none;\n}\n\n.hud-agent-detail {\n  display: none;\n  grid-column: 1 / -1;\n  max-width: 30ch;\n  padding: 6px 8px;\n  border: 1px solid rgba(46, 27, 14, 0.28);\n  border-radius: 6px;\n  color: #2e1b0e;\n  background: rgba(255, 248, 232, 0.88);\n  font-size: 0.7rem;\n  line-height: 1.25;\n  white-space: normal;\n}\n\n.hud-agent-chip:hover .hud-agent-detail,\n.hud-agent-chip:focus-visible .hud-agent-detail,\n.hud-agent-chip[data-open=\"true\"] .hud-agent-detail {\n  display: block;\n}\n\n.prospector-panel-shell {\n  position: fixed;\n  inset: 0;\n  z-index: 36;\n  display: grid;\n  align-items: start;\n  justify-items: end;\n  padding: calc(max(16px, env(safe-area-inset-top)) + 82px) max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));\n  background: rgba(17, 19, 18, 0.36);\n  backdrop-filter: blur(1px);\n  pointer-events: auto;\n}\n\n.prospector-panel-shell[hidden] {\n  display: none;\n}\n\n.prospector-panel {\n  display: grid;\n  gap: 12px;\n  width: min(456px, calc(100vw - 32px));\n  max-height: calc(100vh - 116px);\n  overflow: auto;\n  padding: 14px;\n  border: 2px solid #8b7d3c;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.95), rgba(245, 230, 200, 0.97)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 2px rgba(255, 248, 232, 0.5),\n    0 5px 0 rgba(46, 27, 14, 0.78),\n    0 18px 34px rgba(17, 19, 18, 0.32);\n  font-family: Wellfleet, Georgia, \"Iowan Old Style\", serif;\n}\n\n.prospector-panel__header {\n  display: grid;\n  grid-template-columns: 64px minmax(0, 1fr) 58px;\n  gap: 12px;\n  align-items: center;\n}\n\n.prospector-panel__portrait {\n  width: 64px;\n  height: 64px;\n  border: 2px solid rgba(46, 27, 14, 0.6);\n  border-radius: 8px;\n  object-fit: cover;\n  background: #fff8e8;\n}\n\n.prospector-panel__eyebrow,\n.prospector-panel p,\n.prospector-panel h2,\n.prospector-panel h3 {\n  margin: 0;\n}\n\n.prospector-panel__eyebrow {\n  color: #5b8a8a;\n  font-size: 0.74rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.prospector-panel__progress {\n  margin-top: 3px;\n  color: rgba(46, 27, 14, 0.76);\n  font-size: 0.78rem;\n  line-height: 1.3;\n}\n\n.prospector-panel h2 {\n  color: #2e1b0e;\n  font-size: 1.18rem;\n  line-height: 1.1;\n}\n\n.prospector-panel h3 {\n  color: #5b3a1f;\n  font-size: 0.82rem;\n  text-transform: uppercase;\n}\n\n.prospector-panel__close,\n.prospector-switch,\n.prospector-check {\n  min-height: 44px;\n  pointer-events: auto;\n}\n\n.prospector-panel__close {\n  min-width: 58px;\n  border: 2px solid #8b7d3c;\n  border-radius: 7px;\n  color: #2e1b0e;\n  background: #ffe4a0;\n  padding: 0 8px;\n  font: inherit;\n  font-weight: 900;\n  cursor: pointer;\n}\n\n.prospector-panel__close:hover,\n.prospector-panel__close:focus-visible,\n.prospector-switch:focus-within,\n.prospector-check:focus-within {\n  outline: 3px solid rgba(91, 138, 138, 0.6);\n  outline-offset: 2px;\n}\n\n.prospector-panel__section {\n  display: grid;\n  gap: 8px;\n  padding-top: 10px;\n  border-top: 1px solid rgba(139, 125, 60, 0.34);\n}\n\n.prospector-ladder,\n.prospector-abilities {\n  display: grid;\n  gap: 8px;\n}\n\n.prospector-rung {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(112px, max-content);\n  gap: 10px;\n  align-items: center;\n  min-height: 48px;\n  padding: 8px 0;\n  border-bottom: 1px solid rgba(46, 27, 14, 0.12);\n}\n\n.prospector-rung[data-earned=\"false\"] {\n  grid-template-columns: 1fr;\n}\n\n.prospector-rung[data-current=\"true\"] {\n  border-radius: 6px;\n  padding-right: 8px;\n  padding-left: 8px;\n  background: rgba(91, 138, 138, 0.16);\n  box-shadow: inset 3px 0 0 #5b8a8a;\n}\n\n.prospector-rung strong,\n.prospector-rung span {\n  display: block;\n}\n\n.prospector-rung span,\n.prospector-panel__hint,\n.prospector-receipts {\n  color: rgba(46, 27, 14, 0.78);\n  font-size: 0.78rem;\n  line-height: 1.35;\n}\n\n.prospector-rung__current {\n  color: #5b8a8a;\n  font-size: 0.68rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.prospector-switch,\n.prospector-check {\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr);\n  gap: 8px;\n  align-items: center;\n  cursor: pointer;\n}\n\n.prospector-switch input,\n.prospector-check input {\n  width: 20px;\n  height: 20px;\n  accent-color: #5b8a8a;\n}\n\n.prospector-check {\n  padding: 8px 0;\n}\n\n.prospector-check[data-allowed=\"false\"] span {\n  color: #a0522d;\n}\n\n.prospector-check--locked {\n  grid-template-columns: auto minmax(0, 1fr);\n  cursor: default;\n}\n\n.prospector-lock {\n  width: auto;\n  font-size: 0.62rem;\n  font-weight: 900;\n  text-transform: uppercase;\n  text-align: center;\n}\n\n.prospector-check small {\n  font-size: 0.72rem;\n  font-weight: 800;\n}\n\n.prospector-receipts-wrap {\n  min-width: 0;\n}\n\n.prospector-receipts-wrap summary {\n  display: grid;\n  grid-template-columns: max-content minmax(0, 1fr);\n  gap: 8px;\n  align-items: center;\n  min-height: 44px;\n  color: #5b3a1f;\n  cursor: pointer;\n}\n\n.prospector-receipts-wrap summary span {\n  color: #5b3a1f;\n  font-size: 0.82rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.prospector-receipts-wrap summary strong {\n  min-width: 0;\n  overflow: hidden;\n  color: rgba(46, 27, 14, 0.78);\n  font-size: 0.78rem;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.prospector-receipts {\n  display: grid;\n  gap: 8px;\n  max-height: 184px;\n  margin: 0;\n  padding: 0 0 0 20px;\n  overflow: auto;\n}\n\n.prospector-receipts li {\n  padding: 2px 0;\n}\n\n.hud-panel--build {\n  position: absolute;\n  z-index: 7;\n  left: max(18px, env(safe-area-inset-left));\n  bottom: max(18px, env(safe-area-inset-bottom));\n  width: min(340px, calc(100vw - 36px));\n}\n\n.hud-build-control {\n  display: grid;\n  gap: 8px;\n  pointer-events: auto;\n}\n\n.hud-build-menu {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px;\n}\n\n.hud-build-menu[hidden] {\n  display: none;\n}\n\n.hud-build-blurb {\n  grid-column: 1 / -1;\n  min-height: 58px;\n  border: 1px solid rgba(46, 27, 14, 0.58);\n  border-radius: 8px;\n  padding: 8px 10px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.96), rgba(232, 213, 168, 0.98)),\n    #f5e6c8;\n  box-shadow: inset 0 0 0 1px rgba(91, 138, 138, 0.24);\n}\n\n.hud-build-blurb strong,\n.hud-build-blurb span {\n  display: block;\n}\n\n.hud-build-blurb strong {\n  font-size: 0.78rem;\n  font-weight: 900;\n}\n\n.hud-build-blurb span {\n  margin-top: 2px;\n  font-size: 0.74rem;\n  font-weight: 800;\n  line-height: 1.22;\n  overflow-wrap: anywhere;\n}\n\n.hud-build-button {\n  width: 100%;\n  min-height: 44px;\n  border: 1px solid rgba(246, 241, 223, 0.34);\n  border-radius: 8px;\n  padding: 10px 12px;\n  color: #fff8e8;\n  background: rgba(47, 143, 133, 0.82);\n  font: inherit;\n  font-weight: 800;\n  box-shadow: 0 0 18px rgba(131, 222, 215, 0.22);\n}\n\n.hud-build-tile {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  align-items: center;\n  column-gap: 8px;\n  min-height: 64px;\n  border: 1px solid rgba(46, 27, 14, 0.58);\n  border-radius: 8px;\n  padding: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(245, 230, 200, 0.98)),\n    #f5e6c8;\n  box-shadow: inset 0 0 0 1px rgba(139, 125, 60, 0.32);\n  font: inherit;\n  text-align: left;\n}\n\n.hud-build-tile[data-selected=\"true\"] {\n  outline: 2px solid #5b8a8a;\n  outline-offset: 1px;\n}\n\n.hud-build-tile:disabled {\n  color: rgba(46, 27, 14, 0.46);\n  background: rgba(245, 230, 200, 0.68);\n}\n\n.hud-build-tile__key,\n.hud-build-tile__meta {\n  color: rgba(46, 27, 14, 0.66);\n  font-size: 0.72rem;\n  font-weight: 800;\n}\n\n.hud-build-tile__name {\n  display: block;\n  margin: 2px 0;\n  font-size: 0.88rem;\n  font-weight: 900;\n}\n\n.hud-build-button[data-active=\"true\"] {\n  background: #2f8f85;\n  outline: 2px solid rgba(255, 248, 232, 0.5);\n}\n\n.hud-build-button:disabled {\n  color: rgba(255, 248, 232, 0.5);\n  background: rgba(46, 27, 14, 0.58);\n  box-shadow: none;\n}\n\n.prompt-stack {\n  position: absolute;\n  left: 50%;\n  bottom: calc(max(18px, env(safe-area-inset-bottom)) + 88px);\n  z-index: 6;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  align-items: center;\n  width: min(760px, calc(100vw - 32px));\n  pointer-events: none;\n  transform: translateX(-50%);\n}\n\n#hud[data-paused=\"true\"] .prompt-stack {\n  display: none;\n}\n\n#hud[data-paused=\"true\"] .hud-panel--weapon,\n#hud[data-paused=\"true\"] .hud-panel--xp,\n#hud[data-paused=\"true\"] .hud-panel--build,\nbody:has(#hud[data-paused=\"true\"]) #touch-controls,\nbody:has(.gr-start-menu) #touch-controls,\nbody:has(.gr-profile-title) #touch-controls {\n  display: none;\n}\n\n.assay-office-prompt {\n  padding: 8px 12px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.88), rgba(245, 230, 200, 0.96)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 1px rgba(139, 125, 60, 0.36),\n    0 4px 0 rgba(46, 27, 14, 0.62),\n    0 12px 20px rgba(46, 27, 14, 0.22);\n  font: 800 0.86rem/1.1 Wellfleet, Georgia, serif;\n  pointer-events: none;\n}\n\n.building-context-prompt {\n  display: grid;\n  grid-template-columns: 28px minmax(150px, 1fr) minmax(132px, auto) minmax(132px, auto);\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 8px 10px 8px 12px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(245, 230, 200, 0.97)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 1px rgba(139, 125, 60, 0.36),\n    0 4px 0 rgba(46, 27, 14, 0.62),\n    0 12px 20px rgba(46, 27, 14, 0.22);\n  font: 800 0.86rem/1.15 Wellfleet, Georgia, serif;\n  pointer-events: auto;\n}\n\n.world-info-note {\n  display: grid;\n  gap: 4px;\n  width: min(460px, 100%);\n  padding: 8px 12px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(245, 230, 200, 0.96)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 1px rgba(91, 138, 138, 0.26),\n    0 4px 0 rgba(46, 27, 14, 0.55),\n    0 12px 20px rgba(46, 27, 14, 0.18);\n  font: 800 0.82rem/1.2 Wellfleet, Georgia, serif;\n  pointer-events: none;\n}\n\n.world-info-note__title {\n  color: #2e1b0e;\n  font-size: 0.88rem;\n  line-height: 1.05;\n  overflow-wrap: anywhere;\n}\n\n.world-info-note__body,\n.world-info-note__hint {\n  margin: 0;\n  color: rgba(46, 27, 14, 0.82);\n  overflow-wrap: anywhere;\n}\n\n.world-info-note__hint {\n  color: #5b8a8a;\n  font-size: 0.72rem;\n}\n\n.world-info-note--compact {\n  width: max-content;\n  max-width: 100%;\n  padding: 6px 10px;\n}\n\n.world-info-note--compact .world-info-note__title {\n  font-size: 0.82rem;\n}\n\n.building-context-prompt__icon {\n  display: inline-grid;\n  width: 24px;\n  height: 24px;\n  place-items: center;\n  border: 2px solid #2e1b0e;\n  border-radius: 50%;\n  color: #fff8e8;\n  background: #8b7d3c;\n  box-shadow: inset 0 0 0 1px rgba(255, 248, 232, 0.28);\n  font-size: 0.78rem;\n}\n\n.building-context-prompt__title {\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.building-context-prompt__loss {\n  grid-column: 2 / -1;\n  min-width: 0;\n  color: #2e1b0e;\n  font-size: 0.72rem;\n  line-height: 1.1;\n  opacity: 0.76;\n}\n\n.building-context-prompt__button {\n  min-width: 0;\n  padding: 6px 9px;\n  border: 2px solid #2e1b0e;\n  border-radius: 6px;\n  color: #fff8e8;\n  background: #a0522d;\n  box-shadow: 0 2px 0 rgba(46, 27, 14, 0.55);\n  font: inherit;\n}\n\n.building-context-prompt__button--upgrade {\n  background: #5b8a8a;\n}\n\n.building-context-prompt__button--fund {\n  background: #5b8a8a;\n}\n\n.building-context-prompt__button[hidden] {\n  display: none;\n}\n\n.building-context-prompt__button:disabled {\n  color: rgba(46, 27, 14, 0.7);\n  background: rgba(139, 125, 60, 0.22);\n  box-shadow: none;\n}\n\n.assay-office-prompt[hidden] {\n  display: none;\n}\n\n.building-context-prompt[hidden] {\n  display: none;\n}\n\n.world-info-note[hidden] {\n  display: none;\n}\n\n@media (pointer: coarse), (max-width: 760px) {\n  .prompt-stack {\n    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 190px);\n  }\n}\n\n@media (max-width: 560px) {\n  .prompt-stack {\n    width: calc(100vw - 28px);\n  }\n\n  .building-context-prompt {\n    grid-template-columns: 24px minmax(0, 1fr);\n    align-items: stretch;\n  }\n\n  .world-info-note {\n    width: 100%;\n  }\n\n  .building-context-prompt__button,\n  .building-context-prompt__loss {\n    grid-column: 1 / -1;\n  }\n}\n\n@media (max-width: 430px) {\n  .assay-office-prompt__key {\n    display: none;\n  }\n}\n\n.upgrade-overlay {\n  position: absolute;\n  inset: 0;\n  z-index: 11;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  pointer-events: none;\n  opacity: 0;\n  background: rgba(46, 27, 14, 0.46);\n}\n\n.upgrade-overlay--visible {\n  pointer-events: auto;\n  opacity: 1;\n}\n\n.upgrade-overlay__panel {\n  width: min(820px, 100%);\n}\n\n.upgrade-overlay__cards {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 14px;\n}\n\n.upgrade-card {\n  position: relative;\n  min-height: 166px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  padding: 24px 18px 18px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(246, 241, 223, 0.98)),\n    #f6f1df;\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.42),\n    0 4px 0 rgba(46, 27, 14, 0.78),\n    0 16px 28px rgba(46, 27, 14, 0.28);\n  cursor: pointer;\n  font: inherit;\n  text-align: left;\n}\n\n.upgrade-card:hover,\n.upgrade-card:focus-visible {\n  outline: 3px solid #ffe4a0;\n  outline-offset: 3px;\n}\n\n@media (pointer: coarse), (max-width: 760px) {\n  #touch-controls {\n    display: block;\n    height: 232px;\n  }\n\n  .prompt-stack {\n    left: max(14px, env(safe-area-inset-left));\n    right: calc(max(14px, env(safe-area-inset-right)) + 88px);\n    width: auto;\n    align-items: stretch;\n    transform: none;\n  }\n\n  .hud-panel.hud-panel--build {\n    right: max(18px, env(safe-area-inset-right));\n    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 232px);\n    left: auto;\n    width: 76px;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    box-shadow: none;\n  }\n\n  .hud-panel.hud-panel--build::before,\n  .hud-panel.hud-panel--build::after {\n    display: none;\n  }\n\n  .hud-panel.hud-panel--build:has(.hud-build-menu:not([hidden])) {\n    right: max(12px, env(safe-area-inset-right));\n    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 170px);\n    left: max(12px, env(safe-area-inset-left));\n    width: auto;\n    max-height: calc(100vh - max(12px, env(safe-area-inset-top)) - max(18px, env(safe-area-inset-bottom)) - 190px);\n    overflow: hidden;\n    padding: 8px;\n    border: 2px solid #2e1b0e;\n    background:\n      linear-gradient(135deg, rgba(255, 248, 232, 0.78), rgba(245, 230, 200, 0.94)),\n      #f5e6c8;\n    box-shadow:\n      inset 0 0 0 2px rgba(139, 125, 60, 0.38),\n      0 4px 0 rgba(46, 27, 14, 0.7),\n      0 12px 24px rgba(46, 27, 14, 0.18);\n  }\n\n  #hud:has(.hud-panel--build .hud-build-menu:not([hidden])) .hud-panel--xp,\n  #hud:has(.hud-panel--build .hud-build-menu:not([hidden])) .hud-panel--weapon,\n  #hud:has(.hud-panel--build .hud-build-menu:not([hidden])) .hud-pause,\n  #hud:has(.hud-panel--build .hud-build-menu:not([hidden])) .prompt-stack {\n    display: none;\n  }\n\n  .hud-panel.hud-panel--build:has(.hud-build-menu:not([hidden])) .hud-build-control {\n    grid-template-rows: minmax(0, 1fr) auto;\n    max-height: inherit;\n  }\n\n  .hud-panel.hud-panel--build:has(.hud-build-menu:not([hidden])) .hud-build-menu {\n    overflow: auto;\n    overscroll-behavior: contain;\n  }\n\n  .hud-build-tile {\n    min-height: 54px;\n  }\n\n  .hud-build-blurb {\n    min-height: 64px;\n  }\n\n  .hud-build-button {\n    display: grid;\n    place-items: center;\n    width: 76px;\n    min-height: 76px;\n    border-radius: 50%;\n    padding: 0 8px;\n    text-align: center;\n  }\n\n  .hud-panel.hud-panel--build:has(.hud-build-menu:not([hidden])) .hud-build-button {\n    width: 100%;\n    min-height: 44px;\n    border-radius: 8px;\n  }\n\n  #touch-stick {\n    position: absolute;\n    bottom: 0;\n    left: 0;\n    width: clamp(104px, 28vw, 126px);\n  }\n\n  #confirm-button {\n    position: absolute;\n    right: 0;\n    bottom: 0;\n    width: 76px;\n  }\n\n  #rotate-button {\n    position: absolute;\n    right: 98px;\n    bottom: 10px;\n    width: 58px;\n  }\n\n  #weapon-toggle-button {\n    position: absolute;\n    right: 50px;\n    bottom: 78px;\n    width: 58px;\n  }\n\n  .hud-panel--weapon {\n    top: calc(max(12px, env(safe-area-inset-top)) + 52px);\n    right: max(12px, env(safe-area-inset-right));\n    min-width: 146px;\n    grid-template-columns: 1fr;\n    gap: 2px;\n  }\n\n  .hud-agent-chip {\n    grid-template-columns: 30px minmax(0, 1fr);\n    max-width: 20ch;\n  }\n\n  .hud-agent-chip__portrait {\n    width: 30px;\n    height: 30px;\n  }\n\n  .hud-agent-feed {\n    grid-column: 2;\n  }\n\n  .hud-agent-detail {\n    max-width: 20ch;\n  }\n\n  .prospector-panel-shell {\n    align-items: end;\n    justify-items: stretch;\n    padding: 0;\n    background: rgba(17, 19, 18, 0.58);\n    backdrop-filter: blur(1.5px);\n  }\n\n  .prospector-panel {\n    width: 100%;\n    max-height: min(84vh, 720px);\n    border-right: 0;\n    border-bottom: 0;\n    border-left: 0;\n    border-radius: 8px 8px 0 0;\n    padding: 14px max(14px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(14px, env(safe-area-inset-left));\n  }\n\n  .prospector-rung {\n    grid-template-columns: 1fr;\n  }\n\n  .prospector-receipts-wrap:not([open]) .prospector-receipts {\n    display: none;\n  }\n\n  .prospector-receipts-wrap[open] summary {\n    border-bottom: 1px solid rgba(139, 125, 60, 0.34);\n    margin-bottom: 6px;\n  }\n\n  .upgrade-overlay__cards {\n    grid-template-columns: 1fr;\n  }\n\n  .upgrade-card {\n    min-height: 128px;\n  }\n}\n\n.assay-bench {\n  position: fixed;\n  top: calc(max(16px, env(safe-area-inset-top)) + 126px);\n  right: max(16px, env(safe-area-inset-right));\n  z-index: 30;\n  display: grid;\n  width: min(430px, calc(100vw - 32px));\n  max-height: calc(100vh - 150px);\n  gap: 8px;\n  overflow: auto;\n  padding: 10px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background: rgba(245, 230, 200, 0.96);\n  box-shadow: 0 14px 32px rgba(46, 27, 14, 0.34);\n  font: 13px/1.35 Wellfleet, Georgia, serif;\n}\n\n.assay-bench[hidden] {\n  display: none;\n}\n\n.assay-bench__header {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 10px;\n  align-items: start;\n}\n\n.assay-bench__hint {\n  margin: 5px 0 0;\n  padding: 7px 8px;\n  border-left: 3px solid #5b8a8a;\n  background: rgba(255, 248, 232, 0.72);\n}\n\n.assay-bench__form,\n.assay-bench__card {\n  display: grid;\n  gap: 8px;\n}\n\n.assay-bench__card {\n  padding: 8px;\n  border: 1px solid rgba(46, 27, 14, 0.35);\n  border-radius: 6px;\n  background: rgba(255, 248, 232, 0.78);\n}\n\n.assay-bench label {\n  display: grid;\n  gap: 4px;\n}\n\n.assay-bench textarea,\n.assay-bench input {\n  width: 100%;\n  box-sizing: border-box;\n  border: 1px solid rgba(46, 27, 14, 0.45);\n  border-radius: 5px;\n  padding: 7px 8px;\n  color: inherit;\n  background: #fff8e8;\n  font: inherit;\n}\n\n.assay-bench button {\n  justify-self: start;\n  border: 0;\n  border-radius: 6px;\n  padding: 8px 10px;\n  color: #fff8e8;\n  background: #5b8a8a;\n  font: inherit;\n  cursor: pointer;\n}\n\n.assay-bench button[hidden] {\n  display: none;\n}\n\n.assay-bench__wire {\n  margin: 0;\n  padding: 7px 8px;\n  border-left: 3px solid #9a6a28;\n  color: #4b3828;\n  background: rgba(255, 248, 232, 0.72);\n}\n\n.assay-bench__close {\n  min-width: 34px;\n  min-height: 34px;\n  padding: 0;\n  font-size: 16px;\n  line-height: 1;\n}\n\n.assay-bench button:focus-visible {\n  outline: 3px solid #ffe4a0;\n  outline-offset: 2px;\n}\n\n.assay-bench pre,\n.assay-bench code {\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  font-family: \"JetBrains Mono\", ui-monospace, monospace;\n  font-size: 11px;\n}\n\n.assay-bench ol,\n.assay-bench ul {\n  display: grid;\n  gap: 5px;\n  margin: 0;\n  padding-left: 18px;\n}\n\n.assay-bench__pending-order {\n  padding-left: 6px;\n  border-left: 3px solid #5b8a8a;\n  color: #4b3828;\n}\n\n.assay-bench ol:empty::after,\n.assay-bench ul:empty::after {\n  content: \"None\";\n  opacity: 0.7;\n}\n\n@media (max-width: 760px) {\n  .assay-bench {\n    top: calc(max(12px, env(safe-area-inset-top)) + 150px);\n    right: max(12px, env(safe-area-inset-right));\n    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 354px);\n    width: min(430px, calc(100vw - 24px));\n    max-height: calc(100vh - 174px);\n  }\n}\n\n.complaint-desk.town-ui__board-shell {\n  position: fixed;\n  inset: 0;\n  z-index: 30;\n  display: grid;\n  grid-template-rows: auto minmax(0, 1fr);\n  width: min(780px, calc(100vw - 28px));\n  height: min(760px, calc(100vh - 28px));\n  height: min(760px, calc(100dvh - 28px));\n  max-height: min(760px, calc(100vh - 28px));\n  min-height: 0;\n  box-sizing: border-box;\n  margin: auto;\n  overflow: hidden;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 8px;\n  color: var(--at-wood-950);\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.96), rgba(245, 230, 200, 0.96)),\n    var(--at-sand-100);\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.38),\n    0 7px 0 rgba(46, 27, 14, 0.68),\n    0 22px 48px rgba(46, 27, 14, 0.48);\n  font: 14px/1.4 Wellfleet, Georgia, serif;\n}\n\n.complaint-desk[hidden] {\n  display: none;\n}\n\n.complaint-desk::before,\n.complaint-desk::after {\n  position: absolute;\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  content: \"\";\n  background: var(--at-brass-700);\n  box-shadow: inset 0 1px 0 rgba(255, 248, 232, 0.52);\n}\n\n.complaint-desk::before { top: 7px; left: 7px; }\n.complaint-desk::after { right: 7px; bottom: 7px; }\n\n.complaint-desk__header {\n  display: flex;\n  align-items: start;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 16px 18px 13px;\n  border-bottom: 2px solid rgba(46, 27, 14, 0.58);\n  background: rgba(255, 248, 232, 0.58);\n}\n\n.complaint-desk__header h2,\n.complaint-desk__header p,\n.complaint-desk__moment p,\n.complaint-desk__status {\n  margin: 0;\n}\n\n.complaint-desk__header h2 {\n  font-size: clamp(1.35rem, 4vw, 2rem);\n  line-height: 1.05;\n}\n\n.complaint-desk__eyebrow {\n  color: var(--at-teal-600);\n  font-size: 0.76rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.complaint-desk__close {\n  min-width: 44px;\n  min-height: 44px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 8px;\n  color: var(--at-wood-950);\n  background: var(--at-sand-200);\n  font: 900 1rem/1 Wellfleet, Georgia, serif;\n  cursor: pointer;\n}\n\n.complaint-desk__body {\n  display: grid;\n  grid-template-rows: minmax(0, 1fr) auto;\n  min-height: 0;\n}\n\n.complaint-desk__fields {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(220px, 0.72fr);\n  align-content: start;\n  gap: 12px;\n  min-height: 0;\n  padding: 16px 18px;\n  overflow-y: auto;\n}\n\n.complaint-desk label {\n  display: grid;\n  gap: 5px;\n  font-weight: 800;\n}\n\n.complaint-desk__description {\n  grid-row: span 2;\n}\n\n.complaint-desk textarea,\n.complaint-desk input {\n  width: 100%;\n  box-sizing: border-box;\n  border: 1px solid rgba(46, 27, 14, 0.5);\n  border-radius: 6px;\n  padding: 9px 10px;\n  color: inherit;\n  background: var(--at-cream-50);\n  font: inherit;\n}\n\n.complaint-desk textarea {\n  min-height: 150px;\n  resize: vertical;\n}\n\n.complaint-desk__moment {\n  grid-column: 1 / -1;\n  display: grid;\n  grid-template-columns: minmax(180px, 0.55fr) minmax(0, 1fr);\n  gap: 12px;\n  align-items: center;\n  padding: 10px;\n  border: 1px solid rgba(46, 27, 14, 0.35);\n  border-radius: 7px;\n  background: rgba(255, 248, 232, 0.7);\n}\n\n.complaint-desk__moment--dragging {\n  outline: 3px dashed var(--at-teal-600);\n  outline-offset: -4px;\n}\n\n.complaint-desk__moment img {\n  display: block;\n  width: 100%;\n  max-height: 220px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 6px;\n  object-fit: cover;\n}\n\n.complaint-desk__evidence-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 8px;\n}\n\n.complaint-desk label.complaint-desk__upload {\n  display: inline-flex;\n  align-items: center;\n  cursor: pointer;\n}\n\n.complaint-desk__upload input {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  clip-path: inset(50%);\n}\n\n.complaint-desk__upload-hint {\n  margin-top: 8px !important;\n  font-size: 0.78rem;\n}\n\n.complaint-desk__diagnostics,\n.complaint-desk__bounty {\n  grid-column: 1 / -1;\n  margin: 0;\n  padding: 9px 10px;\n  border-left: 4px solid var(--at-teal-600);\n  background: rgba(91, 138, 138, 0.12);\n}\n\n.complaint-desk__prize {\n  grid-column: 1 / -1;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  gap: 10px;\n  align-items: end;\n}\n\n.complaint-desk__bounty {\n  border-color: var(--at-ochre-500);\n  background: rgba(196, 136, 58, 0.14);\n  font-weight: 900;\n}\n\n.complaint-desk__actions {\n  position: sticky;\n  bottom: 0;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 12px 18px 14px;\n  border-top: 2px solid rgba(46, 27, 14, 0.58);\n  background: var(--at-sand-100);\n  box-shadow: 0 -8px 16px rgba(46, 27, 14, 0.12);\n}\n\n.complaint-desk__status {\n  min-width: 0;\n  font-weight: 800;\n}\n\n.complaint-desk[data-state=\"filed\"] .complaint-desk__status { color: #315f61; }\n.complaint-desk[data-state=\"offline\"] .complaint-desk__status,\n.complaint-desk[data-state=\"declined\"] .complaint-desk__status { color: #7f2633; }\n\n@media (max-width: 620px) {\n  .complaint-desk.town-ui__board-shell {\n    inset: max(10px, env(safe-area-inset-top)) max(10px, env(safe-area-inset-right)) max(10px, env(safe-area-inset-bottom)) max(10px, env(safe-area-inset-left));\n    width: auto;\n    height: auto;\n    max-height: none;\n    margin: 0;\n  }\n\n  .complaint-desk__fields,\n  .complaint-desk__moment,\n  .complaint-desk__prize {\n    grid-template-columns: 1fr;\n  }\n\n  .complaint-desk__description {\n    grid-row: auto;\n  }\n\n  .complaint-desk__actions {\n    align-items: stretch;\n    flex-direction: column;\n  }\n}\n\n/* lane-c: build-tile portraits */\n.hud-build-tile__icon {\n  display: none;\n  width: 34px;\n  height: 34px;\n  border: 1px solid rgba(46, 27, 14, 0.24);\n  border-radius: 6px;\n  background-position: center;\n  background-size: cover;\n  box-shadow: inset 0 0 0 1px rgba(255, 248, 232, 0.35);\n}\n\n.hud-build-tile--icon .hud-build-tile__icon {\n  display: block;\n}\n\n.hud-build-tile__copy {\n  min-width: 0;\n}\n\n.tape-shelf,\n.lantern-show {\n  position: fixed;\n  inset: 0;\n  z-index: 1200;\n  color: var(--at-wood-950, #2e1b0e);\n  font-family: \"Wellfleet\", serif;\n}\n\n.tape-shelf {\n  display: grid;\n  place-items: center;\n  padding: max(14px, env(safe-area-inset-top)) max(14px, env(safe-area-inset-right)) max(14px, env(safe-area-inset-bottom)) max(14px, env(safe-area-inset-left));\n  background: rgba(23, 12, 5, 0.82);\n}\n\n.tape-shelf__panel {\n  width: min(920px, 100%);\n  max-height: 92vh;\n  overflow: auto;\n  padding: 22px;\n  border: 3px solid #8b7d3c;\n  border-radius: 12px;\n  background: #f5e6c8;\n  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.55), inset 0 0 0 2px #2e1b0e;\n}\n\n.tape-shelf__header,\n.tape-shelf__reel {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 14px;\n}\n\n.tape-shelf__header p,\n.tape-shelf__reel p,\n.lantern-show__title p { margin: 0; color: #8b5d24; text-transform: uppercase; letter-spacing: 0.08em; }\n.tape-shelf__header h2,\n.tape-shelf__reel h3,\n.lantern-show__title h1 { margin: 2px 0; }\n.tape-shelf button,\n.lantern-show button { min-height: 42px; border: 2px solid #2e1b0e; border-radius: 6px; padding: 8px 14px; color: #2e1b0e; background: #fff8e8; font: inherit; font-weight: 800; }\n.tape-shelf button:hover,\n.lantern-show button:hover,\n.lantern-show button[aria-pressed=\"true\"] { background: #c4883a; }\n.tape-shelf__message { min-height: 1.5em; color: #7f2633; font-weight: 800; }\n.tape-shelf__list { display: grid; gap: 10px; margin: 16px 0 0; padding: 0; list-style: none; }\n.tape-shelf__reel { flex-wrap: wrap; padding: 14px; border: 1px solid rgba(46, 27, 14, 0.35); border-radius: 8px; background: rgba(255, 248, 232, 0.62); }\n.tape-shelf__reel[data-refused=\"true\"] { border-color: #a0522d; }\n.tape-shelf__reel span { flex: 1 1 260px; }\n\n.lantern-show { color: #fff8e8; pointer-events: none; }\n.lantern-show__stage { position: absolute; inset: 0; pointer-events: auto; cursor: grab; }\n.lantern-show__stage:active { cursor: grabbing; }\n.lantern-show__frame { position: absolute; inset: 0; border: clamp(10px, 2.2vw, 28px) solid #2e1b0e; box-shadow: inset 0 0 0 5px #8b7d3c, inset 0 0 80px 38px rgba(20, 9, 2, 0.74); pointer-events: none; }\n.lantern-show__frame::before,\n.lantern-show__frame::after { content: \"\"; position: absolute; top: 18px; bottom: 18px; width: 14px; background: radial-gradient(circle, #ffe4a0 0 22%, #8b7d3c 25% 45%, transparent 48%) 0 0 / 14px 46px; filter: drop-shadow(0 0 7px #c4883a); }\n.lantern-show__frame::before { left: 10px; }\n.lantern-show__frame::after { right: 10px; }\n.lantern-show__title { position: absolute; top: max(24px, env(safe-area-inset-top)); left: 50%; transform: translateX(-50%); min-width: min(540px, 78vw); padding: 10px 20px; text-align: center; text-shadow: 0 2px 8px #000; pointer-events: none; }\n.lantern-show__title h1 { font-size: clamp(24px, 4vw, 44px); }\n.lantern-show__intertitle { position: absolute; top: 42%; left: 50%; width: min(620px, 82vw); transform: translate(-50%, -50%); padding: 24px; border: 3px double #c4883a; background: rgba(46, 27, 14, 0.92); color: #fff8e8; text-align: center; font-size: clamp(18px, 3vw, 30px); box-shadow: 0 12px 38px rgba(0, 0, 0, 0.62); pointer-events: none; }\n.lantern-show__controls { position: absolute; right: max(24px, env(safe-area-inset-right)); bottom: max(24px, env(safe-area-inset-bottom)); left: max(24px, env(safe-area-inset-left)); display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: 8px; padding: 10px; border: 2px solid #8b7d3c; border-radius: 8px; background: rgba(46, 27, 14, 0.92); pointer-events: auto; }\n.lantern-show__speeds { display: flex; gap: 4px; }\n.lantern-show__controls output { flex: 1 1 220px; text-align: center; }\n.lantern-show-active #hud { opacity: 0; pointer-events: none; }\n\n@media (max-width: 560px) {\n  .tape-shelf__panel { max-height: 96vh; padding: 16px; }\n  .tape-shelf__header { align-items: flex-start; }\n  .tape-shelf__reel { align-items: stretch; flex-direction: column; }\n  .tape-shelf__reel span { flex: none; }\n  .lantern-show__title { top: max(14px, env(safe-area-inset-top)); }\n  .lantern-show__controls { right: max(12px, env(safe-area-inset-right)); bottom: max(12px, env(safe-area-inset-bottom)); left: max(12px, env(safe-area-inset-left)); max-height: 34vh; overflow: auto; }\n  .lantern-show__controls button { min-height: 40px; padding: 6px 10px; }\n  .lantern-show__controls output { flex-basis: 100%; }\n}\n\n/* The ride owns the viewport; framing is a disclosure on narrow screens. */\n.lantern-show__stage > canvas { display: block; width: 100%; height: 100%; }\n.lantern-show__title details { pointer-events: auto; }\n.lantern-show__title summary { cursor: pointer; font-size: clamp(24px, 4vw, 44px); font-weight: 800; }\n.lantern-show__title [data-testid=\"lantern-reel-label\"] { font-size: 14px; color: #fff8e8; background: #2e1b0e; }\n.lantern-show__placeholders { position: absolute; left: 30px; bottom: 130px; margin: 0; padding: 5px 8px; background: rgba(46,27,14,.9); color: #fff8e8; font-size: 12px; }\n@media (max-width: 560px) {\n  .lantern-show__stage { inset: 64px 10px auto; height: 62dvh; }\n  .lantern-show__title { top: 8px; padding: 0 8px; min-width: 90vw; }\n  .lantern-show__title summary { font-size: 23px; }\n  .lantern-show__title details[open] { background: #2e1b0e; }\n  .lantern-show__controls { bottom: 8px; gap: 4px; padding: 6px; max-height: calc(38dvh - 82px); }\n  .lantern-show__controls [data-testid=\"lantern-share-url\"] { min-width: 0; width: 100%; }\n  .lantern-show__placeholders, .lantern-show__stage [data-testid=\"lantern-truth-placeholders\"] { left: 8px !important; bottom: 4px !important; font-size: 10px; }\n}\n"],["STYLE",{},":root {\n  --at-ochre-500: #c4883a;\n  --at-sand-100: #f5e6c8;\n  --at-sand-200: #e8d5a8;\n  --at-rust-600: #a0522d;\n  --at-teal-600: #5b8a8a;\n  --at-brass-700: #8b7d3c;\n  --at-wood-950: #2e1b0e;\n  --at-cream-50: #fff8e8;\n  --at-sun-200: #ffe4a0;\n  --at-sky-100: #c2e6ff;\n  --at-sky-300: #8dc8f0;\n  --at-sky-500: #6bb0dd;\n  --at-sky-600: #5b9bd5;\n}\n\n#hud {\n  position: absolute;\n  inset: 0;\n  z-index: 5;\n  color: var(--at-wood-950);\n  font-family: Georgia, \"Iowan Old Style\", serif;\n  font-variant-numeric: tabular-nums;\n  letter-spacing: 0;\n  pointer-events: none;\n}\n\n#hud [hidden] {\n  display: none !important;\n}\n\n.hud-training-tag {\n  position: absolute;\n  top: 50%;\n  left: max(16px, env(safe-area-inset-left));\n  z-index: 2;\n  margin: 0;\n  border: 2px solid var(--at-teal-600);\n  border-radius: 6px;\n  padding: 5px 10px;\n  color: var(--at-wood-950);\n  background: rgba(236, 238, 207, 0.94);\n  box-shadow: 0 3px 0 rgba(46, 27, 14, 0.58);\n  font: 900 0.72rem/1 Wellfleet, Georgia, serif;\n  letter-spacing: 0.05em;\n  max-width: 144px;\n  text-align: center;\n  text-transform: uppercase;\n  transform: translateY(-50%);\n}\n\n.asset-loading-cue {\n  position: absolute;\n  bottom: max(14px, env(safe-area-inset-bottom));\n  left: max(14px, env(safe-area-inset-left));\n  z-index: 3;\n  margin: 0;\n  border-left: 2px solid rgba(139, 125, 60, 0.8);\n  padding: 5px 8px;\n  color: rgba(46, 27, 14, 0.82);\n  background: rgba(245, 230, 200, 0.8);\n  box-shadow: 0 2px 0 rgba(46, 27, 14, 0.2);\n  font: 700 0.72rem/1.1 Wellfleet, Georgia, serif;\n  letter-spacing: 0.02em;\n  pointer-events: none;\n}\n\n.asset-loading-cue[hidden] {\n  display: none;\n}\n\n@media (pointer: coarse), (max-width: 760px) {\n  .asset-loading-cue {\n    bottom: calc(max(14px, env(safe-area-inset-bottom)) + 240px);\n  }\n}\n\n.hud-panel,\n.hud__wave,\n.hud-meta-recap,\n.hud-pause {\n  border: 2px solid var(--at-wood-950);\n  border-radius: 8px;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.78), rgba(245, 230, 200, 0.94)),\n    var(--at-sand-100);\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.38),\n    0 4px 0 rgba(46, 27, 14, 0.7),\n    0 12px 24px rgba(46, 27, 14, 0.18);\n}\n\n.hud-panel {\n  position: absolute;\n  padding: 10px 12px;\n}\n\n.hud-panel::before,\n.hud-panel::after,\n.hud__wave::before,\n.hud__wave::after,\n.hud-meta-recap::before,\n.hud-meta-recap::after {\n  content: \"\";\n  position: absolute;\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--at-brass-700);\n  box-shadow: inset 0 1px 0 rgba(255, 248, 232, 0.52);\n}\n\n.hud-panel::before,\n.hud__wave::before,\n.hud-meta-recap::before {\n  top: 5px;\n  left: 5px;\n}\n\n.hud-panel::after,\n.hud__wave::after,\n.hud-meta-recap::after {\n  right: 5px;\n  bottom: 5px;\n}\n\n.hud-panel--vitals {\n  top: max(16px, env(safe-area-inset-top));\n  left: max(16px, env(safe-area-inset-left));\n  width: 188px;\n}\n\n.hud-panel--gold {\n  top: max(16px, env(safe-area-inset-top));\n  right: max(16px, env(safe-area-inset-right));\n  display: grid;\n  grid-template-columns: 18px max-content minmax(4ch, 7ch);\n  align-items: center;\n  column-gap: 8px;\n  min-width: 132px;\n  max-width: calc(100vw - 32px);\n}\n\n.hud-panel--resource {\n  top: max(16px, env(safe-area-inset-top));\n  right: calc(max(16px, env(safe-area-inset-right)) + 180px);\n  display: grid;\n  grid-template-columns: 18px max-content max-content minmax(5ch, 8ch);\n  align-items: center;\n  column-gap: 8px;\n  min-width: 152px;\n  max-width: calc(100vw - 180px);\n}\n\n.hud-pressure-uses {\n  padding: 1px 5px;\n  border: 1px solid rgba(91, 138, 138, 0.45);\n  border-radius: 999px;\n  font-size: 10px;\n  line-height: 1.2;\n  color: #315f61;\n  background: rgba(131, 222, 215, 0.2);\n}\n\n.hud-pressure-track {\n  position: relative;\n  grid-column: 1 / -1;\n  height: 5px;\n  overflow: hidden;\n  border-radius: 2px;\n  background: rgba(46, 27, 14, 0.2);\n}\n\n.hud-pressure-safe,\n.hud-pressure-fill { position: absolute; inset-block: 0; }\n.hud-pressure-safe { background: rgba(131, 222, 215, 0.35); }\n.hud-pressure-fill { left: 0; background: #5b8a8a; }\n.hud-panel--pressure[data-state='vent'] .hud-pressure-fill { background: #a0522d; }\n.hud-panel--power[data-state='lit'] { border-color: rgba(196, 136, 58, 0.85); }\n.hud-panel--power[data-state='brown'] { border-color: rgba(160, 82, 45, 0.85); }\n.hud-panel--power[data-state='dark'] { border-color: rgba(46, 38, 66, 0.85); }\n\n.hud-panel--xp {\n  right: max(16px, env(safe-area-inset-right));\n  bottom: max(18px, env(safe-area-inset-bottom));\n  left: max(16px, env(safe-area-inset-left));\n  max-width: 520px;\n  margin-inline: auto;\n}\n\n.hud-panel--tick .hud-coin {\n  animation: hud-coin-tick 240ms ease-out;\n}\n\n.hud-value--gold-pop {\n  display: inline-block;\n  transform-origin: center;\n  animation: hud-gold-pop 120ms ease-out;\n}\n\n.hud__wave {\n  position: absolute;\n  top: max(16px, env(safe-area-inset-top));\n  left: 50%;\n  width: min(320px, calc(100vw - 210px));\n  min-height: 34px;\n  padding: 7px 20px;\n  opacity: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  text-align: center;\n  transform: translateX(-50%);\n  transition: opacity 420ms ease;\n}\n\n.hud__wave-copy {\n  display: grid;\n  gap: 2px;\n  min-width: 0;\n}\n\n.hud__wave-copy strong {\n  font-size: 0.74rem;\n  line-height: 1;\n  text-transform: uppercase;\n}\n\n.hud__wave-portrait {\n  display: block;\n  width: 42px;\n  height: 42px;\n  object-fit: contain;\n  flex: 0 0 auto;\n  margin: -10px 0 -8px -10px;\n}\n\n.hud__wave-portrait[hidden] {\n  display: none;\n}\n\n.hud--announcement-visible .hud__wave {\n  opacity: 1;\n}\n\n.hud--announcement-visible[data-announcement-kind=\"baron\"] .hud__wave,\n.hud--announcement-visible[data-announcement-kind=\"baron-defeat\"] .hud__wave {\n  width: min(460px, calc(100vw - 32px));\n  min-height: 52px;\n  color: var(--at-cream-50);\n  background:\n    linear-gradient(135deg, rgba(64, 17, 22, 0.94), rgba(127, 38, 51, 0.96)),\n    #401116;\n  box-shadow:\n    inset 0 0 0 2px rgba(196, 136, 58, 0.48),\n    0 4px 0 rgba(46, 27, 14, 0.86),\n    0 16px 30px rgba(46, 27, 14, 0.26);\n}\n\n.hud--announcement-visible[data-announcement-kind=\"baron-defeat\"] .hud__wave {\n  top: 50%;\n  width: min(560px, calc(100vw - 32px));\n  min-height: 74px;\n  padding: 12px 24px;\n  transform: translate(-50%, -50%);\n  animation: baron-defeat-bloom 360ms ease-out both;\n}\n\n.hud--announcement-visible[data-announcement-kind=\"baron\"] .hud__wave::before,\n.hud--announcement-visible[data-announcement-kind=\"baron\"] .hud__wave::after,\n.hud--announcement-visible[data-announcement-kind=\"baron-defeat\"] .hud__wave::before,\n.hud--announcement-visible[data-announcement-kind=\"baron-defeat\"] .hud__wave::after {\n  background: var(--at-ochre-500);\n}\n\n@keyframes baron-defeat-bloom {\n  from {\n    opacity: 0;\n    transform: translate(-50%, -48%) scale(0.94);\n  }\n  to {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1);\n  }\n}\n\n.hud__wave-edge:empty {\n  display: none;\n}\n\n.hud__wave-edge {\n  display: inline-grid;\n  place-items: center;\n  width: 20px;\n  height: 20px;\n  border: 1px solid rgba(46, 27, 14, 0.62);\n  border-radius: 50%;\n  color: #fff8e8;\n  background: var(--at-rust-600);\n  font-size: 0.72rem;\n  font-weight: 900;\n  line-height: 1;\n}\n\n.hud-meta-recap {\n  position: absolute;\n  top: calc(max(16px, env(safe-area-inset-top)) + 88px);\n  left: 50%;\n  width: min(560px, calc(100vw - 32px));\n  padding: 10px 24px;\n  opacity: 0;\n  color: var(--at-wood-950);\n  font-size: 0.9rem;\n  font-weight: 800;\n  line-height: 1.25;\n  text-align: center;\n  pointer-events: none;\n  transform: translateX(-50%);\n  transition: opacity 180ms ease-out;\n  overflow: hidden;\n  display: -webkit-box;\n  -webkit-box-orient: vertical;\n  -webkit-line-clamp: 3;\n}\n\n.hud-meta-recap--visible {\n  opacity: 1;\n}\n\n.hud-claim-secured {\n  position: absolute;\n  top: calc(max(16px, env(safe-area-inset-top)) + 132px);\n  right: max(16px, env(safe-area-inset-right));\n  z-index: 4;\n  display: grid;\n  gap: 1px;\n  width: 190px;\n  padding: 7px 10px;\n  border: 2px solid var(--at-brass-700);\n  border-radius: 999px;\n  color: var(--at-cream-50);\n  background: rgba(46, 78, 63, 0.94);\n  box-shadow: 0 4px 0 rgba(46, 27, 14, 0.72), 0 10px 24px rgba(46, 27, 14, 0.22);\n  font-size: 0.72rem;\n  line-height: 1.05;\n  text-align: center;\n}\n\n.hud-claim-secured strong {\n  color: var(--at-sun-200);\n  letter-spacing: 0.06em;\n}\n\n.hud-claim-secured span {\n  font-size: 0.64rem;\n}\n\n@media (max-width: 760px) {\n  .hud-claim-secured {\n    top: calc(max(12px, env(safe-area-inset-top)) + 154px);\n    right: max(12px, env(safe-area-inset-right));\n    width: 162px;\n  }\n}\n\n.contract-briefing {\n  position: absolute;\n  top: calc(max(16px, env(safe-area-inset-top)) + 56px);\n  left: 50%;\n  z-index: 8;\n  width: min(580px, calc(100vw - 32px));\n  color: var(--at-wood-950);\n  pointer-events: auto;\n  transform: translate(-50%, -8px);\n  opacity: 0;\n  transition:\n    opacity 180ms ease,\n    transform 180ms ease;\n}\n\n.contract-briefing--visible {\n  transform: translate(-50%, 0);\n  opacity: 1;\n}\n\n.contract-briefing__paper {\n  display: grid;\n  gap: 10px;\n  border: 2px solid rgba(88, 56, 30, 0.82);\n  border-radius: 8px;\n  padding: 14px 16px;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 223, 0.98), rgba(232, 213, 168, 0.96)),\n    repeating-linear-gradient(90deg, rgba(91, 54, 28, 0.06) 0 2px, transparent 2px 9px);\n  box-shadow:\n    inset 0 0 0 1px rgba(255, 255, 255, 0.52),\n    0 18px 40px rgba(29, 20, 13, 0.34);\n}\n\n.contract-briefing__topline {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n\n.contract-briefing__eyebrow,\n.contract-briefing__label {\n  margin: 0;\n  color: var(--at-teal-600);\n  font-size: 0.72rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.contract-briefing h2 {\n  margin: 0;\n  font-size: 1.38rem;\n  line-height: 1.08;\n}\n\n.contract-briefing__geography {\n  margin: 0;\n  color: rgba(46, 27, 14, 0.78);\n  font-size: 0.92rem;\n  line-height: 1.32;\n}\n\n.contract-briefing__columns {\n  display: grid;\n  grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);\n  gap: 12px;\n}\n\n.briefing-lines {\n  display: grid;\n  gap: 5px;\n  margin: 5px 0 0;\n  padding-left: 1.05rem;\n  font-size: 0.88rem;\n  font-weight: 800;\n  line-height: 1.28;\n}\n\n.contract-briefing__dismiss {\n  min-height: 34px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 7px;\n  padding: 6px 12px;\n  color: #fff8e8;\n  background: var(--at-teal-600);\n  font: 900 0.78rem/1 Georgia, \"Iowan Old Style\", serif;\n  box-shadow: 0 3px 0 rgba(46, 27, 14, 0.5);\n  cursor: pointer;\n}\n\n.contract-briefing__dismiss:hover,\n.contract-briefing__dismiss:focus-visible {\n  outline: 2px solid var(--at-ochre-500);\n  outline-offset: 2px;\n}\n\n.hud-row {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 12px;\n  min-height: 20px;\n}\n\n.hud-row--split {\n  margin-top: 8px;\n}\n\n.hud-label {\n  color: rgba(46, 27, 14, 0.72);\n  font-size: 0.76rem;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.hud-value {\n  min-width: 7ch;\n  text-align: right;\n  font-size: 1rem;\n}\n\n.hud-panel--gold .hud-value {\n  min-width: 4ch;\n}\n\n.hud-bar {\n  height: 10px;\n  margin-top: 7px;\n  overflow: hidden;\n  border: 1px solid rgba(46, 27, 14, 0.64);\n  border-radius: 5px;\n  background: rgba(255, 248, 232, 0.72);\n}\n\n.hud-bar__fill {\n  width: 0;\n  height: 100%;\n  transition: width 120ms ease-out;\n}\n\n.hud-bar__fill--hp {\n  background: linear-gradient(90deg, var(--at-rust-600), #bd7044);\n}\n\n.hud-bar__fill--xp {\n  background: linear-gradient(90deg, #1f7f78, #8ff5e8);\n  box-shadow: inset 0 0 0 1px rgba(255, 248, 232, 0.38);\n}\n\n.hud-coin {\n  width: 16px;\n  height: 16px;\n  border: 2px solid #8f5d1e;\n  border-radius: 50%;\n  background:\n    radial-gradient(circle at 35% 30%, var(--at-sun-200) 0 22%, transparent 23%),\n    var(--at-ochre-500);\n  box-shadow: inset -2px -2px 0 rgba(46, 27, 14, 0.22);\n}\n\n.hud-gauge {\n  width: 16px;\n  height: 16px;\n  border: 2px solid #5b8a8a;\n  border-radius: 50%;\n  background:\n    conic-gradient(from -40deg, #8ff5e8 0 28%, transparent 29% 100%),\n    radial-gradient(circle at 50% 58%, #f5e6c8 0 34%, #5b8a8a 35% 42%, transparent 43%),\n    #2e1b0e;\n  box-shadow: inset 0 0 0 1px rgba(255, 248, 232, 0.42);\n}\n\n.hud-pause {\n  position: absolute;\n  right: max(16px, env(safe-area-inset-right));\n  bottom: max(18px, env(safe-area-inset-bottom));\n  min-width: 19ch;\n  padding: 8px 10px;\n  color: var(--at-wood-950);\n  font: inherit;\n  font-size: 0.82rem;\n  pointer-events: auto;\n}\n\n.hud-pause:hover,\n.hud-pause:focus-visible {\n  outline: 2px solid var(--at-teal-600);\n  outline-offset: 2px;\n}\n\n.hud-meta__pause-title {\n  margin: -2px 0 2px;\n  font: 900 1.2rem/1.05 Wellfleet, Georgia, serif;\n}\n\n.hud-panel--meta {\n  top: calc(max(16px, env(safe-area-inset-top)) + 64px);\n  right: max(16px, env(safe-area-inset-right));\n  display: grid;\n  gap: 7px;\n  width: min(340px, calc(100vw - 32px));\n  max-height: calc(100vh - 128px);\n  overflow: auto;\n  font-size: 0.78rem;\n  line-height: 1.2;\n  overscroll-behavior: contain;\n  pointer-events: auto;\n  touch-action: pan-y;\n}\n\n.hud-meta__eyebrow,\n.hud-meta__label {\n  margin: 0;\n  color: rgba(46, 27, 14, 0.68);\n  font-size: 0.68rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.hud-meta__line {\n  margin: 0;\n  font-weight: 800;\n}\n\n.hud-meta__training {\n  margin: 0;\n  border-left: 3px solid var(--at-teal-600);\n  padding: 6px 8px;\n  background: rgba(91, 138, 138, 0.12);\n  font-weight: 900;\n}\n\n.hud-meta__save {\n  display: grid;\n  gap: 7px;\n  border-top: 1px solid rgba(46, 27, 14, 0.18);\n  border-bottom: 1px solid rgba(46, 27, 14, 0.18);\n  padding: 7px 0;\n}\n\n.hud-meta__save summary {\n  min-height: 44px;\n  color: var(--at-wood-950);\n  font-weight: 900;\n  cursor: pointer;\n}\n\n.hud-meta__save-form {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(58px, max-content);\n  gap: 7px;\n}\n\n.hud-meta__save-form input {\n  min-width: 0;\n  min-height: 36px;\n  border: 1px solid rgba(46, 27, 14, 0.38);\n  border-radius: 6px;\n  padding: 0 8px;\n  color: var(--at-wood-950);\n  background: var(--at-cream-50);\n  font: inherit;\n}\n\n.hud-meta__chip {\n  min-height: 44px;\n  border: 1px solid rgba(46, 27, 14, 0.55);\n  border-radius: 6px;\n  color: var(--at-cream-50);\n  background: var(--at-teal-600);\n  font: inherit;\n  font-weight: 900;\n}\n\n.hud-meta__chip:disabled,\n.hud-meta__save-form input:disabled {\n  opacity: 0.6;\n}\n\n.hud-meta__save-message {\n  margin: 0;\n  color: rgba(46, 27, 14, 0.74);\n  font-size: 0.74rem;\n  line-height: 1.25;\n}\n\n.hud-meta__contract {\n  display: grid;\n  gap: 5px;\n  border-bottom: 1px solid rgba(46, 27, 14, 0.18);\n  padding-bottom: 7px;\n}\n\n.hud-meta__contract strong {\n  font-size: 0.9rem;\n}\n\n.hud-meta__contract span {\n  color: rgba(46, 27, 14, 0.74);\n  font-weight: 800;\n}\n\n.hud-meta__contract .briefing-lines {\n  margin-top: 0;\n  font-size: 0.76rem;\n  font-weight: 800;\n}\n\n.hud-meta__audio {\n  display: grid;\n  gap: 7px;\n  border-top: 1px solid rgba(46, 27, 14, 0.18);\n  padding-top: 7px;\n}\n\n.hud-meta__audio label {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 6px 10px;\n  font-weight: 900;\n}\n\n.hud-meta__audio label > span {\n  color: rgba(46, 27, 14, 0.72);\n  font-size: 0.72rem;\n  text-transform: uppercase;\n}\n\n.hud-meta__audio input[type=\"range\"] {\n  grid-column: 1 / -1;\n  width: 100%;\n  accent-color: var(--at-teal-600);\n}\n\n.hud-meta__audio input[type=\"checkbox\"] {\n  width: 24px;\n  height: 24px;\n  margin: 0;\n  accent-color: var(--at-teal-600);\n}\n\n.hud-meta__list {\n  display: grid;\n  gap: 6px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.hud-meta__list li {\n  display: grid;\n  gap: 2px;\n  border-top: 1px solid rgba(46, 27, 14, 0.18);\n  padding-top: 6px;\n}\n\n.hud-meta__list strong {\n  font-size: 0.8rem;\n}\n\n.hud-meta__list span {\n  color: rgba(46, 27, 14, 0.74);\n}\n\n.damage-vignette {\n  position: absolute;\n  inset: 0;\n  z-index: 4;\n  pointer-events: none;\n  opacity: 0;\n  background:\n    radial-gradient(circle at 50% 50%, transparent 42%, rgba(160, 82, 45, 0.32) 76%),\n    linear-gradient(rgba(160, 82, 45, 0.14), rgba(160, 82, 45, 0.14));\n  transition: opacity 80ms ease-out;\n}\n\n.death-overlay {\n  position: absolute;\n  inset: 0;\n  z-index: 10;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  color: var(--at-wood-950);\n  font-family: Georgia, \"Iowan Old Style\", serif;\n  pointer-events: none;\n  opacity: 0;\n  background: rgba(46, 27, 14, 0.36);\n  transition: opacity 180ms ease-out;\n}\n\n.death-overlay--visible {\n  pointer-events: auto;\n  opacity: 1;\n}\n\n.death-overlay__panel {\n  width: min(420px, 100%);\n  max-height: calc(100vh - 48px);\n  overflow: auto;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 8px;\n  padding: 20px;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(245, 230, 200, 0.98)),\n    var(--at-sand-100);\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.4),\n    0 4px 0 rgba(46, 27, 14, 0.78),\n    0 20px 40px rgba(46, 27, 14, 0.3);\n}\n\n.death-overlay__eyebrow {\n  margin: 0 0 4px;\n  color: rgba(46, 27, 14, 0.72);\n  font-size: 0.8rem;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.death-overlay h1 {\n  margin: 0 0 6px;\n  font-size: 2rem;\n  line-height: 1.05;\n}\n\n.death-overlay__flavor {\n  margin: 0 0 14px;\n  color: rgba(46, 27, 14, 0.78);\n  font-size: 0.95rem;\n  line-height: 1.25;\n}\n\n.death-overlay__ledger {\n  display: grid;\n  gap: 10px;\n  margin: 0 0 14px;\n}\n\n.death-overlay__ledger div {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 16px;\n  border-bottom: 1px solid rgba(46, 27, 14, 0.2);\n  padding-bottom: 8px;\n}\n\n.death-overlay__ledger dt {\n  color: rgba(46, 27, 14, 0.72);\n  font-size: 0.82rem;\n  font-weight: 700;\n  text-transform: uppercase;\n}\n\n.death-overlay__ledger dd {\n  margin: 0;\n  font-size: 1.2rem;\n  font-weight: 800;\n  font-variant-numeric: tabular-nums;\n}\n\n.death-overlay__science,\n.death-overlay__town {\n  margin: -2px 0 14px;\n  padding: 8px 10px;\n  border: 1px solid rgba(91, 138, 138, 0.42);\n  border-radius: 6px;\n  color: var(--at-wood-950);\n  background: rgba(131, 222, 215, 0.14);\n  font-size: 0.86rem;\n  font-weight: 800;\n}\n\n.death-overlay__agent {\n  margin: -2px 0 14px;\n  padding: 8px 10px;\n  border: 1px solid rgba(91, 138, 138, 0.42);\n  border-radius: 6px;\n  color: var(--at-wood-950);\n  background: rgba(131, 222, 215, 0.14);\n  font-size: 0.86rem;\n  font-weight: 800;\n}\n\n.research-ledger {\n  display: grid;\n  gap: 10px;\n  margin: 0 0 14px;\n  padding: 12px;\n  border: 1px solid rgba(46, 27, 14, 0.24);\n  border-radius: 8px;\n  background: rgba(255, 248, 232, 0.52);\n}\n\n.research-ledger__eyebrow,\n.research-ledger__skip,\n.research-card__branch {\n  color: rgba(46, 27, 14, 0.68);\n  font-size: 0.72rem;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.research-ledger h2 {\n  margin: 0;\n  font-size: 1.08rem;\n  line-height: 1.1;\n}\n\n.research-ledger p {\n  margin: 0;\n}\n\n.research-unlock-reveal {\n  display: grid;\n  grid-template-columns: 58px minmax(0, 1fr);\n  gap: 12px;\n  align-items: center;\n  border: 2px solid rgba(91, 138, 138, 0.66);\n  border-radius: 8px;\n  padding: 10px;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.98), rgba(255, 228, 160, 0.38)),\n    repeating-linear-gradient(90deg, rgba(91, 138, 138, 0.05) 0 2px, transparent 2px 10px);\n  box-shadow: inset 0 0 0 1px rgba(255, 248, 232, 0.64);\n}\n\n.research-unlock-reveal__icon {\n  width: 58px;\n  height: 58px;\n  border: 1px solid rgba(46, 27, 14, 0.36);\n  border-radius: 8px;\n  background-color: rgba(255, 248, 232, 0.76);\n  background-position: center;\n  background-repeat: no-repeat;\n  background-size: contain;\n}\n\n.research-unlock-reveal__copy {\n  display: grid;\n  gap: 3px;\n  min-width: 0;\n}\n\n.research-unlock-reveal__kicker {\n  color: var(--at-teal-600);\n  font-size: 0.7rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.research-unlock-reveal strong {\n  font-size: 1.08rem;\n  line-height: 1.08;\n}\n\n.research-unlock-reveal span[data-testid='research-unlock-line'] {\n  color: rgba(46, 27, 14, 0.78);\n  font-size: 0.86rem;\n  line-height: 1.28;\n}\n\n.research-ledger__cards {\n  display: grid;\n  gap: 8px;\n}\n\n.research-card {\n  position: relative;\n  display: grid;\n  gap: 4px;\n  min-height: 86px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 8px;\n  padding: 10px 44px 10px 10px;\n  color: var(--at-wood-950);\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.92), rgba(245, 230, 200, 0.98)),\n    var(--at-sand-100);\n  box-shadow:\n    inset 0 0 0 1px rgba(139, 125, 60, 0.34),\n    0 2px 0 rgba(46, 27, 14, 0.62);\n  font: inherit;\n  text-align: left;\n}\n\n.research-card:hover,\n.research-card:focus-visible {\n  outline: 2px solid var(--at-sun-200);\n  outline-offset: 2px;\n}\n\n.research-card strong {\n  font-size: 1rem;\n  line-height: 1.1;\n}\n\n.research-card span:last-child {\n  color: rgba(46, 27, 14, 0.78);\n  font-size: 0.84rem;\n  line-height: 1.22;\n}\n\n.research-card__key {\n  position: absolute;\n  top: 10px;\n  right: 10px;\n  display: grid;\n  place-items: center;\n  width: 26px;\n  height: 26px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 50%;\n  color: var(--at-cream-50);\n  background: var(--at-teal-600);\n  font-weight: 900;\n}\n\n.research-card .research-card__pin-hint {\n  color: var(--at-teal-600);\n  font-size: 0.8rem;\n  font-weight: 900;\n}\n\n.death-overlay__scores {\n  margin: 0 0 16px;\n}\n\n.death-overlay__scores h2 {\n  margin: 0 0 8px;\n  font-size: 1rem;\n  line-height: 1.1;\n}\n\n.death-overlay__scores ol {\n  display: grid;\n  gap: 6px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.death-overlay__score {\n  display: grid;\n  grid-template-columns: 1fr auto;\n  gap: 10px;\n  border: 1px solid rgba(46, 27, 14, 0.2);\n  border-radius: 6px;\n  padding: 6px 8px;\n  background: rgba(255, 248, 232, 0.48);\n  font-size: 0.82rem;\n}\n\n.death-overlay__score-stamp {\n  color: var(--at-teal-600);\n  font-size: 0.72rem;\n  letter-spacing: 0;\n}\n\n.death-overlay__score--current {\n  border-color: var(--at-teal-600);\n  box-shadow: inset 0 0 0 1px rgba(91, 138, 138, 0.42);\n}\n\n.death-overlay__score-detail {\n  grid-column: 1 / -1;\n  color: rgba(46, 27, 14, 0.72);\n  line-height: 1.25;\n}\n\n.death-overlay__button {\n  width: 100%;\n  min-height: 44px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 8px;\n  color: var(--at-wood-950);\n  background: var(--at-teal-600);\n  box-shadow: 0 3px 0 rgba(46, 27, 14, 0.78);\n  font: inherit;\n  font-size: 1rem;\n  font-weight: 800;\n}\n\n.death-overlay__actions {\n  display: grid;\n  gap: 10px;\n}\n\n.death-overlay__button--secondary {\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.92), rgba(245, 230, 200, 0.96)),\n    var(--at-sand-100);\n}\n\n.death-overlay__button:hover,\n.death-overlay__button:focus-visible {\n  outline: 2px solid var(--at-sun-200);\n  outline-offset: 2px;\n}\n\n.gr-run-overlay {\n  background:\n    radial-gradient(circle at 8% 18%, rgba(255, 228, 160, 0.42), transparent 13rem),\n    radial-gradient(circle at 92% 82%, rgba(196, 136, 58, 0.38), transparent 12rem),\n    rgba(46, 27, 14, 0.4);\n}\n\n.gr-run-overlay__actions {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n}\n\n.claim-office {\n  display: grid;\n  gap: 10px;\n  margin: 0 0 14px;\n  padding: 12px;\n  border: 1px solid rgba(46, 27, 14, 0.24);\n  border-radius: 8px;\n  background: rgba(255, 248, 232, 0.54);\n}\n\n.claim-office h2 {\n  margin: 0;\n  font-size: 1rem;\n}\n\n.claim-office__bark,\n.claim-office__tier {\n  margin: 0;\n  color: rgba(46, 27, 14, 0.76);\n  font-size: 0.86rem;\n  line-height: 1.25;\n}\n\n.claim-office__baron-callout {\n  width: fit-content;\n  margin: 0;\n  padding: 5px 8px;\n  border: 1px solid rgba(127, 38, 51, 0.42);\n  border-radius: 6px;\n  color: #fff8e8;\n  background: #7f2633;\n  font-size: 0.82rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.claim-office__payout {\n  display: grid;\n  gap: 6px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.claim-office__payout li {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto auto;\n  gap: 8px;\n  align-items: baseline;\n  padding: 6px 0;\n  border-bottom: 1px solid rgba(46, 27, 14, 0.16);\n  animation: claimOfficePayout 420ms ease-out both;\n}\n\n.claim-office__payout li:nth-child(2) {\n  animation-delay: 90ms;\n}\n\n.claim-office__payout li:nth-child(3) {\n  animation-delay: 180ms;\n}\n\n.claim-office__payout li:nth-child(4) {\n  animation-delay: 270ms;\n}\n\n.claim-office__payout strong {\n  color: var(--at-ochre-500);\n  font-size: 1rem;\n}\n\n.claim-office__stamp {\n  color: var(--at-teal-600);\n  font-size: 0.68rem;\n  font-weight: 800;\n  text-transform: uppercase;\n}\n\n.gr-profile-title {\n  z-index: 50;\n}\n\n.gr-profile-title__panel {\n  width: min(520px, 100%);\n}\n\n.gr-profile-list {\n  display: grid;\n  gap: 8px;\n  max-height: min(42vh, 320px);\n  margin: 0 0 14px;\n  padding: 0;\n  overflow: auto;\n  list-style: none;\n}\n\n.gr-profile-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  min-height: 46px;\n  border: 1px solid rgba(46, 27, 14, 0.28);\n  border-radius: 6px;\n  padding: 8px 10px;\n  color: var(--at-wood-950);\n  background: rgba(255, 248, 232, 0.56);\n  font: inherit;\n  font-weight: 800;\n  text-align: left;\n}\n\n.gr-profile-row small {\n  color: rgba(46, 27, 14, 0.62);\n  font-size: 0.76rem;\n  text-transform: uppercase;\n}\n\n.gr-profile-row[aria-pressed=\"true\"] {\n  border-color: var(--at-teal-600);\n  box-shadow: inset 0 0 0 2px rgba(91, 138, 138, 0.34);\n}\n\n.gr-profile-row:hover,\n.gr-profile-row:focus-visible,\n.gr-profile-create input:focus-visible {\n  outline: 2px solid var(--at-sun-200);\n  outline-offset: 2px;\n}\n\n.gr-profile-create {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(96px, 128px);\n  gap: 8px;\n  margin-bottom: 10px;\n}\n\n.gr-profile-create--first {\n  margin-bottom: 0;\n}\n\n.gr-profile-create input {\n  min-width: 0;\n  min-height: 44px;\n  border: 1px solid rgba(46, 27, 14, 0.4);\n  border-radius: 6px;\n  padding: 0 10px;\n  color: var(--at-wood-950);\n  background: var(--at-cream-50);\n  font: inherit;\n}\n\n.gr-profile-greenhorn {\n  grid-column: 1 / -1;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px 16px;\n  margin: 0;\n  padding: 8px 10px;\n  border: 1px solid rgba(181, 125, 54, 0.45);\n}\n\n.gr-profile-greenhorn legend {\n  font-weight: 800;\n}\n\n.gr-profile-greenhorn input {\n  min-height: auto;\n  margin-right: 4px;\n}\n\n.hud-agent-chip[data-guide=\"true\"] {\n  max-width: min(48ch, calc(100vw - 32px));\n}\n\n.hud-agent-chip[data-selected=\"true\"] {\n  box-shadow: 0 0 0 2px #83ded7;\n}\n\n.hud-agent-feed[data-guide=\"true\"] {\n  grid-column: 1 / -1;\n  max-width: none;\n  overflow: visible;\n  text-overflow: clip;\n  white-space: normal;\n}\n\n.prospector-dispatch-prompt {\n  position: fixed;\n  z-index: 80;\n  min-height: 44px;\n  max-width: 230px;\n  padding: 10px 14px;\n  border: 2px solid #83ded7;\n  border-radius: 8px;\n  background: #2e1b0e;\n  color: #fff8e8;\n  font: 700 14px/1.2 system-ui, sans-serif;\n}\n\n.gr-profile-create__button {\n  min-width: 0;\n}\n\n.gr-profile-message {\n  margin: 0 0 10px;\n  border: 1px solid rgba(91, 138, 138, 0.38);\n  border-radius: 6px;\n  padding: 8px 10px;\n  color: var(--at-wood-950);\n  background: rgba(131, 222, 215, 0.14);\n  font-size: 0.86rem;\n  line-height: 1.25;\n}\n\n.gr-profile-transfer {\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 8px;\n  margin-bottom: 10px;\n}\n\n.gr-profile-file {\n  display: grid;\n  gap: 6px;\n  border: 1px solid rgba(46, 27, 14, 0.28);\n  border-radius: 6px;\n  padding: 8px 10px;\n  color: var(--at-wood-950);\n  background: rgba(255, 248, 232, 0.56);\n  font-size: 0.88rem;\n  font-weight: 800;\n}\n\n.gr-profile-file input {\n  width: 100%;\n  min-width: 0;\n  font: inherit;\n}\n\n.gr-profile-import {\n  display: grid;\n  gap: 8px;\n  margin-bottom: 10px;\n  border: 1px solid rgba(91, 138, 138, 0.42);\n  border-radius: 6px;\n  padding: 10px;\n  background: rgba(131, 222, 215, 0.14);\n}\n\n.gr-profile-import p {\n  margin: 0;\n  line-height: 1.25;\n}\n\n.gr-account-card {\n  display: grid;\n  gap: 8px;\n  margin: 10px 0;\n  border: 1px solid rgba(91, 138, 138, 0.42);\n  border-radius: 6px;\n  padding: 10px;\n  background: rgba(255, 248, 232, 0.6);\n}\n\n.gr-account-chip {\n  width: max-content;\n  max-width: 100%;\n  margin: 0;\n  border: 1px solid rgba(91, 138, 138, 0.46);\n  border-radius: 6px;\n  padding: 6px 8px;\n  color: var(--at-wood-950);\n  background: rgba(131, 222, 215, 0.16);\n  font-size: 0.8rem;\n  font-weight: 900;\n  line-height: 1.15;\n}\n\n.gr-account-chip--menu {\n  margin: -10px 0 16px;\n  color: #fff8e8;\n  background: rgba(91, 138, 138, 0.56);\n}\n\n.gr-start-menu__saved-claim--rejected {\n  border-color: rgba(127, 38, 51, 0.42);\n  color: #7f2633;\n  background: rgba(127, 38, 51, 0.12);\n}\n\n.gr-account-chip--pause {\n  width: fit-content;\n  margin: 0;\n}\n\n.gr-account-form,\n.gr-account-actions,\n.gr-account-compare,\n.gr-account-burn {\n  display: grid;\n  gap: 8px;\n}\n\n.gr-account-form {\n  grid-template-columns: minmax(0, 1fr) minmax(96px, 128px);\n}\n\n.gr-account-form input {\n  min-width: 0;\n  min-height: 44px;\n  border: 1px solid rgba(46, 27, 14, 0.4);\n  border-radius: 6px;\n  padding: 0 10px;\n  color: var(--at-wood-950);\n  background: var(--at-cream-50);\n  font: inherit;\n}\n\n.gr-account-note,\n.gr-account-compare p,\n.gr-account-burn p,\n.gr-account-dev-code,\n.gr-profile-transfer__note {\n  margin: 0;\n  color: var