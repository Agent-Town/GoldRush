a1f 44%, #5b8a8a);\n  font-family: Wellfleet, Georgia, \"Iowan Old Style\", serif;\n}\n\n.gr-start-menu__backdrop {\n  /* fixed, not absolute: the menu scrolls on short viewports and the painting\n     must stay under the content past the first screenful (owner, 2026-07-13) */\n  position: fixed;\n  inset: 0;\n  opacity: 0.82;\n  background:\n    linear-gradient(90deg, rgba(17, 19, 18, 0.82), rgba(17, 19, 18, 0.18) 48%, rgba(17, 19, 18, 0.08)),\n    radial-gradient(ellipse at 76% 70%, rgba(194, 230, 255, 0.22), transparent 34%),\n    linear-gradient(180deg, rgba(255, 228, 160, 0.34), transparent 42%),\n    repeating-linear-gradient(32deg, rgba(255, 248, 232, 0.08) 0 2px, transparent 2px 10px);\n}\n\n.gr-start-menu__backdrop[data-asset-state=\"ready\"] {\n  opacity: 1;\n  background-repeat: no-repeat;\n  background-position: center right;\n  background-size: cover;\n}\n\n.gr-start-menu__backdrop::after {\n  position: absolute;\n  inset: 0;\n  content: \"\";\n  background: radial-gradient(ellipse at center, rgba(35, 22, 12, 0.12) 0 30%, rgba(20, 14, 10, 0.82) 100%);\n}\n\n.gr-start-menu__column {\n  position: relative;\n  z-index: 1;\n  display: grid;\n  align-content: center;\n  width: min(430px, 34vw);\n  min-width: 340px;\n  min-height: 100%;\n  padding: max(28px, env(safe-area-inset-top)) 32px max(28px, env(safe-area-inset-bottom));\n  background: linear-gradient(90deg, rgba(46, 27, 14, 0.86), rgba(46, 27, 14, 0.52) 72%, transparent);\n}\n\n.gr-start-menu__emblem {\n  width: 112px;\n  aspect-ratio: 1;\n  margin-bottom: 14px;\n  border: 3px solid #8b7d3c;\n  border-radius: 8px;\n  background:\n    radial-gradient(circle at 50% 44%, #ffe4a0 0 13%, transparent 14%),\n    linear-gradient(135deg, rgba(91, 138, 138, 0.86), rgba(196, 136, 58, 0.92)),\n    #f5e6c8;\n  clip-path: polygon(50% 0, 88% 14%, 100% 50%, 78% 92%, 50% 100%, 22% 92%, 0 50%, 12% 14%);\n  box-shadow:\n    inset 0 0 0 5px rgba(46, 27, 14, 0.52),\n    0 12px 28px rgba(0, 0, 0, 0.26);\n}\n\n.gr-start-menu__emblem[data-asset-state=\"ready\"] {\n  width: 128px;\n  border: none;\n  border-radius: 0;\n  background-color: transparent;\n  background-repeat: no-repeat;\n  background-position: center;\n  background-size: contain;\n  clip-path: none;\n  box-shadow: none;\n  filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.32));\n}\n\n.gr-start-menu h1 {\n  margin: 0;\n  color: #ffe4a0;\n  font-family: Smokum, Rye, Georgia, serif;\n  font-size: 52px;\n  font-weight: 400;\n  line-height: 0.92;\n  letter-spacing: 0;\n  text-shadow: 0 3px 0 rgba(46, 27, 14, 0.92);\n}\n\n.gr-start-menu__subtitle {\n  width: max-content;\n  max-width: 100%;\n  margin: 10px 0 24px;\n  padding-bottom: 8px;\n  border-bottom: 2px solid rgba(196, 136, 58, 0.9);\n  color: rgba(255, 248, 232, 0.86);\n  font-size: 14px;\n}\n\n.gr-start-menu__nav {\n  display: grid;\n  gap: 10px;\n}\n\n.gr-start-menu__first-profile {\n  display: grid;\n  gap: 10px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  padding: 14px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.92), rgba(245, 230, 200, 0.98)),\n    var(--gr-menu-panel, none) center/cover,\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.28),\n    0 4px 0 rgba(46, 27, 14, 0.7);\n}\n\n.gr-start-menu__first-profile h2,\n.gr-start-menu__first-profile p {\n  margin: 0;\n}\n\n.gr-start-menu__first-profile h2 {\n  font-size: 1.45rem;\n  line-height: 1.05;\n}\n\n.gr-start-menu__button,\n.gr-start-menu__small-button {\n  min-height: 48px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  padding: 10px 14px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(245, 230, 200, 0.94)),\n    var(--gr-menu-panel, none) center/cover,\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.28),\n    0 4px 0 rgba(46, 27, 14, 0.7);\n  font: 900 16px/1.1 Wellfleet, Georgia, serif;\n  text-align: left;\n  cursor: pointer;\n}\n\n.gr-start-menu__button--primary {\n  color: #fff8e8;\n  background:\n    linear-gradient(135deg, rgba(91, 138, 138, 0.96), rgba(47, 143, 133, 0.96)),\n    #5b8a8a;\n}\n\n.gr-start-menu__button:hover,\n.gr-start-menu__button:focus-visible,\n.gr-start-menu__small-button:hover,\n.gr-start-menu__small-button:focus-visible {\n  outline: 3px solid #ffe4a0;\n  outline-offset: 3px;\n}\n\n.gr-start-menu__button:active,\n.gr-start-menu__small-button:active {\n  transform: translateY(2px);\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.28),\n    0 2px 0 rgba(46, 27, 14, 0.7);\n}\n\n.gr-start-menu__settings,\n.gr-start-menu__research,\n.gr-start-menu__load {\n  margin-top: 14px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  padding: 12px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(245, 230, 200, 0.94)),\n    var(--gr-menu-panel, none) center/cover,\n    #f5e6c8;\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.22);\n}\n\n.gr-start-menu__settings[hidden],\n.gr-start-menu__research[hidden],\n.gr-start-menu__load[hidden] {\n  display: none;\n}\n\n.gr-start-menu__settings {\n  max-height: min(540px, 58vh);\n  overflow: auto;\n}\n\n.gr-start-menu__settings label {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 8px 12px;\n  font-weight: 900;\n}\n\n.gr-start-menu__settings-header {\n  position: sticky;\n  top: -12px;\n  z-index: 1;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin: -12px -12px 10px;\n  padding: 12px;\n  border-bottom: 1px solid rgba(46, 27, 14, 0.24);\n  background: #f5e6c8;\n}\n\n.gr-start-menu__settings-header h2 {\n  margin: 0;\n}\n\n.gr-start-menu__settings input[type=\"checkbox\"] {\n  grid-column: 2;\n  width: 26px;\n  height: 26px;\n  margin: 0;\n}\n\n.gr-start-menu__settings select {\n  min-width: 9rem;\n  min-height: 44px;\n  border: 1px solid rgba(46, 27, 14, 0.45);\n  border-radius: 6px;\n  padding: 0 8px;\n  color: #2e1b0e;\n  background: #fff8e8;\n  font: inherit;\n}\n\n.gr-start-menu__settings input {\n  grid-column: 1 / -1;\n  width: 100%;\n  accent-color: #5b8a8a;\n}\n\n.gr-start-menu__settings-note {\n  margin: 6px 0 0;\n  color: rgba(46, 27, 14, 0.74);\n  font-size: 0.78rem;\n  line-height: 1.35;\n}\n\n.gr-start-menu__research {\n  max-height: min(390px, 45vh);\n  overflow: auto;\n}\n\n.gr-start-menu__load {\n  max-height: min(540px, 58vh);\n  overflow: auto;\n}\n\n.gr-start-menu--research-open .gr-start-menu__column {\n  width: min(1180px, calc(100vw - 48px));\n  align-content: center;\n}\n\n.gr-start-menu--load-open .gr-start-menu__column {\n  width: min(760px, calc(100vw - 48px));\n  align-content: center;\n}\n\n.gr-start-menu--settings-open .gr-start-menu__column {\n  height: 100%;\n  align-content: start;\n  overflow: auto;\n}\n\n.gr-start-menu--research-open .gr-start-menu__nav {\n  grid-template-columns: repeat(5, minmax(0, 1fr));\n}\n\n.gr-start-menu--load-open .gr-start-menu__nav {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n\n.gr-start-menu--research-open .gr-start-menu__research {\n  max-height: min(680px, 72vh);\n}\n\n.gr-start-menu__research h2,\n.gr-start-menu__research p,\n.gr-load-claims__header h2,\n.gr-load-claims__empty,\n.gr-load-claims__message,\n.gr-load-card h3,\n.gr-load-card p {\n  margin: 0 0 8px;\n}\n\n.gr-load-claims__header {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(92px, max-content);\n  gap: 10px;\n  align-items: center;\n}\n\n.gr-load-claims__header h2 {\n  font-size: 1.14rem;\n}\n\n.gr-load-claims__list {\n  display: grid;\n  gap: 10px;\n  margin: 10px 0 0;\n  padding: 0;\n  list-style: none;\n}\n\n.gr-load-card {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(248px, 0.8fr);\n  gap: 12px;\n  align-items: start;\n  padding: 10px;\n  border: 1px solid rgba(46, 27, 14, 0.28);\n  border-radius: 6px;\n  background: rgba(255, 248, 232, 0.72);\n}\n\n.gr-load-card h3 {\n  font-size: 1rem;\n}\n\n.gr-load-card p,\n.gr-load-claims__empty,\n.gr-load-claims__message {\n  color: rgba(46, 27, 14, 0.74);\n  font-size: 0.82rem;\n  line-height: 1.3;\n}\n\n.gr-load-card__actions,\n.gr-load-card__rename {\n  display: grid;\n  gap: 8px;\n}\n\n.gr-load-card__rename {\n  grid-template-columns: minmax(0, 1fr) minmax(76px, max-content);\n}\n\n.gr-load-card__rename input {\n  min-width: 0;\n  min-height: 44px;\n  border: 1px solid rgba(46, 27, 14, 0.38);\n  border-radius: 6px;\n  padding: 0 9px;\n  color: #2e1b0e;\n  background: #fff8e8;\n  font: inherit;\n}\n\n.gr-start-menu__small-button--danger {\n  background:\n    linear-gradient(135deg, rgba(160, 82, 45, 0.94), rgba(127, 38, 51, 0.9)),\n    #a0522d;\n  color: #fff8e8;\n}\n\n@media (min-width: 761px) {\n  .gr-load-card__actions {\n    grid-template-columns: minmax(0, 1fr) minmax(112px, 0.38fr);\n    align-items: start;\n  }\n\n  .gr-load-card__rename {\n    grid-column: 1 / -1;\n  }\n\n  .gr-load-card__actions > .gr-start-menu__small-button--danger {\n    grid-column: 2;\n    grid-row: 1;\n  }\n}\n\n.gr-start-menu__research-grid {\n  display: grid;\n  gap: 8px;\n  margin: 10px 0;\n}\n\n.gr-start-menu__research-grid article {\n  display: grid;\n  gap: 4px;\n  padding: 10px;\n  border: 1px solid rgba(46, 27, 14, 0.28);\n  border-radius: 6px;\n  background: rgba(255, 248, 232, 0.72);\n}\n\n.gr-start-menu__research-grid span {\n  color: #5b8a8a;\n  font-size: 12px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.gr-start-menu__research-grid p {\n  font-size: 13px;\n  line-height: 1.35;\n}\n\n.research-chart {\n  min-width: 0;\n  --research-ink: #2e1b0e;\n  --research-teal: #5b8a8a;\n  --research-brass: #8b7d3c;\n  --research-ochre: #c4883a;\n  --research-paper: rgba(255, 248, 232, 0.88);\n  --research-paper-warm: rgba(255, 228, 160, 0.34);\n}\n\n.research-chart__header,\n.research-chart__body {\n  display: grid;\n  gap: 14px;\n}\n\n.research-chart__header {\n  grid-template-columns: minmax(0, 1fr) minmax(210px, auto);\n  align-items: end;\n}\n\n.research-chart__header h2,\n.research-chart__header p,\n.research-chart__branch h3,\n.research-chart__selection h3,\n.research-chart__continued h3 {\n  margin: 0;\n}\n\n.research-chart__meter {\n  justify-self: end;\n  max-width: 420px;\n  color: var(--research-ink);\n  font-size: 13px;\n  line-height: 1.35;\n  text-align: right;\n}\n\n.research-impact__legacy-copy {\n  display: none;\n}\n\n.research-chart__body {\n  grid-template-columns: minmax(0, 1fr) minmax(230px, 280px);\n  align-items: start;\n}\n\n.research-chart__branches {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(220px, 1fr)) minmax(150px, 0.48fr);\n  gap: 14px;\n  min-width: 0;\n}\n\n.research-chart__branch,\n.research-chart__selection,\n.research-chart__continued,\n.research-chart__epoch {\n  border: 1px solid rgba(46, 27, 14, 0.32);\n  border-radius: 8px;\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.86), rgba(245, 230, 200, 0.78)),\n    repeating-linear-gradient(90deg, rgba(46, 27, 14, 0.035) 0 1px, transparent 1px 12px);\n}\n\n.research-chart__branch,\n.research-chart__selection,\n.research-chart__continued {\n  padding: 14px;\n}\n\n.research-chart__branch h3,\n.research-chart__selection h3,\n.research-chart__continued h3 {\n  color: var(--research-teal);\n  font-size: 13px;\n  text-transform: uppercase;\n}\n\n.research-chart__branch h3 {\n  display: grid;\n  grid-template-columns: 30px minmax(0, 1fr);\n  align-items: center;\n  gap: 8px;\n}\n\n.research-chart__branch-icon,\n.research-chart__node-icon {\n  display: block;\n  background-position: center;\n  background-repeat: no-repeat;\n  background-size: contain;\n}\n\n.research-chart__branch-icon {\n  width: 30px;\n  height: 30px;\n  border: 1px solid rgba(46, 27, 14, 0.35);\n  border-radius: 6px;\n  background-color: rgba(255, 248, 232, 0.76);\n}\n\n.research-chart__nodes {\n  display: grid;\n  gap: 0;\n  margin-top: 12px;\n}\n\n.research-chart__node {\n  position: relative;\n  display: grid;\n  gap: 8px;\n  width: 100%;\n  min-height: 128px;\n  border: 2px solid rgba(46, 27, 14, 0.28);\n  border-radius: 8px;\n  padding: 13px;\n  color: var(--research-ink);\n  background:\n    linear-gradient(180deg, var(--research-paper), rgba(245, 230, 200, 0.9)),\n    repeating-linear-gradient(135deg, rgba(46, 27, 14, 0.025) 0 1px, transparent 1px 11px);\n  font: inherit;\n  text-align: left;\n  cursor: pointer;\n}\n\n.research-chart__survey-line {\n  display: block;\n  width: 2px;\n  height: 24px;\n  margin: -1px 0 -1px 29px;\n  background: repeating-linear-gradient(180deg, rgba(46, 27, 14, 0.56) 0 4px, transparent 4px 8px);\n}\n\n.research-chart__survey-line::after {\n  content: \"\";\n  display: block;\n  width: 11px;\n  height: 2px;\n  margin-left: -4px;\n  background: rgba(46, 27, 14, 0.38);\n  transform: translateY(11px);\n}\n\n.research-chart__node:focus-visible {\n  outline: 3px solid #ffe4a0;\n  outline-offset: 2px;\n}\n\n.research-chart__node-topline {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n\n.research-chart__node-icon {\n  flex: 0 0 auto;\n  width: 46px;\n  height: 46px;\n  border: 1px solid rgba(46, 27, 14, 0.32);\n  border-radius: 8px;\n  background-color: rgba(255, 248, 232, 0.7);\n  box-shadow: inset 0 0 0 1px rgba(255, 248, 232, 0.5);\n}\n\n.research-chart__node strong {\n  font-size: 17px;\n  line-height: 1.12;\n}\n\n.research-chart__node .research-chart__effect,\n.research-chart__node em,\n.research-chart__node b,\n.research-chart__selection p,\n.research-chart__selection li,\n.research-chart__continued p {\n  font-size: 13px;\n  line-height: 1.42;\n}\n\n.research-chart__node em {\n  color: rgba(46, 27, 14, 0.68);\n  font-style: normal;\n}\n\n.research-chart__node b {\n  color: var(--research-brass);\n}\n\n.research-chart__state {\n  width: max-content;\n  color: var(--research-teal);\n  font-size: 11px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.research-chart__node[data-research-state=\"taken\"] {\n  border-color: var(--research-brass);\n  box-shadow: inset 0 0 0 2px rgba(139, 125, 60, 0.24);\n}\n\n.research-chart__node[data-research-state=\"available\"] {\n  border-color: var(--research-teal);\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.96), rgba(255, 228, 160, 0.52)),\n    repeating-linear-gradient(135deg, rgba(91, 138, 138, 0.045) 0 1px, transparent 1px 11px);\n  box-shadow:\n    inset 0 0 0 2px rgba(91, 138, 138, 0.14),\n    0 0 0 2px rgba(91, 138, 138, 0.2);\n}\n\n.research-chart__node[data-research-state=\"locked\"] {\n  opacity: 0.72;\n  color: rgba(46, 27, 14, 0.62);\n  background:\n    repeating-linear-gradient(135deg, rgba(46, 27, 14, 0.055) 0 2px, transparent 2px 10px),\n    rgba(232, 213, 168, 0.54);\n  filter: saturate(0.72);\n}\n\n.research-chart__node[data-research-state=\"locked\"] .research-chart__node-icon {\n  filter: grayscale(0.65) sepia(0.15);\n}\n\n.research-chart__node[data-selected-path=\"true\"] {\n  border-color: var(--research-ochre);\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.95), rgba(255, 228, 160, 0.52)),\n    repeating-linear-gradient(135deg, rgba(196, 136, 58, 0.07) 0 1px, transparent 1px 10px);\n}\n\n.research-chart__node[data-pinned-path=\"true\"] {\n  box-shadow:\n    inset 0 0 0 2px rgba(196, 136, 58, 0.22),\n    0 0 0 2px rgba(196, 136, 58, 0.18);\n}\n\n.research-chart__stamp,\n.research-chart__pin {\n  justify-self: start;\n  border: 2px solid currentColor;\n  border-radius: 5px;\n  padding: 2px 6px;\n  font-size: 11px;\n  line-height: 1;\n  transform: rotate(-2deg);\n}\n\n.research-chart__pin {\n  color: var(--research-ochre);\n  transform: none;\n}\n\n.research-chart__selection {\n  display: grid;\n  gap: 10px;\n  position: sticky;\n  top: 0;\n  border-width: 2px;\n  border-color: rgba(139, 125, 60, 0.5);\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.95), rgba(245, 230, 200, 0.92)),\n    repeating-linear-gradient(0deg, rgba(46, 27, 14, 0.04) 0 1px, transparent 1px 12px);\n}\n\n.research-chart__selection-kicker {\n  color: var(--research-ochre);\n  font-size: 11px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.research-impact {\n  display: grid;\n  gap: 7px;\n  border-top: 1px solid rgba(46, 27, 14, 0.24);\n  border-bottom: 1px solid rgba(46, 27, 14, 0.24);\n  padding: 9px 0;\n}\n\n.research-impact__badges {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.research-impact__badge {\n  width: max-content;\n  border: 1px solid var(--research-teal, #5b8a8a);\n  border-radius: 999px;\n  padding: 4px 8px;\n  color: #fff8e8;\n  background: var(--research-teal, #5b8a8a);\n  font-size: 11px;\n  font-weight: 900;\n  line-height: 1;\n  letter-spacing: 0.04em;\n}\n\n.research-chart__selection ol {\n  margin: 0;\n  padding-left: 18px;\n}\n\n.research-chart__epoch {\n  display: grid;\n  align-content: start;\n  gap: 4px;\n  min-height: 130px;\n  padding: 14px;\n  color: rgba(46, 27, 14, 0.48);\n  background:\n    linear-gradient(90deg, rgba(46, 27, 14, 0.18), transparent 16px),\n    repeating-linear-gradient(135deg, rgba(232, 213, 168, 0.62) 0 8px, rgba(255, 248, 232, 0.5) 8px 16px);\n}\n\n.research-chart__epoch span {\n  font-size: 12px;\n  text-transform: uppercase;\n}\n\n.research-chart__continued {\n  margin-top: 10px;\n}\n\n.gr-start-menu__small-button {\n  min-height: 44px;\n  padding: 8px 12px;\n  font-size: 14px;\n}\n\n@media (max-width: 760px) {\n  .gr-start-menu {\n    overflow: auto;\n  }\n\n  .gr-start-menu__column {\n    width: 100%;\n    min-width: 0;\n    min-height: 100%;\n    padding: max(22px, env(safe-area-inset-top)) 18px max(22px, env(safe-area-inset-bottom));\n    background: linear-gradient(180deg, rgba(46, 27, 14, 0.9), rgba(46, 27, 14, 0.64) 70%, rgba(46, 27, 14, 0.42));\n  }\n\n  .gr-start-menu__emblem {\n    width: 92px;\n  }\n\n  .gr-start-menu h1 {\n    font-size: 44px;\n  }\n\n  .gr-start-menu--research-open .gr-start-menu__column {\n    width: 100%;\n  }\n\n  .gr-start-menu--load-open .gr-start-menu__column {\n    width: 100%;\n  }\n\n  .gr-start-menu--research-open .gr-start-menu__nav {\n    grid-template-columns: 1fr;\n  }\n\n  .gr-start-menu--load-open .gr-start-menu__nav {\n    grid-template-columns: 1fr;\n  }\n\n  .gr-load-card {\n    grid-template-columns: 1fr;\n  }\n\n  .gr-load-card__rename {\n    grid-template-columns: 1fr;\n  }\n\n  .research-chart__header,\n  .research-chart__body {\n    grid-template-columns: 1fr;\n  }\n\n  .research-chart__meter {\n    justify-self: start;\n    text-align: left;\n  }\n\n  .research-chart__branches {\n    display: flex;\n    gap: 12px;\n    overflow-x: auto;\n    padding-bottom: 10px;\n    scroll-snap-type: x mandatory;\n  }\n\n  .research-chart__branch,\n  .research-chart__epoch {\n    flex: 0 0 min(340px, 86vw);\n    scroll-snap-align: start;\n  }\n\n  .research-chart__selection {\n    position: static;\n    order: -1;\n  }\n\n  .research-chart__node,\n  .research-chart__selection .gr-start-menu__small-button {\n    min-height: 44px;\n  }\n}\n\n#touch-controls {\n  position: absolute;\n  right: max(18px, env(safe-area-inset-right));\n  bottom: max(18px, env(safe-area-inset-bottom));\n  left: max(18px, env(safe-area-inset-left));\n  display: none;\n  justify-content: space-between;\n  align-items: flex-end;\n  pointer-events: none;\n}\n\n#touch-stick {\n  position: relative;\n  width: clamp(96px, 24vw, 132px);\n  aspect-ratio: 1;\n  border: 1px solid rgba(246, 241, 223, 0.28);\n  border-radius: 50%;\n  background: rgba(17, 19, 18, 0.52);\n  pointer-events: auto;\n  touch-action: none;\n}\n\n#touch-knob {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 42%;\n  aspect-ratio: 1;\n  border-radius: 50%;\n  background: #f5ba49;\n  box-shadow: 0 0 24px rgba(245, 186, 73, 0.44);\n  transform: translate(-50%, -50%);\n}\n\n#confirm-button,\n#rotate-button,\n#weapon-toggle-button {\n  width: clamp(74px, 18vw, 96px);\n  aspect-ratio: 1;\n  border: 1px solid rgba(246, 241, 223, 0.3);\n  border-radius: 50%;\n  color: #111312;\n  background: #48baa7;\n  font-weight: 800;\n  pointer-events: auto;\n  touch-action: none;\n}\n\n#rotate-button {\n  width: clamp(52px, 13vw, 68px);\n  background: #c4883a;\n}\n\n#weapon-toggle-button {\n  width: clamp(52px, 13vw, 68px);\n  background: #83ded7;\n}\n\n.hud-panel--weapon {\n  top: calc(max(16px, env(safe-area-inset-top)) + 58px);\n  right: max(16px, env(safe-area-inset-right));\n  display: grid;\n  grid-template-columns: max-content minmax(10ch, max-content);\n  align-items: baseline;\n  column-gap: 8px;\n  min-width: 168px;\n}\n\n.hud-panel--weapon .hud-value {\n  min-width: 10ch;\n}\n\n.hud-panel--weapon.hud-panel--disarmed > .hud-label,\n.hud-panel--weapon.hud-panel--disarmed > .hud-value {\n  opacity: 0.42;\n}\n\n.hud-weapon-reason {\n  grid-column: 1 / -1;\n  color: #7a4028;\n  font-size: 0.72rem;\n  font-style: italic;\n}\n\n.hud-agent-chip {\n  grid-column: 1 / -1;\n  display: grid;\n  grid-template-columns: 34px minmax(0, 1fr);\n  align-items: center;\n  gap: 4px 8px;\n  width: 100%;\n  max-width: 30ch;\n  min-height: 44px;\n  margin: 4px 0 0;\n  padding: 5px 0 0;\n  border-top: 1px solid rgba(255, 248, 232, 0.18);\n  border-right: 0;\n  border-bottom: 0;\n  border-left: 0;\n  color: inherit;\n  background: transparent;\n  font-size: 0.72rem;\n  font-family: inherit;\n  font-weight: 800;\n  text-align: left;\n  pointer-events: auto;\n  cursor: pointer;\n}\n\n.hud-agent-chip:hover,\n.hud-agent-chip:focus-visible {\n  outline: 2px solid rgba(91, 138, 138, 0.72);\n  outline-offset: 3px;\n}\n\n.hud-agent-chip__portrait {\n  grid-row: span 2;\n  width: 34px;\n  height: 34px;\n  border: 1px solid rgba(46, 27, 14, 0.52);\n  border-radius: 6px;\n  object-fit: cover;\n  background: #f5e6c8;\n}\n\n.hud-agent-chip__main {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) max-content;\n  gap: 2px 6px;\n  width: 100%;\n  min-width: 0;\n}\n\n.hud-agent-chip__main [data-hud-agent-name] {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.hud-agent-chip strong {\n  color: #f5ba49;\n}\n\n.hud-agent-chip [data-hud-agent-label] {\n  grid-column: 1 / -1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.hud-agent-feed {\n  grid-column: 2;\n  max-width: 24ch;\n  overflow: hidden;\n  color: #83ded7;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.hud-agent-feed:empty {\n  display: none;\n}\n\n.hud-agent-detail {\n  display: none;\n  grid-column: 1 / -1;\n  max-width: 30ch;\n  padding: 6px 8px;\n  border: 1px solid rgba(46, 27, 14, 0.28);\n  border-radius: 6px;\n  color: #2e1b0e;\n  background: rgba(255, 248, 232, 0.88);\n  font-size: 0.7rem;\n  line-height: 1.25;\n  white-space: normal;\n}\n\n.hud-agent-chip:hover .hud-agent-detail,\n.hud-agent-chip:focus-visible .hud-agent-detail,\n.hud-agent-chip[data-open=\"true\"] .hud-agent-detail {\n  display: block;\n}\n\n.prospector-panel-shell {\n  position: fixed;\n  inset: 0;\n  z-index: 36;\n  display: grid;\n  align-items: start;\n  justify-items: end;\n  padding: calc(max(16px, env(safe-area-inset-top)) + 82px) max(16px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));\n  background: rgba(17, 19, 18, 0.36);\n  backdrop-filter: blur(1px);\n  pointer-events: auto;\n}\n\n.prospector-panel-shell[hidden] {\n  display: none;\n}\n\n.prospector-panel {\n  display: grid;\n  gap: 12px;\n  width: min(456px, calc(100vw - 32px));\n  max-height: calc(100vh - 116px);\n  overflow: auto;\n  padding: 14px;\n  border: 2px solid #8b7d3c;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(180deg, rgba(255, 248, 232, 0.95), rgba(245, 230, 200, 0.97)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 2px rgba(255, 248, 232, 0.5),\n    0 5px 0 rgba(46, 27, 14, 0.78),\n    0 18px 34px rgba(17, 19, 18, 0.32);\n  font-family: Wellfleet, Georgia, \"Iowan Old Style\", serif;\n}\n\n.prospector-panel__header {\n  display: grid;\n  grid-template-columns: 64px minmax(0, 1fr) 58px;\n  gap: 12px;\n  align-items: center;\n}\n\n.prospector-panel__portrait {\n  width: 64px;\n  height: 64px;\n  border: 2px solid rgba(46, 27, 14, 0.6);\n  border-radius: 8px;\n  object-fit: cover;\n  background: #fff8e8;\n}\n\n.prospector-panel__eyebrow,\n.prospector-panel p,\n.prospector-panel h2,\n.prospector-panel h3 {\n  margin: 0;\n}\n\n.prospector-panel__eyebrow {\n  color: #5b8a8a;\n  font-size: 0.74rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.prospector-panel__progress {\n  margin-top: 3px;\n  color: rgba(46, 27, 14, 0.76);\n  font-size: 0.78rem;\n  line-height: 1.3;\n}\n\n.prospector-panel h2 {\n  color: #2e1b0e;\n  font-size: 1.18rem;\n  line-height: 1.1;\n}\n\n.prospector-panel h3 {\n  color: #5b3a1f;\n  font-size: 0.82rem;\n  text-transform: uppercase;\n}\n\n.prospector-panel__close,\n.prospector-switch,\n.prospector-check {\n  min-height: 44px;\n  pointer-events: auto;\n}\n\n.prospector-panel__close {\n  min-width: 58px;\n  border: 2px solid #8b7d3c;\n  border-radius: 7px;\n  color: #2e1b0e;\n  background: #ffe4a0;\n  padding: 0 8px;\n  font: inherit;\n  font-weight: 900;\n  cursor: pointer;\n}\n\n.prospector-panel__close:hover,\n.prospector-panel__close:focus-visible,\n.prospector-switch:focus-within,\n.prospector-check:focus-within {\n  outline: 3px solid rgba(91, 138, 138, 0.6);\n  outline-offset: 2px;\n}\n\n.prospector-panel__section {\n  display: grid;\n  gap: 8px;\n  padding-top: 10px;\n  border-top: 1px solid rgba(139, 125, 60, 0.34);\n}\n\n.prospector-ladder,\n.prospector-abilities {\n  display: grid;\n  gap: 8px;\n}\n\n.prospector-rung {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(112px, max-content);\n  gap: 10px;\n  align-items: center;\n  min-height: 48px;\n  padding: 8px 0;\n  border-bottom: 1px solid rgba(46, 27, 14, 0.12);\n}\n\n.prospector-rung[data-earned=\"false\"] {\n  grid-template-columns: 1fr;\n}\n\n.prospector-rung[data-current=\"true\"] {\n  border-radius: 6px;\n  padding-right: 8px;\n  padding-left: 8px;\n  background: rgba(91, 138, 138, 0.16);\n  box-shadow: inset 3px 0 0 #5b8a8a;\n}\n\n.prospector-rung strong,\n.prospector-rung span {\n  display: block;\n}\n\n.prospector-rung span,\n.prospector-panel__hint,\n.prospector-receipts {\n  color: rgba(46, 27, 14, 0.78);\n  font-size: 0.78rem;\n  line-height: 1.35;\n}\n\n.prospector-rung__current {\n  color: #5b8a8a;\n  font-size: 0.68rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.prospector-switch,\n.prospector-check {\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr);\n  gap: 8px;\n  align-items: center;\n  cursor: pointer;\n}\n\n.prospector-switch input,\n.prospector-check input {\n  width: 20px;\n  height: 20px;\n  accent-color: #5b8a8a;\n}\n\n.prospector-check {\n  padding: 8px 0;\n}\n\n.prospector-check[data-allowed=\"false\"] span {\n  color: #a0522d;\n}\n\n.prospector-check--locked {\n  grid-template-columns: auto minmax(0, 1fr);\n  cursor: default;\n}\n\n.prospector-lock {\n  width: auto;\n  font-size: 0.62rem;\n  font-weight: 900;\n  text-transform: uppercase;\n  text-align: center;\n}\n\n.prospector-check small {\n  font-size: 0.72rem;\n  font-weight: 800;\n}\n\n.prospector-receipts-wrap {\n  min-width: 0;\n}\n\n.prospector-receipts-wrap summary {\n  display: grid;\n  grid-template-columns: max-content minmax(0, 1fr);\n  gap: 8px;\n  align-items: center;\n  min-height: 44px;\n  color: #5b3a1f;\n  cursor: pointer;\n}\n\n.prospector-receipts-wrap summary span {\n  color: #5b3a1f;\n  font-size: 0.82rem;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.prospector-receipts-wrap summary strong {\n  min-width: 0;\n  overflow: hidden;\n  color: rgba(46, 27, 14, 0.78);\n  font-size: 0.78rem;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.prospector-receipts {\n  display: grid;\n  gap: 8px;\n  max-height: 184px;\n  margin: 0;\n  padding: 0 0 0 20px;\n  overflow: auto;\n}\n\n.prospector-receipts li {\n  padding: 2px 0;\n}\n\n.hud-panel--build {\n  position: absolute;\n  z-index: 7;\n  left: max(18px, env(safe-area-inset-left));\n  bottom: max(18px, env(safe-area-inset-bottom));\n  width: min(340px, calc(100vw - 36px));\n}\n\n.hud-build-control {\n  display: grid;\n  gap: 8px;\n  pointer-events: auto;\n}\n\n.hud-build-menu {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px;\n}\n\n.hud-build-menu[hidden] {\n  display: none;\n}\n\n.hud-build-blurb {\n  grid-column: 1 / -1;\n  min-height: 58px;\n  border: 1px solid rgba(46, 27, 14, 0.58);\n  border-radius: 8px;\n  padding: 8px 10px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.96), rgba(232, 213, 168, 0.98)),\n    #f5e6c8;\n  box-shadow: inset 0 0 0 1px rgba(91, 138, 138, 0.24);\n}\n\n.hud-build-blurb strong,\n.hud-build-blurb span {\n  display: block;\n}\n\n.hud-build-blurb strong {\n  font-size: 0.78rem;\n  font-weight: 900;\n}\n\n.hud-build-blurb span {\n  margin-top: 2px;\n  font-size: 0.74rem;\n  font-weight: 800;\n  line-height: 1.22;\n  overflow-wrap: anywhere;\n}\n\n.hud-build-button {\n  width: 100%;\n  min-height: 44px;\n  border: 1px solid rgba(246, 241, 223, 0.34);\n  border-radius: 8px;\n  padding: 10px 12px;\n  color: #fff8e8;\n  background: rgba(47, 143, 133, 0.82);\n  font: inherit;\n  font-weight: 800;\n  box-shadow: 0 0 18px rgba(131, 222, 215, 0.22);\n}\n\n.hud-build-tile {\n  display: grid;\n  grid-template-columns: auto minmax(0, 1fr);\n  align-items: center;\n  column-gap: 8px;\n  min-height: 64px;\n  border: 1px solid rgba(46, 27, 14, 0.58);\n  border-radius: 8px;\n  padding: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(245, 230, 200, 0.98)),\n    #f5e6c8;\n  box-shadow: inset 0 0 0 1px rgba(139, 125, 60, 0.32);\n  font: inherit;\n  text-align: left;\n}\n\n.hud-build-tile[data-selected=\"true\"] {\n  outline: 2px solid #5b8a8a;\n  outline-offset: 1px;\n}\n\n.hud-build-tile:disabled {\n  color: rgba(46, 27, 14, 0.46);\n  background: rgba(245, 230, 200, 0.68);\n}\n\n.hud-build-tile__key,\n.hud-build-tile__meta {\n  color: rgba(46, 27, 14, 0.66);\n  font-size: 0.72rem;\n  font-weight: 800;\n}\n\n.hud-build-tile__name {\n  display: block;\n  margin: 2px 0;\n  font-size: 0.88rem;\n  font-weight: 900;\n}\n\n.hud-build-button[data-active=\"true\"] {\n  background: #2f8f85;\n  outline: 2px solid rgba(255, 248, 232, 0.5);\n}\n\n.hud-build-button:disabled {\n  color: rgba(255, 248, 232, 0.5);\n  background: rgba(46, 27, 14, 0.58);\n  box-shadow: none;\n}\n\n.prompt-stack {\n  position: absolute;\n  left: 50%;\n  bottom: calc(max(18px, env(safe-area-inset-bottom)) + 88px);\n  z-index: 6;\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  align-items: center;\n  width: min(760px, calc(100vw - 32px));\n  pointer-events: none;\n  transform: translateX(-50%);\n}\n\n#hud[data-paused=\"true\"] .prompt-stack {\n  display: none;\n}\n\n#hud[data-paused=\"true\"] .hud-panel--weapon,\n#hud[data-paused=\"true\"] .hud-panel--xp,\n#hud[data-paused=\"true\"] .hud-panel--build,\nbody:has(#hud[data-paused=\"true\"]) #touch-controls,\nbody:has(.gr-start-menu) #touch-controls,\nbody:has(.gr-profile-title) #touch-controls {\n  display: none;\n}\n\n.assay-office-prompt {\n  padding: 8px 12px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.88), rgba(245, 230, 200, 0.96)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 1px rgba(139, 125, 60, 0.36),\n    0 4px 0 rgba(46, 27, 14, 0.62),\n    0 12px 20px rgba(46, 27, 14, 0.22);\n  font: 800 0.86rem/1.1 Wellfleet, Georgia, serif;\n  pointer-events: none;\n}\n\n.building-context-prompt {\n  display: grid;\n  grid-template-columns: 28px minmax(150px, 1fr) minmax(132px, auto) minmax(132px, auto);\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  padding: 8px 10px 8px 12px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(245, 230, 200, 0.97)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 1px rgba(139, 125, 60, 0.36),\n    0 4px 0 rgba(46, 27, 14, 0.62),\n    0 12px 20px rgba(46, 27, 14, 0.22);\n  font: 800 0.86rem/1.15 Wellfleet, Georgia, serif;\n  pointer-events: auto;\n}\n\n.world-info-note {\n  display: grid;\n  gap: 4px;\n  width: min(460px, 100%);\n  padding: 8px 12px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(245, 230, 200, 0.96)),\n    #f5e6c8;\n  box-shadow:\n    inset 0 0 0 1px rgba(91, 138, 138, 0.26),\n    0 4px 0 rgba(46, 27, 14, 0.55),\n    0 12px 20px rgba(46, 27, 14, 0.18);\n  font: 800 0.82rem/1.2 Wellfleet, Georgia, serif;\n  pointer-events: none;\n}\n\n.world-info-note__title {\n  color: #2e1b0e;\n  font-size: 0.88rem;\n  line-height: 1.05;\n  overflow-wrap: anywhere;\n}\n\n.world-info-note__body,\n.world-info-note__hint {\n  margin: 0;\n  color: rgba(46, 27, 14, 0.82);\n  overflow-wrap: anywhere;\n}\n\n.world-info-note__hint {\n  color: #5b8a8a;\n  font-size: 0.72rem;\n}\n\n.world-info-note--compact {\n  width: max-content;\n  max-width: 100%;\n  padding: 6px 10px;\n}\n\n.world-info-note--compact .world-info-note__title {\n  font-size: 0.82rem;\n}\n\n.building-context-prompt__icon {\n  display: inline-grid;\n  width: 24px;\n  height: 24px;\n  place-items: center;\n  border: 2px solid #2e1b0e;\n  border-radius: 50%;\n  color: #fff8e8;\n  background: #8b7d3c;\n  box-shadow: inset 0 0 0 1px rgba(255, 248, 232, 0.28);\n  font-size: 0.78rem;\n}\n\n.building-context-prompt__title {\n  min-width: 0;\n  overflow-wrap: anywhere;\n}\n\n.building-context-prompt__loss {\n  grid-column: 2 / -1;\n  min-width: 0;\n  color: #2e1b0e;\n  font-size: 0.72rem;\n  line-height: 1.1;\n  opacity: 0.76;\n}\n\n.building-context-prompt__button {\n  min-width: 0;\n  padding: 6px 9px;\n  border: 2px solid #2e1b0e;\n  border-radius: 6px;\n  color: #fff8e8;\n  background: #a0522d;\n  box-shadow: 0 2px 0 rgba(46, 27, 14, 0.55);\n  font: inherit;\n}\n\n.building-context-prompt__button--upgrade {\n  background: #5b8a8a;\n}\n\n.building-context-prompt__button--fund {\n  background: #5b8a8a;\n}\n\n.building-context-prompt__button[hidden] {\n  display: none;\n}\n\n.building-context-prompt__button:disabled {\n  color: rgba(46, 27, 14, 0.7);\n  background: rgba(139, 125, 60, 0.22);\n  box-shadow: none;\n}\n\n.assay-office-prompt[hidden] {\n  display: none;\n}\n\n.building-context-prompt[hidden] {\n  display: none;\n}\n\n.world-info-note[hidden] {\n  display: none;\n}\n\n@media (pointer: coarse), (max-width: 760px) {\n  .prompt-stack {\n    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 190px);\n  }\n}\n\n@media (max-width: 560px) {\n  .prompt-stack {\n    width: calc(100vw - 28px);\n  }\n\n  .building-context-prompt {\n    grid-template-columns: 24px minmax(0, 1fr);\n    align-items: stretch;\n  }\n\n  .world-info-note {\n    width: 100%;\n  }\n\n  .building-context-prompt__button,\n  .building-context-prompt__loss {\n    grid-column: 1 / -1;\n  }\n}\n\n@media (max-width: 430px) {\n  .assay-office-prompt__key {\n    display: none;\n  }\n}\n\n.upgrade-overlay {\n  position: absolute;\n  inset: 0;\n  z-index: 11;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  pointer-events: none;\n  opacity: 0;\n  background: rgba(46, 27, 14, 0.46);\n}\n\n.upgrade-overlay--visible {\n  pointer-events: auto;\n  opacity: 1;\n}\n\n.upgrade-overlay__panel {\n  width: min(820px, 100%);\n}\n\n.upgrade-overlay__cards {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 14px;\n}\n\n.upgrade-card {\n  position: relative;\n  min-height: 166px;\n  border: 2px solid #2e1b0e;\n  border-radius: 8px;\n  padding: 24px 18px 18px;\n  color: #2e1b0e;\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(246, 241, 223, 0.98)),\n    #f6f1df;\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.42),\n    0 4px 0 rgba(46, 27, 14, 0.78),\n    0 16px 28px rgba(46, 27, 14, 0.28);\n  cursor: pointer;\n  font: inherit;\n  text-align: left;\n}\n\n.upgrade-card:hover,\n.upgrade-card:focus-visible {\n  outline: 3px solid #ffe4a0;\n  outline-offset: 3px;\n}\n\n@media (pointer: coarse), (max-width: 760px) {\n  #touch-controls {\n    display: block;\n    height: 232px;\n  }\n\n  .prompt-stack {\n    left: max(14px, env(safe-area-inset-left));\n    right: calc(max(14px, env(safe-area-inset-right)) + 88px);\n    width: auto;\n    align-items: stretch;\n    transform: none;\n  }\n\n  .hud-panel.hud-panel--build {\n    right: max(18px, env(safe-area-inset-right));\n    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 232px);\n    left: auto;\n    width: 76px;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    box-shadow: none;\n  }\n\n  .hud-panel.hud-panel--build::before,\n  .hud-panel.hud-panel--build::after {\n    display: none;\n  }\n\n  .hud-panel.hud-panel--build:has(.hud-build-menu:not([hidden])) {\n    right: max(12px, env(safe-area-inset-right));\n    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 170px);\n    left: max(12px, env(safe-area-inset-left));\n    width: auto;\n    max-height: calc(100vh - max(12px, env(safe-area-inset-top)) - max(18px, env(safe-area-inset-bottom)) - 190px);\n    overflow: hidden;\n    padding: 8px;\n    border: 2px solid #2e1b0e;\n    background:\n      linear-gradient(135deg, rgba(255, 248, 232, 0.78), rgba(245, 230, 200, 0.94)),\n      #f5e6c8;\n    box-shadow:\n      inset 0 0 0 2px rgba(139, 125, 60, 0.38),\n      0 4px 0 rgba(46, 27, 14, 0.7),\n      0 12px 24px rgba(46, 27, 14, 0.18);\n  }\n\n  #hud:has(.hud-panel--build .hud-build-menu:not([hidden])) .hud-panel--xp,\n  #hud:has(.hud-panel--build .hud-build-menu:not([hidden])) .hud-panel--weapon,\n  #hud:has(.hud