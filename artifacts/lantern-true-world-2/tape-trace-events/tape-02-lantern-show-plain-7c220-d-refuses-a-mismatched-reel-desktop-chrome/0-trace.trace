ight: 1.25;\n}\n\n.gr-account-dev-code {\n  width: max-content;\n  max-width: 100%;\n  border: 1px solid rgba(196, 136, 58, 0.5);\n  border-radius: 6px;\n  padding: 6px 8px;\n  background: rgba(255, 228, 160, 0.24);\n  font-weight: 900;\n}\n\n.gr-account-danger {\n  color: #fff8e8;\n  background:\n    linear-gradient(135deg, rgba(160, 82, 45, 0.96), rgba(127, 38, 51, 0.96)),\n    #a0522d;\n}\n\n@media (max-width: 520px) {\n  .gr-account-form {\n    grid-template-columns: 1fr;\n  }\n}\n\n@keyframes claimOfficePayout {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.upgrade-overlay {\n  position: absolute;\n  inset: 0;\n  z-index: 11;\n  display: grid;\n  place-items: center;\n  padding: 24px;\n  color: var(--at-wood-950);\n  font-family: Georgia, \"Iowan Old Style\", serif;\n  pointer-events: none;\n  visibility: hidden;\n  opacity: 0;\n  background: rgba(46, 27, 14, 0.46);\n  transition: opacity 160ms ease-out;\n}\n\n.upgrade-overlay--visible {\n  pointer-events: auto;\n  visibility: visible;\n  opacity: 1;\n}\n\n.upgrade-overlay__panel {\n  width: min(820px, 100%);\n}\n\n.upgrade-overlay__eyebrow {\n  margin: 0 0 4px;\n  color: var(--at-sun-200);\n  font-size: 0.8rem;\n  font-weight: 800;\n  text-align: center;\n  text-transform: uppercase;\n}\n\n.upgrade-overlay h1 {\n  margin: 0 0 16px;\n  color: var(--at-cream-50);\n  font-size: 2rem;\n  line-height: 1.05;\n  text-align: center;\n  text-shadow: 0 2px 0 rgba(46, 27, 14, 0.8);\n}\n\n.upgrade-overlay__cards {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 14px;\n}\n\n.upgrade-card {\n  position: relative;\n  min-height: 166px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 8px;\n  padding: 24px 18px 18px;\n  color: var(--at-wood-950);\n  background:\n    linear-gradient(135deg, rgba(255, 248, 232, 0.9), rgba(246, 241, 223, 0.98)),\n    #f6f1df;\n  box-shadow:\n    inset 0 0 0 2px rgba(139, 125, 60, 0.42),\n    0 4px 0 rgba(46, 27, 14, 0.78),\n    0 16px 28px rgba(46, 27, 14, 0.28);\n  cursor: pointer;\n  font: inherit;\n  text-align: left;\n}\n\n.upgrade-card--provenance {\n  min-height: 198px;\n  padding-top: 44px;\n}\n\n.upgrade-card:hover,\n.upgrade-card:focus-visible {\n  outline: 3px solid var(--at-sun-200);\n  outline-offset: 3px;\n  transform: translateY(-2px);\n}\n\n.upgrade-card__key {\n  position: absolute;\n  top: 10px;\n  right: 10px;\n  display: grid;\n  place-items: center;\n  width: 28px;\n  height: 28px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 50%;\n  background: var(--at-teal-600);\n  color: var(--at-cream-50);\n  font-weight: 900;\n}\n\n.upgrade-card__elder-mark {\n  position: absolute;\n  top: 10px;\n  left: 10px;\n  display: grid;\n  place-items: center;\n  width: 28px;\n  height: 28px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 50%;\n  color: var(--at-cream-50);\n  background: var(--at-brass-700);\n  font-size: 0.72rem;\n  font-weight: 900;\n  line-height: 1;\n}\n\n.upgrade-card__name,\n.upgrade-card__effect,\n.upgrade-card__stacks {\n  display: block;\n}\n\n.upgrade-card__provenance {\n  display: block;\n  margin-top: 10px;\n  border-top: 1px solid rgba(91, 138, 138, 0.36);\n  padding-top: 8px;\n  color: rgba(46, 27, 14, 0.72);\n  font-size: 0.78rem;\n  font-weight: 800;\n  line-height: 1.22;\n}\n\n.upgrade-card__name {\n  max-width: calc(100% - 36px);\n  margin-bottom: 18px;\n  font-size: 1.48rem;\n  font-weight: 900;\n  line-height: 1.08;\n}\n\n.upgrade-card__effect {\n  color: var(--at-rust-600);\n  font-size: 1rem;\n  font-weight: 800;\n  line-height: 1.25;\n}\n\n.upgrade-card__stacks {\n  position: absolute;\n  left: 14px;\n  bottom: 12px;\n  display: grid;\n  place-items: center;\n  min-width: 24px;\n  height: 20px;\n  padding: 0 6px;\n  border: 1px solid rgba(139, 125, 60, 0.62);\n  border-radius: 999px;\n  color: rgba(46, 27, 14, 0.68);\n  background: rgba(255, 228, 160, 0.38);\n  font-size: 0.68rem;\n  font-weight: 800;\n  line-height: 1;\n}\n\n.upgrade-card__icon {\n  position: absolute;\n  top: 46px;\n  right: 12px;\n  width: 56px;\n  height: 56px;\n  background-size: contain;\n  background-repeat: no-repeat;\n  background-position: center;\n  filter: drop-shadow(0 2px 2px rgba(46, 27, 14, 0.32));\n  pointer-events: none;\n}\n\n.upgrade-card--icon .upgrade-card__name,\n.upgrade-card--icon .upgrade-card__effect {\n  max-width: calc(100% - 66px);\n}\n\n.upgrade-card--provenance.upgrade-card--icon .upgrade-card__icon {\n  top: 66px;\n}\n\n@keyframes hud-coin-tick {\n  0% {\n    transform: translateY(0) scale(1);\n  }\n  45% {\n    transform: translateY(-3px) scale(1.12);\n  }\n  100% {\n    transform: translateY(0) scale(1);\n  }\n}\n\n@keyframes hud-gold-pop {\n  0% {\n    transform: scale(1);\n  }\n  55% {\n    transform: scale(1.18);\n  }\n  100% {\n    transform: scale(1);\n  }\n}\n\n@media (max-width: 760px) {\n  .hud-training-tag {\n    left: max(12px, env(safe-area-inset-left));\n  }\n\n  .hud-panel {\n    padding: 8px 10px;\n  }\n\n  .hud-panel--vitals {\n    top: max(12px, env(safe-area-inset-top));\n    left: max(12px, env(safe-area-inset-left));\n    width: 162px;\n  }\n\n  .hud-panel--gold {\n    top: max(12px, env(safe-area-inset-top));\n    right: max(12px, env(safe-area-inset-right));\n    min-width: 108px;\n    max-width: calc(100vw - 24px);\n    grid-template-columns: 16px max-content minmax(3ch, 7ch);\n    column-gap: 6px;\n  }\n\n  .hud-panel--resource {\n    top: calc(max(12px, env(safe-area-inset-top)) + 48px);\n    right: max(12px, env(safe-area-inset-right));\n    min-width: 126px;\n    max-width: calc(100vw - 24px);\n    grid-template-columns: 16px max-content max-content minmax(4ch, 7ch);\n    column-gap: 6px;\n  }\n\n  .hud--pressure-visible .hud-panel--weapon {\n    top: calc(max(12px, env(safe-area-inset-top)) + 106px);\n  }\n\n  .hud__wave {\n    top: calc(max(12px, env(safe-area-inset-top)) + 104px);\n    left: max(1