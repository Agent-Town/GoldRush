n  text-transform: uppercase;\n}\n\n.playbook-surface h2 { margin: .15rem 0 0; font-size: 1.35rem; }\n.playbook-surface p { margin: .65rem 0; line-height: 1.35; }\n.playbook-surface label { display: block; margin-bottom: .3rem; font-size: .78rem; font-weight: 700; }\n\n.playbook-surface__heading button,\n.playbook-surface__recorder button,\n.playbook-surface__shelf button {\n  min-height: 2.35rem;\n  border: 1px solid #765033;\n  border-radius: .3rem;\n  color: #fff4d8;\n  background: #5b3a25;\n  font: 700 .78rem Georgia, 'Times New Roman', serif;\n}\n\n.playbook-surface__heading button { min-width: 2.35rem; font-size: 1.2rem; }\n.playbook-surface__recorder button,\n.playbook-surface__shelf button { padding: .45rem .7rem; }\n.playbook-surface button:disabled { opacity: .45; }\n\n.playbook-surface input {\n  min-width: 0;\n  flex: 1;\n  padding: .55rem;\n  border: 1px solid #8a6847;\n  border-radius: .25rem;\n  color: #3d2619;\n  background: #fff8e8;\n  font: inherit;\n}\n\n.playbook-surface__message { min-height: 1.2rem; color: #2f7f78; font-weight: 700; }\n.playbook-surface__shelf { display: grid; gap: .4rem; margin: .5rem 0 0; padding: 0; list-style: none; }\n.playbook-surface__shelf li { padding: .55rem; border-top: 1px solid rgba(118, 80, 51, .35); }\n.playbook-surface__shelf li span { display: grid; gap: .18rem; }\n.playbook-surface__shelf small { color: #765033; }\n.playbook-surface__empty { color: #765033; font-style: italic; }\n\n@media (max-width: 600px) {\n  .playbook-surface__toggle { top: 4.35rem; right: .5rem; }\n  .playbook-surface__panel {\n    top: auto;\n    right: .5rem;\n    bottom: 5rem;\n    width: calc(100vw - 1rem);\n    max-height: 58vh;\n    box-sizing: border-box;\n  }\n}\n"],["STYLE",{},".party-overview {\n  position: absolute;\n  top: calc(max(16px, env(safe-area-inset-top)) + 126px);\n  left: max(16px, env(safe-area-inset-left));\n  z-index: 3;\n  width: min(560px, calc(100vw - 32px));\n  color: var(--at-wood-950);\n  font: 700 0.72rem/1.1 Wellfleet, Georgia, serif;\n  pointer-events: auto;\n}\n\n.party-overview__header {\n  display: flex;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 12px;\n  margin-bottom: 5px;\n  padding-inline: 3px;\n  color: var(--at-cream-50);\n  text-shadow: 0 1px 2px rgba(46, 27, 14, 0.9);\n  text-transform: uppercase;\n  letter-spacing: 0.05em;\n}\n\n.party-overview__pot {\n  color: var(--at-sun-200);\n  white-space: nowrap;\n}\n\n.party-overview__cards {\n  display: flex;\n  gap: 7px;\n  overflow-x: auto;\n  padding: 0 0 5px;\n  scrollbar-width: none;\n}\n\n.party-overview__cards::-webkit-scrollbar {\n  display: none;\n}\n\n.party-rider-card {\n  flex: 0 0 126px;\n  min-height: 54px;\n  border: 2px solid var(--at-wood-950);\n  border-radius: 7px;\n  padding: 6px 8px;\n  color: var(--at-wood-950);\n  background: linear-gradient(135deg, rgba(255, 248, 232, 0.94), rgba(245, 230, 200, 0.96));\n  box-shadow: inset 0 0 0 1px rgba(139, 125, 60, 0.38), 0 3px 0 rgba(46, 27, 14, 0.68);\n  font: inherit;\n  text-align: left;\n  cursor: pointer;\n}\n\n.party-rider-card[data-self='true'] {\n  border-color: var(--at-teal-600);\n  box-shadow: inset 0 0 0 1px rgba(91, 138, 138, 0.55), 0 3px 0 rgba(46, 27, 14, 0.68);\n}\n\n.party-rider-card[data-agent='true'] {\n  border-color: var(--at-teal-600);\n  background: linear-gradient(135deg, rgba(224, 243, 238, 0.96), rgba(245, 230, 200, 0.96));\n}\n\n.party-rider-card[data-glancing='true'] {\n  outline: 3px solid var(--at-sun-200);\n  outline-offset: 1px;\n  transform: translateY(-1px);\n}\n\n.party-rider-card__topline {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 5px;\n  min-width: 0;\n}\n\n.party-rider-card__topline strong {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.party-rider-card__topline span {\n  color: var(--at-teal-600);\n  font-size: 0.6rem;\n  text-transform: uppercase;\n}\n\n.party-rider-card__hp {\n  display: block;\n  height: 6px;\n