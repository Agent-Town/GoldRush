    migrateProfileState(state) ?? {
      version: 2 as const,
      activeId: 'robin',
      profiles: [freshProfile(DEFAULT_PROFILE_NAME, Date.now(), 'robin')],
    };
  rawSet(storage, PROFILE_KEY, JSON.stringify(next));
  return next;
