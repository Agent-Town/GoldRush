import { loadContract, type ContractManifest, type ContractWaterMaskRegion } from '../meta/ContractFamilies';

const WIDTH = 80;
const HEIGHT = 56;
const PAD_X = 3;
const PAD_Y = 2;
const COLS = 16;
const ROWS = 12;
const DEFAULT_SEAM_ANCHORS = [
  { x: -22, z: -6.8 }, { x: -9, z: 6.7 }, { x: -1.5, z: -6.4 },
  { x: 7.5, z: 6.5 }, { x: 18, z: -7 }, { x: 25, z: 6.9 },
