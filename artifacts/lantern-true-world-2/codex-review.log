  if (!__GR_RELEASE_E1__ && currentSearch.has('editor')) {
    void import('./editor/DescriptorInspector').then(({ installDescriptorInspector }) => installDescriptorInspector(app));
  }
  releaseStartupAssetGateOnFirstGameFrame();
