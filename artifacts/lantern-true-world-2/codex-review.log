  // Inert unless GR_CAPTURE_EXTERNAL_SERVER=1, so lanes and ordinary runs pay nothing.
  globalSetup: './scripts/external-server-guard.mjs',
  webServer: process.env.GR_CAPTURE_EXTERNAL_SERVER === '1' ? undefined : {
    command: 'npm run dev',
