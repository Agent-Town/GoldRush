     1	import type { RunTape } from '../game/RunTape';
     2	import { applyStoredPerformanceTier } from '../game/PerformanceTier';
     3	import { stageReplayContract } from '../meta/ContractFamilies';
     4	import { markStartupFrameReady } from '../assets/generated';
     5	import { LanternController } from './LanternController';
     6	
     7	/** One contract per page: stage BEFORE dynamically evaluating Terrain/TileHeight, as the worker does. */
     8	export async function bootLantern(parent: HTMLElement, tape: RunTape, options: {
     9	  shareUrl: string;
    10	  close: () => void;
    11	  tactical: boolean;
    12	}): Promise<{ dispose: () => void }> {
    13	  stageReplayContract(tape.contract);
    14	  const tier = applyStoredPerformanceTier(tape.contract).tier;
    15	  const { LanternWorldStage, lanternHeightAt } = await import('../world/LanternWorldStage');
    16	  const probe = document.createElement('canvas');
    17	  const gl = probe.getContext('webgl2');
    18	  const hasWebGL = gl !== null;
    19	  gl?.getExtension('WEBGL_lose_context')?.loseContext();
    20	  const world = hasWebGL ? new LanternWorldStage() : undefined;
    21	  const tactical = options.tactical || tier === 'lite' || !world;
    22	  // Lite still constructs the same painted ground; the explicitly labelled SVG is its current presentation.
    23	  if (world && tactical) world.canvas.hidden = true;
    24	  const controller = new LanternController(parent, tape, {
    25	    ...options, tactical, world, heightAt: lanternHeightAt,
    26	    pan: (dx, dz) => world?.pan(dx, dz),
    27	    render: (frame, snapshot, paused, speed) => {
    28	      world?.update(snapshot);
    29	      world?.render(frame.deltaSeconds, paused, speed);
    30	    },
    31	  });
    32	  const show = parent.querySelector<HTMLElement>('[data-testid="lantern-show"]');
    33	  if (show) {
    34	    show.dataset.boot = 'independent';
    35	    show.dataset.tier = tier;
    36	    show.dataset.worldSource = world ? world.canvas.dataset.terrain3dPilotRenderSource ?? 'painted' : 'unavailable';
    37	    show.dataset.fallback = !hasWebGL ? 'no-webgl' : tier === 'lite' ? 'lite' : options.tactical ? 'requested' : '';
    38	  }
    39	  markStartupFrameReady();
    40	  return { dispose: () => { controller.dispose(); world?.dispose(); } };
    41	}

