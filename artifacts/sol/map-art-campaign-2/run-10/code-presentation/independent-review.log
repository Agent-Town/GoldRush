   143	function addPathSegment(
   144	  a: RailPathPoint,
   145	  b: RailPathPoint,
   146	  rails: RailSegment[],
   147	  ties: Tie[],
   148	  samples: RailPathDiagnostics['samples'],
   149	  startOffset?: RailPathPoint,
   150	  endOffset?: RailPathPoint,
   151	): void {
   152	  const dx = b.x - a.x;
   153	  const dz = b.z - a.z;
   154	  const length = Math.hypot(dx, dz);
   155	  if (length <= 0.001) return;
   156
   157	  const dirX = dx / length;
   158	  const dirZ = dz / length;
   159	  const sideX = -dirZ;
   160	  const sideZ = dirX;
   161	  const railSteps = Math.max(1, Math.ceil(length / SEGMENT_MAX));
