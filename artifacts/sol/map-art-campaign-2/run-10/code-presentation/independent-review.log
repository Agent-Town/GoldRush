   197	function createRailMesh(segments: readonly RailSegment[]): THREE.InstancedMesh {
   198	  const mesh = new THREE.InstancedMesh(
   199	    new THREE.BoxGeometry(1, 1, 1),
   200	    new THREE.MeshStandardMaterial({ color: '#2d2921', roughness: 0.62, metalness: 0.28 }),
   201	    segments.length,
   202	  );
   203	  mesh.name = 'RailPath.Rails';
   204	  mesh.renderOrder = RenderLayers.groundDecals;
   205	  mesh.frustumCulled = false;
   206	  mesh.receiveShadow = true;
   207
   208	  const matrix = new THREE.Matrix4();
   209	  const midpoint = new THREE.Vector3();
   210	  const direction = new THREE.Vector3();
   211	  const rotation = new THREE.Quaternion();
   212	  const scale = new THREE.Vector3();
   213	  for (let index = 0; index < segments.length; index += 1) {
   214	    const segment = segments[index]!;
   215	    midpoint.copy(segment.start).add(segment.end).multiplyScalar(0.5);
   216	    direction.copy(segment.end).sub(segment.start);
   217	    const length = Math.max(0.001, direction.length());
   218	    rotation.setFromUnitVectors(UNIT_Z, direction.normalize());
   219	    scale.set(segment.width ?? RAIL_WIDTH, segment.height ?? RAIL_HEIGHT, length);
   220	    matrix.compose(midpoint, rotation, scale);
   221	    mesh.setMatrixAt(index, matrix);
   222	  }
   223	  mesh.instanceMatrix.needsUpdate = true;
   224	  return mesh;
   225	}
