   481	/** Cut silhouettes from the shipped atlas's green (2,1) and pale wood (0,1) cells.
   482	 * These are geometric cards, not a new bitmap or a new asset-store authoring path. */
   483	function riparianCardGeometry(kind: RiparianCard): THREE.BufferGeometry {
   484	  const positions: number[] = [], uvs: number[] = [];
   485	  const wood = [0.025, 0.525, 0.225, 0.725], green = [0.525, 0.525, 0.725, 0.725];
   486	  const strip = (ax: number, ay: number, bx: number, by: number, width: number, tip: number, cell: number[], angle: number) => {
   487	    const dx = bx - ax, dy = by - ay, length = Math.hypot(dx, dy);
   488	    const nx = -dy / length, ny = dx / length;
   489	    const points = [[ax + nx * width, ay + ny * width], [ax - nx * width, ay - ny * width],
   490	      [bx + nx * tip, by + ny * tip], [bx - nx * tip, by - ny * tip]];
   491	    for (const index of [0, 1, 2, 2, 1, 3]) {
   492	      const [x, y] = points[index]!;
   493	      positions.push(x! * Math.cos(angle), y!, x! * Math.sin(angle));
   494	      uvs.push(cell[index % 2 === 0 ? 0 : 2]!, cell[index < 2 ? 1 : 3]!);
   495	    }
   496	  };
   497	  for (const angle of [0, Math.PI / 2]) {
   498	    if (kind === 'driftwood') {
   499	      strip(-0.65, 0.13, 0.65, 0.18, 0.13, 0.09, wood, angle);
   500	      strip(0.08, 0.18, 0.38, 0.46, 0.06, 0.025, wood, angle);
   501	    } else if (kind === 'willow') {
   502	      strip(0, 0, 0.08, 1.85, 0.085, 0.02, wood, angle);
   503	      for (const side of [-1, 1]) for (const y of [0.9, 1.3, 1.7]) {
   504	        strip(0, y, side * 0.55, y - 0.12, 0.035, 0.012, wood, angle);
   505	        strip(side * 0.27, y, side * 0.48, y - 0.58, 0.18, 0.008, green, angle);
   506	      }
   507	    } else {
   508	      for (const [x, height] of [[-0.22, 0.86], [0, 1.25], [0.22, 1.05]]) {
   509	        strip(x!, 0, x! * 1.5, height!, 0.065, 0.006, green, angle);
   510	        strip(x! * 1.4, height! * 0.72, x! * 1.5, height! * 0.94, 0.042, 0.04, wood, angle);
   511	      }
   512	    }
   513	  }
   514	  const geometry = new THREE.BufferGeometry();
   515	  geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
   516	  geometry.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
   517	  geometry.computeVertexNormals();
   518	  return geometry;
   519	}
