   326	  private createClass(profile: DetailProfile, density: number): DetailClass {
   327	    const count = Math.max(0, Math.floor(profile.baseCount * density));
   328	    const mesh = new THREE.InstancedMesh(profile.geometry, profile.material, Math.max(1, count));
   329	    mesh.name = `DetailScatter.${profile.id}`;
   330	    mesh.userData.detailProfile = profile;
   331	    mesh.count = count;
   332	    mesh.frustumCulled = false;
   333	    mesh.castShadow = false;
   334	    mesh.receiveShadow = true;
   335	    if (profile.groundRotationX !== undefined) mesh.renderOrder = RenderLayers.groundDecals;
   336	    if (count === 0) mesh.visible = false;
   337	    this.group.add(mesh);
   338
   339	    const rng = createRng((this.seed ^ normalizeSeed(profile.id)) >>> 0);
   340	    // Dressing draws from a stream of its own, so adding a tint cannot shift one placement:
   341	    // the seeded scatter signature stays byte-identical to the run before this upgrade.
   342	    const tintRng = createRng((this.seed ^ normalizeSeed(`${profile.id}:tint`)) >>> 0);
   343	    const instances: DetailInstance[] = [];
   344	    for (let index = 0; index < count; index += 1) {
   345	      const placed = placeDetail(profile, rng, instances);
   346	      if (profile.instanceTint) mesh.setColorAt(index, profile.instanceTint(tintRng));
   347	      if (!placed) {
   348	        mesh.setMatrixAt(index, hiddenMatrix);
   349	        continue;
   350	      }
   351	      const detail: DetailInstance = {
   352	        ...placed,
   353	        hidden: false,
   354	        mesh,
   355	        index,
   356	        shadowIndex: CONTACT_SHADOW_CLASSES[profile.id] ? this.seededInstances.length : -1,
   357	      };
   358	      writeInstance(mesh, index, detail, false);
   359	      mesh.setColorAt(index, instanceTint(profile.id, placed.x, placed.z));
   360	      instances.push(detail);
   361	      this.seededInstances.push(detail);
   362	    }
   363	    mesh.instanceMatrix.needsUpdate = true;
   364	    if (mesh.instanceColor) mesh.instanceColor.needsUpdate = true;
   365	    const contact = contactPatchMesh(instances, profile);
   366	    if (contact) this.group.add(contact);
   367	    const swayTime = (profile.material.userData.reedTime ?? null) as THREE.IUniform<number> | null;
   368	    if (swayTime) {
   369	      let lastFrame = -1;
   370	      let last = 0;
   371	      mesh.onBeforeRender = (renderer) => {
   372	        if (renderer.info.render.frame === lastFrame) return;
   373	        lastFrame = renderer.info.render.frame;
   374	        const now = performance.now();
   375	        swayTime.value += last === 0 ? 0 : Math.min(0.1, Math.max(0, (now - last) / 1000));
   376	        last = now;
   377	      };
   378	    }
   379	    return { profile, mesh, instances };
   380	  }
   381	}
   382
   457	      contact: { radius: 0.38, minScale: 0.98 },
   458	    },
   459	  ];
   460	  if (!RIPARIAN_TABLE) return profiles;
   461	  const atlas = new THREE.TextureLoader().load(new URL('../../assets/pilots/map-rebuild-spike/landmarks/twin-banks/twin-banks-landmarks-atlas.png', import.meta.url).href);
   462	  atlas.colorSpace = THREE.SRGBColorSpace;
   463	  for (const profile of profiles) {
   464	    const card = RIPARIAN_TABLE[profile.id];
   465	    if (!card) continue;
   466	    profile.geometry.dispose();
   467	    profile.geometry = riparianCardGeometry(card);
   468	    // Ruts already own a transparent, double-sided draw. Keep it, but stand its driftwood up.
   469	    delete profile.groundRotationX;
   470	    const material = profile.material as THREE.MeshStandardMaterial | THREE.MeshBasicMaterial;
   471	    material.map?.dispose();
   472	    material.map = atlas;
   473	    material.color.set('#ffffff');
   474	    material.side = THREE.DoubleSide;
   475	    material.userData.riparianCard = card;
   476	    profile.baseY = -0.025;
   477	  }
   478	  return profiles;
   479	}
