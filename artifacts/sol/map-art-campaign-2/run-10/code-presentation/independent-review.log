   521	function profileCount(id: DetailClassId, fallback: number): number {
   522	  return Math.max(0, Math.floor(SCATTER_DESCRIPTOR?.classCounts?.[id] ?? fallback));
   523	}
   524
   525	function placeDetail(
   526	  profile: DetailProfile,
   527	  rng: Rng,
   528	  placedInClass: readonly DetailInstance[],
   529	): Omit<DetailInstance, 'hidden' | 'mesh' | 'index' | 'shadowIndex'> | null {
   530	  const attempts = Math.max(40, profile.baseCount * 80);
   531	  for (let attempt = 0; attempt < attempts; attempt += 1) {
   532	    const x = rng.range(Terrain.bounds.minX + 1, Terrain.bounds.maxX - 1);
   533	    const z = rng.range(Terrain.bounds.minZ + 1, Terrain.bounds.maxZ - 1);
   534	    if (Terrain.sample(x, z).zone !== 'bank') continue;
   535	    if (staticExcluded(x, z)) continue;
   536	    if (rng.next() > detailAcceptance(profile, x, z)) continue;
   537	    if (tooCloseToClass(x, z, placedInClass)) continue;
   538
   539	    const scale = rng.range(profile.minScale, profile.maxScale);
   540	    return {
   541	      x,
   542	      z,
   543	      y: Terrain.visualY(x, z, profile.baseY, 0.35),
   544	      rotation: rng.range(0, Math.PI * 2),
   545	      scale,
   546	    };
   547	  }
   548	  return null;
   549	}
   550
   551	function staticExcluded(x: number, z: number): boolean {
   552	  if (RIPARIAN_TABLE) {
   553	    // Include the widest card's footprint, not just its root. No vegetation in either build
   554	    // rectangle or either ford approach; no card reaches across a bank into navigable water.
   555	    const pad = 1.0;
   556	    const tile = activeContract().tileParams;
   557	    if (tile.buildZones?.some(zone => x >= zone.minX - pad && x <= zone.maxX + pad && z >= zone.minZ - pad && z <= zone.maxZ + pad)) return true;
   558	    if (tile.fords?.some(ford => Math.abs(x - ford.x) < ford.halfWidth + pad && Math.abs(z) < 7)) return true;
   559	    for (const [dx, dz] of [[pad, 0], [-pad, 0], [0, pad], [0, -pad]]) {
   560	      if (Terrain.sample(x + dx!, z + dz!).zone !== 'bank') return true;
   561	    }
   562	  }
   563	  if (Terrain.routingLaneDistance(x, z) < Balance.world.detailRoutingLaneClearRadius) return true;
   564	  if (distanceSq(x, z, BUILD_PAD_PROBE.x, BUILD_PAD_PROBE.z) < Balance.world.detailBuildPadClearRadius ** 2) return true;
   565	  for (const anchor of Terrain.nodeAnchors) {
   566	    if (distanceSq(x, z, anchor.x, anchor.z) < Balance.world.detailHarvestAnchorClearRadius ** 2) return true;
   567	  }
   568	  return false;
   569	}
   570
   571	function routingLaneDistance(x: number, z: number): number {
   572	  return Terrain.routingLaneDistance(x, z);
   573	}
   574
   575	function detailAcceptance(profile: DetailProfile, x: number, z: number): number {
   576	  const feature = Terrain.terrainFeatureSample(x, z);
   577	  const edge = Math.max(Math.abs(x) / Terrain.CLAIM_HALF, Math.abs(z) / Terrain.CLAIM_HALF);
   578	  const lane = Math.min(1, routingLaneDistance(x, z) / 10);
   579	  const base = 0.16 + edge * 0.74 + lane * 0.12;
   580	  if (profile.id === 'cactus') {
   581	    const dryEdge = smoothstep(7, 20, Math.abs(z)) * (1 - nearWaterMask(x, z));
   582	    return THREE.MathUtils.clamp(base * dryEdge * (0.7 + feature.shelf * 1.2 + feature.bluff * 0.4), 0.04, 0.88);
   583	  }
   584	  if (profile.id === 'reeds') {
   585	    const water = nearWaterMask(x, z);
   586	    const bias = SCATTER_DESCRIPTOR?.nearWaterBias ?? 1;
   587	    return THREE.MathUtils.clamp((0.14 + water * 1.6 * bias) * (0.7 + lane * 0.35), 0.02, 0.96);
   588	  }
   589	  const bias =
   590	    profile.id === 'rocks'
   591	      ? 0.42 + feature.shelf * 1.45 + feature.bluff * 0.55
   592	      : profile.id === 'dry_grass'
   593	        ? 0.58 + feature.pocket * 1.15 - feature.gully * 0.18
   594	        : 0.76 + feature.pocket * 0.18;
   595	  return THREE.MathUtils.clamp(base * bias, 0.08, 0.98);
   596	}
   597
   598	function nearWaterMask(x: number, z: number): number {
   599	  let mask = Terrain.hasRiverWater() ? 1 - smoothstep(0.8, 6.5, Math.max(0, Math.abs(z - ((Terrain.RIVER_MIN_Z + Terrain.RIVER_MAX_Z) / 2)) - ((Terrain.RIVER_MAX_Z - Terrain.RIVER_MIN_Z) / 2))) : 0;
   600	  for (const source of Terrain.waterSources()) {
   601	    mask = Math.max(mask, 1 - smoothstep(source.radius + 0.35, source.radius + 5.5, Math.hypot(x - source.x, z - source.z)));
   602	  }
   603	  return THREE.MathUtils.clamp(mask, 0, 1);
   604	}
   605
   606	function tooCloseToClass(x: number, z: number, placed: readonly DetailInstance[]): boolean {
   607	  for (const detail of placed) {
   608	    if (distanceSq(x, z, detail.x, detail.z) < 0.7 * 0.7) return true;
   609	  }
   610	  return false;
   611	}
   612
   613	function writeInstance(mesh: THREE.InstancedMesh, index: number, detail: DetailInstance | Omit<DetailInstance, 'mesh' | 'index'>, hidden: boolean): void {
   614	  if (hidden) {
   615	    mesh.setMatrixAt(index, hiddenMatrix);
   616	    return;
   617	  }
   618	  const profile = profileForMesh(mesh);
   619	  scratchObject.position.set(detail.x, detail.y, detail.z);
   620	  if (profile?.groundRotationX !== undefined) {
   621	    scratchObject.rotation.set(profile.groundRotationX, 0, detail.rotation);
   622	  } else {
   623	    scratchObject.rotation.set(0, detail.rotation, 0);
   624	  }
   625	  scratchObject.scale.setScalar(detail.scale);
   626	  scratchObject.updateMatrix();
   627	  mesh.setMatrixAt(index, scratchObject.matrix);
   628	}
