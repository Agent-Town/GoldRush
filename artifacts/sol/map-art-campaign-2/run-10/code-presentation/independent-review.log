   244	    for (const child of [...this.group.children]) {
   245	      if (child.name.startsWith('DetailScatter.opaque.') || child.name.endsWith('.contact')) {
   246	        // Batch materials borrow the class atlas; do not dispose that shared texture.
   247	        const mesh = child as THREE.Mesh;
   248	        mesh.geometry.dispose();
   249	        if (child.name.endsWith('.contact')) (mesh.material as THREE.MeshBasicMaterial).map?.dispose();
   250	        (mesh.material as THREE.Material).dispose();
   251	        this.group.remove(child);
   252	      }
   253	    }
   254	    for (const entry of this.classes) {
   255	      entry.mesh.instanceMatrix.needsUpdate = true;
   256	      const contact = contactPatchMesh(entry.instances, entry.profile);
   257	      if (contact) this.group.add(contact);
   258	    }
   259	    this.batchOpaqueClasses();
   260	  }
   261
   262	  /** F-ASTRA-6: the census found 68–88% of the solid scatter outside the camera.
   263	   * Flatten static instances into two compatible opaque draws, preserving each class's
   264	   * linear tint, roughness, metalness and sidedness. Reeds retain their instanced sway;
   265	   * ruts and every contact shadow retain their original transparent render-list item. */
   266	  private batchOpaqueClasses(): void {
   267	    const cohorts = new Map<string, DetailClass[]>();
   268	    for (const entry of this.classes) {
   269	      const material = entry.profile.material;
   270	      if (!(material instanceof THREE.MeshStandardMaterial) || material.transparent ||
   271	          material.alphaTest > 0 || material.userData.reedTime || !entry.instances.length) continue;
   272	      const key = `${material.side}:${material.metalness}`;
   273	      const cohort = cohorts.get(key) ?? [];
   274	      cohort.push(entry);
   275	      cohorts.set(key, cohort);
   276	    }
   277	    for (const cohort of cohorts.values()) {
   278	      const material = (cohort[0]!.profile.material as THREE.MeshStandardMaterial).clone();
   279	      material.color.setRGB(1, 1, 1);
   280	      material.vertexColors = true;
   281	      material.customProgramCacheKey = () => 'opaque-scatter-roughness-v1';
   282	      material.onBeforeCompile = (shader) => {
   283	        shader.vertexShader = shader.vertexShader
   284	          .replace('#include <common>', '#include <common>\nattribute float scatterRoughness;\nvarying float vScatterRoughness;')
   285	          .replace('#include <begin_vertex>', '#include <begin_vertex>\nvScatterRoughness = scatterRoughness;');
   286	        shader.fragmentShader = shader.fragmentShader
   287	          .replace('#include <common>', '#include <common>\nvarying float vScatterRoughness;')
   288	          .replace('#include <roughnessmap_fragment>', '#include <roughnessmap_fragment>\nroughnessFactor = vScatterRoughness;');
   289	      };
   290	      const parts: OpaquePropPart[] = [];
   291	      const temporary: THREE.BufferGeometry[] = [];
   292	      for (const entry of cohort) {
   293	        const source = entry.profile.material as THREE.MeshStandardMaterial;
   294	        for (const detail of entry.instances) {
   295	          const geometry = new THREE.BufferGeometry();
   296	          geometry.setAttribute('position', entry.profile.geometry.getAttribute('position').clone());
   297	          geometry.setAttribute('normal', entry.profile.geometry.getAttribute('normal').clone());
   298	          if (RIPARIAN_TABLE) geometry.setAttribute('uv', entry.profile.geometry.getAttribute('uv').clone());
   299	          if (entry.profile.geometry.index) geometry.setIndex(entry.profile.geometry.index.clone());
   300	          const count = geometry.getAttribute('position').count;
   301	          const color = new THREE.Color();
   302	          entry.mesh.getColorAt(detail.index, color);
   303	          color.multiply(source.color);
   304	          const colors = new Float32Array(count * 3);
   305	          for (let vertex = 0; vertex < count; vertex++) color.toArray(colors, vertex * 3);
   306	          geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
   307	          geometry.setAttribute('scatterRoughness', new THREE.BufferAttribute(new Float32Array(count).fill(source.roughness), 1));
   308	          const matrix = new THREE.Matrix4();
   309	          entry.mesh.getMatrixAt(detail.index, matrix);
   310	          parts.push({ geometry, matrix, hidden: () => detail.hidden });
   311	          temporary.push(geometry);
   312	        }
   313	        // Keep the logical class and its seeded placement records for clearing diagnostics.
   314	        // This source mesh is never submitted; all rendering belongs to its opaque batch.
   315	        entry.mesh.visible = false;
   316	      }
   317	      const batch = createOpaquePropBatch(parts, material);
   318	      temporary.forEach(geometry => geometry.dispose());
   319	      batch.name = `DetailScatter.opaque.${cohort.map(entry => entry.profile.id).join('+')}`;
   320	      batch.userData.opaqueSourceIds = cohort.map(entry => entry.mesh.id);
   321	      batch.receiveShadow = true;
   322	      this.group.add(batch);
   323	    }
   324	  }
