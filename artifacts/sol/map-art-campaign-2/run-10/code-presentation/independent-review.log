   630	/**
   631	 * One mesh, one material, one draw call for every contact shadow on the map. Sized to the exact
   632	 * number of standing instances rather than a guessed ceiling.
   633	 */
   634	function createContactShadows(details: readonly DetailInstance[]): THREE.InstancedMesh {
   635	  const shadowed = details.filter((detail) => detail.shadowIndex >= 0);
   636	  const mesh = new THREE.InstancedMesh(
   637	    new THREE.CircleGeometry(1, 14),
   638	    new THREE.MeshBasicMaterial({
   639	      color: '#2e1b0e',
   640	      transparent: true,
   641	      opacity: CONTACT_SHADOW_OPACITY,
   642	      depthWrite: false,
   643	      polygonOffset: true,
   644	      polygonOffsetFactor: -1,
   645	      polygonOffsetUnits: -1,
   646	    }),
   647	    Math.max(1, shadowed.length),
   648	  );
   649	  mesh.name = 'DetailScatter.contactShadows';
   650	  mesh.frustumCulled = false;
   651	  mesh.castShadow = false;
   652	  mesh.receiveShadow = false;
   653	  mesh.renderOrder = RenderLayers.groundShadows;
   654	  mesh.count = shadowed.length;
   655	  if (shadowed.length === 0) mesh.visible = false;
   656	  // shadowIndex is an index into `details`, so compact it down to the shadow mesh's own slots.
   657	  shadowed.forEach((detail, slot) => {
   658	    detail.shadowIndex = slot;
   659	    writeContactShadow(mesh, slot, detail, detail.hidden);
   660	  });
   661	  mesh.instanceMatrix.needsUpdate = true;
   662	  return mesh;
   663	}
   664
   665	function writeContactShadow(
   666	  mesh: THREE.InstancedMesh,
   667	  slot: number,
   668	  detail: DetailInstance,
   669	  hidden: boolean,
   670	): void {
   671	  if (hidden) {
   672	    mesh.setMatrixAt(slot, hiddenMatrix);
   673	    return;
   674	  }
   675	  const profile = profileForMesh(detail.mesh);
   676	  const shape = profile ? CONTACT_SHADOW_CLASSES[profile.id] : undefined;
   677	  if (!shape) {
   678	    mesh.setMatrixAt(slot, hiddenMatrix);
   679	    return;
   680	  }
   681	  scratchObject.position.set(detail.x, Terrain.visualY(detail.x, detail.z, 0, 0.35) + CONTACT_SHADOW_LIFT, detail.z);
   682	  scratchObject.rotation.set(-Math.PI / 2, 0, detail.rotation);
   683	  scratchObject.scale.set(shape.radius * detail.scale, shape.radius * shape.squash * detail.scale, 1);
   684	  scratchObject.updateMatrix();
   685	  mesh.setMatrixAt(slot, scratchObject.matrix);
   686	}
   687
   688	/**
   689	 * A warm/cool and light/dark nudge per instance, hashed from world position so it is stable across
   690	 * boots and independent of the placement stream. Multiplied onto the class colour by three's
   691	 * instance-colour attribute — same material, same single draw call.
   692	 */
   693	function instanceTint(id: DetailClassId, x: number, z: number): THREE.Color {
   694	  const jitter = TINT_JITTER[id];
   695	  if (!jitter) return scratchColor.setRGB(1, 1, 1);
   696	  const warm = hash01(x * 12.9898 + z * 78.233) - 0.5;
   697	  const value = hash01(x * 39.3468 - z * 11.135 + 7.31) - 0.5;
   698	  const scale = 1 + value * jitter.value * 2;
   699	  return scratchColor.setRGB(
   700	    scale * (1 + warm * jitter.warm),
   701	    scale,
   702	    scale * (1 - warm * jitter.warm),
   703	  );
   704	}
   705
   706	function hash01(value: number): number {
   707	  const scaled = Math.sin(value) * 43758.5453;
   708	  return scaled - Math.floor(scaled);
   709	}
   710
   711	function profileForMesh(mesh: THREE.InstancedMesh): DetailProfile | undefined {
   712	  return mesh.userData.detailProfile as DetailProfile | undefined;
   713	}
   714
   715	function isNearAny(detail: DetailInstance, clearings: readonly DetailScatterClearPoint[]): boolean {
   716	  for (const clearing of clearings) {
   717	    if (distanceSq(detail.x, detail.z, clearing.x, clearing.z) < clearing.radius * clearing.radius) return true;
   718	  }
   719	  return false;
   720	}
   721
   722	function probeClear(
   723	  details: readonly DetailInstance[],
   724	  x: number,
   725	  z: number,
   726	  clearRadius: number,
   727	): DetailScatterProbe {
   728	  let nearestSq = Number.POSITIVE_INFINITY;
   729	  for (const detail of details) {
   730	    if (detail.hidden) continue;
   731	    nearestSq = Math.min(nearestSq, distanceSq(x, z, detail.x, detail.z));
   732	  }
   733	  const nearest = Number.isFinite(nearestSq) ? Math.sqrt(nearestSq) : null;
   734	  return {
   735	    x,
   736	    z,
   737	    clearRadius,
   738	    nearest,
   739	    clear: nearest === null || nearest >= clearRadius,
   740	  };
   741	}
   742
   743	function detailDensity(tier: DetailDensityTier): number {
   744	  if (tier === 'off') return 0;
   745	  const raw = tier === 'mobile-reduced' ? Balance.world.detailMobileDensity : Balance.world.detailDensity;
   746	  return THREE.MathUtils.clamp(raw * (SCATTER_DESCRIPTOR?.density ?? 1), 0, 1.5);
   747	}
   748
   749	function densityTier(): DetailDensityTier {
   750	  const mobile = typeof window !== 'undefined' && window.innerWidth <= 430;
   751	  const density = mobile ? Balance.world.detailMobileDensity : Balance.world.detailDensity;
   752	  if (density <= 0) return 'off';
   753	  return mobile ? 'mobile-reduced' : 'desktop';
   754	}
   755
   756	function scatterSeed(): number {
   757	  const raw = typeof window === 'undefined' ? null : new URLSearchParams(window.location.search).get('seed');
   758	  return (normalizeSeed(raw) ^ 0x51f15eed) >>> 0;
   759	}
   760
   761	function distanceSq(ax: number, az: number, bx: number, bz: number): number {
   762	  const dx = ax - bx;
   763	  const dz = az - bz;
