   230	    new THREE.MeshStandardMaterial({ color: '#6f4b2d', roughness: 0.9, metalness: 0.02 }),
   231	    ties.length,
   232	  );
   233	  mesh.name = 'RailPath.Sleepers';
   234	  mesh.renderOrder = RenderLayers.groundDecals;
   235	  mesh.frustumCulled = false;
   236	  mesh.receiveShadow = true;
   237
   238	  const matrix = new THREE.Matrix4();
   239	  const position = new THREE.Vector3();
   240	  const rotation = new THREE.Quaternion();
   241	  const scale = new THREE.Vector3(TIE_WIDTH, TIE_HEIGHT, TIE_DEPTH);
