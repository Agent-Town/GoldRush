     4	/** Render-only, like CanalFlowPresentation: read the existing front and suppression; write
     5	 * only material uniforms. No orders, view fields, sim clock, terrain import or extra draws.
     6	 * The four GLBs' authored teal lamp/dial faces occupy atlas cell (0,2). The rest of each
     7	 * frame keeps its existing daylight pigment and calibrated whole-body ink lift. */
     8	type SignalState = Pick<InterferenceFrontDiagnostics, 'sites'>;
     9	type Binding = {
    10	  site: string;
    11	  material: THREE.MeshStandardMaterial;
    12	  pulse: THREE.IUniform<number>;
