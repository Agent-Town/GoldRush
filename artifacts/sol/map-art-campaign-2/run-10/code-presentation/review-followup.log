    18	export class RelaySignalPresentation {
    19	  private readonly bindings: Binding[] = [];
    20	  private readonly previousRender: THREE.Scene['onBeforeRender'];
    21	  private readonly render: THREE.Scene['onBeforeRender'];
    22	  private complete = false;
    23	  private disposed = false;
    24
    25	  static terrainState(canvas: HTMLCanvasElement, cancelled: boolean): string | undefined {
    26	    if (cancelled) return 'disposed';
    27	    // The canvas can survive a run restart, so its primary state takes precedence over an
    28	    // old landmark-state attribute until the new terrain owner has finished loading.
    29	    return canvas.dataset.terrain3dPilotState === 'ready'
    30	      ? canvas.dataset.terrain3dPilotLandmarkLoadState
    31	      : canvas.dataset.terrain3dPilotState;
    32	  }
