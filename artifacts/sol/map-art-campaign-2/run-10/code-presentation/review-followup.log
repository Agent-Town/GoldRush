    38	    private readonly readTerrainState: () => string | undefined = () => 'mounted',
    39	  ) {
    40	    this.previousRender = scene.onBeforeRender;
    41	    this.render = (...args) => {
    42	      this.previousRender.apply(scene, args);
    43	      this.sync(performance.now() / 1000);
    44	    };
    45	    scene.onBeforeRender = this.render;
    46	  }
    47
    48	  sync(seconds: number): void {
    49	    if (this.disposed) return;
    50	    const terrain = this.readTerrainState();
    51	    if (terrain === 'off' || terrain === 'lite' || terrain === 'failed' || terrain === 'disposed') {
    52	      this.dispose();
