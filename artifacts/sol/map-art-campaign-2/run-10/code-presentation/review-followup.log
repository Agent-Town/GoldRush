    93	  private bind(site: string, material: THREE.MeshStandardMaterial): void {
    94	    if (this.bindings.some(binding => binding.material === material)) return;
    95	    const binding: Binding = {
    96	      site, material, pulse: { value: 0 }, compile: material.onBeforeCompile,
