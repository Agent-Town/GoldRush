    54	    }
    55	    // No scene walks, front snapshots or uniforms while the asynchronous terrain is pending.
    56	    if (terrain !== 'mounted') return;
    57	    const state = this.readFront();
    58	    // Models arrive asynchronously. Once the four slots bind, the steady frame does no tree
    59	    // traversal. Their material disposal releases this owner with the existing terrain owner.
    60	    if (!this.complete) {
    61	      for (const site of state.sites) {
    62	        if (this.bindings.some(binding => binding.site === site.id)) continue;
    63	        const match = /^relay-site-(r[1-4])$/.exec(site.id);
    64	        const model = match ? this.scene.getObjectByName(`rush-relay-${match[1]}-frame`) : undefined;
    65	        model?.traverse(object => {
    66	          const mesh = object as THREE.Mesh;
    67	          if (!mesh.isMesh) return;
    68	          for (const material of Array.isArray(mesh.material) ? mesh.material : [mesh.material]) {
    69	            if (material instanceof THREE.MeshStandardMaterial && material.map) this.bind(site.id, material);
    70	          }
    71	        });
    72	      }
    73	      // 'mounted' is the terrain owner's terminal receipt. A missing slot cannot arrive
    74	      // later in this mount, so even an incomplete/empty pack must not cause an endless scan.
    75	      this.complete = true;
    76	      if (this.bindings.length === 0) { this.dispose(); return; }
    77	    }
    78	    const suppressed = this.suppressed();
    79	    const pulse = 1.05 + 0.3 * Math.sin(seconds * Math.PI * 1.5);
    80	    for (const binding of this.bindings) {
