name = "MULTIPLAYER_ROOMS"
class_name = "MultiplayerRoom"
script_name = "gold-rush-mp-room"

# Enable only after the owner deploys and bootstraps the registry; also set the
# environment's ACCOUNT_REGISTRY_SCOPE (source ACCOUNTS KV namespace ID).
# See docs/ops/account-registry.md. Both settings deliberately stay absent here.
# [[durable_objects.bindings]]
# name = "ACCOUNT_REGISTRY"
# class_name = "AccountRegistry"
# script_name = "gold-rush-account-registry"

# F-LBKV-1 (2026-08-04): standings/bugs/stats read `env.TELEMETRY ?? env.ACCOUNTS`; no KV
