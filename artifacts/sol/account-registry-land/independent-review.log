   102	    const expected = await sha256(`Bearer ${secret}`);
   103	    const actual = await sha256(supplied);
   104	    let difference = 0;
   105	    for (let index = 0; index < expected.length; index += 1) difference |= expected.charCodeAt(index) ^ actual.charCodeAt(index);
