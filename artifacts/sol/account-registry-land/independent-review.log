    96	  async fetch(request: Request, env: RegistryEnv): Promise<Response> {
    97	    const path = new URL(request.url).pathname;
    98	    if (path !== '/bootstrap' && path !== '/status') return json({ error: 'not_found' }, 404);
    99	    const secret = env.ACCOUNT_REGISTRY_MIGRATION_SECRET;
