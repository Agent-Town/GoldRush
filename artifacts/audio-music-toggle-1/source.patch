diff --git a/src/ui/theme.css b/src/ui/theme.css
index aa984609a..35344b4d9 100644
--- a/src/ui/theme.css
+++ b/src/ui/theme.css
@@ -2120,0 +2121,67 @@
+
+/* One-tap music controls share the audio preference across scene owners. */
+.music-toggle {
+  min-width: 44px;
+  min-height: 44px;
+  touch-action: manipulation;
+}
+.hud-music-toggle {
+  position: absolute;
+  right: calc(max(16px, env(safe-area-inset-right)) + 180px);
+  bottom: max(18px, env(safe-area-inset-bottom));
+  padding: 6px 10px;
+  border: 2px solid var(--at-wood-950);
+  border-radius: 8px;
+  background: var(--at-sand-100);
+  color: var(--at-wood-950);
+  font: inherit;
+  font-size: .82rem;
+  pointer-events: auto;
+}
+.music-toggle:focus-visible {
+  outline: 2px solid var(--at-teal-600);
+  outline-offset: 2px;
+}
+@media (pointer: coarse), (max-width: 760px) {
+  .hud-music-toggle {
+    right: calc(max(18px, env(safe-area-inset-right)) + 82px);
+    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 238px);
+  }
+  #hud[data-paused="true"] .hud-music-toggle {
+    right: max(12px, env(safe-area-inset-right));
+    bottom: calc(max(12px, env(safe-area-inset-bottom)) + 64px);
+  }
+}
+@media (min-width: 390px) and (max-width: 430px) and (min-height: 701px) {
+  /* Share the agent chip's painted footprint without adding a HUD grid row. */
+  #hud:has(.hud-music-toggle) .hud-panel--weapon .hud-agent-chip {
+    padding-right: 50px;
+  }
+  #hud:has(.hud-music-toggle) .hud-panel--weapon [data-hud-agent-label] {
+    overflow: hidden;
+    text-overflow: ellipsis;
+    white-space: nowrap;
+  }
+  #hud:has(.hud-music-toggle) .hud-panel--weapon:has(.e7-jack-board[hidden]) .hud-agent-chip {
+    padding-right: 6px;
+  }
+  #hud:not([data-paused="true"]) .hud-music-toggle {
+    position: absolute;
+    grid-column: 1 / 3;
+    grid-row: 3;
+    top: 0;
+    right: 82px;
+    bottom: auto;
+    width: 44px;
+    padding: 2px;
+    font-size: .6875rem;
+    line-height: 1.1;
+  }
+  #hud:not([data-paused="true"]):has(.e7-jack-board) .hud-music-toggle {
+    grid-column: 1 / -1;
+    right: 184px;
+  }
+  #hud:not([data-paused="true"]):has(.e7-jack-board[hidden]) .hud-music-toggle {
+    right: 0;
+  }
+}
