   223	function craftingQueuePlugin(): Plugin {
   224	  return {
   225	    name: 'gold-rush-crafting-queue',
   226	    handleHotUpdate(ctx) {
   227	      const queueRoot = resolve(process.cwd(), 'assets/crafting-queue') + sep;
   228	      if (ctx.file.startsWith(queueRoot)) return [];
   229	    },
   230	    configureServer(server) {
   231	      server.middlewares.use('/__goldrush/crafting-queue/state', async (req, res) => {
   232	        if (req.method !== 'GET') {
   233	          res.statusCode = 405;
   234	          res.end('Method not allowed');
   235	          return;
   236	        }
   237	
   238	        const url = new URL(req.url ?? '/', 'http://goldrush.local');
   239	        const profile = normalizeQueueProfile(url.searchParams.get('profile'));
   240	        res.setHeader('content-type', 'application/json');
   241	        res.end(JSON.stringify(await readQueueState(profile)));
   242	      });
   243	
   244	      server.middlewares.use('/__goldrush/crafting-queue/pending', async (req, res) => {
   245	        if (req.method !== 'POST') {
   246	          res.statusCode = 405;
   247	          res.end('Method not allowed');
   248	          return;
   249	        }
   250	
   251	        let payload: unknown;
   252	        try {
   253	          payload = JSON.parse(await readBody(req));
   254	        } catch {
   255	          res.statusCode = 400;
   256	          res.end('Invalid pending order');
   257	          return;
   258	        }
   259	
   260	        const request = sanitizePendingQueueRequest(payload);
   261	        if (!request) {
   262	          res.statusCode = 400;
   263	          res.end('Invalid pending order');
   264	          return;
   265	        }
   266	
   267	        const root = resolve(process.cwd(), CRAFTING_QUEUE_PENDING_DIR);
   268	        const relativePath = pendingQueuePath(request.id);
   269	        const filePath = resolve(process.cwd(), relativePath);
   270	        if (!filePath.startsWith(root + sep)) {
   271	          res.statusCode = 400;
   272	          res.end('Invalid pending path');
   273	          return;
   274	        }
   275	
   276	        const existingPath = await existingQueuePath(request.id);
   277	        if (existingPath) {
   278	          res.setHeader('content-type', 'application/json');
   279	          res.end(JSON.stringify({ ok: false, reason: 'duplicate', message: 'already at the works', path: existingPath }));
   280	          return;
   281	        }
   282	
   283	        try {
   284	          await mkdir(root, { recursive: true });
   285	          await writeFile(filePath, `${JSON.stringify(request, null, 2)}\n`, 'utf8');
   286	        } catch {
   287	          res.statusCode = 500;
   288	          res.end('Could not save pending order');
   289	          return;
   290	        }
   291	
   292	        res.setHeader('content-type', 'application/json');
   293	        res.end(JSON.stringify({ ok: true, path: relativePath }));
   294	      });
   295	    },
   296	  };
   297	}
   298	
   299	async function readQueueState(profile: string): Promise<{
   300	  pending: CraftingQueueRequest[];
   301	  approved: CraftingQueueApproved[];
   302	  rejected: CraftingQueueRejected[];
   303	}> {
   304	  const approved = (await readQueueDir('assets/crafting-queue/approved', parseApprovedQueueEntry)).filter(
   305	    (entry) => entry.request.profile === profile,
   306	  );
   307	  const rejected = (await readQueueDir('assets/crafting-queue/rejected', parseRejectedQueueEntry)).filter(
   308	    (entry) => entry.request.profile === profile,
   309	  );
   310	  const verdictIds = new Set([...approved, ...rejected].map((entry) => entry.id));
   311	  const pending = (await readQueueDir(CRAFTING_QUEUE_PENDING_DIR, sanitizePendingQueueRequest)).filter(
   312	    (entry) => entry.profile === profile && !verdictIds.has(entry.id),
   313	  );
   314	  return { pending, approved, rejected };
   315	}
   316	
   317	async function readQueueDir<T>(relativeDir: string, parse: (value: unknown) => T | null): Promise<T[]> {
   318	  const dir = resolve(process.cwd(), relativeDir);
   319	  const files = await readdir(dir).catch(() => []);
   320	  const entries = await Promise.all(
   321	    files
   322	      .filter((file) => file.endsWith('.json'))
   323	      .sort()
   324	      .map(async (file) => {
   325	        try {
   326	          return parse(JSON.parse(await readFile(resolve(dir, file), 'utf8')));
   327	        } catch {
   328	          return null;
   329	        }
   330	      }),
   331	  );
   332	  return entries.filter((entry): entry is T => Boolean(entry));
   333	}
   334	
   335	async function existingQueuePath(id: string): Promise<string | undefined> {
   336	  for (const state of ['pending', 'approved', 'rejected'] as const) {
   337	    const relativePath =
   338	      state === 'pending' ? pendingQueuePath(id) : `assets/crafting-queue/${state}/${id}.json`;
   339	    if (await fileExists(relativePath)) return relativePath;
   340	  }
   341	}
   342	
   343	async function fileExists(relativePath: string): Promise<boolean> {
   344	  try {
   345	    await access(resolve(process.cwd(), relativePath));
   346	    return true;
   347	  } catch {
   348	    return false;
   349	  }
   350	}
   351	
   352	function readBody(req: IncomingMessage): Promise<string> {
   353	  return new Promise((resolveBody, reject) => {
   354	    let body = '';
   355	    req.setEncoding('utf8');
   356	    req.on('data', (chunk) => {
   357	      body += chunk;
   358	      if (body.length > 4096) reject(new Error('Body too large'));
   359	    });
   360	    req.on('end', () => resolveBody(body));
   361	    req.on('error', reject);
   362	  });
   363	}

