   188	function releaseE1CharacterImports(): string[] {
   189	  const processedRoot = resolve(process.cwd(), 'assets/processed');
   190	  const characterContract = JSON.parse(
   191	    readFileSync(resolve(process.cwd(), 'assets/layer-contracts/characters.v2.json'), 'utf8'),
   192	  ) as { slots: Array<{ slot: string; [key: string]: unknown }> };
   193	  const townSheets = JSON.parse(
   194	    readFileSync(resolve(process.cwd(), 'src/town/town-actor-sheets.json'), 'utf8'),
   195	  ) as Record<string, string>;
   196	  const runtimeFrames = JSON.parse(
   197	    readFileSync(resolve(process.cwd(), 'src/assets/character-runtime-frames.json'), 'utf8'),
   198	  ) as unknown;
   199	  const references = new Set<string>(Object.values(townSheets).map((sheet) => `${sheet}.png`));
   200	  const collectPngReferences = (value: unknown): void => {
   201	    if (typeof value === 'string' && value.startsWith('char-') && value.endsWith('.png')) references.add(value);
   202	    else if (Array.isArray(value)) value.forEach(collectPngReferences);
   203	    else if (value && typeof value === 'object') Object.values(value).forEach(collectPngReferences);
   204	  };
   205	  characterContract.slots
   206	    .filter(({ slot }) => !/^char\.e(?:[2-9]|10)\./.test(slot))
   207	    .forEach(collectPngReferences);
   208	  collectPngReferences(runtimeFrames);
   209	
   210	  const contractedFiles = readdirSync(processedRoot).filter((file) =>
   211	    [...references].some((reference) =>
   212	      file === reference || file.startsWith(`${reference.slice(0, -4)}-r`) && /^.+-r\d+c\d+\.png$/.test(file),
   213	    ),
   214	  );
   215	  for (const sheet of Object.values(townSheets)) {
   216	    if (!contractedFiles.some((file) => file.startsWith(`${sheet}-r`))) {
   217	      throw new Error(`Frontier town actor sheet has no processed frames: ${sheet}`);
   218	    }
   219	  }
   220	  return contractedFiles.sort().map((file) => `../../assets/processed/${file}`);
   221	}
