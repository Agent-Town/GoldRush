export const SAME_ANGLE = 'The attached reference shows this same subject from ONE camera angle in four walk phases; copy its drawing, its costume and its technique exactly and change only what the heading above requires.';
export const HALFWAY = 'The attached reference sheet shows this same subject from the TWO camera angles either side of the one you must draw. Copy the costume, the palette and the drawing technique from the references — but NOT their camera angle: the new drawings are EXACTLY HALFWAY between the two reference angles, a true 45-degree three-quarter turn, the same 45 degrees in all four of them. Prove the turn in the drawing: the silhouette is visibly ASYMMETRIC about its vertical centre line, one side of the body is clearly nearer the camera and drawn larger than the other, and the near side overlaps the far side.';

export function buildPrompt(row) {
  const anchoring = row.mode === 'halfway' ? HALFWAY : SAME_ANGLE;
  return [row.sheet, RENDER, row.subject, row.facing, anchoring, row.phases, ANCHOR, SHEET_LAW].join(' ');
}
