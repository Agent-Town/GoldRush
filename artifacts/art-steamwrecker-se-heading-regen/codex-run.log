  const width=maxX-minX+1,height=maxY-minY+1,c=(minX+maxX)/2,offset=(best.cx-c)/width*100;
  cells.push({height,pct:+(height/512*100).toFixed(2),width,bbox:[minX,minY,maxX,maxY],lamp:best.size,lampCx:+best.cx.toFixed(2),offsetPct:+offset.toFixed(2),exact,near});
 }
 const flips=[];for(let a=0;a<4;a++)for(let b=a+1;b<4;b++){let sum=0,n=0,identical=true;const aox=(a%2)*512,aoy=Math.floor(a/2)*512,box=(b%2)*512,boy=Math.floor(b/2)*512;for(let y=0;y<512;y++)for(let x=0;x<512;x++){const ia=((aoy+y)*W+aox+x)*ch,ib=((boy+y)*W+box+(511-x))*ch;const fga=!BG(data[ia],data[ia+1],data[ia+2]),fgb=!BG(data[ib],data[ib+1],data[ib+2]);if(!(fga||fgb))continue;for(let k=0;k<3;k++){const d=Math.abs(data[ia+k]-data[ib+k]);sum+=d;n++;if(d)identical=false;}}flips.push({pair:`${a+1}-${b+1}`,mae:+(sum/n).toFixed(2),identical});}
