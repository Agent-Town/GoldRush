    16	test('FNV-1a 64 known vectors, full bytes, and independent BigInt reference', () => {
    17	  assert.equal(atlasHash(new Uint8Array()), 'cbf29ce484222325');
    18	  assert.equal(atlasHash(new TextEncoder().encode('hello')), 'a430d84680aabd0b');
    19	  const input = Uint8Array.from({ length: 16385 }, (_, i) => (i * 137) & 255);
    20	  let hash = 0xcbf29ce484222325n;
    21	  for (const byte of input) hash = BigInt.asUintN(64, (hash ^ BigInt(byte)) * 0x100000001b3n);
    22	  assert.equal(atlasHash(input), hash.toString(16).padStart(16, '0'));
    23	  input[input.length - 1] ^= 1;
    24	  assert.notEqual(atlasHash(input), hash.toString(16));
    25	});
