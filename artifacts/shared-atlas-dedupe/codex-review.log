    50	  const b = await cache.acquire(new Uint8Array([1]), async () => decoded().texture);
    51	  assert.notEqual(a.source, b.source); assert.equal(cache.size, 2);
    52	  cache.clear(); assert.equal(cache.size, 0);
    53	  await assert.rejects(cache.acquire(bytes, async () => decoded().texture), /disposed/);
    54	  const pending = new SharedAtlasCache(), late = decoded();
    55	  let finish;
    56	  const result = pending.acquire(bytes, () => new Promise(resolve => { finish = resolve; }));
    57	  await Promise.resolve(); pending.clear(); finish(late.texture);
    58	  await assert.rejects(result, /disposed/); assert.equal(pending.size, 0); assert.equal(late.closed(), 1);
    59	});
