     4	/** Full-byte FNV-1a 64, with exact 32-bit limbs (no BigInt allocation per byte). */
     5	export function atlasHash(bytes: Uint8Array): string {
     6	  let high = 0xcbf29ce4;
     7	  let low = 0x84222325;
     8	  for (const byte of bytes) {
     9	    low = (low ^ byte) >>> 0;
    10	    const product = low * 0x1b3;
    11	    high = (high * 0x1b3 + low * 0x100 + Math.floor(product / 0x100000000)) >>> 0;
    12	    low = product >>> 0;
    13	  }
    14	  return high.toString(16).padStart(8, '0') + low.toString(16).padStart(8, '0');
    15	}
    16	
    17	type Atlas = {
    18	  key: string;
    19	  promise: Promise<THREE.Texture>;
    20	  texture?: THREE.Texture;
    21	  views: Set<THREE.Texture>;
    22	  pending: number;
    23	};
    24	
    25	/** One decode promise / Source per image identity, owned by one canvas tracker. */
    26	export class SharedAtlasCache {
    27	  private readonly atlases = new Map<string, Atlas>();
    28	  private readonly sources = new WeakMap<THREE.Source, Atlas>();
    29	  private closed = false;
    30	
    31	  get size(): number { return this.atlases.size; }
    32	
    33	  owns(texture: THREE.Texture): boolean { return this.sources.has(texture.source); }
    34	
    35	  async acquire(bytes: Uint8Array, decode: () => Promise<THREE.Texture>): Promise<THREE.Texture> {
    36	    if (this.closed) throw new Error('Shared atlas tracker disposed');
    37	    const key = atlasHash(bytes);
    38	    let atlas = this.atlases.get(key);
    39	    if (!atlas) {
    40	      atlas = { key, promise: Promise.resolve().then(decode), views: new Set(), pending: 0 };
    41	      this.atlases.set(key, atlas);
    42	    }
    43	    atlas.pending++;
    44	    try {
    45	      const texture = await atlas.promise;
    46	      atlas.texture = texture;
    47	      this.sources.set(texture.source, atlas);
    48	      if (this.closed) throw new Error('Shared atlas tracker disposed');
    49	      return this.clone(texture)!;
    50	    } catch (error) {
    51	      if (this.atlases.get(key) === atlas) this.atlases.delete(key);
    52	      throw error;
    53	    } finally {
    54	      atlas.pending--;
    55	      this.releaseUnused(atlas);
    56	    }
    57	  }
    58	
    59	  /** Material views isolate sampler, UV and colorSpace state; Source stays shared. */
    60	  clone(texture: THREE.Texture): THREE.Texture | undefined {
    61	    const atlas = this.sources.get(texture.source);
    62	    if (!atlas) return undefined;
    63	    const view = texture.clone();
    64	    atlas.views.add(view);
    65	    const dispose = () => {
    66	      view.removeEventListener('dispose', dispose);
    67	      atlas.views.delete(view);
    68	      this.releaseUnused(atlas);
    69	    };
    70	    view.addEventListener('dispose', dispose);
    71	    return view;
    72	  }
    73	
    74	  clear(): void {
    75	    this.closed = true;
    76	    for (const atlas of this.atlases.values()) {
    77	      for (const texture of atlas.views) texture.dispose();
    78	      this.releaseUnused(atlas);
    79	    }
    80	    this.atlases.clear();
    81	  }
    82	
    83	  private releaseUnused(atlas: Atlas): void {
    84	    if (atlas.pending || atlas.views.size || !atlas.texture) return;
    85	    if (this.atlases.get(atlas.key) === atlas) this.atlases.delete(atlas.key);
    86	    const texture = atlas.texture;
    87	    atlas.texture = undefined;
    88	    this.sources.delete(texture.source);
    89	    texture.dispose();
    90	    // ImageBitmap owns native memory independently of the WebGL allocation.
    91	    texture.image?.close?.();
    92	  }
    93	}
