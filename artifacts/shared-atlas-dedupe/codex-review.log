    61	async function parse(cache, { wrapS = 10497, color = true, webp = false, mixed = false } = {}) {
    62	  const gltf = {
    63	    asset: { version: '2.0' }, buffers: [{ byteLength: 4, uri: 'data:application/octet-stream;base64,YXRsYQ==' }],
    64	    bufferViews: [{ buffer: 0, byteLength: 4 }], images: [{ bufferView: 0, mimeType: webp ? 'image/webp' : 'image/png' }],
    65	    textures: [{ sampler: 0, ...(webp ? { extensions: { EXT_texture_webp: { source: 0 } } } : { source: 0 }) }],
    66	    samplers: [{ wrapS, minFilter: 9728 }],
    67	    materials: [{ pbrMetallicRoughness: color ? { baseColorTexture: { index: 0 } } : { metallicRoughnessTexture: { index: 0 } }, ...(mixed ? { normalTexture: { index: 0 }, emissiveTexture: { index: 0, texCoord: 1 } } : {}) }],
    68	    meshes: [{ primitives: [{ attributes: {}, material: 0 }] }], nodes: [{ mesh: 0 }], scenes: [{ nodes: [0] }], scene: 0,
    69	    ...(webp ? { extensionsUsed: ['EXT_texture_webp'] } : {}),
    70	  };
    71	  const loader = new GLTFLoader();
    72	  loader.register(parser => {
    73	    parser.loadImageSource = async () => decoded().texture;
    74	    return new SharedAtlasPlugin(parser, cache);
    75	  });
    76	  const result = await loader.parseAsync(JSON.stringify(gltf), '');
    77	  return result.scene.children[0].material;
    78	}
