    36	  assert.notEqual(a.wrapS, b.wrapS); assert.notEqual(a.colorSpace, b.colorSpace); assert.equal(b.repeat.x, 1);
    37	  a.dispose(); assert.equal(cache.size, 1); assert.equal(image.closed(), 0);
    38	  a.dispose(); assert.equal(image.closed(), 0);
    39	  b.dispose(); assert.equal(cache.size, 0); assert.equal(image.closed(), 1);
    40	  const next = decoded();
    41	  const c = await cache.acquire(bytes, async () => next.texture);
    42	  assert.notEqual(c.source, a.source); c.dispose(); assert.equal(next.closed(), 1);
    43	});
