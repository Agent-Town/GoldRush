     1	import { mkdir, readFile, readdir, writeFile } from 'node:fs/promises';
     2	import path from 'node:path';
     3	import { expect, test, type Page } from '@playwright/test';
     4	import type * as THREE from 'three';
     5	
     6	const OUT = path.resolve('artifacts/shared-atlas-dedupe');
     7	const contracts = ['the-claim', 'e2-hill-mine', 'e8-mare-claim'];
     8	type Runtime = { scene: THREE.Scene; renderer: THREE.WebGLRenderer; dispose: () => void };
     9	// Test-only read access is installed INSIDE Game's existing ?debug guard.
    10	declare global { interface Window { __ATLAS_RUNTIME__?: () => Runtime } }
    11	
    12	async function instrument(page: Page, native = false) {
    13	  const errors: string[] = [];
    14	  page.on('pageerror', error => errors.push(error.message));
    15	  page.on('console', message => { if (message.type() === 'error') errors.push(message.text()); });
    16	  await page.route('**/src/game/Game.ts*', async route => {
    17	    const response = await route.fetch();
    18	    const source = await response.text();
    19	    expect(source).toContain('window.__GR_TEST__ = {');
    20	    await route.fulfill({ response, body: source.replace('window.__GR_TEST__ = {', 'window.__ATLAS_RUNTIME__ = () => ({ scene: this.scene, renderer: this.renderer, dispose: () => this.dispose() }); window.__GR_TEST__ = {') });
    21	  });
    22	  if (native) await page.route('**/src/assets/AssetLoading.ts*', async route => {
    23	    const response = await route.fetch();
    24	    const source = await response.text();
    25	    expect(source).toContain('new SharedAtlasPlugin(parser, cache)');
    26	    await route.fulfill({ response, body: source.replace('new SharedAtlasPlugin(parser, cache)', '({ name: "atlas-native-control" })') });
    27	  });
    28	  return errors;
    29	}
    30	
    31	async function boot(page: Page, contract: string) {
    32	  await page.goto(`/?debug&autotier&contract=${contract}&nowaves&nolevel&nokill&nopause&tier=full&seed=shared-atlas`);
    33	  const begin = page.getByRole('button', { name: 'Begin', exact: true });
    34	  if (await begin.isVisible()) await begin.click();
    35	  const briefing = page.getByTestId('contract-briefing');
    36	  if (await briefing.isVisible()) await page.getByTestId('contract-briefing-dismiss').click();
    37	  await page.waitForFunction(() => window.__GR_TEST__ && document.querySelector<HTMLCanvasElement>('#game-canvas')?.dataset.terrain3dPilotLandmarkLoadState === 'mounted', null, { timeout: 60_000 });
    38	  await page.evaluate(() => { window.__GR_TEST__!.teleport(8, 12); window.__GR_TEST__!.setManualSim(true); });
    39	  await page.waitForTimeout(2500);
    40	}
    41	
    42	async function snapshot(page: Page) {
    43	  return page.evaluate(async () => {
    44	    const { imageResidency } = await Function('return import("/artifacts/shared-atlas-dedupe/browser-harness.ts")')() as typeof import('../artifacts/shared-atlas-dedupe/browser-harness');
    45	    const { scene, renderer } = window.__ATLAS_RUNTIME__!();
    46	    return { textures: renderer.info.memory.textures, scene: imageResidency(scene), landmarks: imageResidency(scene.getObjectByName('Terrain3dLandmarks')) };
    47	  });
    48	}
    49	
    50	for (const contract of contracts) test(`${contract}: identical atlas sources share residency`, async ({ page, context }, info) => {
    51	  test.setTimeout(180_000);
    52	  const errors = await instrument(page);
    53	  await boot(page, contract);
    54	  const after = await snapshot(page);
    55	  await mkdir(OUT, { recursive: true });
    56	  await page.screenshot({ path: path.join(OUT, `after-${contract}-${info.project.name}.png`) });
    57	  // Same seed/camera/tier, native loader in an independent page: no production bypass flag.
    58	  const control = await context.newPage();
    59	  const controlErrors = await instrument(control, true);
    60	  await boot(control, contract);
    61	  const before = await snapshot(control);
    62	  await control.screenshot({ path: path.join(OUT, `before-${contract}-${info.project.name}.png`) });
    63	  await writeFile(path.join(OUT, `${contract}-${info.project.name}.json`), JSON.stringify({ before, after, errors, controlErrors }, null, 2) + '\n');
    64	  expect(after.landmarks.images).toBeLessThan(before.landmarks.images);
    65	  expect(after.landmarks.estimatedBytes).toBeLessThan(before.landmarks.estimatedBytes);
    66	  if (contract === 'the-claim') expect(before.textures - after.textures).toBeGreaterThanOrEqual(4);
    67	  expect(errors).toEqual([]); expect(controlErrors).toEqual([]);
    68	  await control.close();
    69	});
    70	
    71	test('production WebP atlas load-dispose-load returns to the renderer baseline', async ({ page }, info) => {
    72	  test.setTimeout(90_000);
    73	  const errors = await instrument(page);
    74	  await boot(page, 'the-claim');
    75	  // Read production names from GLB image census, rather than predicting Vite hashes.
    76	  const census = JSON.parse(await readFile(path.join(OUT, 'census.json'), 'utf8'));
    77	  const group = census.productionBuild.duplicates.find((entry: { images: string[] }) => entry.images.some(file => file.startsWith('active_headframe-')));
    78	  expect(group?.images).toHaveLength(5);
    79	  const files: string[] = group.images.map((file: string) => file.split('#')[0]);
    80	  const available = await readdir('dist/assets');
    81	  expect(files.every(file => available.includes(file))).toBe(true);
    82	  const proof = await page.evaluate(async urls => {
    83	    const { lifecycle } = await Function('return import("/artifacts/shared-atlas-dedupe/browser-harness.ts")')() as typeof import('../artifacts/shared-atlas-dedupe/browser-harness');
    84	    return lifecycle(window.__ATLAS_RUNTIME__!().renderer, urls);
    85	  }, files.map(file => `/dist/assets/${file}`));
    86	  await writeFile(path.join(OUT, `lifecycle-${info.project.name}.json`), JSON.stringify(proof, null, 2) + '\n');
    87	  for (const cycle of proof.cycles) {
    88	    expect(cycle.images).toBe(1);
    89	    expect(cycle.loaded - proof.baseline).toBe(1);
    90	    expect(cycle.disposed).toBe(proof.baseline);
    91	  }
    92	  expect(errors).toEqual([]);
    93	});

