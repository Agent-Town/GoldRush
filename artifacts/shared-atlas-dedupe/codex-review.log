    80	test('real GLTF parser: cross-file wrap, colorSpace, UV and WebP paths preserve independent material views', async () => {
    81	  // Buffer loading uses the browser ProgressEvent API in the installed GLTFLoader.
    82	  globalThis.ProgressEvent ??= class { constructor(type, init) { Object.assign(this, { type }, init); } };
    83	  const cache = new SharedAtlasCache();
    84	  const [a, b, c] = await Promise.all([parse(cache, { mixed: true }), parse(cache, { color: false, wrapS: 33071 }), parse(cache, { webp: true })]);
    85	  assert.equal(cache.size, 1);
    86	  assert.equal(a.map.source, b.metalnessMap.source); assert.equal(a.map.source, c.map.source);
    87	  assert.equal(a.map.colorSpace, THREE.SRGBColorSpace); assert.equal(a.normalMap.colorSpace, THREE.NoColorSpace);
    88	  assert.equal(b.metalnessMap.colorSpace, THREE.NoColorSpace);
    89	  assert.equal(a.map.wrapS, THREE.RepeatWrapping); assert.equal(b.metalnessMap.wrapS, THREE.ClampToEdgeWrapping);
    90	  assert.equal(a.map.generateMipmaps, false); assert.equal(a.emissiveMap.channel, 1); assert.equal(a.map.channel, 0);
    91	  for (const material of [a, b, c]) { material.emissiveMap = material.map; for (const value of Object.values(material)) if (value?.isTexture) value.dispose(); material.dispose(); }
    92	  assert.equal(cache.size, 0);
    93	});
