     5	export function imageResidency(root: THREE.Object3D | undefined) {
     6	  const images = new Set<{ width: number; height: number }>();
     7	  root?.traverse((node) => {
     8	    const mesh = node as THREE.Mesh;
     9	    for (const material of Array.isArray(mesh.material) ? mesh.material : mesh.material ? [mesh.material] : []) {
    10	      for (const value of Object.values(material)) if (value?.isTexture && value.image?.width) images.add(value.image);
    11	    }
    12	  });
    13	  return { images: images.size, estimatedBytes: [...images].reduce((sum, image) => sum + image.width * image.height * 4 * 4 / 3, 0) };
    14	}
