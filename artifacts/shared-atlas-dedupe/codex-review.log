     1	import { createHash } from 'node:crypto';
     2	import { readdir, readFile, writeFile } from 'node:fs/promises';
     3	import path from 'node:path';
     4	async function census(root) {
     5	  const groups = new Map();
     6	  const files = (await readdir(root, { recursive: true })).filter(p => p.endsWith('.glb')).sort();
     7	  let images = 0, embeddedBytes = 0, glbBytes = 0;
     8	  for (const file of files) {
     9	    const glb = await readFile(path.join(root, file));
    10	    glbBytes += glb.length;
    11	    let json, bin;
    12	    for (let off = 12; off < glb.length;) {
    13	      const length = glb.readUInt32LE(off), type = glb.readUInt32LE(off + 4);
    14	      const chunk = glb.subarray(off + 8, off + 8 + length);
    15	      if (type === 0x4e4f534a) json = JSON.parse(chunk.toString('utf8'));
    16	      if (type === 0x004e4942) bin = chunk;
    17	      off += 8 + length;
    18	    }
    19	    for (const [index, image] of (json.images ?? []).entries()) {
    20	      if (image.bufferView === undefined) continue;
    21	      const view = json.bufferViews[image.bufferView];
    22	      const data = bin.subarray(view.byteOffset ?? 0, (view.byteOffset ?? 0) + view.byteLength);
    23	      const hash = createHash('sha256').update(data).digest('hex');
    24	      const group = groups.get(hash) ?? { hash, bytes: data.length, mimeType: image.mimeType, images: [] };
    25	      group.images.push(`${file}#image-${index}`);
    26	      groups.set(hash, group);
    27	      images++; embeddedBytes += data.length;
    28	    }
    29	  }
    30	  const duplicates = [...groups.values()].filter(g => g.images.length > 1);
    31	  return { root, glbs: files.length, glbBytes, images, embeddedBytes, uniqueImages: groups.size, duplicateGroups: duplicates.length, redundantImageBytes: duplicates.reduce((s, g) => s + g.bytes * (g.images.length - 1), 0), duplicates };
    32	}
    33	const result = { source: await census('assets/pilots'), productionBuild: await census('dist/assets') };
    34	await writeFile('artifacts/shared-atlas-dedupe/census.json', JSON.stringify(result, null, 2) + '\n');
    35	for (const { duplicates, ...summary } of Object.values(result)) console.log(summary);
