    95	const FILTERS = {
    96	  9728: THREE.NearestFilter, 9729: THREE.LinearFilter,
    97	  9984: THREE.NearestMipmapNearestFilter, 9985: THREE.LinearMipmapNearestFilter,
    98	  9986: THREE.NearestMipmapLinearFilter, 9987: THREE.LinearMipmapLinearFilter,
    99	} as const;
   100	const WRAPS = { 33071: THREE.ClampToEdgeWrapping, 33648: THREE.MirroredRepeatWrapping, 10497: THREE.RepeatWrapping } as const;
   101	
   102	export class SharedAtlasPlugin implements GLTFLoaderPlugin {
   103	  readonly name = 'GR_shared_atlas';
   104	  private readonly intermediates: THREE.Texture[] = [];
   105	
   106	  constructor(private readonly parser: GLTFParser, private readonly cache: SharedAtlasCache) {
   107	    // EXT_texture_webp/avif run before custom plugins. They converge here with
   108	    // ordinary PNG/JPEG loads, so compressed production GLBs share the same cache.
   109	    const loadImage = parser.loadTextureImage.bind(parser);
   110	    parser.loadTextureImage = (index, source, loader) => this.loadTexture(index, source, loader) ?? loadImage(index, source, loader);
   111	    const assign = parser.assignTexture.bind(parser);
   112	    parser.assignTexture = async (params, name, definition, colorSpace) => {
   113	      const texture = await assign({}, name, definition, colorSpace);
   114	      if (!texture) return texture;
   115	      const view = cache.clone(texture);
   116	      if (view) {
   117	        view.colorSpace = colorSpace ?? THREE.NoColorSpace;
   118	        const association = parser.associations.get(texture);
   119	        if (association) parser.associations.set(view, association);
   120	      }
   121	      params[name] = view ?? texture;
   122	      return params[name];
   123	    };
   124	  }
   125	
   126	  loadTexture(index: number, sourceIndex = this.parser.json.textures[index].source, loader: THREE.Loader = this.parser.textureLoader): Promise<THREE.Texture> | null {
   127	    const { parser, cache } = this;
   128	    const image = parser.json.images?.[sourceIndex];
   129	    // Leave external images and GPU-compressed formats to their native loaders.
   130	    if (image?.bufferView === undefined || !/^image\/(png|jpeg|webp|avif)$/.test(image.mimeType)) return null;
   131	    return parser.getDependency('bufferView', image.bufferView).then(async (buffer: ArrayBuffer) => {
   132	      const texture = await cache.acquire(new Uint8Array(buffer), () => parser.loadImageSource(sourceIndex, loader));
   133	      const definition = parser.json.textures[index];
   134	      const sampler = parser.json.samplers?.[definition.sampler] ?? {};
   135	      texture.magFilter = FILTERS[sampler.magFilter as keyof typeof FILTERS] as THREE.MagnificationTextureFilter ?? THREE.LinearFilter;
   136	      texture.minFilter = FILTERS[sampler.minFilter as keyof typeof FILTERS] ?? THREE.LinearMipmapLinearFilter;
   137	      texture.wrapS = WRAPS[sampler.wrapS as keyof typeof WRAPS] ?? THREE.RepeatWrapping;
   138	      texture.wrapT = WRAPS[sampler.wrapT as keyof typeof WRAPS] ?? THREE.RepeatWrapping;
   139	      texture.generateMipmaps = texture.minFilter !== THREE.NearestFilter && texture.minFilter !== THREE.LinearFilter;
   140	      texture.flipY = false;
   141	      texture.name = definition.name ?? image.name ?? '';
   142	      texture.userData = { ...image.extras, mimeType: image.mimeType };
   143	      parser.associations.set(texture, { textures: index });
   144	      this.intermediates.push(texture);
   145	      return texture;
   146	    });
   147	  }
   148	
   149	  afterRoot(result: GLTF): null {
   150	    // Consumers can replace map slots (the terrain pilot replaces emissiveMap).
   151	    // Material disposal must release those original views as well.
   152	    const materials = new Set<THREE.Material>();
   153	    for (const scene of result.scenes) scene.traverse((node) => {
   154	      const mesh = node as THREE.Mesh;
   155	      for (const material of Array.isArray(mesh.material) ? mesh.material : mesh.material ? [mesh.material] : []) materials.add(material);
   156	    });
   157	    for (const material of materials) {
   158	      const views = Object.values(material).filter((value): value is THREE.Texture => value?.isTexture === true && this.cache.owns(value));
   159	      const dispose = () => {
   160	        material.removeEventListener('dispose', dispose);
   161	        for (const view of views) view.dispose();
   162	      };
   163	      material.addEventListener('dispose', dispose);
   164	    }
   165	    // assignTexture's final material views now own the image. The parser's
   166	    // temporary views were never uploaded and must not keep the cache alive.
   167	    for (const texture of this.intermediates) texture.dispose();
   168	    this.intermediates.length = 0;
   169	    return null;
   170	  }
   171	}
