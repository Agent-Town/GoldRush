{
  "name": "gold-rush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "build:release": "tsc && vite build && node scripts/assert-release-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "census": "playwright test e2e/map-census.spec.ts --project=desktop-chrome --workers=1",
    "test:accounts": "node scripts/test-accounts.mjs",
    "test:mp": "node scripts/test-multiplayer.mjs",
    "test:power-budget": "node --experimental-strip-types scripts/check-power-graph-budget.mjs",
    "verify:visual": "playwright test e2e/visual.spec.ts",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "test:release": "playwright test --config playwright.release.config.ts",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.184.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
