{
  "name": "gold-rush",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build && node scripts/asset-diet.mjs",
    "build:release": "tsc && vite build && node scripts/asset-diet.mjs && node scripts/assert-release-build.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test",
    "test:asset-diet": "GR_ASSET_DIET_BUNDLE=1 playwright test --config playwright.preview.config.ts e2e/asset-diet.spec.ts --workers=1",
    "census": "playwright test e2e/map-census.spec.ts --project=desktop-chrome --workers=1",
    "test:accounts": "node scripts/test-accounts.mjs",
    "mint:prizes": "node scripts/mint-prize-codes.mjs",
    "test:mp": "node scripts/test-multiplayer.mjs",
    "test:power-budget": "node --experimental-strip-types scripts/check-power-graph-budget.mjs",
    "test:node-guards": "node --test scripts/collection-guards-cwd-invariance.test.mjs scripts/e3-mask-tables.test.mjs scripts/entry-damage-table.test.mjs scripts/glob-fallback-completeness.test.mjs scripts/goal-tracker.test.mjs scripts/probe-base.test.mjs scripts/rehearsal-base.test.mjs scripts/run-guards.test.mjs scripts/stream-curate.test.mjs scripts/stream-director.test.mjs scripts/stream-showcase-queue.test.mjs scripts/suite-red-inventory.test.mjs scripts/town-era-props-node-safety.test.mjs scripts/town-spec-collection.test.mjs scripts/whole-suite-collection.test.mjs && node scripts/test-ticker-stats.mjs",
    "test:guards": "node scripts/run-guards.mjs",
    "test:task-guards": "node scripts/task-guard-audit.mjs",
    "test:stats": "node scripts/test-stats.mjs",
    "test:deploy-contract": "bash scripts/test-deploy-contract.sh",
    "test:deploy-site-contract": "bash scripts/test-deploy-site-contract.sh",
    "verify:visual": "playwright test e2e/visual.spec.ts",
    "test:preview": "playwright test --config playwright.preview.config.ts",
    "test:release": "playwright test --config playwright.release.config.ts",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.4.1",
    "@gltf-transform/extensions": "^4.4.1",
    "@gltf-transform/functions": "^4.4.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.0",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.184.1",
    "meshoptimizer": "^1.2.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.34.5",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}
